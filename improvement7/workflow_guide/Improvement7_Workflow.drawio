        </mxCell>
        <mxCell id="validate" value="Validate + Explain&#10;Local / structured path: 0 calls&#10;Optional model path: up to 1 each" parent="1" vertex="1" style="rounded=1;arcSize=5;whiteSpace=wrap;html=0;fontSize=29;spacing=10;fillColor=#E3EFF9;strokeColor=#71808D;fontColor=#172126;">
