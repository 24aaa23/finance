        </mxCell>
        <mxCell id="qu_retry" value="Invalid interpretation&#10;Attempts remain: feedback + retry&#10;Maximum 3 attempts&#10;After attempt 3: fallback below" parent="1" vertex="1" style="rounded=1;arcSize=5;whiteSpace=wrap;html=0;fontSize=29;spacing=10;fillColor=#FFF1CE;strokeColor=#71808D;fontColor=#172126;">
          <mxGeometry x="20" y="345" width="470" height="155" as="geometry" />
        </mxCell>
        <mxCell id="qu_fallback" value="Still invalid after 3 attempts&#10;Return empty contract {}&#10;Original question -&gt; Retrieve" parent="1" vertex="1" style="rounded=1;arcSize=5;whiteSpace=wrap;html=0;fontSize=29;spacing=10;fillColor=#FFF1CE;strokeColor=#71808D;fontColor=#172126;">
          <mxGeometry x="20" y="540" width="470" height="135" as="geometry" />
        </mxCell>
        <mxCell id="decompose_retry" value="Invalid decomposition OR&#10;Query_Spec retries exhausted&#10;Passes left: Decompose again&#10;Max 3 passes; exhausted: error" parent="1" vertex="1" style="rounded=1;arcSize=5;whiteSpace=wrap;html=0;fontSize=29;spacing=10;fillColor=#FFF1CE;strokeColor=#71808D;fontColor=#172126;">
          <mxGeometry x="20" y="730" width="470" height="160" as="geometry" />
        </mxCell>
        <mxCell id="qs_retry" value="Invalid Query_Spec&#10;Attempts remain: feedback + retry&#10;3 failures: replan upstream" parent="1" vertex="1" style="rounded=1;arcSize=5;whiteSpace=wrap;html=0;fontSize=29;spacing=10;fillColor=#FFF1CE;strokeColor=#71808D;fontColor=#172126;">
          <mxGeometry x="20" y="930" width="470" height="135" as="geometry" />
        </mxCell>
        <mxCell id="pre_retry" value="Pre-scan fails; attempts remain&#10;Regenerate SQL&#10;Local 0 calls or LLM fallback 1&#10;No attempts left: error row" parent="1" vertex="1" style="rounded=1;arcSize=5;whiteSpace=wrap;html=0;fontSize=29;spacing=10;fillColor=#FFF1CE;strokeColor=#71808D;fontColor=#172126;">
          <mxGeometry x="20" y="1320" width="470" height="145" as="geometry" />
        </mxCell>
        <mxCell id="scan_retry" value="Scan fails; attempts remain&#10;No SQL: Generate (0 or 1)&#10;Unknown fields: Query_Spec (1)&#10;Valid: Generate; invalid: Refine&#10;Other SQL error: Refine (1)&#10;Similar timeout SQL: Generate too&#10;Then pre-check and Scan again&#10;No attempts left: error row" parent="1" vertex="1" style="rounded=1;arcSize=5;whiteSpace=wrap;html=0;fontSize=29;spacing=10;fillColor=#FFF1CE;strokeColor=#71808D;fontColor=#172126;">
          <mxGeometry x="20" y="1515" width="470" height="295" as="geometry" />
        </mxCell>
        <mxCell id="final_retry" value="Invalid plan or execution error&#10;Attempts left: Final_Spec again&#10;1 LLM call per new plan&#10;Up to 4 attempts per execution&#10;No attempts left: error row" parent="1" vertex="1" style="rounded=1;arcSize=5;whiteSpace=wrap;html=0;fontSize=29;spacing=10;fillColor=#FFF1CE;strokeColor=#71808D;fontColor=#172126;">
          <mxGeometry x="20" y="2100" width="470" height="185" as="geometry" />
        </mxCell>
        <mxCell id="consult" value="OPTIONAL ADVICE (default off)&#10;Requests from Decompose,&#10;Query_Spec or Final_Spec&#10;Domain: 1 LLM call&#10;Query Understanding: 1-3&#10;Shared limit: 5 requests" parent="1" vertex="1" style="rounded=1;arcSize=5;whiteSpace=wrap;html=0;fontSize=29;spacing=10;fillColor=#FFF1CE;strokeColor=#71808D;fontColor=#172126;">
          <mxGeometry x="1300" y="750" width="480" height="220" as="geometry" />
        </mxCell>
        <mxCell id="consult_return" value="UNCHANGED interpretation&#10;Repeat ONLY requesting stage&#10;Decompose, Query_Spec OR&#10;Final_Spec - not all three" parent="1" vertex="1" style="rounded=1;arcSize=5;whiteSpace=wrap;html=0;fontSize=29;spacing=10;fillColor=#FFF1CE;strokeColor=#71808D;fontColor=#172126;">
          <mxGeometry x="1300" y="1020" width="480" height="165" as="geometry" />
        </mxCell>
        <mxCell id="consult_changed" value="CHANGED interpretation&#10;Passes left: Retrieve again&#10;Then restart Decompose&#10;No passes left: error row" parent="1" vertex="1" style="rounded=1;arcSize=5;whiteSpace=wrap;html=0;fontSize=29;spacing=10;fillColor=#FFF1CE;strokeColor=#71808D;fontColor=#172126;">
          <mxGeometry x="1300" y="1270" width="480" height="180" as="geometry" />
        </mxCell>
        <mxCell id="upstream" value="Missing required source data&#10;Request upstream retrieval repair&#10;Decompose -&gt; rerun branches&#10;Up to 3 decomposition passes&#10;Additional model calls each pass" parent="1" vertex="1" style="rounded=1;arcSize=5;whiteSpace=wrap;html=0;fontSize=29;spacing=10;fillColor=#FFF1CE;strokeColor=#71808D;fontColor=#172126;">
          <mxGeometry x="1300" y="2000" width="480" height="200" as="geometry" />
        </mxCell>
        <mxCell id="limits" value="RETRY BUDGETS ARE LOCAL&#10;They can nest or restart stages.&#10;There is no 3-call total limit.&#10;Exhausted repair -&gt; error row.&#10;Quota or startup failures&#10;can stop the batch." parent="1" vertex="1" style="rounded=1;arcSize=5;whiteSpace=wrap;html=0;fontSize=29;spacing=10;fillColor=#F1F2F4;strokeColor=#71808D;fontColor=#172126;">
          <mxGeometry x="1300" y="2350" width="480" height="215" as="geometry" />
        </mxCell>
        <mxCell id="startup_note" value="STARTUP AND QUESTION INPUT&#10;Cache reused across questions.&#10;Invalid domain pack: startup stops.&#10;Question is preprocessed first.&#10;Understanding off: 0 for that agent;&#10;Retrieve still makes its own call." parent="1" vertex="1" style="rounded=1;arcSize=5;whiteSpace=wrap;html=0;fontSize=29;spacing=10;fillColor=#F1F2F4;strokeColor=#71808D;fontColor=#172126;">
          <mxGeometry x="1300" y="150" width="480" height="225" as="geometry" />
        </mxCell>
        <mxCell id="consult_limits" value="CONSULTATION EXCEPTIONS&#10;Invalid request or budget spent:&#10;return a plan contract error.&#10;Other unavailable advice: reask.&#10;Quota / transient error: propagate.&#10;Reasks add model calls." parent="1" vertex="1" style="rounded=1;arcSize=5;whiteSpace=wrap;html=0;fontSize=29;spacing=10;fillColor=#F1F2F4;strokeColor=#71808D;fontColor=#172126;">
          <mxGeometry x="1300" y="1530" width="480" height="210" as="geometry" />
        </mxCell>
        <mxCell id="validation_note" value="VALIDATION DOES NOT REPAIR&#10;Execution check fails: error row.&#10;Optional model review rejection:&#10;record verdict, retain result.&#10;Successful report saves actual&#10;executed data, not LLM prose." parent="1" vertex="1" style="rounded=1;arcSize=5;whiteSpace=wrap;html=0;fontSize=29;spacing=10;fillColor=#F1F2F4;strokeColor=#71808D;fontColor=#172126;">
