        </mxCell>
        <mxCell id="report" value="Save answer or execution error&#10;Raw report and diagnostics&#10;Continue with the next question" parent="1" vertex="1" style="rounded=1;arcSize=5;whiteSpace=wrap;html=0;fontSize=29;spacing=10;fillColor=#F1F2F4;strokeColor=#71808D;fontColor=#172126;">
