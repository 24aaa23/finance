        </mxCell>
        <mxCell id="grader" value="Separate grader&#10;Compare answer with ground truth&#10;Calls excluded from pipeline average" parent="1" vertex="1" style="rounded=1;arcSize=5;whiteSpace=wrap;html=0;fontSize=29;spacing=10;fillColor=#F1F2F4;strokeColor=#71808D;fontColor=#172126;">
