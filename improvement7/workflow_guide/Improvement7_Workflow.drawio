        <mxCell id="error_note" value="ERROR EXIT (not forward flow)&#10;Unrepaired stages skip ahead&#10;to report the failed question.&#10;Processing failure: error row.&#10;Understanding API exceptions&#10;need not reach its fallback.&#10;Empty Scan results can be valid." parent="1" vertex="1" style="rounded=1;arcSize=5;whiteSpace=wrap;html=0;fontSize=29;spacing=10;fillColor=#F1F2F4;strokeColor=#71808D;fontColor=#172126;">
