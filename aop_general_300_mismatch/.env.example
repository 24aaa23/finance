# Copy this file to .env and insert your real key there.
OPENAI_API_KEY=your_openai_api_key_here
PLANNER_MODEL=gpt-5.2
OPENAI_SPARQL_MODEL=gpt-5.2
FINAL_EVALUATOR_MODEL=qwen2.5-coder:32b
PIPELINE_VERSION=qwen14-final-qwen32-sparql-gpt52-v1

# Local Ollama/OpenAI-compatible endpoint.
LLM_BASE_URL=http://127.0.0.1:11440/v1
LLM_API_KEY=local-model

# Optional per-role local-model overrides.
# REFINE_MODEL=qwen2.5-coder:14b
# VALIDATE_MODEL=qwen2.5-coder:14b
# EXPLAIN_MODEL=qwen2.5-coder:14b

DAG_PLANNER_MODE=multi_candidate
DAG_PLANNER_MAX_ROUNDS=3
