        <schema1:sourceName>goal_type_id</schema1:sourceName>
        <schema1:displayName>Goal Type ID</schema1:displayName>
      </owl:DatatypeProperty>
    </schema1:implementedByDatatypeProperty>
  </owl:Class>
  <owl:AnnotationProperty rdf:about="http://example.org/schema-linkage#sourceName">
    <rdfs:label>sourceName</rdfs:label>
  </owl:AnnotationProperty>
  <owl:Class rdf:about="http://example.org/schema-linkage#PortfolioHealth_GoalMatchPct">
    <rdfs:subClassOf rdf:resource="http://example.org/schema-linkage#PortfolioHealth"/>
