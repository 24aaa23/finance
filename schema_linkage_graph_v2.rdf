    <rdfs:label>Goal Type ID</rdfs:label>
    <schema1:nodeKind>column</schema1:nodeKind>
    <schema1:columnRole>physical_column</schema1:columnRole>
    <schema1:displayName>Goal Type ID</schema1:displayName>
