    <schema1:aggregatable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</schema1:aggregatable>
    <skos:altLabel>goal alignment</skos:altLabel>
    <skos:altLabel>goal match</skos:altLabel>
