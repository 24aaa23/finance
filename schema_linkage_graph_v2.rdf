    <rdfs:comment>Unique identifier for goal type</rdfs:comment>
    <schema1:columnDataType>string</schema1:columnDataType>
    <schema1:filterable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</schema1:filterable>
    <schema1:implementedByDatatypeProperty>
      <owl:DatatypeProperty rdf:about="http://example.org/schema-linkage#investment_goal_context__goal_type_id">
        <rdfs:label>Investment Goal Rules / Goal Type ID</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/schema-linkage#InvestmentGoalContext"/>
