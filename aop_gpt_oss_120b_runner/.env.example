# Copy this file to .env and fill in your real credentials.
# Do not commit .env to GitHub.

# Required for GPT-OSS 120B through the AWS Bedrock OpenAI-compatible endpoint.
AWS_BEDROCK_API_KEY=replace_with_your_key
BEDROCK_REGION=us-east-1

# Optional. Use this only if your Bedrock endpoint URL is custom.
# BEDROCK_BASE_URL=https://bedrock-runtime.us-east-1.amazonaws.com/openai/v1

# Model used by the script.
BEDROCK_GPT_OSS_MODEL=openai.gpt-oss-120b-1:0

# Fuseki SPARQL endpoint. Keep this if you start Fuseki with dataset name "wealth".
FUSEKI_ENDPOINT=http://127.0.0.1:3030/wealth/query

# For a quick smoke test, set TEST_QUERY_LIMIT=1.
# For the full default run, use TEST_QUERY_LIMIT=300.
TEST_QUERY_LIMIT=1
TEST_QUERY_OFFSET=0
TEST_MAX_WORKERS=1
