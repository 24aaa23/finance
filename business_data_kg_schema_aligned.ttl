@prefix ex:      <http://example.org/kg#> .
@prefix schema1: <http://example.org/schema-linkage#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .


# ============================================================
# ONTOLOGY HEADER
# ============================================================
<http://example.org/kg#> a owl:Ontology ;
    rdfs:label "Investment Portfolio Knowledge Graph – Corrected v2" ;
    rdfs:comment """Rebuilt from raw CSVs + schema linkage.
    Fixes applied:
      1. Single InvestmentType hierarchy (20 nodes from investment_types.csv only).
      2. Single AssetClass hierarchy (10 nodes from categories.csv only). No mixing.
      3. All 10 holdings now carry ex:hasInvestmentType object-property links.
      4. SectorAllocation: UUID stored as sectorAllocationId; hasSector links Sector by name.
      5. goal_tracking.csv source-data bug (all rows pointed to G001) corrected;
         INV002 tracking linked to G002, INV003 to G003.
      6. Hallucinated risk-tolerance labels removed. RISK001-RISK011 describe
         investment-product risk only (from investment_risk_categories.csv).
      7. Orphan GOALTYPE / TimeHorizon phantom instances removed entirely.
      8. 'Private Equity' category in holding 3 has no match in categories.csv;
         stored as literal only, no fabricated AssetClass node.
      9. 'Debt' segment in several holdings has no match in segments.csv;
         stored as literal only, no fabricated Segment node.
     10. Source typos (Coporate Bond, Soverign Government Bond) kept verbatim in
         InvestmentType nodes with rdfs:comment noting the typo – holdings link
         to those nodes without hallucinating a parallel 'corrected' node.
    """ .

# ============================================================
# PROPERTY ALIGNMENT BRIDGE
# Maps the KG's human-readable ex: property names to the
# canonical names defined in schema_linkage_graph_v2.rdf.
# This lets SPARQL queries use EITHER name and lets Protégé
# understand that they are the same property.
# ============================================================

# ── PortfolioHolding ──────────────────────────────────────
ex:sectorLiteral         owl:equivalentProperty schema1:portfolio_holding__sector .
ex:segmentLiteral        owl:equivalentProperty schema1:portfolio_holding__segment .
ex:categoryLiteral       owl:equivalentProperty schema1:portfolio_holding__category .
ex:investmentTypeLiteral owl:equivalentProperty schema1:portfolio_holding__investment_type .
ex:investmentName        owl:equivalentProperty schema1:portfolio_holding__investment_name .
ex:returnsPct            owl:equivalentProperty schema1:portfolio_holding__returns_pct .
ex:hasSector             owl:equivalentProperty schema1:portfolio_holding__sector__context .
ex:hasSegment            owl:equivalentProperty schema1:portfolio_holding__segment__context .
ex:hasAssetClass         owl:equivalentProperty schema1:portfolio_holding__category__context .
ex:hasInvestmentType     owl:equivalentProperty schema1:portfolio_holding__investment_type__context .

# ── InvestmentGoal ────────────────────────────────────────
ex:targetAmount          owl:equivalentProperty schema1:investment_goal__target_amount .
ex:currentValue          owl:equivalentProperty schema1:investment_goal__current_value .
ex:progressPct           owl:equivalentProperty schema1:investment_goal__progress_pct .
ex:shortfall             owl:equivalentProperty schema1:investment_goal__shortfall .
ex:timeToGoalMonths      owl:equivalentProperty schema1:investment_goal__time_to_goal_months .
ex:avgAnnualReturnPct    owl:equivalentProperty schema1:investment_goal__avg_annual_return_pct .
ex:avgPostTaxReturnPct   owl:equivalentProperty schema1:investment_goal__avg_post_tax_return_pct .
ex:avgSharpeRatio        owl:equivalentProperty schema1:investment_goal__avg_sharpe_ratio .
ex:avgVolatilityPct      owl:equivalentProperty schema1:investment_goal__avg_volatility_pct .
ex:stdDevAnnualReturnPct owl:equivalentProperty schema1:investment_goal__std_dev_annual_return_pct .

# ── InvestorProfile ───────────────────────────────────────
ex:investmentGoalLabel   owl:equivalentProperty schema1:investor_profile__investment_goal .
ex:riskTolerance         owl:equivalentProperty schema1:investor_profile__risk_tolerance .
ex:timeHorizon           owl:equivalentProperty schema1:investor_profile__time_horizon .
ex:sectorFocus           owl:equivalentProperty schema1:investor_profile__sector_focus .
ex:preferredSegment      owl:equivalentProperty schema1:investor_profile__segment .
ex:preferredCategory     owl:equivalentProperty schema1:investor_profile__category .

# ── CashFlow ──────────────────────────────────────────────
ex:cashFlowType          owl:equivalentProperty schema1:cash_flow__type .
ex:amount                owl:equivalentProperty schema1:cash_flow__amount .

# ── PortfolioHealth ───────────────────────────────────────
ex:goalMatchPct          owl:equivalentProperty schema1:portfolio_health__goal_match_pct .
ex:riskScore             owl:equivalentProperty schema1:portfolio_health__risk_score .
ex:liquidityScore        owl:equivalentProperty schema1:portfolio_health__liquidity_score .
ex:diversificationScore  owl:equivalentProperty schema1:portfolio_health__diversification_score .

# ── RebalancingAction ─────────────────────────────────────
ex:currentAllocationPct  owl:equivalentProperty schema1:rebalancing_action__current_allocation_pct .
ex:targetAllocationPct   owl:equivalentProperty schema1:rebalancing_action__target_allocation_pct .

# ── SectorAllocation ──────────────────────────────────────
ex:allocationPct         owl:equivalentProperty schema1:sector_allocation__allocation_pct .
ex:totalInvestment       owl:equivalentProperty schema1:sector_allocation__total_investment .
ex:sectorName            owl:equivalentProperty schema1:sector_allocation__sector .



# ============================================================
# CLASS DECLARATIONS
# ============================================================
ex:InvestorProfile        a owl:Class ; rdfs:label "Investor Profile" .
ex:InvestmentGoal         a owl:Class ; rdfs:label "Investment Goal" .
ex:PortfolioHolding       a owl:Class ; rdfs:label "Portfolio Holding" .
ex:InvestmentType         a owl:Class ; rdfs:label "Investment Type" .
ex:AssetClass             a owl:Class ; rdfs:label "Asset Class" .
ex:Sector                 a owl:Class ; rdfs:label "Sector" .
ex:Segment                a owl:Class ; rdfs:label "Market Segment" .
ex:InvestmentRiskCategory a owl:Class ; rdfs:label "Investment Risk Category" .
ex:SectorAllocation       a owl:Class ; rdfs:label "Sector Allocation" .
ex:PortfolioHealth        a owl:Class ; rdfs:label "Portfolio Health" .
ex:CashFlow               a owl:Class ; rdfs:label "Cash Flow" .
ex:RebalancingAction      a owl:Class ; rdfs:label "Rebalancing Action" .
ex:ScenarioRebalancing    a owl:Class ; rdfs:label "Scenario-Based Rebalancing" .

# ============================================================
# OBJECT PROPERTY DECLARATIONS
# ============================================================
ex:hasInvestor       a owl:ObjectProperty ; rdfs:range ex:InvestorProfile .
ex:hasInvestmentGoal a owl:ObjectProperty ; rdfs:domain ex:InvestorProfile   ; rdfs:range ex:InvestmentGoal .
ex:hasHolding        a owl:ObjectProperty ; rdfs:domain ex:InvestorProfile   ; rdfs:range ex:PortfolioHolding .
ex:hasInvestmentType a owl:ObjectProperty ; rdfs:domain ex:PortfolioHolding  ; rdfs:range ex:InvestmentType .
ex:hasAssetClass     a owl:ObjectProperty ; rdfs:domain ex:PortfolioHolding  ; rdfs:range ex:AssetClass .
ex:hasSector         a owl:ObjectProperty ; rdfs:range ex:Sector .
ex:hasSegment        a owl:ObjectProperty ; rdfs:domain ex:PortfolioHolding  ; rdfs:range ex:Segment .
ex:hasRiskCategory   a owl:ObjectProperty ; rdfs:domain ex:InvestmentType    ; rdfs:range ex:InvestmentRiskCategory .

# ============================================================
# DATATYPE PROPERTY DECLARATIONS (selected key ones)
# ============================================================
ex:investorId          a owl:DatatypeProperty ; rdfs:range xsd:string .
ex:investorName        a owl:DatatypeProperty ; rdfs:range xsd:string .
ex:invtypeId           a owl:DatatypeProperty ; rdfs:range xsd:string .
ex:investmentTypeName  a owl:DatatypeProperty ; rdfs:range xsd:string .
ex:categoryId          a owl:DatatypeProperty ; rdfs:range xsd:string .
ex:categoryName        a owl:DatatypeProperty ; rdfs:range xsd:string .
ex:sectorId            a owl:DatatypeProperty ; rdfs:range xsd:string .
ex:sectorName          a owl:DatatypeProperty ; rdfs:range xsd:string .
ex:segmentId           a owl:DatatypeProperty ; rdfs:range xsd:string .
ex:segmentName         a owl:DatatypeProperty ; rdfs:range xsd:string .
ex:riskCategoryId      a owl:DatatypeProperty ; rdfs:range xsd:string .
ex:riskLevel           a owl:DatatypeProperty ; rdfs:range xsd:string .
ex:holdingId           a owl:DatatypeProperty ; rdfs:range xsd:string .
ex:investmentName      a owl:DatatypeProperty ; rdfs:range xsd:string .
ex:purchaseDate        a owl:DatatypeProperty ; rdfs:range xsd:date .
ex:cost                a owl:DatatypeProperty ; rdfs:range xsd:decimal .
ex:currentValue        a owl:DatatypeProperty ; rdfs:range xsd:decimal .
ex:returnsPct          a owl:DatatypeProperty ; rdfs:range xsd:decimal .
ex:dividends           a owl:DatatypeProperty ; rdfs:range xsd:decimal .
ex:taxesPaid           a owl:DatatypeProperty ; rdfs:range xsd:decimal .
ex:goalId              a owl:DatatypeProperty ; rdfs:range xsd:string .
ex:targetAmount        a owl:DatatypeProperty ; rdfs:range xsd:decimal .
ex:progressPct         a owl:DatatypeProperty ; rdfs:range xsd:decimal .
ex:shortfall           a owl:DatatypeProperty ; rdfs:range xsd:decimal .
ex:timeToGoalMonths    a owl:DatatypeProperty ; rdfs:range xsd:integer .
ex:avgAnnualReturnPct  a owl:DatatypeProperty ; rdfs:range xsd:decimal .
ex:avgPostTaxReturnPct a owl:DatatypeProperty ; rdfs:range xsd:decimal .
ex:avgSharpeRatio      a owl:DatatypeProperty ; rdfs:range xsd:decimal .
ex:avgVolatilityPct    a owl:DatatypeProperty ; rdfs:range xsd:decimal .
ex:stdDevAnnualReturnPct a owl:DatatypeProperty ; rdfs:range xsd:decimal .

# ============================================================
# REFERENCE DATA – InvestmentType   (source: investment_types.csv)
# ONE canonical node per row.  No duplicates from categories.csv.
