    ex:riskCategoryId "RISK005" ;
    ex:investmentTypeLiteral "Alternative Investment Funds (AIF Cat III)" ;
    ex:fullForm "Global Macro Hedge Funds" ;
    ex:riskLevel "High" .

ex:RISK006 a ex:InvestmentRiskCategory ;
    ex:riskCategoryId "RISK006" ;
    ex:investmentTypeLiteral "Global Equity" ;
    ex:fullForm "Global Equity" ;
    ex:riskLevel "High" .

ex:RISK007 a ex:InvestmentRiskCategory ;
    ex:riskCategoryId "RISK007" ;
    ex:investmentTypeLiteral "Equity" ;
    ex:fullForm "Equity (Stocks)" ;
    ex:riskLevel "High" .

ex:RISK008 a ex:InvestmentRiskCategory ;
    ex:riskCategoryId "RISK008" ;
    ex:investmentTypeLiteral "Mutual Fund" ;
    ex:fullForm "Debt Mutual Fund" ;
    ex:riskLevel "Low" .

ex:RISK009 a ex:InvestmentRiskCategory ;
    ex:riskCategoryId "RISK009" ;
    ex:investmentTypeLiteral "REIT" ;
    ex:fullForm "Real Estate Investment Trust" ;
    ex:riskLevel "Medium" .

ex:RISK010 a ex:InvestmentRiskCategory ;
    ex:riskCategoryId "RISK010" ;
    ex:investmentTypeLiteral "Cash & Equivalent" ;
    ex:fullForm "Cash" ;
    ex:riskLevel "Low" .

ex:RISK011 a ex:InvestmentRiskCategory ;
    ex:riskCategoryId "RISK011" ;
    ex:investmentTypeLiteral "Certificates of Deposit (CDs)" ;
    ex:fullForm "Certificates of Deposit (CDs)" ;
    ex:riskLevel "Low" .

# Link InvestmentType nodes → their risk categories
ex:INVTYPE013 ex:hasRiskCategory ex:RISK001 .   # Coporate Bond       → Medium
ex:INVTYPE014 ex:hasRiskCategory ex:RISK002 .   # Soverign Govt Bond  → Low
ex:INVTYPE015 ex:hasRiskCategory ex:RISK003 .   # AIF Cat I           → High
ex:INVTYPE016 ex:hasRiskCategory ex:RISK004 .   # AIF Cat II          → High
ex:INVTYPE017 ex:hasRiskCategory ex:RISK005 .   # AIF Cat III         → High
ex:INVTYPE018 ex:hasRiskCategory ex:RISK006 .   # Global Equity       → High
ex:INVTYPE006 ex:hasRiskCategory ex:RISK007 .   # Equity              → High
ex:INVTYPE010 ex:hasRiskCategory ex:RISK008 .   # Mutual Fund         → Low
ex:INVTYPE008 ex:hasRiskCategory ex:RISK009 .   # REIT                → Medium
ex:INVTYPE019 ex:hasRiskCategory ex:RISK010 .   # Cash & Equivalent   → Low
ex:INVTYPE020 ex:hasRiskCategory ex:RISK011 .   # CDs                 → Low

# ============================================================
# INVESTOR PROFILES   (source: investor_profile.csv)
# riskTolerance stored as plain string literal.
# "High" and "Highest" are NOT in the schema's allowed values
# (Conservative/Moderate/Aggressive) – kept as-is per source data.
# No invented risk-tolerance nodes.
# ============================================================

