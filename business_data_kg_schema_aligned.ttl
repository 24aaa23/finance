# ============================================================
# INVESTMENT GOALS   (sources: investment_goals.csv + goal_tracking.csv
#                              + goal_performance.csv + goal_risk_metrics.csv)
#
# BUG FIX – goal_tracking.csv source data error:
#   All three rows set goal_id = "G001" regardless of investor.
#   The correct mapping (from investment_goals.csv) is:
#     INV001 → G001  (row 10d18e8e – correctly already G001)
#     INV002 → G002  (row 23cfae3f – CSV says G001, CORRECTED)
#     INV003 → G003  (row bd92ec7b – CSV says G001, CORRECTED)
# ============================================================

ex:G001 a ex:InvestmentGoal ;
    ex:goalId              "G001" ;
    ex:investmentGoalLabel "Income Generation" ;
    ex:description         "Focus on safety and inflation hedge" ;
    ex:hasInvestor         ex:INV001 ;
    # --- goal_tracking row for INV001 ---
    ex:goalTrackingId      "10d18e8e-3ee8-4819-b5c5-9061aecc6016" ;
    ex:targetAmount        "1000000"^^xsd:decimal ;
    ex:currentValue        "1046172"^^xsd:decimal ;
    ex:progressPct         "104.62"^^xsd:decimal ;
    ex:shortfall           "-46172"^^xsd:decimal ;
    ex:timeToGoalMonths    "36"^^xsd:integer ;
    # --- goal_performance row for INV001, G001 ---
    ex:goalPerformanceId   "47fef283-1b62-435f-8659-5dd9bd9e7863" ;
    ex:avgAnnualReturnPct  "13.9"^^xsd:decimal ;
    ex:avgPostTaxReturnPct "11.12"^^xsd:decimal ;
    ex:avgSharpeRatio      "2.24"^^xsd:decimal ;
    # --- goal_risk_metrics row for INV001, G001 ---
    ex:goalRiskId          "660c5d78-3ad7-44c8-8212-fb28dfa7129d" ;
    ex:avgVolatilityPct    "6.19"^^xsd:decimal ;
    ex:stdDevAnnualReturnPct "9.15"^^xsd:decimal .

ex:G002 a ex:InvestmentGoal ;
    ex:goalId              "G002" ;
    ex:investmentGoalLabel "Growth" ;
    ex:description         "Aggressive equity growth strategy" ;
    ex:hasInvestor         ex:INV002 ;
    # --- goal_tracking row for INV002 (CORRECTED from G001) ---
    ex:goalTrackingId      "23cfae3f-8b67-4760-ab78-9d4ba2a8265a" ;
    ex:targetAmount        "1500000"^^xsd:decimal ;
    ex:currentValue        "1345444"^^xsd:decimal ;
    ex:progressPct         "89.7"^^xsd:decimal ;
    ex:shortfall           "154556"^^xsd:decimal ;
