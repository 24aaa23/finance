ex:SEGMENT009 a ex:Segment ; ex:segmentId "SEGMENT009" ; ex:segmentName "International" .

# ============================================================
# REFERENCE DATA – InvestmentRiskCategory  (source: investment_risk_categories.csv)
# IMPORTANT: These nodes describe investment-PRODUCT risk (Medium/High/Low).
# They do NOT represent investor risk-tolerance levels.
# Do NOT confuse with investor risk profile (Conservative/Moderate/Aggressive).
# The hallucinated RISK_001="Conservative" / RISK_003="Aggressive" nodes are removed.
# ============================================================
ex:RISK001 a ex:InvestmentRiskCategory ;
    ex:riskCategoryId "RISK001" ;
    ex:investmentTypeLiteral "Coporate Bond" ;
    ex:fullForm "Coporate Bond" ;
    ex:riskLevel "Medium" .

ex:RISK002 a ex:InvestmentRiskCategory ;
    ex:riskCategoryId "RISK002" ;
    ex:investmentTypeLiteral "Soverign Government Bond" ;
    ex:fullForm "Government Bond" ;
    ex:riskLevel "Low" .

ex:RISK003 a ex:InvestmentRiskCategory ;
    ex:riskCategoryId "RISK003" ;
    ex:investmentTypeLiteral "Alternative Investment Funds (AIF - Cat I)" ;
    ex:fullForm "Private Equity" ;
    ex:riskLevel "High" .

