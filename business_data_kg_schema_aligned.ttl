ex:INVTYPE001 a ex:InvestmentType ; ex:invtypeId "INVTYPE001" ; ex:investmentTypeName "Bond" .
ex:INVTYPE002 a ex:InvestmentType ; ex:invtypeId "INVTYPE002" ; ex:investmentTypeName "SGB" .
