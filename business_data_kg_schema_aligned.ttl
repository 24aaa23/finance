ex:CATEGORY001 a ex:AssetClass ; ex:categoryId "CATEGORY001" ; ex:categoryName "Bond" .
ex:CATEGORY002 a ex:AssetClass ; ex:categoryId "CATEGORY002" ; ex:categoryName "SGB" .
