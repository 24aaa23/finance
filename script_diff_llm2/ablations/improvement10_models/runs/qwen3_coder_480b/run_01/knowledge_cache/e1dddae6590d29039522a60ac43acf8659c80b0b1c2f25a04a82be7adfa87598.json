        ]
      },
      {
        "id": "K14",
        "text": "For Aggressive investors, flag any single sector allocation exceeding 40% or equity allocation exceeding 80%.",
        "fields": [
          {
            "table": "ATOM_ENTITY_INVESTOR_PROFILE_001",
