      {
        "id": "K16",
        "text": "ELSS investments have a 3-year lock-in period. Do not recommend redemption if (today - purchase_date) < 3 years.",
        "fields": [
          {
            "table": "ATOM_ENTITY_PORTFOLIO_HOLDING_001",
