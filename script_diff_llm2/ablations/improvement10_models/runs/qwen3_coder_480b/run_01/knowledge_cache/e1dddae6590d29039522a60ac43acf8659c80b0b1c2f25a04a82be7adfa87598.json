        ]
      },
      {
        "id": "K10",
        "text": "Goal achievement percentage (achievement_pct) is calculated as (current_value / target_amount) * 100 on the investment_goal table.",
        "fields": [
          {
            "table": "ATOM_ENTITY_INVESTMENT_GOAL_001",
            "column": "current_value"
          },
          {
            "table": "ATOM_ENTITY_INVESTMENT_GOAL_001",
            "column": "target_amount"
          }
        ],
        "citations": [],
        "sources": [
          "domain"
        ]
      },
      {
        "id": "K11",
        "text": "If achievement_pct < 50% and goal target_date is within 2 years, flag as high-priority advisory case.",
        "fields": [
          {
            "table": "ATOM_ENTITY_INVESTMENT_GOAL_001",
            "column": "progress_pct"
          }
        ],
        "citations": [],
        "sources": [
          "domain"
        ]
      },
      {
        "id": "K12",
        "text": "Allocation drift is calculated as absolute difference between current_allocation_pct and target_allocation_pct. If drift > 10 percentage points, trigger rebalancing recommendation.",
        "fields": [
          {
            "table": "ATOM_EVENT_REBALANCING_ACTION_001",
            "column": "current_allocation_pct"
          },
          {
            "table": "ATOM_EVENT_REBALANCING_ACTION_001",
            "column": "target_allocation_pct"
          }
        ],
        "citations": [],
        "sources": [
          "domain"
        ]
      },
      {
        "id": "K13",
        "text": "For Conservative investors, flag any single sector allocation exceeding 30% for compliance review.",
        "fields": [
          {
            "table": "ATOM_ENTITY_INVESTOR_PROFILE_001",
            "column": "risk_tolerance"
          },
          {
            "table": "ATOM_ENTITY_SECTOR_ALLOCATION_001",
