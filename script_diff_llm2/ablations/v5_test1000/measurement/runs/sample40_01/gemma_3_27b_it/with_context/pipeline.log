[SQL GENERATE] Generated SQL: WITH InvestorProfiles AS (
  SELECT
    investor_id
  FROM ATOM_ENTITY_INVESTOR_PROFILE_001
  WHERE
    risk_tolerance = 'Conservative'
),
PortfolioHealth AS (
  SELECT
    investor_id,
    liquidity_score
  FROM ATOM_ENTITY_PORTFOLIO_HEALTH_001
),
PortfolioHoldings AS (
  SELECT
    investor_id,
    cost,
    current_value
  FROM ATOM_ENTITY_PORTFOLIO_HOLDING_001
  WHERE
    cost IS NOT NULL AND current_value IS NOT NULL
),
LossMakingHoldings AS (
  SELECT
    investor_id
  FROM PortfolioHoldings
  WHERE
    current_value < cost
),
InvestmentGoals AS (
  SELECT
    investor_id,
    shortfall
  FROM ATOM_ENTITY_INVESTMENT_GOAL_001
),
UnderfundedGoals AS (
  SELECT
    investor_id
  FROM InvestmentGoals
  WHERE
    shortfall > 0
),
RebalancingActions AS (
  SELECT
    investor_id
  FROM ATOM_EVENT_REBALANCING_ACTION_001
  WHERE
    action = 'Asset Reallocation'
)
SELECT
  ip.investor_id
FROM InvestorProfiles AS ip
INNER JOIN PortfolioHealth AS ph ON ip.investor_id = ph.investor_id
INNER JOIN LossMakingHoldings AS lmh ON ip.investor_id = lmh.investor_id
INNER JOIN UnderfundedGoals AS ug ON ip.investor_id = ug.investor_id
INNER JOIN RebalancingActions AS ra ON ip.investor_id = ra.investor_id
WHERE
  ph.liquidity_score < 25;
