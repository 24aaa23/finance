[SQL GENERATE] Generated SQL: WITH profile_base AS (
  SELECT 
    "investor_id",
    "risk_tolerance"
  FROM "ATOM_ENTITY_INVESTOR_PROFILE_001"
),
cash_flow_metrics AS (
  SELECT
    "investor_id",
    SUM("amount") AS "net_cash_flow_per_entity",
    AVG("amount") AS "avg_cash_flow_per_entity"
  FROM "ATOM_EVENT_CASH_FLOW_001"
  GROUP BY "investor_id"
),
scenario_metrics AS (
  SELECT
    "investor_id",
    AVG("new_allocation_pct" - "current_allocation_pct") AS "avg_allocation_shift_per_entity"
  FROM "ATOM_EVENT_SCENARIO_REBALANCING_001"
  GROUP BY "investor_id"
),
goal_metrics AS (
  SELECT
    "investor_id",
    AVG("progress_pct") AS "avg_goal_progress_per_entity"
  FROM "ATOM_ENTITY_INVESTMENT_GOAL_001"
  GROUP BY "investor_id"
),
final_aggregation AS (
  SELECT
    p."risk_tolerance" AS "risk_tolerance",
    AVG(COALESCE(c."net_cash_flow_per_entity", 0)) AS "avg_net_cash_flow",
    AVG(c."avg_cash_flow_per_entity") AS "avg_cash_flow_amount",
    AVG(s."avg_allocation_shift_per_entity") AS "avg_scenario_allocation_shift",
    AVG(g."avg_goal_progress_per_entity") AS "avg_goal_progress"
  FROM profile_base p
  LEFT JOIN cash_flow_metrics c ON p."investor_id" = c."investor_id"
  LEFT JOIN scenario_metrics s ON p."investor_id" = s."investor_id"
  LEFT JOIN goal_metrics g ON p."investor_id" = g."investor_id"
  GROUP BY p."risk_tolerance"
)
SELECT 
  "risk_tolerance",
  "avg_net_cash_flow",
  "avg_cash_flow_amount",
  "avg_scenario_allocation_shift",
  "avg_goal_progress"
FROM final_aggregation;

