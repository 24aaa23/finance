[SQL GENERATE] Generated SQL: WITH holding_gains AS (
  SELECT 
    investor_id,
    SUM(current_value - cost) AS total_holding_gain
  FROM ATOM_ENTITY_PORTFOLIO_HOLDING_001
  WHERE cost IS NOT NULL 
    AND current_value IS NOT NULL
  GROUP BY investor_id
),
rebalance_amounts AS (
  SELECT 
    investor_id,
    SUM(amount) AS total_rebalance_amount
  FROM ATOM_EVENT_REBALANCING_ACTION_001
  GROUP BY investor_id
)
SELECT 
  ip.investor_id,
  ip.investor_name,
  COALESCE(hg.total_holding_gain, 0) AS total_holding_gain,
  COALESCE(ra.total_rebalance_amount, 0) AS total_rebalance_amount,
  (COALESCE(hg.total_holding_gain, 0) + COALESCE(ra.total_rebalance_amount, 0)) AS composite_score
FROM ATOM_ENTITY_INVESTOR_PROFILE_001 ip
INNER JOIN holding_gains hg ON ip.investor_id = hg.investor_id
INNER JOIN rebalance_amounts ra ON ip.investor_id = ra.investor_id
ORDER BY 
  composite_score DESC,
  ip.investor_id ASC
LIMIT 10
