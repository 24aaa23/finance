PREFIX wm: <https://wealth.example.org/ontology/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?investorId ?investorName
WHERE {
  ?inv a wm:Investor ;
       wm:investorId ?investorId ;
       wm:investorName ?investorName ;
       wm:riskTolerance "Conservative" .

  {
    SELECT ?investorId (MIN(?divScore) AS ?divScore)
    WHERE {
      ?ph a wm:PortfolioHealth ;
          wm:diversificationScore ?divScore ;
          wm:healthOfInvestor ?invHealth .
      ?invHealth wm:investorId ?investorId .
    }
    GROUP BY ?investorId
    HAVING(?divScore < 25)
  }

  {
    SELECT ?investorId (MAX(?allocPct) AS ?allocPct)
    WHERE {
      ?sa a wm:SectorAllocation ;
          wm:sector "Automobile" ;
          wm:allocationPct ?allocPct ;
          wm:investorId ?investorId .
    }
    GROUP BY ?investorId
    HAVING(?allocPct > 0)
  }

  {
    SELECT ?investorId (COUNT(?h) AS ?lossHoldingCount)
    WHERE {
      ?h a wm:PortfolioHolding ;
         wm:investorId ?investorId ;
         wm:cost ?cost ;
         wm:currentValue ?curr .
      FILTER(?curr < ?cost)
    }
    GROUP BY ?investorId
    HAVING(?lossHoldingCount > 0)
  }
}

