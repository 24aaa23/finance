[SQL GENERATE] Generated SQL: WITH
    net_cash_per_inv AS (
        SELECT investor_id, SUM(amount) AS net_cash_flow
        FROM ATOM_EVENT_CASH_FLOW_001
        GROUP BY investor_id
    ),
    avg_net_cash AS (
        SELECT p.risk_tolerance,
               AVG(nc.net_cash_flow) AS avg_net_cash_flow
        FROM ATOM_ENTITY_INVESTOR_PROFILE_001 p
        LEFT JOIN net_cash_per_inv nc ON p.investor_id = nc.investor_id
        GROUP BY p.risk_tolerance
    ),
    avg_signed_cf AS (
        SELECT p.risk_tolerance,
               AVG(cf.amount) AS avg_signed_cash_flow_amount
        FROM ATOM_ENTITY_INVESTOR_PROFILE_001 p
        LEFT JOIN ATOM_EVENT_CASH_FLOW_001 cf ON p.investor_id = cf.investor_id
        GROUP BY p.risk_tolerance
    ),
    avg_risk_score AS (
        SELECT p.risk_tolerance,
               AVG(ph.risk_score) AS avg_risk_score
        FROM ATOM_ENTITY_INVESTOR_PROFILE_001 p
        LEFT JOIN ATOM_ENTITY_PORTFOLIO_HEALTH_001 ph ON p.investor_id = ph.investor_id
        GROUP BY p.risk_tolerance
    ),
    risk_groups AS (
        SELECT DISTINCT risk_tolerance FROM ATOM_ENTITY_INVESTOR_PROFILE_001
    )
SELECT
    rg.risk_tolerance,
    anc.avg_net_cash_flow,
    asc.avg_signed_cash_flow_amount,
    ars.avg_risk_score
FROM risk_groups rg
LEFT JOIN avg_net_cash anc ON rg.risk_tolerance = anc.risk_tolerance
LEFT JOIN avg_signed_cf asc ON rg.risk_tolerance = asc.risk_tolerance
LEFT JOIN avg_risk_score ars ON rg.risk_tolerance = ars.risk_tolerance
ORDER BY rg.risk_tolerance;
