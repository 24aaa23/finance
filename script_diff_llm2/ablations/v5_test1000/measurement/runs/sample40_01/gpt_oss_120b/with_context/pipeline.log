PREFIX wm: <https://wealth.example.org/ontology/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT DISTINCT ?investorId
WHERE {
  ?inv a wm:Investor .
  ?inv wm:segment ?segment .
  FILTER(LCASE(?segment) = "mid cap") .
  ?inv wm:investorId ?investorId .

  ?inv wm:hasPortfolioHealth ?ph .
  ?ph wm:liquidityScore ?liq .
  FILTER(?liq < 50) .

  FILTER EXISTS {
