    ?sa wm:sector ?sector .
    FILTER(LCASE(?sector) = "automobile") .
    ?sa wm:allocationPct ?alloc .
    FILTER(?alloc > 0) .
  }

  FILTER EXISTS {
    ?inv wm:hasInvestmentGoal ?goal .
    ?goal wm:shortfall ?sf .
    FILTER(?sf > 0) .
  }
}

