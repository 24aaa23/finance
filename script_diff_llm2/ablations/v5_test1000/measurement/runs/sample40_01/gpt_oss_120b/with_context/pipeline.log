PREFIX wm: <https://wealth.example.org/ontology/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?investorId ?investorName ?loss_holding_count
WHERE {
  # Investor and core filters
  ?investor a wm:Investor ;
            wm:investorId ?investorId ;
            wm:riskTolerance "Conservative" .
  OPTIONAL { ?investor wm:investorName ?investorName . }

  # Portfolio health filter
  ?investor wm:hasPortfolioHealth ?ph .
  ?ph wm:diversificationScore ?divScore .
  FILTER(?divScore < 25) .

  # Automobile sector allocation filter
  ?investor wm:hasSectorAllocation ?sa .
  ?sa wm:sector "Automobile" ;
      wm:allocationPct ?allocPct .
  FILTER(?allocPct > 0) .

  # Join pre‑aggregated loss‑making holdings count
  {
    SELECT ?investorId (COUNT(?holding) AS ?loss_holding_count)
    WHERE {
      ?holding a wm:PortfolioHolding ;
               wm:investorId ?investorId ;
               wm:cost ?cost ;
               wm:currentValue ?curr .
      FILTER(?curr < ?cost) .
    }
    GROUP BY ?investorId
    HAVING (COUNT(?holding) > 0)
  }
}

