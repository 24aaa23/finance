      "investor_id",
      SUM("current_value") AS "total_holding_value_per_investor"
    FROM
      "ATOM_ENTITY_PORTFOLIO_HOLDING_001"
    GROUP BY
      "investor_id"
  ),
  investor_avg_return AS (
    SELECT
      "investor_id",
      AVG("returns_pct") AS "avg_holding_return_per_investor"
    FROM
      "ATOM_ENTITY_PORTFOLIO_HOLDING_001"
    WHERE
      "cost" > 0
      AND "current_value" > 0
    GROUP BY
      "investor_id"
  ),
  investor_avg_gain AS (
    SELECT
      "investor_id",
      AVG("current_value" - "cost") AS "avg_holding_gain_per_investor"
    FROM
      "ATOM_ENTITY_PORTFOLIO_HOLDING_001"
