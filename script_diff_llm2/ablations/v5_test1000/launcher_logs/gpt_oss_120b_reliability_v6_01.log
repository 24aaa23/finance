PREFIX wm: <https://wealth.example.org/ontology/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

SELECT ?investorId ?investorName ?loss_holding_count WHERE {
  # Investor with Aggressive risk tolerance
  ?inv a wm:Investor ;
       wm:investorId ?investorId ;
       wm:investorName ?investorName ;
       wm:riskTolerance "Aggressive" .

  # Portfolio health with risk score > 75
  ?ph a wm:PortfolioHealth ;
       wm:investorId ?investorId ;
       wm:riskScore ?riskScore .
  FILTER(?riskScore > 75)

  # Automobile sector allocation > 0%
  ?sa a wm:SectorAllocation ;
       wm:investorId ?investorId ;
       wm:sector "Automobile" ;
       wm:allocationPct ?allocPct .
  FILTER(?allocPct > 0)

  # Underfunded investment goal (shortfall > 0)
  ?ig a wm:InvestmentGoal ;
       wm:investorId ?investorId ;
       wm:shortfall ?shortfall .
  FILTER(?shortfall > 0)

  # Count of loss‑making holdings (currentValue < cost)
  {
    SELECT ?investorId (COUNT(?holding) AS ?loss_holding_count) WHERE {
      ?holding a wm:PortfolioHolding ;
               wm:investorId ?investorId ;
               wm:cost ?cost ;
               wm:currentValue ?currentValue .
      FILTER(?currentValue < ?cost)
    }
    GROUP BY ?investorId
    HAVING (COUNT(?holding) > 0)
  }
}

