[SQL GENERATE] Generated SQL: WITH
-- Distinct risk tolerance groups (preserve null groups)
risk_groups AS (
    SELECT DISTINCT risk_tolerance FROM ATOM_ENTITY_INVESTOR_PROFILE_001
),
-- Sum of holding current value per investor
holder_sum AS (
    SELECT investor_id, SUM(current_value) AS total_holding_value
    FROM ATOM_ENTITY_PORTFOLIO_HOLDING_001
    GROUP BY investor_id
),
-- Average of the per‑investor total holding value per risk group
avg_holding_value_by_risk AS (
    SELECT ip.risk_tolerance,
           AVG(hs.total_holding_value) AS avg_total_holding_value
    FROM ATOM_ENTITY_INVESTOR_PROFILE_001 ip
    LEFT JOIN holder_sum hs ON ip.investor_id = hs.investor_id
    GROUP BY ip.risk_tolerance
),
-- Average holding return (only where cost and current_value are present) per risk group
avg_holding_return_by_risk AS (
    SELECT ip.risk_tolerance,
           AVG(h.returns_pct) AS avg_holding_return
    FROM ATOM_ENTITY_INVESTOR_PROFILE_001 ip
    JOIN ATOM_ENTITY_PORTFOLIO_HOLDING_001 h
      ON ip.investor_id = h.investor_id
    WHERE h.cost IS NOT NULL
      AND h.current_value IS NOT NULL
    GROUP BY ip.risk_tolerance
),
-- Sum of rebalance amount per investor
rebalance_sum AS (
    SELECT investor_id, SUM(amount) AS total_rebalance_amount
    FROM ATOM_EVENT_REBALANCING_ACTION_001
    GROUP BY investor_id
),
-- Average of the per‑investor total rebalance amount per risk group
avg_rebalance_by_risk AS (
    SELECT ip.risk_tolerance,
           AVG(r.total_rebalance_amount) AS avg_total_rebalance_amount
    FROM ATOM_ENTITY_INVESTOR_PROFILE_001 ip
    LEFT JOIN rebalance_sum r ON ip.investor_id = r.investor_id
    GROUP BY ip.risk_tolerance
),
-- Average risk score per risk group
avg_risk_score_by_risk AS (
    SELECT ip.risk_tolerance,
           AVG(ph.risk_score) AS avg_risk_score
    FROM ATOM_ENTITY_INVESTOR_PROFILE_001 ip
    LEFT JOIN ATOM_ENTITY_PORTFOLIO_HEALTH_001 ph ON ip.investor_id = ph.investor_id
    GROUP BY ip.risk_tolerance
)
SELECT
    rg.risk_tolerance,
    ahv.avg_total_holding_value,
    ahr.avg_holding_return,
    arb.avg_total_rebalance_amount,
    ars.avg_risk_score
FROM risk_groups rg
LEFT JOIN avg_holding_value_by_risk ahv ON rg.risk_tolerance = ahv.risk_tolerance
LEFT JOIN avg_holding_return_by_risk ahr ON rg.risk_tolerance = ahr.risk_tolerance
LEFT JOIN avg_rebalance_by_risk arb ON rg.risk_tolerance = arb.risk_tolerance
LEFT JOIN avg_risk_score_by_risk ars ON rg.risk_tolerance = ars.risk_tolerance
ORDER BY rg.risk_tolerance;
