[SQL GENERATE] Generated SQL: WITH rebalance AS (
    SELECT investor_id,
           SUM(amount) AS total_rebalance_amount
    FROM ATOM_EVENT_REBALANCING_ACTION_001
    GROUP BY investor_id
),
scenario AS (
    SELECT investor_id,
           SUM(new_allocation_pct - current_allocation_pct) AS total_scenario_shift
    FROM ATOM_EVENT_SCENARIO_REBALANCING_001
    GROUP BY investor_id
),
joined AS (
    SELECT i.investor_id,
           r.total_rebalance_amount,
           s.total_scenario_shift
    FROM ATOM_ENTITY_INVESTOR_PROFILE_001 i
    INNER JOIN rebalance r ON i.investor_id = r.investor_id
    INNER JOIN scenario s ON i.investor_id = s.investor_id
)
SELECT investor_id,
       100.0 * (
           ( (total_rebalance_amount - min_reb) / NULLIF(max_reb - min_reb, 0) ) +
           ( (total_scenario_shift - min_shift) / NULLIF(max_shift - min_shift, 0) )
       ) / 2.0 AS composite_score
FROM (
    SELECT *,
           MIN(total_rebalance_amount) OVER () AS min_reb,
           MAX(total_rebalance_amount) OVER () AS max_reb,
           MIN(total_scenario_shift) OVER () AS min_shift,
           MAX(total_scenario_shift) OVER () AS max_shift
    FROM joined
) t
ORDER BY composite_score DESC,
         investor_id ASC
LIMIT 10;
