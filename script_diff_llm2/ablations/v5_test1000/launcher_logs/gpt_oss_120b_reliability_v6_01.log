PREFIX wm: <https://wealth.example.org/ontology/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?investorId ?investorName ?netCashFlow WHERE {
  {
    SELECT ?investorId ?investorName (SUM(xsd:decimal(?amount)) AS ?netCashFlow)
    WHERE {
      ?inv a wm:Investor .
      ?inv wm:investorId ?investorId .
      ?inv wm:investorName ?investorName .
      ?inv wm:timeHorizon "Medium-term" .
      ?inv wm:hasCashFlow ?cf .
      ?cf wm:amount ?amount .
      ?cf wm:date ?date .
      FILTER(?date >= "2024-01-01"^^xsd:date && ?date <= "2024-12-31"^^xsd:date)
    }
    GROUP BY ?investorId ?investorName
    HAVING (SUM(xsd:decimal(?amount)) < 0)
  }
}

