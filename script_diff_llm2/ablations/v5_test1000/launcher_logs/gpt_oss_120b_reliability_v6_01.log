    JOIN ATOM_ENTITY_PORTFOLIO_HOLDING_001 h
        ON p.investor_id = h.investor_id
        AND h.cost IS NOT NULL
        AND h.current_value IS NOT NULL
    WHERE h.returns_pct IS NOT NULL
),
avg_holding_return_by_risk AS (
    SELECT risk_tolerance,
           AVG(returns_pct) AS avg_holding_return
    FROM holding_returns
    GROUP BY risk_tolerance
),
risk_score_per_investor AS (
