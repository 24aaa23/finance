PREFIX wm: <https://wealth.example.org/ontology/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

SELECT ?investorId ?investorName ?net_cash_flow_2024 WHERE {
  ?inv a wm:Investor .
  ?inv wm:investorId ?investorId .
  OPTIONAL { ?inv wm:investorName ?investorName . }
  ?inv wm:hasTimeHorizon ?th .
  ?th rdfs:label "Medium-term" .

  {
    SELECT ?investorId (SUM(xsd:decimal(?amount)) AS ?net_cash_flow_2024) WHERE {
      ?inv2 a wm:Investor .
      ?inv2 wm:investorId ?investorId .
      ?inv2 wm:hasCashFlow ?cf .
      ?cf wm:date ?date .
      FILTER(?date >= "2024-01-01"^^xsd:date && ?date <= "2024-12-31"^^xsd:date) .
      ?cf wm:amount ?amount .
    } GROUP BY ?investorId
  }

  FILTER(?net_cash_flow_2024 < 0)
}

