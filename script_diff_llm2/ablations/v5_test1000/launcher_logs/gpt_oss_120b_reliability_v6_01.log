[SQL GENERATE] Generated SQL: WITH cash AS (
        SELECT investor_id,
               SUM(amount) AS net_cash_flow_raw
        FROM ATOM_EVENT_CASH_FLOW_001
        GROUP BY investor_id
    ),
    risk AS (
        SELECT investor_id,
               risk_score AS risk_score_raw
        FROM ATOM_ENTITY_PORTFOLIO_HEALTH_001
    ),
    joined AS (
        SELECT c.investor_id,
               c.net_cash_flow_raw,
               r.risk_score_raw
        FROM cash c
        INNER JOIN risk r ON c.investor_id = r.investor_id
    ),
    normed AS (
        SELECT investor_id,
               (net_cash_flow_raw - MIN(net_cash_flow_raw) OVER ()) /
               NULLIF(MAX(net_cash_flow_raw) OVER () - MIN(net_cash_flow_raw) OVER (), 0) AS normalized_cash_flow,
               (risk_score_raw - MIN(risk_score_raw) OVER ()) /
               NULLIF(MAX(risk_score_raw) OVER () - MIN(risk_score_raw) OVER (), 0) AS normalized_risk_score
        FROM joined
    ),
    final AS (
        SELECT investor_id,
               100.0 * ((normalized_cash_flow + normalized_risk_score) / 2.0) AS composite_score
        FROM normed
    )
SELECT investor_id,
       composite_score
FROM final
ORDER BY composite_score DESC, investor_id ASC
LIMIT 10;
