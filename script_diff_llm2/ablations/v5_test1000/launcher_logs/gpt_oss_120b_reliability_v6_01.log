)
SELECT i.investor_id,
       (c.net_cash_flow - g.avg_goal_shortfall) AS composite_score
FROM ATOM_ENTITY_INVESTOR_PROFILE_001 i
INNER JOIN cash c ON i.investor_id = c.investor_id
INNER JOIN goals g ON i.investor_id = g.investor_id
ORDER BY composite_score DESC,
         i.investor_id ASC
LIMIT 10;
