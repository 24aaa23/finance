FROM ATOM_ENTITY_INVESTOR_PROFILE_001 p
LEFT JOIN rebalance_amount_cte ram ON p.investor_id = ram.investor_id
LEFT JOIN rebalance_shift_cte rsh ON p.investor_id = rsh.investor_id
LEFT JOIN scenario_shift_cte ssh ON p.investor_id = ssh.investor_id
GROUP BY p.risk_tolerance
