PREFIX wm: <https://wealth.example.org/ontology/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?investorId ?investorName
WHERE {
  # Base Investor with required attributes
  ?inv a wm:Investor ;
       wm:investorId ?investorId ;
       wm:investorName ?investorName ;
       wm:riskTolerance "Conservative" .

  # PortfolioHealth with liquidityScore < 25
  ?ph a wm:PortfolioHealth ;
      wm:investorId ?investorId ;
      wm:liquidityScore ?liqScore .
  FILTER(?liqScore < 25)

  # RebalancingAction with Aggressive Entry
  ?ra a wm:RebalancingAction ;
      wm:investorId ?investorId ;
      wm:action "Aggressive Entry" .

  # Loss‑making holding flag (per investor)
  {
    SELECT ?investorId (MAX(?lossFlag) AS ?lossHoldingFlag)
    WHERE {
      ?holding a wm:PortfolioHolding ;
               wm:investorId ?investorId ;
               wm:cost ?cost ;
               wm:currentValue ?currentValue .
      BIND(IF(?currentValue < ?cost, 1, 0) AS ?lossFlag)
    }
    GROUP BY ?investorId
  }
  FILTER(?lossHoldingFlag = 1)

  # Underfunded goal flag (per investor)
  {
    SELECT ?investorId (MAX(?goalFlag) AS ?underfundedGoalFlag)
    WHERE {
      ?goal a wm:InvestmentGoal ;
            wm:investorId ?investorId ;
            wm:shortfall ?shortfall .
      BIND(IF(?shortfall > 0, 1, 0) AS ?goalFlag)
    }
    GROUP BY ?investorId
  }
  FILTER(?underfundedGoalFlag = 1)
}


