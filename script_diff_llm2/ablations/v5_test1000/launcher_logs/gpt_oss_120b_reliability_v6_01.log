  sum_per_inv AS (
    SELECT investor_id, SUM(amount) AS sum_amount
    FROM ATOM_EVENT_CASH_FLOW_001
    GROUP BY investor_id
  ),
  count_per_inv AS (
    SELECT investor_id, COUNT(cash_flow_id) AS cf_count
    FROM ATOM_EVENT_CASH_FLOW_001
    GROUP BY investor_id
  ),
  net_cash_group AS (
    SELECT p.risk_tolerance,
           AVG(s.sum_amount) AS avg_net_cash_flow
    FROM ATOM_ENTITY_INVESTOR_PROFILE_001 p
    LEFT JOIN sum_per_inv s ON p.investor_id = s.investor_id
    GROUP BY p.risk_tolerance
  ),
  cash_flow_count_group AS (
    SELECT p.risk_tolerance,
           AVG(c.cf_count) AS avg_cash_flow_count
    FROM ATOM_ENTITY_INVESTOR_PROFILE_001 p
    LEFT JOIN count_per_inv c ON p.investor_id = c.investor_id
    GROUP BY p.risk_tolerance
  ),
  avg_signed_group AS (
    SELECT p.risk_tolerance,
           AVG(cf.amount) AS avg_signed_cash_flow_amount
    FROM ATOM_ENTITY_INVESTOR_PROFILE_001 p
    LEFT JOIN ATOM_EVENT_CASH_FLOW_001 cf ON p.investor_id = cf.investor_id
    GROUP BY p.risk_tolerance
  )
SELECT
  n.risk_tolerance,
  n.avg_net_cash_flow,
  s.avg_signed_cash_flow_amount,
  cnt.avg_cash_flow_count
FROM net_cash_group n
LEFT JOIN avg_signed_group s ON n.risk_tolerance = s.risk_tolerance
LEFT JOIN cash_flow_count_group cnt ON n.risk_tolerance = cnt.risk_tolerance
ORDER BY n.risk_tolerance;
