[SQL GENERATE] Generated SQL: WITH cash AS (
    SELECT investor_id, SUM(amount) AS net_cash_flow
    FROM ATOM_EVENT_CASH_FLOW_001
    GROUP BY investor_id
),
ph AS (
    SELECT investor_id, AVG(risk_score) AS risk_score
    FROM ATOM_ENTITY_PORTFOLIO_HEALTH_001
    GROUP BY investor_id
),
goal AS (
    SELECT investor_id, AVG(shortfall) AS avg_shortfall
    FROM ATOM_ENTITY_INVESTMENT_GOAL_001
    GROUP BY investor_id
),
combined AS (
    SELECT i.investor_id,
           cash.net_cash_flow,
           ph.risk_score,
           goal.avg_shortfall
    FROM ATOM_ENTITY_INVESTOR_PROFILE_001 AS i
    INNER JOIN cash  ON i.investor_id = cash.investor_id
    INNER JOIN ph    ON i.investor_id = ph.investor_id
    INNER JOIN goal  ON i.investor_id = goal.investor_id
)
SELECT investor_id,
       composite_score
FROM (
    SELECT investor_id,
           net_cash_flow,
           risk_score,
           avg_shortfall,
           MIN(net_cash_flow) OVER () AS min_net_cash_flow,
           MAX(net_cash_flow) OVER () AS max_net_cash_flow,
           MIN(risk_score)   OVER () AS min_risk_score,
           MAX(risk_score)   OVER () AS max_risk_score,
           MIN(avg_shortfall) OVER () AS min_shortfall,
           MAX(avg_shortfall) OVER () AS max_shortfall,
           (net_cash_flow - MIN(net_cash_flow) OVER ()) / NULLIF(MAX(net_cash_flow) OVER () - MIN(net_cash_flow) OVER (), 0) AS norm_cash_flow,
           (risk_score - MIN(risk_score) OVER ()) / NULLIF(MAX(risk_score) OVER () - MIN(risk_score) OVER (), 0) AS norm_risk_score,
           (avg_shortfall - MIN(avg_shortfall) OVER ()) / NULLIF(MAX(avg_shortfall) OVER () - MIN(avg_shortfall) OVER (), 0) AS norm_shortfall,
           1 - ((avg_shortfall - MIN(avg_shortfall) OVER ()) / NULLIF(MAX(avg_shortfall) OVER () - MIN(avg_shortfall) OVER (), 0)) AS inverted_shortfall,
           100 * ((
               (net_cash_flow - MIN(net_cash_flow) OVER ()) / NULLIF(MAX(net_cash_flow) OVER () - MIN(net_cash_flow) OVER (), 0) +
               (risk_score - MIN(risk_score) OVER ()) / NULLIF(MAX(risk_score) OVER () - MIN(risk_score) OVER (), 0) +
               (1 - ((avg_shortfall - MIN(avg_shortfall) OVER ()) / NULLIF(MAX(avg_shortfall) OVER () - MIN(avg_shortfall) OVER (), 0)))
           ) / 3.0) AS composite_score
    FROM combined
) 
ORDER BY composite_score DESC, investor_id ASC
LIMIT 10;
