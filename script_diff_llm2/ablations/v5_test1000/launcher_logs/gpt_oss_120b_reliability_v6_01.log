[SQL GENERATE] Generated SQL: WITH
  risk_groups AS (
    SELECT DISTINCT risk_tolerance
    FROM ATOM_ENTITY_INVESTOR_PROFILE_001
  ),
  cf_sum AS (
    SELECT investor_id, SUM(amount) AS net_cash_flow_sum
    FROM ATOM_EVENT_CASH_FLOW_001
    GROUP BY investor_id
  ),
  avg_net AS (
    SELECT p.risk_tolerance,
           AVG(cf_sum.net_cash_flow_sum) AS avg_net_cash_flow
    FROM ATOM_ENTITY_INVESTOR_PROFILE_001 p
    LEFT JOIN cf_sum ON p.investor_id = cf_sum.investor_id
    GROUP BY p.risk_tolerance
  ),
  avg_signed AS (
    SELECT p.risk_tolerance,
           AVG(cf.amount) AS avg_signed_cash_flow_amount
    FROM ATOM_ENTITY_INVESTOR_PROFILE_001 p
    LEFT JOIN ATOM_EVENT_CASH_FLOW_001 cf ON p.investor_id = cf.investor_id
    GROUP BY p.risk_tolerance
  ),
  avg_rebalance AS (
    SELECT p.risk_tolerance,
           AVG(r.amount) AS avg_rebalance_amount
    FROM ATOM_ENTITY_INVESTOR_PROFILE_001 p
    LEFT JOIN ATOM_EVENT_REBALANCING_ACTION_001 r ON p.investor_id = r.investor_id
    GROUP BY p.risk_tolerance
  )
SELECT
  rg.risk_tolerance,
  an.avg_net_cash_flow,
  asg.avg_signed_cash_flow_amount,
  ar.avg_rebalance_amount
FROM risk_groups rg
LEFT JOIN avg_net an       ON rg.risk_tolerance = an.risk_tolerance
LEFT JOIN avg_signed asg   ON rg.risk_tolerance = asg.risk_tolerance
