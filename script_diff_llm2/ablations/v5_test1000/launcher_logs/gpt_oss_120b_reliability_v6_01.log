           SUM(new_allocation_pct - current_allocation_pct) AS allocation_shift_raw
    FROM ATOM_EVENT_SCENARIO_REBALANCING_001
    GROUP BY investor_id
),
risk AS (
    SELECT investor_id,
           MAX(risk_score) AS risk_score_raw
