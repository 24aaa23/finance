      FILTER(?cv < ?cost)
    }
    GROUP BY ?investorId
    HAVING (COUNT(?h) > 0)
  }
  # Corporate sector allocation > 0%
  {
    SELECT ?investorId
    WHERE {
      ?alloc a wm:SectorAllocation ;
            wm:investorId ?investorId ;
            wm:sector "Corporate" ;
            wm:allocationPct ?allocPct .
      FILTER(?allocPct > 0)
    }
  }
}

