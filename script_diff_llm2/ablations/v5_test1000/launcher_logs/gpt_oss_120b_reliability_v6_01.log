PREFIX wm: <https://wealth.example.org/ontology/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

SELECT ?investorName
WHERE {
  ?investor a wm:Investor ;
            wm:investorName ?investorName ;
            wm:riskTolerance "Conservative" .
  {
    SELECT ?investor (SUM(xsd:decimal(?amount)) AS ?netCashFlow)
    WHERE {
      ?investor wm:hasCashFlow ?cf .
      ?cf wm:date ?date .
      FILTER(?date >= "2025-01-01"^^xsd:date && ?date <= "2025-12-31"^^xsd:date) .
      ?cf wm:amount ?amount .
    }
    GROUP BY ?investor
  }
  FILTER(?netCashFlow < 0)
}

