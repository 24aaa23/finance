[SQL GENERATE] Generated SQL: WITH cash AS (
    SELECT investor_id,
           SUM(amount) AS net_cash_flow_raw
    FROM ATOM_EVENT_CASH_FLOW_001
    GROUP BY investor_id
),
holding AS (
    SELECT investor_id,
           SUM(current_value - cost) AS holding_gain_raw
    FROM ATOM_ENTITY_PORTFOLIO_HOLDING_001
    WHERE cost IS NOT NULL
      AND current_value IS NOT NULL
    GROUP BY investor_id
),
allocation AS (
    SELECT investor_id,
           SUM(new_allocation_pct - current_allocation_pct) AS allocation_shift_raw
    FROM ATOM_EVENT_SCENARIO_REBALANCING_001
    GROUP BY investor_id
)
SELECT sub.investor_id,
       sub.investor_name,
       100 * ((
                (sub.net_cash_flow_raw - sub.min_net) / NULLIF(sub.max_net - sub.min_net, 0) +
                (sub.holding_gain_raw   - sub.min_gain) / NULLIF(sub.max_gain - sub.min_gain, 0) +
                (sub.allocation_shift_raw - sub.min_shift) / NULLIF(sub.max_shift - sub.min_shift, 0)
            ) / 3.0) AS composite_score
FROM (
    SELECT ip.investor_id,
           ip.investor_name,
           c.net_cash_flow_raw,
           h.holding_gain_raw,
           a.allocation_shift_raw,
           MIN(c.net_cash_flow_raw) OVER () AS min_net,
           MAX(c.net_cash_flow_raw) OVER () AS max_net,
           MIN(h.holding_gain_raw)   OVER () AS min_gain,
           MAX(h.holding_gain_raw)   OVER () AS max_gain,
           MIN(a.allocation_shift_raw) OVER () AS min_shift,
           MAX(a.allocation_shift_raw) OVER () AS max_shift
    FROM ATOM_ENTITY_INVESTOR_PROFILE_001 ip
    INNER JOIN cash c ON ip.investor_id = c.investor_id
    INNER JOIN holding h ON ip.investor_id = h.investor_id
    INNER JOIN allocation a ON ip.investor_id = a.investor_id
) sub
ORDER BY composite_score DESC, investor_id ASC
LIMIT 10;

