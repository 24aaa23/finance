        FROM ATOM_EVENT_REBALANCING_ACTION_001
        GROUP BY investor_id
    ),
    risk_cte AS (
        SELECT investor_id,
               MAX(risk_score) AS risk_score
        FROM ATOM_ENTITY_PORTFOLIO_HEALTH_001
        GROUP BY investor_id
    ),
    stats AS (
        SELECT MIN(c.net_cash_flow) AS min_cash,
               MAX(c.net_cash_flow) AS max_cash,
               MIN(r.total_rebalance_amount) AS min_reb,
               MAX(r.total_rebalance_amount) AS max_reb,
               MIN(s.risk_score) AS min_risk,
               MAX(s.risk_score) AS max_risk
        FROM cash_cte c
        JOIN rebalance_cte r USING (investor_id)
        JOIN risk_cte s USING (investor_id)
    )
SELECT i.investor_id,
       100.0 * (
           (
               (c.net_cash_flow - stats.min_cash) / NULLIF(stats.max_cash - stats.min_cash, 0)
           ) +
           (
               (r.total_rebalance_amount - stats.min_reb) / NULLIF(stats.max_reb - stats.min_reb, 0)
           ) +
