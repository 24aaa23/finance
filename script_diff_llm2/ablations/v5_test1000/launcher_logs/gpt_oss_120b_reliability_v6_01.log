PREFIX wm: <https://wealth.example.org/ontology/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

SELECT ?investorId ?investorName ?net_cash_flow_2025 WHERE {
  ?inv rdf:type wm:Investor .
  ?inv wm:investorId ?investorId .
  OPTIONAL { ?inv wm:investorName ?investorName . }
  ?inv wm:riskTolerance ?riskTol .
  FILTER(LCASE(?riskTol) = "moderate") .

  FILTER EXISTS {
    ?inv wm:hasInvestmentGoal ?goal .
    ?goal wm:shortfall ?sf .
    FILTER(?sf > 0) .
  }

  {
    SELECT ?investorId (SUM(xsd:decimal(?amt)) AS ?net_cash_flow_2025) WHERE {
      ?cf rdf:type wm:CashFlow .
      ?cf wm:investorId ?investorId .
      ?cf wm:amount ?amt .
      ?cf wm:date ?date .
      FILTER(?date >= "2025-01-01"^^xsd:date && ?date <= "2025-12-31"^^xsd:date) .
    }
    GROUP BY ?investorId
    HAVING (SUM(xsd:decimal(?amt)) < 0)
  }
}
ORDER BY ?investorId

