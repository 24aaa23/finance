PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX wm: <https://wealth.example.org/ontology/>

SELECT DISTINCT ?investorId ?investorName
WHERE {
  # Investor with Conservative risk tolerance
  ?inv a wm:Investor ;
       wm:investorId ?investorId ;
       wm:investorName ?investorName ;
       wm:riskTolerance ?riskTol .
  FILTER(LCASE(?riskTol) = "conservative")

  # Portfolio health with risk score > 75
  ?ph a wm:PortfolioHealth ;
       wm:investorId ?investorId ;
       wm:riskScore ?riskScore .
  FILTER(?riskScore > 75)

  # Investment goal with shortfall > 0 (underfunded)
  ?ig a wm:InvestmentGoal ;
       wm:investorId ?investorId ;
       wm:shortfall ?shortfall .
  FILTER(?shortfall > 0)

  # Sector allocation in Corporate sector with allocation > 0%
  ?sa a wm:SectorAllocation ;
       wm:investorId ?investorId ;
       wm:sector ?sector ;
       wm:allocationPct ?allocPct .
  FILTER(LCASE(?sector) = "corporate")
  FILTER(?allocPct > 0)

  # Existence of at least one loss‑making holding (cost and current value present, current < cost)
  {
    SELECT ?investorId (COUNT(?holdingId) AS ?loss_holding_count)
    WHERE {
      ?h a wm:PortfolioHolding ;
         wm:investorId ?investorId ;
         wm:cost ?cost ;
         wm:currentValue ?currentValue ;
         wm:holdingId ?holdingId .
      FILTER(?currentValue < ?cost)
    }
    GROUP BY ?investorId
    HAVING (COUNT(?holdingId) > 0)
  }
}
ORDER BY ?investorId

