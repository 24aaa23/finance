[SQL GENERATE] Generated SQL: WITH
-- Gather distinct risk tolerance groups
risk_groups AS (
    SELECT DISTINCT risk_tolerance
    FROM ATOM_ENTITY_INVESTOR_PROFILE_001
),
-- Net cash flow per investor, then average per risk tolerance
net_cash AS (
    SELECT p.risk_tolerance,
           AVG(cf_sum.net_cash_flow) AS avg_net_cash_flow
    FROM ATOM_ENTITY_INVESTOR_PROFILE_001 p
    LEFT JOIN (
        SELECT investor_id,
               SUM(amount) AS net_cash_flow
        FROM ATOM_EVENT_CASH_FLOW_001
        GROUP BY investor_id
    ) cf_sum ON p.investor_id = cf_sum.investor_id
    GROUP BY p.risk_tolerance
),
-- Cash‑flow amount (raw) averaged per risk tolerance
cash_amt AS (
    SELECT p.risk_tolerance,
           AVG(cf.amount) AS avg_cash_flow_amount
    FROM ATOM_ENTITY_INVESTOR_PROFILE_001 p
    JOIN ATOM_EVENT_CASH_FLOW_001 cf ON p.investor_id = cf.investor_id
    GROUP BY p.risk_tolerance
),
-- Total holding value per investor, then average per risk tolerance
holding_val AS (
    SELECT p.risk_tolerance,
           AVG(h_sum.total_holding_value) AS avg_total_holding_value
    FROM ATOM_ENTITY_INVESTOR_PROFILE_001 p
    LEFT JOIN (
        SELECT investor_id,
               SUM(current_value) AS total_holding_value
        FROM ATOM_ENTITY_PORTFOLIO_HOLDING_001
        GROUP BY investor_id
    ) h_sum ON p.investor_id = h_sum.investor_id
    GROUP BY p.risk_tolerance
),
-- Risk score per investor, then average per risk tolerance
risk_sc AS (
    SELECT p.risk_tolerance,
           AVG(ph.risk_score) AS avg_risk_score
    FROM ATOM_ENTITY_INVESTOR_PROFILE_001 p
    JOIN ATOM_ENTITY_PORTFOLIO_HEALTH_001 ph ON p.investor_id = ph.investor_id
    GROUP BY p.risk_tolerance
)
SELECT rg.risk_tolerance,
       net.avg_net_cash_flow,
       ca.avg_cash_flow_amount,
       hv.avg_total_holding_value,
       rs.avg_risk_score
FROM risk_groups rg
LEFT JOIN net_cash net   ON rg.risk_tolerance = net.risk_tolerance
LEFT JOIN cash_amt ca    ON rg.risk_tolerance = ca.risk_tolerance
LEFT JOIN holding_val hv ON rg.risk_tolerance = hv.risk_tolerance
LEFT JOIN risk_sc rs     ON rg.risk_tolerance = rs.risk_tolerance
ORDER BY rg.risk_tolerance;

