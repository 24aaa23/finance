  AVG(hold_div.avg_dividends) AS avg_dividends
FROM ATOM_ENTITY_INVESTOR_PROFILE_001 ip
INNER JOIN hold_sum      ON ip.investor_id = hold_sum.investor_id
INNER JOIN hold_return   ON ip.investor_id = hold_return.investor_id
INNER JOIN hold_gain     ON ip.investor_id = hold_gain.investor_id
INNER JOIN hold_div      ON ip.investor_id = hold_div.investor_id
GROUP BY ip.time_horizon;
