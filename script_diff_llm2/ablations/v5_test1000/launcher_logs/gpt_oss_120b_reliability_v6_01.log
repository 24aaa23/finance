SELECT
    p.risk_tolerance,
    AVG(cs.sum_amount)            AS avg_net_cash_flow,
    AVG(ca.avg_amount)            AS avg_signed_cash_flow_amount,
    AVG(hs.sum_current_value)    AS avg_total_holding_value,
    AVG(ss.avg_shift)             AS avg_scenario_shift
FROM ATOM_ENTITY_INVESTOR_PROFILE_001 AS p
LEFT JOIN cash_sum      cs ON p.investor_id = cs.investor_id
LEFT JOIN cash_avg      ca ON p.investor_id = ca.investor_id
LEFT JOIN holding_sum   hs ON p.investor_id = hs.investor_id
