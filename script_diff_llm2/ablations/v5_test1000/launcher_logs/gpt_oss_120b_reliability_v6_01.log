    WHERE investment_type = 'Equity'
    GROUP BY investor_id
    HAVING COUNT(holding_id) > 0
),
cash_flow AS (
    SELECT investor_id,
           SUM(amount) AS net_cash_flow
    FROM ATOM_EVENT_CASH_FLOW_001
    WHERE date BETWEEN '2025-01-01' AND '2025-12-31'
    GROUP BY investor_id
    HAVING SUM(amount) < 0
)
SELECT i.investor_id,
       i.investor_name
FROM ATOM_ENTITY_INVESTOR_PROFILE_001 AS i
INNER JOIN equity_holding eh ON i.investor_id = eh.investor_id
INNER JOIN cash_flow cf ON i.investor_id = cf.investor_id;

