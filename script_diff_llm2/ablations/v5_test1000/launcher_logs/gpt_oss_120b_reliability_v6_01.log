    FROM ATOM_ENTITY_PORTFOLIO_HEALTH_001 h
    JOIN ATOM_ENTITY_INVESTOR_PROFILE_001 p ON h.investor_id = p.investor_id
    GROUP BY p.risk_tolerance
  )
SELECT
  p.risk_tolerance AS risk_tolerance,
  AVG(cf_sum_inv.sum_amount) AS avg_net_cash_flow,
  cf_avg_group.avg_amount AS avg_cash_flow_amount,
  AVG(holding_sum_inv.sum_current_value) AS avg_total_holding_value,
  AVG(sector_sum_inv.sum_total_investment) AS avg_total_sector_investment,
  risk_score_avg_group.avg_risk_score AS avg_risk_score
FROM ATOM_ENTITY_INVESTOR_PROFILE_001 p
LEFT JOIN cf_sum_inv ON p.investor_id = cf_sum_inv.investor_id
LEFT JOIN holding_sum_inv ON p.investor_id = holding_sum_inv.investor_id
LEFT JOIN sector_sum_inv ON p.investor_id = sector_sum_inv.investor_id
LEFT JOIN cf_avg_group ON p.risk_tolerance = cf_avg_group.risk_tolerance
LEFT JOIN risk_score_avg_group ON p.risk_tolerance = risk_score_avg_group.risk_tolerance
GROUP BY p.risk_tolerance
ORDER BY p.risk_tolerance;
