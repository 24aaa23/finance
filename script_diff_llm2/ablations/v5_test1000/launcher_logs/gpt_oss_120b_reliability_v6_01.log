SELECT ?investor_id WHERE {
  {
    SELECT ?investorId (COUNT(?goal) AS ?count_underfunded_goals) WHERE {
      ?goal rdf:type wm:InvestmentGoal .
      ?goal wm:shortfall ?shortfall .
      FILTER(?shortfall > 0) .
      ?goal wm:belongsToInvestor ?inv .
      ?inv rdf:type wm:Investor .
      ?inv wm:investorId ?investorId .
    }
    GROUP BY ?investorId
  }
  FILTER(?count_underfunded_goals > 0)
  BIND(?investorId AS ?investor_id)
}

