                   COUNT(DISTINCT sector_id) AS has_sector_allocation,
                   COUNT(DISTINCT goal_id) AS has_investment_goal
            FROM (
                SELECT ip2.investor_id, cf.cash_flow_id, NULL AS holding_id, NULL AS sector_id, NULL AS goal_id, ph.cost, ph.current_value
                FROM ATOM_ENTITY_INVESTOR_PROFILE_001 AS ip2
                LEFT JOIN ATOM_EVENT_CASH_FLOW_001 AS cf ON ip2.investor_id = cf.investor_id
                LEFT JOIN ATOM_ENTITY_PORTFOLIO_HOLDING_001 AS ph ON ip2.investor_id = ph.investor_id
                
                UNION ALL
                
                SELECT ip2.investor_id, NULL AS cash_flow_id, ph.holding_id, NULL AS sector_id, NULL AS goal_id, ph.cost, ph.current_value
                FROM ATOM_ENTITY_INVESTOR_PROFILE_001 AS ip2
                LEFT JOIN ATOM_ENTITY_PORTFOLIO_HOLDING_001 AS ph ON ip2.investor_id = ph.investor_id
                
                UNION ALL
                
                SELECT ip2.investor_id, NULL AS cash_flow_id, NULL AS holding_id, sa.sector_id, NULL AS goal_id, NULL AS cost, NULL AS current_value
                FROM ATOM_ENTITY_INVESTOR_PROFILE_001 AS ip2
                LEFT JOIN ATOM_ENTITY_SECTOR_ALLOCATION_001 AS sa ON ip2.investor_id = sa.investor_id
                
                UNION ALL
                
                SELECT ip2.investor_id, NULL AS cash_flow_id, NULL AS holding_id, NULL AS sector_id, ig.goal_id, NULL AS cost, NULL AS current_value
                FROM ATOM_ENTITY_INVESTOR_PROFILE_001 AS ip2
                LEFT JOIN ATOM_ENTITY_INVESTMENT_GOAL_001 AS ig ON ip2.investor_id = ig.investor_id
            ) AS all_records
            GROUP BY investor_id
        ) AS counts
        WHERE has_cash_flow > 0
          AND has_holdings > 0
          AND has_sector_allocation > 0
          AND has_investment_goal > 0
    )
), 
net_cash_flow_cte AS (
    SELECT investor_id, SUM(amount) AS net_cash_flow
    FROM ATOM_EVENT_CASH_FLOW_001
    WHERE investor_id IN (SELECT investor_id FROM investor_with_all_components)
    GROUP BY investor_id
),
total_holding_gain_cte AS (
    SELECT investor_id, SUM(current_value - cost) AS total_holding_gain
    FROM ATOM_ENTITY_PORTFOLIO_HOLDING_001
    WHERE investor_id IN (SELECT investor_id FROM investor_with_all_components)
      AND cost IS NOT NULL
      AND current_value IS NOT NULL
    GROUP BY investor_id
),
total_sector_investment_cte AS (
    SELECT investor_id, SUM(total_investment) AS total_sector_investment
    FROM ATOM_ENTITY_SECTOR_ALLOCATION_001
    WHERE investor_id IN (SELECT investor_id FROM investor_with_all_components)
    GROUP BY investor_id
),
average_goal_shortfall_cte AS (
    SELECT investor_id, AVG(shortfall) AS average_goal_shortfall
    FROM ATOM_ENTITY_INVESTMENT_GOAL_001
    WHERE investor_id IN (SELECT investor_id FROM investor_with_all_components)
    GROUP BY investor_id
),
combined AS (
    SELECT ip.investor_id,
           ncf.net_cash_flow,
           COALESCE(thg.total_holding_gain, 0) AS total_holding_gain,
           COALESCE(tsi.total_sector_investment, 0) AS total_sector_investment,
           COALESCE(ags.average_goal_shortfall, 0) AS average_goal_shortfall
    FROM ATOM_ENTITY_INVESTOR_PROFILE_001 AS ip
    INNER JOIN investor_with_all_components AS iwac ON ip.investor_id = iwac.investor_id
    INNER JOIN net_cash_flow_cte AS ncf ON ip.investor_id = ncf.investor_id
    LEFT JOIN total_holding_gain_cte AS thg ON ip.investor_id = thg.investor_id
    LEFT JOIN total_sector_investment_cte AS tsi ON ip.investor_id = tsi.investor_id
    LEFT JOIN average_goal_shortfall_cte AS ags ON ip.investor_id = ags.investor_id
)
SELECT investor_id,
       (net_cash_flow + total_holding_gain + total_sector_investment - average_goal_shortfall) AS composite_score
FROM combined
ORDER BY composite_score DESC, investor_id
LIMIT 10;
