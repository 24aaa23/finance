[SQL GENERATE] Generated SQL: WITH net_cash_flow_per_investor AS (
    SELECT investor_id, SUM(amount) AS investor_net_cash_flow
    FROM ATOM_EVENT_CASH_FLOW_001
    GROUP BY investor_id
),
avg_signed_cash_flow_per_investor AS (
    SELECT investor_id, AVG(amount) AS investor_avg_signed_cash_flow
    FROM ATOM_EVENT_CASH_FLOW_001
    GROUP BY investor_id
),
avg_rebalance_amount_per_investor AS (
    SELECT investor_id, AVG(amount) AS investor_avg_rebalance_amount
    FROM ATOM_EVENT_REBALANCING_ACTION_001
    GROUP BY investor_id
),
profile_groups AS (
    SELECT investor_id, risk_tolerance
    FROM ATOM_ENTITY_INVESTOR_PROFILE_001
)
SELECT 
    pg.risk_tolerance,
    AVG(ncf.investor_net_cash_flow) AS avg_net_cash_flow,
    AVG(ascf.investor_avg_signed_cash_flow) AS avg_signed_cash_flow_amount,
    AVG(ara.investor_avg_rebalance_amount) AS avg_rebalance_amount
FROM profile_groups pg
LEFT JOIN net_cash_flow_per_investor ncf ON pg.investor_id = ncf.investor_id
LEFT JOIN avg_signed_cash_flow_per_investor ascf ON pg.investor_id = ascf.investor_id
LEFT JOIN avg_rebalance_amount_per_investor ara ON pg.investor_id = ara.investor_id
GROUP BY pg.risk_tolerance
ORDER BY pg.risk_tolerance;
