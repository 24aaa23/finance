PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT ?investorId
WHERE {
  ?investor rdf:type wm:Investor ;
            wm:riskTolerance "Moderate" ;
            wm:investorId ?investorId .
  ?portfolioHealth rdf:type wm:PortfolioHealth ;
                    wm:healthOfInvestor ?investor ;
                    wm:diversificationScore ?diversificationScore .
  FILTER (xsd:decimal(?diversificationScore) < 25)
  ?scenarioRebalancing rdf:type wm:ScenarioRebalancing ;
                       wm:scenarioRebalancingOfInvestor ?investor ;
                       wm:scenario "Bull Market" .
  ?investmentGoal rdf:type wm:InvestmentGoal ;
                  wm:belongsToInvestor ?investor ;
                  wm:shortfall ?shortfall .
  FILTER (xsd:decimal(?shortfall) > 0)
}

