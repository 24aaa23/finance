[SQL GENERATE] Generated SQL: WITH risk_above_75 AS (
    SELECT 
        investor_id,
        1 AS has_risk_above_75
    FROM ATOM_ENTITY_PORTFOLIO_HEALTH_001
    WHERE risk_score > 75
    GROUP BY investor_id
),
loss_making_holdings AS (
    SELECT 
        investor_id,
        1 AS has_loss_making_holding
    FROM ATOM_ENTITY_PORTFOLIO_HOLDING_001
    WHERE cost IS NOT NULL 
        AND current_value IS NOT NULL 
        AND cost > current_value
    GROUP BY investor_id
),
underfunded_goals AS (
    SELECT 
        investor_id,
        1 AS has_underfunded_goal
    FROM ATOM_ENTITY_INVESTMENT_GOAL_001
    WHERE shortfall > 0
    GROUP BY investor_id
),
consumer_goods_allocation AS (
    SELECT 
        investor_id,
        1 AS has_consumer_goods_allocation
    FROM ATOM_ENTITY_SECTOR_ALLOCATION_001
    WHERE sector = 'Consumer Goods' 
        AND allocation_pct > 0
    GROUP BY investor_id
)
SELECT 
    ip.investor_id
FROM ATOM_ENTITY_INVESTOR_PROFILE_001 ip
INNER JOIN risk_above_75 r ON ip.investor_id = r.investor_id
INNER JOIN loss_making_holdings l ON ip.investor_id = l.investor_id
INNER JOIN underfunded_goals u ON ip.investor_id = u.investor_id
INNER JOIN consumer_goods_allocation c ON ip.investor_id = c.investor_id
WHERE ip.risk_tolerance = 'Moderate'
GROUP BY ip.investor_id
