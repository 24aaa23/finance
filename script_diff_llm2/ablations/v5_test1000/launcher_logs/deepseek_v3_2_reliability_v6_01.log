[SQL GENERATE] Generated SQL: WITH deposits_cte AS (
  SELECT 
    investor_id,
    SUM(amount) AS deposits_2024
  FROM ATOM_EVENT_CASH_FLOW_001
  WHERE 
    date BETWEEN '2024-01-01' AND '2024-12-31'
    AND type IN ('Deposit', 'Dividend Reinvestment', 'Interest Credit', 'Lump Sum', 'SIP', 'Tax Refund')
  GROUP BY investor_id
),
withdrawals_cte AS (
  SELECT 
    investor_id,
    SUM(amount) AS withdrawals_2024
  FROM ATOM_EVENT_CASH_FLOW_001
  WHERE 
    date BETWEEN '2024-01-01' AND '2024-12-31'
    AND type = 'Withdrawal'
  GROUP BY investor_id
),
et_cash_flow_cte AS (
  SELECT
    COALESCE(d.investor_id, w.investor_id) AS investor_id,
    COALESCE(d.deposits_2024, 0) AS deposits_2024,
    COALESCE(w.withdrawals_2024, 0) AS withdrawals_2024,
    (COALESCE(d.deposits_2024, 0) - COALESCE(w.withdrawals_2024, 0)) AS net_cash_flow_2024
  FROM deposits_cte d
  FULL OUTER JOIN withdrawals_cte w ON d.investor_id = w.investor_id
)
SELECT 
  investor_id,
  net_cash_flow_2024,
  withdrawals_2024,
  deposits_2024
FROM net_cash_flow_cte
WHERE net_cash_flow_2024 < 0
ORDER BY investor_id
