      WHEN mm.max_tsas - mm.min_tsas = 0 THEN 0
      ELSE (b.total_scenario_allocation_shift - mm.min_tsas) / (mm.max_tsas - mm.min_tsas)
    END AS total_scenario_allocation_shift_norm,
    CASE
      WHEN mm.max_rs - mm.min_rs = 0 THEN 0
      ELSE (b.risk_score - mm.min_rs) / (mm.max_rs - mm.min_rs)
    END AS risk_score_norm
  FROM base_cte b
  CROSS JOIN min_max_cte mm
),
composite_cte AS (
  SELECT
    investor_id,
    100 * ((net_cash_flow_norm + total_holding_gain_norm + total_scenario_allocation_shift_norm + risk_score_norm) / 4) AS composite_score
  FROM norm_cte
)
SELECT
  investor_id,
  composite_score
FROM composite_cte
ORDER BY composite_score DESC, investor_id
LIMIT 10

