      investor_id
  ),
  avg_holding_return_per_investor AS (
    SELECT
      investor_id,
      AVG(returns_pct) AS avg_holding_return
    FROM
      ATOM_ENTITY_PORTFOLIO_HOLDING_001
    WHERE
      cost IS NOT NULL
