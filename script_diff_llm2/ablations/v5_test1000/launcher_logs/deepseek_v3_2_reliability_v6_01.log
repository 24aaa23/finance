        AVG(cfa.cash_flow_avg_per_entity) AS avg_cash_flow_amount,
        AVG(th.total_holding_value_sum_per_entity) AS avg_total_holding_value,
        AVG(g.goal_progress_avg_per_entity) AS avg_goal_progress
    FROM ATOM_ENTITY_INVESTOR_PROFILE_001 p
    LEFT JOIN grouped_net_cash_flow cf ON p.investor_id = cf.investor_id
    LEFT JOIN grouped_cash_flow_amount cfa ON p.investor_id = cfa.investor_id
    LEFT JOIN grouped_total_holding_value th ON p.investor_id = th.investor_id
    LEFT JOIN grouped_goal_progress g ON p.investor_id = g.investor_id
    GROUP BY p.risk_tolerance
)
SELECT
    risk_tolerance,
    avg_net_cash_flow,
    avg_cash_flow_amount,
    avg_total_holding_value,
    avg_goal_progress
FROM final_groups;
