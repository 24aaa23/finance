[SQL GENERATE] Generated SQL: WITH
net_cash_flow_per_investor AS (
  SELECT
    investor_id,
    SUM(amount) AS net_cash_flow
  FROM ATOM_EVENT_CASH_FLOW_001
  GROUP BY investor_id
),
total_sector_investment_per_investor AS (
  SELECT
    investor_id,
    SUM(total_investment) AS total_sector_investment
  FROM ATOM_ENTITY_SECTOR_ALLOCATION_001
  GROUP BY investor_id
),
total_scenario_allocation_shift_per_investor AS (
  SELECT
    investor_id,
    SUM(new_allocation_pct - current_allocation_pct) AS total_scenario_allocation_shift
  FROM ATOM_EVENT_SCENARIO_REBALANCING_001
  GROUP BY investor_id
),
risk_score_per_investor AS (
  SELECT
    investor_id,
    AVG(risk_score) AS risk_score
  FROM ATOM_ENTITY_PORTFOLIO_HEALTH_001
  GROUP BY investor_id
),
all_components AS (
  SELECT
    p.investor_id,
    p.investor_name,
    nc.net_cash_flow,
    si.total_sector_investment,
    ss.total_scenario_allocation_shift,
    rs.risk_score
  FROM ATOM_ENTITY_INVESTOR_PROFILE_001 p
  INNER JOIN net_cash_flow_per_investor nc ON nc.investor_id = p.investor_id
  INNER JOIN total_sector_investment_per_investor si ON si.investor_id = p.investor_id
  INNER JOIN total_scenario_allocation_shift_per_investor ss ON ss.investor_id = p.investor_id
  INNER JOIN risk_score_per_investor rs ON rs.investor_id = p.investor_id
),
with_norms AS (
  SELECT
    investor_id,
    investor_name,
    net_cash_flow,
    total_sector_investment,
    total_scenario_allocation_shift,
    risk_score,
    CASE WHEN MAX(net_cash_flow) OVER() = MIN(net_cash_flow) OVER() THEN 0.0
         ELSE (net_cash_flow - MIN(net_cash_flow) OVER()) / (MAX(net_cash_flow) OVER() - MIN(net_cash_flow) OVER())
    END AS net_cash_flow_norm,
    CASE WHEN MAX(total_sector_investment) OVER() = MIN(total_sector_investment) OVER() THEN 0.0
         ELSE (total_sector_investment - MIN(total_sector_investment) OVER()) / (MAX(total_sector_investment) OVER() - MIN(total_sector_investment) OVER())
    END AS total_sector_investment_norm,
    CASE WHEN MAX(total_scenario_allocation_shift) OVER() = MIN(total_scenario_allocation_shift) OVER() THEN 0.0
         ELSE (total_scenario_allocation_shift - MIN(total_scenario_allocation_shift) OVER()) / (MAX(total_scenario_allocation_shift) OVER() - MIN(total_scenario_allocation_shift) OVER())
    END AS total_scenario_allocation_shift_norm,
    CASE WHEN MAX(risk_score) OVER() = MIN(risk_score) OVER() THEN 0.0
         ELSE (risk_score - MIN(risk_score) OVER()) / (MAX(risk_score) OVER() - MIN(risk_score) OVER())
    END AS risk_score_norm
  FROM all_components
)
SELECT
  investor_id,
  100.0 * ((net_cash_flow_norm + total_sector_investment_norm + total_scenario_allocation_shift_norm + risk_score_norm) / 4.0) AS composite_score,
  investor_name
FROM with_norms
ORDER BY composite_score DESC, investor_id
LIMIT 10
