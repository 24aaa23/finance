[SQL GENERATE] Generated SQL: WITH
-- calculate total holding gain per investor
holding_gain_per_investor AS (
    SELECT
        investor_id,
        SUM(current_value - cost) AS total_holding_gain
    FROM ATOM_ENTITY_PORTFOLIO_HOLDING_001
    WHERE cost > 0 AND current_value > 0
    GROUP BY investor_id
),
-- get maximum risk score per investor
risk_score_per_investor AS (
    SELECT
        investor_id,
        MAX(risk_score) AS risk_score
    FROM ATOM_ENTITY_PORTFOLIO_HEALTH_001
    GROUP BY investor_id
),
-- join components on investors that have both
investor_components AS (
    SELECT
        hg.investor_id,
        hg.total_holding_gain,
        rs.risk_score
    FROM holding_gain_per_investor hg
    INNER JOIN risk_score_per_investor rs
        ON hg.investor_id = rs.investor_id
),
-- compute normalization components with safe division
normalized_components AS (
    SELECT
        investor_id,
        total_holding_gain,
        risk_score,
        CASE
            WHEN MAX(total_holding_gain) OVER () = MIN(total_holding_gain) OVER () THEN 0
            ELSE (total_holding_gain - MIN(total_holding_gain) OVER ()) / 
                 (MAX(total_holding_gain) OVER () - MIN(total_holding_gain) OVER ())
        END AS normalized_gain,
        CASE
            WHEN MAX(risk_score) OVER () = MIN(risk_score) OVER () THEN 0
            ELSE (risk_score - MIN(risk_score) OVER ()) / 
                 (MAX(risk_score) OVER () - MIN(risk_score) OVER ())
        END AS normalized_risk
    FROM investor_components
),
-- compute composite score
composite_scores AS (
    SELECT
        investor_id,
        100 * ((normalized_gain + normalized_risk) / 2) AS composite_score
    FROM normalized_components
)
SELECT
    investor_id,
    composite_score
FROM composite_scores
ORDER BY composite_score DESC, investor_id
LIMIT 10;
