            investor_id,
            -- Equal-weighted mean scaled to 0-100
            100 * (
                normalized_net_cash_flow +
                normalized_total_sector_investment +
                normalized_risk_score
            ) / 3.0 AS composite_score
        FROM
            normalized_components
        WHERE
            normalized_net_cash_flow IS NOT NULL
            AND normalized_total_sector_investment IS NOT NULL
            AND normalized_risk_score IS NOT NULL
    )
