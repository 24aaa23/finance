    WHERE scenario = 'Approaching Goal'
    GROUP BY investor_id
  ),
  goals_cte AS (
    SELECT
      investor_id,
      COUNT(*) AS underfunded_goals_count
    FROM ATOM_ENTITY_INVESTMENT_GOAL_001
    WHERE shortfall > 0
    GROUP BY investor_id
  )
SELECT
  prof.investor_id
FROM ATOM_ENTITY_INVESTOR_PROFILE_001 prof
INNER JOIN diversification_cte d ON prof.investor_id = d.investor_id
INNER JOIN scenario_cte s ON prof.investor_id = s.investor_id
INNER JOIN goals_cte g ON prof.investor_id = g.investor_id
WHERE prof.risk_tolerance = 'Aggressive'
  AND d.diversification_score < 25
  AND s.has_approaching_goal_scenario > 0
  AND g.underfunded_goals_count >= 1
GROUP BY prof.investor_id
