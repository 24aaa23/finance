    SELECT
        investor_id,
        AVG(amount) AS cash_flow_avg_per_entity
    FROM ATOM_EVENT_CASH_FLOW_001
    GROUP BY investor_id
),
grouped_total_holding_value AS (
    SELECT
        investor_id,
        SUM(current_value) AS total_holding_value_sum_per_entity
