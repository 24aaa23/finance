  AVG(th.total_holding_value) AS avg_total_holding_value,
  AVG(ahr.avg_holding_return) AS avg_holding_return,
  AVG(rb.total_rebalance_amount) AS avg_total_rebalance_amount,
  AVG(sa.avg_allocation_shift) AS avg_scenario_allocation_shift
FROM
