[SQL GENERATE] Generated SQL: WITH investor_category AS (
  SELECT DISTINCT investor_id, category
  FROM ATOM_ENTITY_INVESTOR_PROFILE_001
),
holdings_per_investor AS (
  SELECT investor_id, COUNT(holding_id) AS holdings_count
  FROM ATOM_ENTITY_PORTFOLIO_HOLDING_001
  GROUP BY investor_id
),
rebalancing_per_investor AS (
  SELECT investor_id, COUNT(rebalance_id) AS rebalancing_count
  FROM ATOM_EVENT_REBALANCING_ACTION_001
  GROUP BY investor_id
),
risk_per_investor AS (
  SELECT investor_id, AVG(risk_score) AS risk_score_avg
  FROM ATOM_ENTITY_PORTFOLIO_HEALTH_001
  GROUP BY investor_id
),
combined AS (
  SELECT 
    ic.category,
    COALESCE(hpi.holdings_count, 0) AS holdings_count,
    COALESCE(rpi.rebalancing_count, 0) AS rebalancing_count,
    rski.risk_score_avg
  FROM investor_category ic
  LEFT JOIN holdings_per_investor hpi ON ic.investor_id = hpi.investor_id
  LEFT JOIN rebalancing_per_investor rpi ON ic.investor_id = rpi.investor_id
  LEFT JOIN risk_per_investor rski ON ic.investor_id = rski.investor_id
)
SELECT 
  category,
  AVG(holdings_count) AS avg_holdings_per_investor,
  AVG(rebalancing_count) AS avg_rebalancing_actions_per_investor,
  AVG(risk_score_avg) AS avg_risk_score
FROM combined
GROUP BY category;
