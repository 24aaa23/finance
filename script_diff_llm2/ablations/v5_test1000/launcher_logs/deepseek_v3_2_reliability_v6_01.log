[SQL GENERATE] Generated SQL: WITH 
  -- Base table of investor profiles
  investor_profiles AS (
    SELECT 
      investor_id, 
      risk_tolerance
    FROM ATOM_ENTITY_INVESTOR_PROFILE_001
  ),
  
  -- Per-investor aggregated metrics from rebalancing actions
  per_investor_metrics AS (
    SELECT 
      investor_id,
      -- avg_rebalance_amount: AVG per investor of amount
      AVG(amount) AS avg_rebalance_amount_per_investor,
      -- avg_rebalance_shift: AVG per investor of (target_allocation_pct - current_allocation_pct)
      AVG(target_allocation_pct - current_allocation_pct) AS avg_rebalance_shift_per_investor,
      -- avg_rebalance_count: COUNT per investor of rebalance_id (distinct)
      COUNT(DISTINCT rebalance_id) AS avg_rebalance_count_per_investor
    FROM ATOM_EVENT_REBALANCING_ACTION_001
    GROUP BY investor_id
  )
  
SELECT 
  investor_profiles.risk_tolerance AS risk_tolerance,
  -- Final AVG across investors within each risk tolerance
  AVG(per_investor_metrics.avg_rebalance_amount_per_investor) AS avg_rebalance_amount,
  AVG(per_investor_metrics.avg_rebalance_shift_per_investor) AS avg_rebalance_shift,
  -- Apply missing_entity_value = 0 for investors with no rebalancing actions
  AVG(COALESCE(per_investor_metrics.avg_rebalance_count_per_investor, 0)) AS avg_rebalance_count
FROM investor_profiles
LEFT JOIN per_investor_metrics 
  ON investor_profiles.investor_id = per_investor_metrics.investor_id
GROUP BY investor_profiles.risk_tolerance
ORDER BY investor_profiles.risk_tolerance;
