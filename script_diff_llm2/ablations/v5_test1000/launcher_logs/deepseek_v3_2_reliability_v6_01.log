        ip.investor_id,
        COALESCE(SUM(cf.amount), 0) AS net_cash_flow,
        COALESCE(SUM(CASE WHEN ph.cost > 0 AND ph.current_value > 0 THEN ph.current_value - ph.cost ELSE 0 END), 0) AS total_holding_gain,
        COALESCE(SUM(sa.total_investment), 0) AS total_sector_investment,
        COALESCE(AVG(phl.risk_score), 0) AS risk_score
    FROM ATOM_ENTITY_INVESTOR_PROFILE_001 ip
    LEFT JOIN ATOM_EVENT_CASH_FLOW_001 cf ON ip.investor_id = cf.investor_id
    LEFT JOIN ATOM_ENTITY_PORTFOLIO_HOLDING_001 ph ON ip.investor_id = ph.investor_id
    LEFT JOIN ATOM_ENTITY_SECTOR_ALLOCATION_001 sa ON ip.investor_id = sa.investor_id
    LEFT JOIN ATOM_ENTITY_PORTFOLIO_HEALTH_001 phl ON ip.investor_id = phl.investor_id
    GROUP BY ip.investor_id
),
components_with_normalization AS (
    SELECT 
        investor_id,
        net_cash_flow,
        total_holding_gain,
        total_sector_investment,
        risk_score,
        (net_cash_flow - MIN(net_cash_flow) OVER ()) / NULLIF(MAX(net_cash_flow) OVER () - MIN(net_cash_flow) OVER (), 0) AS net_cash_flow_norm,
        (total_holding_gain - MIN(total_holding_gain) OVER ()) / NULLIF(MAX(total_holding_gain) OVER () - MIN(total_holding_gain) OVER (), 0) AS total_holding_gain_norm,
        (total_sector_investment - MIN(total_sector_investment) OVER ()) / NULLIF(MAX(total_sector_investment) OVER () - MIN(total_sector_investment) OVER (), 0) AS total_sector_investment_norm,
        (risk_score - MIN(risk_score) OVER ()) / NULLIF(MAX(risk_score) OVER () - MIN(risk_score) OVER (), 0) AS risk_score_norm
    FROM investor_components
    WHERE 
        (net_cash_flow IS NOT NULL OR net_cash_flow != 0) 
        AND (total_holding_gain IS NOT NULL OR total_holding_gain != 0) 
        AND (total_sector_investment IS NOT NULL OR total_sector_investment != 0) 
        AND (risk_score IS NOT NULL OR risk_score != 0)
),
final_scores AS (
    SELECT 
        investor_id,
        100.0 * (
            COALESCE(net_cash_flow_norm, 0) + 
            COALESCE(total_holding_gain_norm, 0) + 
            COALESCE(total_sector_investment_norm, 0) + 
            COALESCE(risk_score_norm, 0)
        ) / 4.0 AS composite_score
    FROM components_with_normalization
)
