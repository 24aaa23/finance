  FROM "ATOM_ENTITY_SECTOR_ALLOCATION_001"
  GROUP BY "investor_id"
),
allocation_shift_per_investor AS (
  SELECT
    "investor_id",
    AVG("new_allocation_pct" - "current_allocation_pct") AS avg_shift_per_investor
  FROM "ATOM_EVENT_SCENARIO_REBALANCING_001"
  GROUP BY "investor_id"
),
base_groups AS (
  SELECT
    "investor_id",
    "risk_tolerance"
  FROM "ATOM_ENTITY_INVESTOR_PROFILE_001"
)
SELECT
  b."risk_tolerance",
  AVG(c.total_net_cash_flow) AS avg_net_cash_flow,
  AVG(c.avg_cash_flow_per_investor) AS avg_cash_flow_amount,
  AVG(h.total_holding_value) AS avg_total_holding_value,
  AVG(s.total_sector_investment) AS avg_total_sector_investment,
  AVG(a.avg_shift_per_investor) AS avg_scenario_allocation_shift
FROM base_groups b
LEFT JOIN cash_flow_per_investor c ON b."investor_id" = c."investor_id"
LEFT JOIN holding_value_per_investor h ON b."investor_id" = h."investor_id"
LEFT JOIN sector_investment_per_investor s ON b."investor_id" = s."investor_id"
LEFT JOIN allocation_shift_per_investor a ON b."investor_id" = a."investor_id"
GROUP BY b."risk_tolerance";
