),
holding_return_per_investor AS (
    SELECT investor_id, AVG(returns_pct) AS avg_return_pct
    FROM ATOM_ENTITY_PORTFOLIO_HOLDING_001
    WHERE cost > 0 AND current_value > 0
    GROUP BY investor_id
),
risk_score_per_investor AS (
    SELECT investor_id, AVG(risk_score) AS avg_risk_score
    FROM ATOM_ENTITY_PORTFOLIO_HEALTH_001
    GROUP BY investor_id
)
SELECT
    i.segment AS segment,
    AVG(s.total_investment_sum) AS avg_total_sector_allocation_investment_per_investor,
    AVG(h.avg_return_pct) AS avg_holding_return_per_investor,
    AVG(r.avg_risk_score) AS avg_risk_score
FROM investor_segments i
LEFT JOIN sector_allocation_per_investor s ON i.investor_id = s.investor_id
LEFT JOIN holding_return_per_investor h ON i.investor_id = h.investor_id
LEFT JOIN risk_score_per_investor r ON i.investor_id = r.investor_id
GROUP BY i.segment
ORDER BY i.segment;
