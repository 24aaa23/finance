PREFIX wm: <https://wealth.example.org/ontology/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?investorId
WHERE {
  ?investor rdf:type wm:Investor .
  ?investor wm:riskTolerance "Aggressive" .
  ?investor wm:investorId ?investorId .

  ?portfolioHealth rdf:type wm:PortfolioHealth .
  ?portfolioHealth wm:healthOfInvestor ?investor .
  ?portfolioHealth wm:liquidityScore ?liquidityScore .
  FILTER (xsd:decimal(?liquidityScore) < 25)

  ?investmentGoal rdf:type wm:InvestmentGoal .
  ?investmentGoal wm:belongsToInvestor ?investor .
  ?investmentGoal wm:shortfall ?shortfall .
  FILTER (xsd:decimal(?shortfall) > 0)

  {
    SELECT ?investor (COUNT(DISTINCT ?holding) AS ?loss_making_holding_count)
    WHERE {
      ?holding rdf:type wm:PortfolioHolding .
      ?holding wm:heldByInvestor ?investor .
      ?holding wm:cost ?cost .
      ?holding wm:currentValue ?currentValue .
      FILTER (xsd:decimal(?cost) > 0)
      FILTER (xsd:decimal(?currentValue) > 0)
      FILTER (xsd:decimal(?currentValue) < xsd:decimal(?cost))
    }
    GROUP BY ?investor
    HAVING (COUNT(DISTINCT ?holding) > 0)
  }
}

