PREFIX wm: <https://wealth.example.org/ontology/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?investorId
WHERE {
  # Base entity: Investor
  ?investor rdf:type wm:Investor ;
            wm:riskTolerance "Aggressive" ;
            wm:investorId ?investorId .

  # Condition 1: Liquidity score below 25
  ?investor wm:hasPortfolioHealth ?portfolioHealth .
  ?portfolioHealth wm:liquidityScore ?liquidityScore .
  FILTER (xsd:decimal(?liquidityScore) < 25)

  # Condition 2: Underfunded goal (shortfall > 0)
  ?investor wm:hasInvestmentGoal ?investmentGoal .
  ?investmentGoal wm:shortfall ?shortfall .
  FILTER (xsd:decimal(?shortfall) > 0)

  # Condition 3: 'Aggressive Entry' rebalancing action
  ?investor wm:hasRebalancingAction ?rebalancingAction .
  ?rebalancingAction wm:action "Aggressive Entry" .

  # Condition 4: At least one loss-making holding (cost > currentValue) with recorded cost and current value
  {
    SELECT ?investor (COUNT(?holding) AS ?has_loss_making_holding)
    WHERE {
      ?investor wm:hasHolding ?holding .
      ?holding wm:cost ?cost ;
               wm:currentValue ?currentValue .
      FILTER (xsd:decimal(?cost) > 0 && xsd:decimal(?currentValue) > 0 && xsd:decimal(?currentValue) < xsd:decimal(?cost))
    }
    GROUP BY ?investor
    HAVING (COUNT(?holding) > 0)
  }
}

