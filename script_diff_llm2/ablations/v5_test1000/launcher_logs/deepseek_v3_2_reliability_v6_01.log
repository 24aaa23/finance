      COALESCE(ss.total_scenario_allocation_shift, 0) AS total_scenario_allocation_shift
    FROM ATOM_ENTITY_INVESTOR_PROFILE_001 AS ip
    INNER JOIN net_cash_flow_per_investor AS cf ON ip.investor_id = cf.investor_id
    INNER JOIN total_holding_gain_per_investor AS hg ON ip.investor_id = hg.investor_id
    INNER JOIN total_scenario_allocation_shift_per_investor AS ss ON ip.investor_id = ss.investor_id
  ),
  normalized_metrics AS (
