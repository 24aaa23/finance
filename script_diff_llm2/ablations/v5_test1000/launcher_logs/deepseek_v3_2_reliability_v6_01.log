            ELSE (net_cash_flow - MIN(net_cash_flow) OVER ()) / (MAX(net_cash_flow) OVER () - MIN(net_cash_flow) OVER ())
        END AS normalized_net_cash_flow,
        CASE
            WHEN MAX(total_holding_gain) OVER () - MIN(total_holding_gain) OVER () = 0 THEN 0.5
