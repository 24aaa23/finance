[SQL GENERATE] Generated SQL: WITH cash_flow_by_investor AS (
  SELECT
    investor_id,
    SUM(CASE 
          WHEN type IN ('Deposit', 'Lump Sum', 'SIP', 'Interest Credit', 'Tax Refund', 'Dividend Reinvestment') THEN amount
          WHEN type IN ('Withdrawal', 'Redemption') THEN -amount
          ELSE 0
        END) AS net_cash_flow
  FROM ATOM_EVENT_CASH_FLOW_001
  GROUP BY investor_id
),
allocation_shift_by_investor AS (
  SELECT
    investor_id,
    SUM(new_allocation_pct - current_allocation_pct) AS total_scenario_allocation_shift
  FROM ATOM_EVENT_SCENARIO_REBALANCING_001
  GROUP BY investor_id
),
investor_components AS (
  SELECT
    cf.investor_id,
    cf.net_cash_flow,
    ash.total_scenario_allocation_shift
  FROM cash_flow_by_investor cf
  INNER JOIN allocation_shift_by_investor ash ON cf.investor_id = ash.investor_id
),
normalized_values AS (
  SELECT
    investor_id,
    net_cash_flow,
    total_scenario_allocation_shift,
    (net_cash_flow - MIN(net_cash_flow) OVER ()) / (MAX(net_cash_flow) OVER () - MIN(net_cash_flow) OVER ()) AS normalized_net_cash_flow,
    (total_scenario_allocation_shift - MIN(total_scenario_allocation_shift) OVER ()) / (MAX(total_scenario_allocation_shift) OVER () - MIN(total_scenario_allocation_shift) OVER ()) AS normalized_allocation_shift
  FROM investor_components
),
composite_scores AS (
  SELECT
    investor_id,
    normalized_net_cash_flow,
    normalized_allocation_shift,
    100.0 * ((normalized_net_cash_flow + normalized_allocation_shift) / 2) AS composite_score
  FROM normalized_values
)
SELECT
  investor_id,
  ROUND(composite_score, 2) AS composite_score
FROM composite_scores
ORDER BY composite_score DESC, investor_id
