    AVG(ra.investor_avg_rebalance_amount) AS avg_rebalance_amount
FROM ATOM_ENTITY_INVESTOR_PROFILE_001 ip
LEFT JOIN holdings_total ht ON ip.investor_id = ht.investor_id
LEFT JOIN holdings_return hr ON ip.investor_id = hr.investor_id
LEFT JOIN rebalance_amounts ra ON ip.investor_id = ra.investor_id
GROUP BY ip.risk_tolerance
ORDER BY ip.risk_tolerance
