        (total_holding_gain - MIN(total_holding_gain) OVER ()) / NULLIF(MAX(total_holding_gain) OVER () - MIN(total_holding_gain) OVER (), 0) AS normalized_total_holding_gain,
        (total_rebalance_amount - MIN(total_rebalance_amount) OVER ()) / NULLIF(MAX(total_rebalance_amount) OVER () - MIN(total_rebalance_amount) OVER (), 0) AS normalized_total_rebalance_amount,
        (total_scenario_allocation_shift - MIN(total_scenario_allocation_shift) OVER ()) / NULLIF(MAX(total_scenario_allocation_shift) OVER () - MIN(total_scenario_allocation_shift) OVER (), 0) AS normalized_total_scenario_allocation_shift
    FROM investor_components
),
-- Compute composite score (0-100 index) as 100 times the equal-weighted mean of normalized components
composite_score_compute AS (
    SELECT
        investor_id,
        100 * (
            (COALESCE(normalized_net_cash_flow, 0) +
             COALESCE(normalized_total_holding_gain, 0) +
             COALESCE(normalized_total_rebalance_amount, 0) +
             COALESCE(normalized_total_scenario_allocation_shift, 0)) / 4.0
        ) AS composite_score
    FROM normalized_components
)
-- Return top 10 investors ranked by composite score descending, ties broken by investor_id
SELECT
    investor_id,
    composite_score
FROM composite_score_compute
ORDER BY composite_score DESC, investor_id
LIMIT 10;
