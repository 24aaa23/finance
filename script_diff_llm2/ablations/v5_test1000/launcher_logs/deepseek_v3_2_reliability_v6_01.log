    AVG(ps.total_sector_investment) AS avg_total_sector_investment
  FROM investor_risk ir
  LEFT JOIN per_investor_holding_sum ph ON ir."investor_id" = ph."investor_id"
  LEFT JOIN per_investor_return_avg pr ON ir."investor_id" = pr."investor_id"
  LEFT JOIN per_investor_sector_sum ps ON ir."investor_id" = ps."investor_id"
  GROUP BY ir."risk_tolerance"
)
SELECT 
  "risk_tolerance",
  "avg_total_holding_value",
  "avg_holding_return",
  "avg_total_sector_investment"
FROM grouped_result;

