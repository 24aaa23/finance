      (c.net_cash_flow_raw - MIN(c.net_cash_flow_raw) OVER ())
      / NULLIF(MAX(c.net_cash_flow_raw) OVER () - MIN(c.net_cash_flow_raw) OVER (), 0)
    ) +
    (
      (r.total_rebalance_raw - MIN(r.total_rebalance_raw) OVER ())
      / NULLIF(MAX(r.total_rebalance_raw) OVER () - MIN(r.total_rebalance_raw) OVER (), 0)
    ) +
    (
      (k.risk_score_raw - MIN(k.risk_score_raw) OVER ())
      / NULLIF(MAX(k.risk_score_raw) OVER () - MIN(k.risk_score_raw) OVER (), 0)
    ) +
    (1 - (
        (g.avg_goal_shortfall_raw - MIN(g.avg_goal_shortfall_raw) OVER ())
        / NULLIF(MAX(g.avg_goal_shortfall_raw) OVER () - MIN(g.avg_goal_shortfall_raw) OVER (), 0)
      ))
  ) / 4.0 AS composite_score
FROM ATOM_ENTITY_INVESTOR_PROFILE_001 b
INNER JOIN cash c       ON b.investor_id = c.investor_id
INNER JOIN rebalance r   ON b.investor_id = r.investor_id
INNER JOIN risk k       ON b.investor_id = k.investor_id
INNER JOIN goal g       ON b.investor_id = g.investor_id
ORDER BY composite_score DESC, b.investor_id ASC
LIMIT 10;
