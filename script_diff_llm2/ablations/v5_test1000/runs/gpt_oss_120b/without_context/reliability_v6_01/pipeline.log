PREFIX wm: <https://wealth.example.org/ontology/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?investorId ?investorName
WHERE {
  # Investor with Aggressive risk tolerance
  ?inv a wm:Investor ;
       wm:investorId ?investorId ;
       wm:investorName ?investorName ;
       wm:riskTolerance "Aggressive" .

  # Portfolio health with riskScore > 75
  ?ph a wm:PortfolioHealth ;
      wm:healthOfInvestor ?inv ;
      wm:riskScore ?riskScore .
  FILTER(?riskScore > 75)

  # Banking sector allocation > 0%
  ?sa a wm:SectorAllocation ;
      wm:allocationOfInvestor ?inv ;
      wm:sector "Banking" ;
      wm:allocationPct ?allocPct .
  FILTER(?allocPct > 0)

  # At least one loss‑making holding (currentValue < cost)
  {
    SELECT ?investorId (SUM(?lossFlag) AS ?lossHoldingCount)
    WHERE {
      ?holding a wm:PortfolioHolding ;
               wm:heldByInvestor ?invHold ;
               wm:cost ?cost ;
               wm:currentValue ?curr .
      ?invHold wm:investorId ?investorId .
      FILTER(bound(?cost) && bound(?curr))
      BIND(IF(?curr < ?cost, 1, 0) AS ?lossFlag)
    }
    GROUP BY ?investorId
    HAVING (SUM(?lossFlag) > 0)
  }

  # At least one underfunded goal (shortfall > 0)
  {
    SELECT ?investorId (COUNT(?goal) AS ?underfundedGoalCount)
    WHERE {
      ?goal a wm:InvestmentGoal ;
            wm:belongsToInvestor ?invGoal ;
            wm:shortfall ?shortfall .
      ?invGoal wm:investorId ?investorId .
      FILTER(?shortfall > 0)
    }
    GROUP BY ?investorId
    HAVING (COUNT(?goal) > 0)
  }
}

