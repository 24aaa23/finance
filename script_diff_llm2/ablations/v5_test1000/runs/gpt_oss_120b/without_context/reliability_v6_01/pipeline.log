[SQL GENERATE] Generated SQL: WITH sector_tot AS (
        SELECT investor_id,
               AVG(total_investment) AS avg_total_investment
        FROM ATOM_ENTITY_SECTOR_ALLOCATION_001
        GROUP BY investor_id
    ),
    sector_alloc AS (
        SELECT investor_id,
               AVG(allocation_pct) AS avg_allocation_pct
        FROM ATOM_ENTITY_SECTOR_ALLOCATION_001
        GROUP BY investor_id
    ),
    scenario_shift AS (
        SELECT investor_id,
               AVG(new_allocation_pct - current_allocation_pct) AS avg_scenario_shift
        FROM ATOM_EVENT_SCENARIO_REBALANCING_001
        GROUP BY investor_id
    )
SELECT p.risk_tolerance,
       AVG(st.avg_total_investment)   AS avg_total_investment,
       AVG(sa.avg_allocation_pct)    AS avg_allocation_pct,
       AVG(ss.avg_scenario_shift)    AS avg_scenario_shift
FROM ATOM_ENTITY_INVESTOR_PROFILE_001 AS p
INNER JOIN sector_tot      AS st ON p.investor_id = st.investor_id
INNER JOIN sector_alloc    AS sa ON p.investor_id = sa.investor_id
INNER JOIN scenario_shift  AS ss ON p.investor_id = ss.investor_id
