[SQL GENERATE] Generated SQL: WITH cash AS (
        SELECT investor_id,
               SUM(amount) AS net_cash_flow_raw
        FROM ATOM_EVENT_CASH_FLOW_001
        GROUP BY investor_id
    ),
    holdings AS (
        SELECT investor_id,
               SUM(current_value - cost) AS total_holding_gain_raw
        FROM ATOM_ENTITY_PORTFOLIO_HOLDING_001
        WHERE cost IS NOT NULL AND current_value IS NOT NULL
        GROUP BY investor_id
    ),
    health AS (
        SELECT investor_id,
               AVG(risk_score) AS risk_score_raw
        FROM ATOM_ENTITY_PORTFOLIO_HEALTH_001
        GROUP BY investor_id
    ),
    goals AS (
        SELECT investor_id,
               AVG(shortfall) AS avg_goal_shortfall_raw
        FROM ATOM_ENTITY_INVESTMENT_GOAL_001
        GROUP BY investor_id
    ),
    raw AS (
        SELECT ip.investor_id,
               c.net_cash_flow_raw,
               h.total_holding_gain_raw,
               ph.risk_score_raw,
               g.avg_goal_shortfall_raw
        FROM ATOM_ENTITY_INVESTOR_PROFILE_001 ip
        INNER JOIN cash c USING (investor_id)
        INNER JOIN holdings h USING (investor_id)
        INNER JOIN health ph USING (investor_id)
        INNER JOIN goals g USING (investor_id)
    )
SELECT
    investor_id,
    100.0 * (
        (net_cash_flow_raw - min_net) / NULLIF(max_net - min_net, 0) +
        (total_holding_gain_raw - min_gain) / NULLIF(max_gain - min_gain, 0) +
        (risk_score_raw - min_risk) / NULLIF(max_risk - min_risk, 0) +
        (1 - ((avg_goal_shortfall_raw - min_sf) / NULLIF(max_sf - min_sf, 0)))
    ) / 4.0 AS composite_score
FROM (
    SELECT
        investor_id,
        net_cash_flow_raw,
        total_holding_gain_raw,
        risk_score_raw,
        avg_goal_shortfall_raw,
        MIN(net_cash_flow_raw) OVER () AS min_net,
        MAX(net_cash_flow_raw) OVER () AS max_net,
        MIN(total_holding_gain_raw) OVER () AS min_gain,
        MAX(total_holding_gain_raw) OVER () AS max_gain,
        MIN(risk_score_raw) OVER () AS min_risk,
        MAX(risk_score_raw) OVER () AS max_risk,
        MIN(avg_goal_shortfall_raw) OVER () AS min_sf,
        MAX(avg_goal_shortfall_raw) OVER () AS max_sf
    FROM raw
) t
ORDER BY composite_score DESC, investor_id ASC
LIMIT 10;
