[SQL GENERATE] Generated SQL: WITH cash AS (
    SELECT investor_id, SUM(amount) AS net_cash_flow
    FROM ATOM_EVENT_CASH_FLOW_001
    GROUP BY investor_id
),
hold AS (
    SELECT investor_id, SUM(current_value - cost) AS holding_gain
    FROM ATOM_ENTITY_PORTFOLIO_HOLDING_001
    WHERE cost IS NOT NULL AND current_value IS NOT NULL
    GROUP BY investor_id
),
reb AS (
    SELECT investor_id, SUM(amount) AS total_rebalance_amount
    FROM ATOM_EVENT_REBALANCING_ACTION_001
    GROUP BY investor_id
),
risk AS (
    SELECT investor_id, AVG(risk_score) AS risk_score
    FROM ATOM_ENTITY_PORTFOLIO_HEALTH_001
    GROUP BY investor_id
)
SELECT sub.investor_id,
       100.0 * (sub.norm_net_cash_flow + sub.norm_holding_gain + sub.norm_total_rebalance_amount + sub.norm_risk_score) / 4.0 AS composite_score
FROM (
    SELECT i.investor_id,
           cash.net_cash_flow,
           hold.holding_gain,
           reb.total_rebalance_amount,
           risk.risk_score,
