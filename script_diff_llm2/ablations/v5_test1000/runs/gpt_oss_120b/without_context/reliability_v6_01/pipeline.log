PREFIX wm: <https://wealth.example.org/ontology/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

SELECT DISTINCT ?investorId
WHERE {
  # Aggressive investors
  {
    SELECT ?investorId
    WHERE {
      ?inv a wm:Investor ;
           wm:investorId ?investorId ;
           wm:riskTolerance "Aggressive" .
    }
  }
  # Diversification score below 25
  {
    SELECT ?investorId
    WHERE {
      ?ph a wm:PortfolioHealth ;
          wm:investorId ?investorId ;
          wm:diversificationScore ?divScore .
      FILTER(?divScore < 25)
    }
  }
  # At least one loss-making holding (cost and currentValue present, currentValue < cost)
  {
    SELECT ?investorId (COUNT(?h) AS ?lossHoldingCount)
    WHERE {
      ?h a wm:PortfolioHolding ;
         wm:investorId ?investorId ;
         wm:cost ?cost ;
         wm:currentValue ?cv .
      FILTER(?cv < ?cost)
    }
    GROUP BY ?investorId
    HAVING (COUNT(?h) > 0)
  }
  # Corporate sector allocation > 0%
  {
    SELECT ?investorId
    WHERE {
      ?alloc a wm:SectorAllocation ;
            wm:investorId ?investorId ;
            wm:sector "Corporate" ;
            wm:allocationPct ?allocPct .
      FILTER(?allocPct > 0)
    }
  }
}

