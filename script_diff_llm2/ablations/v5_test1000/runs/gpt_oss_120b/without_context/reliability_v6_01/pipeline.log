PREFIX wm: <https://wealth.example.org/ontology/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?investorId ?investorName ?net_cash_flow_2025
WHERE {
  ?inv a wm:Investor .
  ?inv wm:investorId ?investorId .
  ?inv wm:riskTolerance ?risk .
  FILTER(LCASE(?risk) = "moderate") .
  OPTIONAL { ?inv wm:investorName ?investorName . }

  FILTER EXISTS {
    ?goal wm:belongsToInvestor ?inv ;
          wm:shortfall ?sf .
    FILTER(?sf > 0) .
  }

  {
    SELECT ?inv (SUM(xsd:decimal(?amount)) AS ?net_cash_flow_2025)
    WHERE {
      ?cf wm:cashFlowOfInvestor ?inv ;
          wm:amount ?amount ;
          wm:date ?date .
      FILTER(?date >= "2025-01-01"^^xsd:date && ?date <= "2025-12-31"^^xsd:date)
    }
    GROUP BY ?inv
  }

  FILTER(?net_cash_flow_2025 < 0)
}

