        FROM ATOM_EVENT_REBALANCING_ACTION_001 r
        JOIN profile p ON p.investor_id = r.investor_id
        GROUP BY p.risk_tolerance
    ),
    risk_groups AS (
        SELECT DISTINCT risk_tolerance
        FROM ATOM_ENTITY_INVESTOR_PROFILE_001
    )
SELECT
    rg.risk_tolerance,
    nc.avg_net_cash_flow,
    sc.avg_signed_cash_flow_amount,
    hv.avg_total_holding_value,
    rb.avg_rebalance_amount
FROM risk_groups rg
LEFT JOIN net_cf_by_risk nc ON rg.risk_tolerance = nc.risk_tolerance
LEFT JOIN signed_cf_by_risk sc ON rg.risk_tolerance = sc.risk_tolerance
LEFT JOIN holding_by_risk hv ON rg.risk_tolerance = hv.risk_tolerance
LEFT JOIN rebalance_by_risk rb ON rg.risk_tolerance = rb.risk_tolerance
ORDER BY rg.risk_tolerance;
