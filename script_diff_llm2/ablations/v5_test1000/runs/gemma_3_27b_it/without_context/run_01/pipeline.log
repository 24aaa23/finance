  FROM ATOM_ENTITY_PORTFOLIO_HEALTH_001
  GROUP BY
    investor_id
),
holdings AS (
  SELECT
    investor_id,
    dividends,
    segment
  FROM ATOM_ENTITY_PORTFOLIO_HOLDING_001
  GROUP BY
    investor_id,
    segment
)
SELECT
  h.segment,
  AVG(h.dividends) AS avg_holding_dividend
FROM ATOM_ENTITY_INVESTOR_PROFILE_001 AS i
INNER JOIN investor_sharpe AS isharpe ON i.investor_id = isharpe.investor_id
INNER JOIN portfolio_health AS phealth ON i.investor_id = phealth.investor_id
INNER JOIN holdings AS h ON i.investor_id = h.investor_id
WHERE
  isharpe.avg_sharpe_ratio > 0.0
  AND phealth.goal_match_pct > 50
GROUP BY
  h.segment;

