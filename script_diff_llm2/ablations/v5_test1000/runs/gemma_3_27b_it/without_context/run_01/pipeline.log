  GROUP BY
    investor_id
)
SELECT
  ip.risk_tolerance,
  AVG(icf.total_cash_flow) AS avg_net_cash_flow,
  AVG(icf.total_cash_flow) AS avg_cash_flow_amount,
  AVG(ra.total_rebalance_amount) AS avg_total_rebalance_amount,
  AVG(si.total_sector_investment) AS avg_total_sector_investment,
  AVG(gp.avg_goal_progress) AS avg_goal_progress
FROM ATOM_ENTITY_INVESTOR_PROFILE_001 AS ip
LEFT JOIN investor_cash_flow AS icf ON ip.investor_id = icf.investor_id
LEFT JOIN rebalancing_amount AS ra ON ip.investor_id = ra.investor_id
LEFT JOIN sector_investment AS si ON ip.investor_id = si.investor_id
LEFT JOIN goal_progress AS gp ON ip.investor_id = gp.investor_id
GROUP BY
