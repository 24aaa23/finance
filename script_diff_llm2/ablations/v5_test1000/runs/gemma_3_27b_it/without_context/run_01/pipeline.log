[SQL GENERATE] Generated SQL: WITH investor_profile AS (
  SELECT
    investor_id
  FROM ATOM_ENTITY_INVESTOR_PROFILE_001
  WHERE
    risk_tolerance = 'Aggressive'
),
portfolio_health AS (
  SELECT
    investor_id,
    risk_score
  FROM ATOM_ENTITY_PORTFOLIO_HEALTH_001
),
portfolio_holding AS (
  SELECT
    investor_id,
    category
  FROM ATOM_ENTITY_PORTFOLIO_HOLDING_001
),
rebalancing_action AS (
  SELECT
    investor_id,
    action
  FROM ATOM_EVENT_REBALANCING_ACTION_001
),
investment_goal AS (
  SELECT
    investor_id,
    shortfall
  FROM ATOM_ENTITY_INVESTMENT_GOAL_001
)
SELECT
  ip.investor_id
FROM investor_profile AS ip
INNER JOIN portfolio_health AS ph
  ON ip.investor_id = ph.investor_id
INNER JOIN portfolio_holding AS phold
  ON ip.investor_id = phold.investor_id
INNER JOIN rebalancing_action AS ra
  ON ip.investor_id = ra.investor_id
INNER JOIN investment_goal AS ig
  ON ip.investor_id = ig.investor_id
WHERE
  ph.risk_score > 50
  AND phold.category = 'Gold'
