PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?investorId
WHERE {
  ?investor rdf:type wm:Investor .
  ?investor wm:segment "Diversified" .
  ?investor wm:hasPortfolioHealth ?portfolioHealth .
  ?portfolioHealth wm:liquidityScore ?liquidityScore .
  FILTER (?liquidityScore < 50) .
  ?investor wm:hasSectorAllocation ?sectorAllocation .
  ?sectorAllocation wm:sector "Automobile" .
  ?sectorAllocation wm:allocationPct ?allocationPct .
  FILTER (?allocationPct > 0) .
  ?investor wm:hasInvestmentGoal ?investmentGoal .
  ?investmentGoal wm:shortfall ?shortfall .
  FILTER (?shortfall > 0) .
  BIND (?investor wm:investorId AS ?investorId)
}

