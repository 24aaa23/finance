),
risk_score_cte AS (
  SELECT investor_id, AVG(risk_score) AS risk_score
  FROM ATOM_ENTITY_PORTFOLIO_HEALTH_001
  GROUP BY investor_id
),
combined_cte AS (
  SELECT
    net_cash_flow_cte.investor_id,
    net_cash_flow_cte.net_cash_flow,
    holding_gain_cte.total_holding_gain,
    rebalance_amount_cte.total_rebalance_amount,
    risk_score_cte.risk_score
  FROM net_cash_flow_cte
  INNER JOIN holding_gain_cte ON net_cash_flow_cte.investor_id = holding_gain_cte.investor_id
  INNER JOIN rebalance_amount_cte ON net_cash_flow_cte.investor_id = rebalance_amount_cte.investor_id
  INNER JOIN risk_score_cte ON net_cash_flow_cte.investor_id = risk_score_cte.investor_id
),
norm_cte AS (
