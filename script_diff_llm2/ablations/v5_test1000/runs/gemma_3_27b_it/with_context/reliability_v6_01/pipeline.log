  cf.net_cash_flow - gs.average_goal_shortfall AS composite_score
FROM cash_flow AS cf
INNER JOIN goal_shortfall AS gs
  ON cf.investor_id = gs.investor_id
WHERE
  NOT EXISTS (
    SELECT
      1
    FROM ATOM_ENTITY_INVESTMENT_GOAL_001 AS g
    WHERE
      g.goal_id IS NULL AND g.investor_id = cf.investor_id
  ) AND NOT EXISTS (
    SELECT
      1
    FROM ATOM_ENTITY_PORTFOLIO_HOLDING_001 AS h
    WHERE
      h.holding_id IS NULL AND h.investor_id = cf.investor_id
  ) AND NOT EXISTS (
    SELECT
      1
    FROM ATOM_EVENT_CASH_FLOW_001 AS c
    WHERE
      c.cash_flow_id IS NULL AND c.investor_id = cf.investor_id
  ) AND NOT EXISTS (
    SELECT
      1
    FROM ATOM_ENTITY_PORTFOLIO_HEALTH_001 AS ph
    WHERE
      ph.portfolio_health_id IS NULL AND ph.investor_id = cf.investor_id
  ) AND NOT EXISTS (
    SELECT
      1
    FROM ATOM_ENTITY_SECTOR_ALLOCATION_001 AS sa
    WHERE
      sa.sector_id IS NULL AND sa.investor_id = cf.investor_id
  ) AND NOT EXISTS (
    SELECT
      1
    FROM ATOM_EVENT_REBALANCING_ACTION_001 AS ra
    WHERE
      ra.rebalance_id IS NULL AND ra.investor_id = cf.investor_id
  ) AND NOT EXISTS (
    SELECT
      1
    FROM ATOM_EVENT_SCENARIO_REBALANCING_001 AS sr
    WHERE
      sr.scenario_rebalance_id IS NULL AND sr.investor_id = cf.investor_id
  )
ORDER BY
  composite_score DESC, investor_id
LIMIT 10;
