NormalizedScores AS (
  SELECT
    investor_id,
    (net_cash_flow - (SELECT MIN(net_cash_flow) FROM NetCashFlow)) / (SELECT MAX(net_cash_flow) - MIN(net_cash_flow) FROM NetCashFlow) AS normalized_net_cash_flow,
    (total_holding_gain - (SELECT MIN(total_holding_gain) FROM TotalHoldingGain)) / (SELECT MAX(total_holding_gain) - MIN(total_holding_gain) FROM TotalHoldingGain) AS normalized_holding_gain,
    (risk_score - (SELECT MIN(risk_score) FROM RiskScore)) / (SELECT MAX(risk_score) - MIN(risk_score) FROM RiskScore) AS normalized_risk_score
  FROM NetCashFlow
  INNER JOIN TotalHoldingGain ON NetCashFlow.investor_id = TotalHoldingGain.investor_id
  INNER JOIN RiskScore ON NetCashFlow.investor_id = RiskScore.investor_id
),
CompositeScores AS (
