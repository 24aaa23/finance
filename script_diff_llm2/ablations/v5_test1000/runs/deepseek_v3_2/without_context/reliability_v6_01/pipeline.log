    FROM
        combined_components
),
-- Compute composite score
composite_scores AS (
    SELECT
        investor_id,
        100 * (net_cash_flow_norm + total_holding_gain_norm + risk_score_norm + avg_goal_shortfall_norm) / 4 AS composite_score
    FROM
        normalized_components
)
