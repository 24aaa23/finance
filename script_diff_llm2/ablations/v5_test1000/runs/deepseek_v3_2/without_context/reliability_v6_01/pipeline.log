PREFIX wm: <https://wealth.example.org/ontology/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

SELECT DISTINCT ?investorId ?investorName
WHERE {
  ?investor a wm:Investor ;
            wm:riskTolerance "Aggressive" ;
            wm:investorId ?investorId ;
            wm:investorName ?investorName .

  ?investor wm:hasPortfolioHealth ?portfolioHealth .
  ?portfolioHealth wm:riskScore ?riskScore .
  FILTER (xsd:decimal(?riskScore) > 75)

  ?investor wm:hasInvestmentGoal ?investmentGoal .
  ?investmentGoal wm:shortfall ?shortfall .
  FILTER (xsd:decimal(?shortfall) > 0)

  ?investor wm:hasSectorAllocation ?sectorAllocation .
  ?sectorAllocation wm:hasSector ?sectorNode .
  ?sectorNode rdfs:label "Banking" .
  ?sectorAllocation wm:allocationPct ?allocationPct .
  FILTER (xsd:decimal(?allocationPct) > 0)

  FILTER EXISTS {
    ?investor wm:hasHolding ?holding .
    ?holding wm:cost ?cost ;
             wm:currentValue ?currentValue .
    FILTER (xsd:decimal(?currentValue) < xsd:decimal(?cost))
  }
}

