  AVG(h.total_holding_value) AS avg_total_holding_value,
  AVG(r.avg_investor_return) AS avg_holding_return,
  AVG(rb.total_rebalance_amount) AS avg_total_rebalance_amount,
  AVG(s.total_sector_investment) AS avg_total_sector_investment
FROM ATOM_ENTITY_INVESTOR_PROFILE_001 AS ip
LEFT JOIN holding_aggregates AS h ON ip.investor_id = h.investor_id
LEFT JOIN return_filtered AS r ON ip.investor_id = r.investor_id
LEFT JOIN rebalance_aggregates AS rb ON ip.investor_id = rb.investor_id
LEFT JOIN sector_aggregates AS s ON ip.investor_id = s.investor_id
GROUP BY ip.risk_tolerance
ORDER BY ip.risk_tolerance
