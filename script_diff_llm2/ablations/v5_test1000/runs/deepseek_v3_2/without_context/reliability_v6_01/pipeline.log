    investor_name,
    net_cash_flow,
    total_sector_investment,
    total_scenario_allocation_shift,
    risk_score,
    CASE WHEN MAX(net_cash_flow) OVER() = MIN(net_cash_flow) OVER() THEN 0.0
         ELSE (net_cash_flow - MIN(net_cash_flow) OVER()) / (MAX(net_cash_flow) OVER() - MIN(net_cash_flow) OVER())
    END AS net_cash_flow_norm,
    CASE WHEN MAX(total_sector_investment) OVER() = MIN(total_sector_investment) OVER() THEN 0.0
         ELSE (total_sector_investment - MIN(total_sector_investment) OVER()) / (MAX(total_sector_investment) OVER() - MIN(total_sector_investment) OVER())
    END AS total_sector_investment_norm,
    CASE WHEN MAX(total_scenario_allocation_shift) OVER() = MIN(total_scenario_allocation_shift) OVER() THEN 0.0
         ELSE (total_scenario_allocation_shift - MIN(total_scenario_allocation_shift) OVER()) / (MAX(total_scenario_allocation_shift) OVER() - MIN(total_scenario_allocation_shift) OVER())
    END AS total_scenario_allocation_shift_norm,
    CASE WHEN MAX(risk_score) OVER() = MIN(risk_score) OVER() THEN 0.0
         ELSE (risk_score - MIN(risk_score) OVER()) / (MAX(risk_score) OVER() - MIN(risk_score) OVER())
    END AS risk_score_norm
  FROM all_components
)
SELECT
  investor_id,
  100.0 * ((net_cash_flow_norm + total_sector_investment_norm + total_scenario_allocation_shift_norm + risk_score_norm) / 4.0) AS composite_score,
  investor_name
FROM with_norms
ORDER BY composite_score DESC, investor_id
LIMIT 10
