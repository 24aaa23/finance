[SQL GENERATE] Generated SQL: WITH aggregated_components AS (
    SELECT 
        ip.investor_id,
        ip.investor_name,
        -- Measure: net_cash_flow
        COALESCE(SUM(cf.amount), 0) AS net_cash_flow,
        -- Measure: total_sector_investment
        COALESCE(SUM(sa.total_investment), 0) AS total_sector_investment,
        -- Measure: allocation_shift
        COALESCE(SUM(sr.new_allocation_pct - sr.current_allocation_pct), 0) AS allocation_shift,
        -- Measure: risk_score
        COALESCE(AVG(ph.risk_score), 0) AS risk_score
    FROM ATOM_ENTITY_INVESTOR_PROFILE_001 AS ip
    LEFT JOIN ATOM_EVENT_CASH_FLOW_001 AS cf ON ip.investor_id = cf.investor_id
    LEFT JOIN ATOM_ENTITY_SECTOR_ALLOCATION_001 AS sa ON ip.investor_id = sa.investor_id
    LEFT JOIN ATOM_EVENT_SCENARIO_REBALANCING_001 AS sr ON ip.investor_id = sr.investor_id
    LEFT JOIN ATOM_ENTITY_PORTFOLIO_HEALTH_001 AS ph ON ip.investor_id = ph.investor_id
    WHERE ip.investor_id IN ('INV-1025', 'INV-250', 'INV-393', 'INV-073', 'INV-1304', 'INV-068', 'INV-1281', 'INV-725', 'INV-1057', 'INV-1269')
    GROUP BY ip.investor_id, ip.investor_name
    HAVING 
        COUNT(DISTINCT CASE WHEN cf.amount IS NOT NULL THEN 1 END) > 0 AND
        COUNT(DISTINCT CASE WHEN sa.total_investment IS NOT NULL THEN 1 END) > 0 AND
        COUNT(DISTINCT CASE WHEN sr.new_allocation_pct IS NOT NULL THEN 1 END) > 0 AND
        COUNT(DISTINCT CASE WHEN ph.risk_score IS NOT NULL THEN 1 END) > 0
),
normalized_components AS (
    SELECT 
        investor_id,
        investor_name,
        net_cash_flow,
        total_sector_investment,
        allocation_shift,
        risk_score,
        -- Measure: normalized_net_cash_flow
        (net_cash_flow - MIN(net_cash_flow) OVER ()) / NULLIF(MAX(net_cash_flow) OVER () - MIN(net_cash_flow) OVER (), 0) AS normalized_net_cash_flow,
        -- Measure: normalized_total_sector_investment
        (total_sector_investment - MIN(total_sector_investment) OVER ()) / NULLIF(MAX(total_sector_investment) OVER () - MIN(total_sector_investment) OVER (), 0) AS normalized_total_sector_investment,
        -- Measure: normalized_allocation_shift
        (allocation_shift - MIN(allocation_shift) OVER ()) / NULLIF(MAX(allocation_shift) OVER () - MIN(allocation_shift) OVER (), 0) AS normalized_allocation_shift,
        -- Measure: normalized_risk_score
        (risk_score - MIN(risk_score) OVER ()) / NULLIF(MAX(risk_score) OVER () - MIN(risk_score) OVER (), 0) AS normalized_risk_score
    FROM aggregated_components
)
SELECT 
    investor_id,
    investor_name,
    -- Measure: composite_score
    100 * ((normalized_net_cash_flow + normalized_total_sector_investment + normalized_allocation_shift + normalized_risk_score) / 4) AS composite_score
FROM normalized_components
ORDER BY composite_score DESC, investor_id
LIMIT 10;
