  SELECT investor_id, SUM(new_allocation_pct) AS total_scenario_allocation_shift
  FROM ATOM_EVENT_SCENARIO_REBALANCING_001
  WHERE investor_id IN ('INV-881', 'INV-1121', 'INV-796', 'INV-121', 'INV-053', 'INV-1450', 'INV-133', 'INV-841', 'INV-068', 'INV-794')
  GROUP BY investor_id
),
risk_by_investor AS (
  SELECT investor_id, AVG(risk_score) AS risk_score
  FROM ATOM_ENTITY_PORTFOLIO_HEALTH_001
  WHERE investor_id IN ('INV-881', 'INV-1121', 'INV-796', 'INV-121', 'INV-053', 'INV-1450', 'INV-133', 'INV-841', 'INV-068', 'INV-794')
  GROUP BY investor_id
),
investor_components AS (
  SELECT 
    inv.investor_id,
    cf.net_cash_flow,
    asft.total_scenario_allocation_shift,
    r.risk_score
  FROM ATOM_ENTITY_INVESTOR_PROFILE_001 inv
  INNER JOIN cash_flow_by_investor cf ON inv.investor_id = cf.investor_id
  INNER JOIN allocation_shift_by_investor asft ON inv.investor_id = asft.investor_id
  INNER JOIN risk_by_investor r ON inv.investor_id = r.investor_id
),
min_max_values AS (
  SELECT 
    MIN(net_cash_flow) AS min_net_cash_flow,
    MAX(net_cash_flow) AS max_net_cash_flow,
    MIN(total_scenario_allocation_shift) AS min_total_scenario_allocation_shift,
    MAX(total_scenario_allocation_shift) AS max_total_scenario_allocation_shift,
    MIN(risk_score) AS min_risk_score,
    MAX(risk_score) AS max_risk_score
  FROM investor_components
),
normalized_components AS (
  SELECT 
    ic.investor_id,
    CASE 
      WHEN mm.max_net_cash_flow - mm.min_net_cash_flow = 0 THEN 0
      ELSE (ic.net_cash_flow - mm.min_net_cash_flow) / (mm.max_net_cash_flow - mm.min_net_cash_flow)
    END AS normalized_net_cash_flow,
    CASE 
      WHEN mm.max_total_scenario_allocation_shift - mm.min_total_scenario_allocation_shift = 0 THEN 0
      ELSE (ic.total_scenario_allocation_shift - mm.min_total_scenario_allocation_shift) / (mm.max_total_scenario_allocation_shift - mm.min_total_scenario_allocation_shift)
    END AS normalized_total_scenario_allocation_shift,
    CASE 
      WHEN mm.max_risk_score - mm.min_risk_score = 0 THEN 0
      ELSE (ic.risk_score - mm.min_risk_score) / (mm.max_risk_score - mm.min_risk_score)
    END AS normalized_risk_score
  FROM investor_components ic
  CROSS JOIN min_max_values mm
)
SELECT 
  investor_id,
  100 * ((normalized_net_cash_flow + normalized_total_scenario_allocation_shift + normalized_risk_score) / 3) AS composite_score
FROM normalized_components
ORDER BY composite_score DESC, investor_id
LIMIT 10

