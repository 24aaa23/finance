[SQL GENERATE] Generated SQL: WITH investor_risk AS (
  SELECT DISTINCT "investor_id", "risk_tolerance"
  FROM "ATOM_ENTITY_INVESTOR_PROFILE_001"
),
per_investor_holding_sum AS (
  SELECT "investor_id", SUM("current_value") AS total_holding_value
  FROM "ATOM_ENTITY_PORTFOLIO_HOLDING_001"
  GROUP BY "investor_id"
),
per_investor_return_avg AS (
  SELECT "investor_id", AVG("returns_pct") AS avg_return_per_investor
  FROM "ATOM_ENTITY_PORTFOLIO_HOLDING_001"
  WHERE "cost" > 0 AND "current_value" > 0
  GROUP BY "investor_id"
),
per_investor_sector_sum AS (
  SELECT "investor_id", SUM("total_investment") AS total_sector_investment
  FROM "ATOM_ENTITY_SECTOR_ALLOCATION_001"
