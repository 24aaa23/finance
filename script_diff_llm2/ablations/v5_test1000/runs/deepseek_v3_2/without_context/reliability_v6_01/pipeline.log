),
avg_goal_shortfall_cte AS (
    SELECT
        investor_id,
        AVG(shortfall) AS avg_goal_shortfall
    FROM
        ATOM_ENTITY_INVESTMENT_GOAL_001
    GROUP BY
        investor_id
),
-- Join all components (inner join ensures all 4 components)
combined_components AS (
    SELECT
        ip.investor_id,
        nc.net_cash_flow,
        thg.total_holding_gain,
        rc.risk_score,
        ags.avg_goal_shortfall
    FROM
        ATOM_ENTITY_INVESTOR_PROFILE_001 ip
        INNER JOIN net_cash_flow_cte nc ON ip.investor_id = nc.investor_id
        INNER JOIN total_holding_gain_cte thg ON ip.investor_id = thg.investor_id
        INNER JOIN risk_score_cte rc ON ip.investor_id = rc.investor_id
        INNER JOIN avg_goal_shortfall_cte ags ON ip.investor_id = ags.investor_id
),
-- Min-max normalize each component
normalized_components AS (
    SELECT
        investor_id,
        net_cash_flow,
        total_holding_gain,
        risk_score,
        avg_goal_shortfall,
        (net_cash_flow - MIN(net_cash_flow) OVER ()) / 
            (MAX(net_cash_flow) OVER () - MIN(net_cash_flow) OVER ()) AS net_cash_flow_norm,
        (total_holding_gain - MIN(total_holding_gain) OVER ()) / 
            (MAX(total_holding_gain) OVER () - MIN(total_holding_gain) OVER ()) AS total_holding_gain_norm,
        (risk_score - MIN(risk_score) OVER ()) / 
            (MAX(risk_score) OVER () - MIN(risk_score) OVER ()) AS risk_score_norm,
        1 - ((avg_goal_shortfall - MIN(avg_goal_shortfall) OVER ()) / 
