[SQL GENERATE] Generated SQL: WITH net_cash_flow_by_investor AS (
    SELECT
        investor_id,
        SUM(amount) AS net_cash_flow
    FROM ATOM_EVENT_CASH_FLOW_001
    GROUP BY investor_id
), total_scenario_allocation_shift_by_investor AS (
    SELECT
        investor_id,
        SUM(new_allocation_pct - current_allocation_pct) AS total_scenario_allocation_shift
    FROM ATOM_EVENT_SCENARIO_REBALANCING_001
    GROUP BY investor_id
), combined_components AS (
    SELECT
        ncf.investor_id,
        ncf.net_cash_flow,
        tsas.total_scenario_allocation_shift
    FROM net_cash_flow_by_investor ncf
    INNER JOIN total_scenario_allocation_shift_by_investor tsas
        ON ncf.investor_id = tsas.investor_id
), normalized_components AS (
    SELECT
        investor_id,
        net_cash_flow,
        total_scenario_allocation_shift,
        (
            (
                net_cash_flow - MIN(net_cash_flow) OVER ()
            ) / (
                MAX(net_cash_flow) OVER () - MIN(net_cash_flow) OVER ()
            )
        ) AS normalized_net_cash_flow,
        (
            (
                total_scenario_allocation_shift - MIN(total_scenario_allocation_shift) OVER ()
            ) / (
                MAX(total_scenario_allocation_shift) OVER () - MIN(total_scenario_allocation_shift) OVER ()
            )
        ) AS normalized_total_scenario_allocation_shift
    FROM combined_components
), ranked AS (
    SELECT
        investor_id,
        100.0 * (
            (normalized_net_cash_flow + normalized_total_scenario_allocation_shift) / 2.0
        ) AS composite_score,
        net_cash_flow,
        total_scenario_allocation_shift
    FROM normalized_components
    ORDER BY
        composite_score DESC,
        investor_id
    LIMIT 10
)
SELECT
    investor_id,
    composite_score,
