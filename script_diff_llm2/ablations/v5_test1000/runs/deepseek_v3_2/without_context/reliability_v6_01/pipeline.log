      COALESCE(s.risk_score, 0) AS risk_score,
      COALESCE(g.avg_goal_shortfall, 0) AS avg_goal_shortfall
    FROM base b
    INNER JOIN net_cash_flow_cte n ON b.investor_id = n.investor_id
    INNER JOIN total_rebalance_amount_cte r ON b.investor_id = r.investor_id
    INNER JOIN risk_score_cte s ON b.investor_id = s.investor_id
    INNER JOIN avg_goal_shortfall_cte g ON b.investor_id = g.investor_id
  ),
