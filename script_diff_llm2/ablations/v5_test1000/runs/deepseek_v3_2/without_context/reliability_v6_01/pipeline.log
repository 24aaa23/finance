[SQL GENERATE] Generated SQL: WITH 
  holding_aggregates AS (
    SELECT
      investor_id,
      SUM(current_value) AS total_holding_value
    FROM ATOM_ENTITY_PORTFOLIO_HOLDING_001
    GROUP BY investor_id
  ),
  return_filtered AS (
    SELECT
      investor_id,
