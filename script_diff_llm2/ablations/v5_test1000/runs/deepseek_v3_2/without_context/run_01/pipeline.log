PREFIX wm: <https://wealth.example.org/ontology/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?investorId
WHERE {
  ?investor rdf:type wm:Investor .
  ?investor wm:riskTolerance "Aggressive" .
  ?investor wm:investorId ?investorId .

  ?ph rdf:type wm:PortfolioHealth .
  ?ph wm:healthOfInvestor ?investor .
  ?ph wm:riskScore ?riskScore .
  FILTER (xsd:decimal(?riskScore) > 75)

  {
    SELECT ?investor (COUNT(?goal) AS ?has_underfunded_goal)
    WHERE {
      ?goal rdf:type wm:InvestmentGoal .
      ?goal wm:belongsToInvestor ?investor .
      ?goal wm:shortfall ?shortfall .
      FILTER (xsd:decimal(?shortfall) > 0)
    }
    GROUP BY ?investor
  }
  FILTER (?has_underfunded_goal > 0)
}

