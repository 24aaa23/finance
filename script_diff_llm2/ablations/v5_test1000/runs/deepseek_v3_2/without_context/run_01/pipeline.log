[SQL GENERATE] Generated SQL: WITH investor_base AS (
    SELECT "investor_id", MAX("time_horizon") AS "time_horizon"
    FROM "ATOM_ENTITY_INVESTOR_PROFILE_001"
    GROUP BY "investor_id"
),
cash_flow_per_investor AS (
    SELECT "investor_id", SUM("amount") AS "cash_flow_sum"
    FROM "ATOM_EVENT_CASH_FLOW_001"
    GROUP BY "investor_id"
),
goal_progress_per_investor AS (
    SELECT "investor_id", AVG("progress_pct") AS "goal_progress_avg"
    FROM "ATOM_ENTITY_INVESTMENT_GOAL_001"
    GROUP BY "investor_id"
),
risk_score_per_investor AS (
    SELECT "investor_id", AVG("risk_score") AS "risk_score_avg"
    FROM "ATOM_ENTITY_PORTFOLIO_HEALTH_001"
    GROUP BY "investor_id"
),
grouped_metrics AS (
    SELECT 
        investor_base."time_horizon",
        AVG(COALESCE(cash_flow_per_investor."cash_flow_sum", 0)) AS "avg_net_cash_flow_per_investor",
        AVG(goal_progress_per_investor."goal_progress_avg") AS "avg_goal_progress_per_investor",
        AVG(risk_score_per_investor."risk_score_avg") AS "avg_risk_score"
    FROM investor_base
    LEFT JOIN cash_flow_per_investor ON investor_base."investor_id" = cash_flow_per_investor."investor_id"
    LEFT JOIN goal_progress_per_investor ON investor_base."investor_id" = goal_progress_per_investor."investor_id"
    LEFT JOIN risk_score_per_investor ON investor_base."investor_id" = risk_score_per_investor."investor_id"
    GROUP BY investor_base."time_horizon"
)
SELECT 
    "time_horizon",
    "avg_net_cash_flow_per_investor",
    "avg_goal_progress_per_investor",
    "avg_risk_score"
FROM grouped_metrics;
