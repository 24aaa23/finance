[SQL GENERATE] Generated SQL: WITH net_cash_flow_cte AS (
  SELECT investor_id, SUM(amount) AS net_cash_flow
  FROM ATOM_EVENT_CASH_FLOW_001
  GROUP BY investor_id
),
total_holding_gain_cte AS (
  SELECT investor_id, SUM(current_value - cost) AS total_holding_gain
  FROM ATOM_ENTITY_PORTFOLIO_HOLDING_001
  WHERE cost > 0 AND current_value > 0
  GROUP BY investor_id
),
total_scenario_allocation_shift_cte AS (
  SELECT investor_id, SUM(new_allocation_pct - current_allocation_pct) AS total_scenario_allocation_shift
  FROM ATOM_EVENT_SCENARIO_REBALANCING_001
  GROUP BY investor_id
),
avg_goal_shortfall_cte AS (
  SELECT investor_id, AVG(shortfall) AS avg_goal_shortfall
  FROM ATOM_ENTITY_INVESTMENT_GOAL_001
  GROUP BY investor_id
),
components AS (
  SELECT 
    ip.investor_id,
    COALESCE(ncf.net_cash_flow, 0) AS net_cash_flow,
    COALESCE(thg.total_holding_gain, 0) AS total_holding_gain,
    COALESCE(tsas.total_scenario_allocation_shift, 0) AS total_scenario_allocation_shift,
    COALESCE(ags.avg_goal_shortfall, 0) AS avg_goal_shortfall
  FROM ATOM_ENTITY_INVESTOR_PROFILE_001 ip
  INNER JOIN net_cash_flow_cte ncf ON ip.investor_id = ncf.investor_id
  INNER JOIN total_holding_gain_cte thg ON ip.investor_id = thg.investor_id
  INNER JOIN total_scenario_allocation_shift_cte tsas ON ip.investor_id = tsas.investor_id
  INNER JOIN avg_goal_shortfall_cte ags ON ip.investor_id = ags.investor_id
),
normalized_components AS (
  SELECT 
    investor_id,
    net_cash_flow,
    total_holding_gain,
    total_scenario_allocation_shift,
    avg_goal_shortfall,
    CASE 
      WHEN (MAX(net_cash_flow) OVER () - MIN(net_cash_flow) OVER ()) = 0 THEN 0 
      ELSE (net_cash_flow - MIN(net_cash_flow) OVER ()) / (MAX(net_cash_flow) OVER () - MIN(net_cash_flow) OVER ()) 
    END AS normalized_net_cash_flow,
    CASE 
      WHEN (MAX(total_holding_gain) OVER () - MIN(total_holding_gain) OVER ()) = 0 THEN 0 
      ELSE (total_holding_gain - MIN(total_holding_gain) OVER ()) / (MAX(total_holding_gain) OVER () - MIN(total_holding_gain) OVER ()) 
    END AS normalized_total_holding_gain,
    CASE 
      WHEN (MAX(total_scenario_allocation_shift) OVER () - MIN(total_scenario_allocation_shift) OVER ()) = 0 THEN 0 
      ELSE (total_scenario_allocation_shift - MIN(total_scenario_allocation_shift) OVER ()) / (MAX(total_scenario_allocation_shift) OVER () - MIN(total_scenario_allocation_shift) OVER ()) 
    END AS normalized_total_scenario_allocation_shift,
    CASE 
      WHEN (MAX(avg_goal_shortfall) OVER () - MIN(avg_goal_shortfall) OVER ()) = 0 THEN 0 
      ELSE (avg_goal_shortfall - MIN(avg_goal_shortfall) OVER ()) / (MAX(avg_goal_shortfall) OVER () - MIN(avg_goal_shortfall) OVER ()) 
    END AS normalized_avg_goal_shortfall
  FROM components
)
SELECT 
  investor_id,
  100 * ((normalized_net_cash_flow + normalized_total_holding_gain + normalized_total_scenario_allocation_shift + (1 - normalized_avg_goal_shortfall)) / 4) AS composite_score
FROM normalized_components
ORDER BY composite_score DESC, investor_id
LIMIT 10;

