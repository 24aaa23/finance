    FROM "ATOM_ENTITY_SECTOR_ALLOCATION_001" 
    GROUP BY "investor_id"
),
entity_scenario_allocation_shift AS (
    SELECT "investor_id", 
           AVG("new_allocation_pct" - "current_allocation_pct") AS "investor_avg_scenario_allocation_shift"
    FROM "ATOM_EVENT_SCENARIO_REBALANCING_001" 
    GROUP BY "investor_id"
),
grouped_result AS (
    SELECT 
        profile_groups."risk_tolerance" AS "risk_tolerance",
        AVG(entity_net_cash_flow."investor_net_cash_flow_total") AS "avg_net_cash_flow",
