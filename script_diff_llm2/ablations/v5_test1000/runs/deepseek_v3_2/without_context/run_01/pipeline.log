  FROM ATOM_ENTITY_INVESTMENT_GOAL_001
),
combined_metrics AS (
  SELECT
    b.investor_id,
    COALESCE(c.net_cash_flow, 0) AS net_cash_flow,
    COALESCE(r.total_rebalance_amount, 0) AS total_rebalance_amount,
    g.avg_goal_shortfall AS avg_goal_shortfall,
    (COALESCE(c.net_cash_flow, 0) + COALESCE(r.total_rebalance_amount, 0) - g.avg_goal_shortfall) AS composite_score
  FROM base_investors b
  JOIN cash_flow_agg c ON b.investor_id = c.investor_id
  JOIN rebalancing_agg r ON b.investor_id = r.investor_id
  JOIN goal_agg g ON b.investor_id = g.investor_id
)
