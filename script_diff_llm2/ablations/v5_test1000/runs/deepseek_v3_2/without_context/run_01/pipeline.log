[SQL GENERATE] Generated SQL: WITH 
    investor_risk_tolerance AS (
        SELECT DISTINCT investor_id, risk_tolerance
        FROM ATOM_ENTITY_INVESTOR_PROFILE_001
    ),
    cash_flow_by_investor AS (
        SELECT investor_id, 
               SUM(amount) AS investor_total_net_cash_flow,
               AVG(amount) AS investor_avg_cash_amount
        FROM ATOM_EVENT_CASH_FLOW_001
        GROUP BY investor_id
    ),
    holding_value_by_investor AS (
        SELECT investor_id,
               SUM(current_value) AS investor_total_holding_value
        FROM ATOM_ENTITY_PORTFOLIO_HOLDING_001
        GROUP BY investor_id
    ),
    rebalance_by_investor AS (
        SELECT investor_id,
               SUM(amount) AS investor_total_rebalance_amount
        FROM ATOM_EVENT_REBALANCING_ACTION_001
        GROUP BY investor_id
    ),
    risk_score_by_investor AS (
        SELECT investor_id,
               AVG(risk_score) AS investor_avg_risk_score
        FROM ATOM_ENTITY_PORTFOLIO_HEALTH_001
        GROUP BY investor_id
    )
SELECT 
    ir.risk_tolerance AS risk_tolerance,
    AVG(cf.investor_total_net_cash_flow) AS avg_net_cash_flow,
    AVG(cf.investor_avg_cash_amount) AS avg_cash_flow_amount,
    AVG(hv.investor_total_holding_value) AS avg_total_holding_value,
    AVG(rb.investor_total_rebalance_amount) AS avg_total_rebalance_amount,
    AVG(rs.investor_avg_risk_score) AS avg_risk_score
FROM investor_risk_tolerance AS ir
LEFT JOIN cash_flow_by_investor AS cf ON ir.investor_id = cf.investor_id
LEFT JOIN holding_value_by_investor AS hv ON ir.investor_id = hv.investor_id
LEFT JOIN rebalance_by_investor AS rb ON ir.investor_id = rb.investor_id
LEFT JOIN risk_score_by_investor AS rs ON ir.investor_id = rs.investor_id
GROUP BY ir.risk_tolerance
ORDER BY ir.risk_tolerance;
