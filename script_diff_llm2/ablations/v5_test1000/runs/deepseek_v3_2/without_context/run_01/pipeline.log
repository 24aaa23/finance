[SQL GENERATE] Generated SQL: WITH
pre_net_cash_flow AS (
  SELECT investor_id, SUM(amount) AS net_cash_flow
  FROM ATOM_EVENT_CASH_FLOW_001
  GROUP BY investor_id
),
pre_total_rebalance_amount AS (
  SELECT investor_id, SUM(amount) AS total_rebalance_amount
  FROM ATOM_EVENT_REBALANCING_ACTION_001
  GROUP BY investor_id
),
pre_total_sector_investment AS (
  SELECT investor_id, SUM(total_investment) AS total_sector_investment
  FROM ATOM_ENTITY_SECTOR_ALLOCATION_001
  GROUP BY investor_id
),
pre_risk_score AS (
  SELECT investor_id, MAX(risk_score) AS risk_score
  FROM ATOM_ENTITY_PORTFOLIO_HEALTH_001
  GROUP BY investor_id
),
all_measures AS (
  SELECT
    ip.investor_id,
    ncf.net_cash_flow,
    tra.total_rebalance_amount,
    tsi.total_sector_investment,
    rs.risk_score
  FROM ATOM_ENTITY_INVESTOR_PROFILE_001 ip
  INNER JOIN pre_net_cash_flow ncf ON ip.investor_id = ncf.investor_id
  INNER JOIN pre_total_rebalance_amount tra ON ip.investor_id = tra.investor_id
  INNER JOIN pre_total_sector_investment tsi ON ip.investor_id = tsi.investor_id
  INNER JOIN pre_risk_score rs ON ip.investor_id = rs.investor_id
),
norm_base AS (
  SELECT
    investor_id,
    net_cash_flow,
    total_rebalance_amount,
    total_sector_investment,
    risk_score,
    MIN(net_cash_flow) OVER () AS min_net_cash_flow,
    MAX(net_cash_flow) OVER () AS max_net_cash_flow,
    MIN(total_rebalance_amount) OVER () AS min_total_rebalance_amount,
    MAX(total_rebalance_amount) OVER () AS max_total_rebalance_amount,
    MIN(total_sector_investment) OVER () AS min_total_sector_investment,
    MAX(total_sector_investment) OVER () AS max_total_sector_investment,
    MIN(risk_score) OVER () AS min_risk_score,
    MAX(risk_score) OVER () AS max_risk_score
  FROM all_measures
)
SELECT
  investor_id,
  CASE
    WHEN max_net_cash_flow - min_net_cash_flow != 0
    THEN (net_cash_flow - min_net_cash_flow) / (max_net_cash_flow - min_net_cash_flow)
    ELSE 0
  END AS normalized_net_cash_flow,
  CASE
    WHEN max_total_rebalance_amount - min_total_rebalance_amount != 0
    THEN (total_rebalance_amount - min_total_rebalance_amount) / (max_total_rebalance_amount - min_total_rebalance_amount)
    ELSE 0
  END AS normalized_total_rebalance_amount,
  CASE
    WHEN max_total_sector_investment - min_total_sector_investment != 0
    THEN (total_sector_investment - min_total_sector_investment) / (max_total_sector_investment - min_total_sector_investment)
    ELSE 0
  END AS normalized_total_sector_investment,
  CASE
    WHEN max_risk_score - min_risk_score != 0
    THEN (risk_score - min_risk_score) / (max_risk_score - min_risk_score)
    ELSE 0
  END AS normalized_risk_score,
  ROUND(100.0 * (
    (CASE WHEN max_net_cash_flow - min_net_cash_flow != 0 THEN (net_cash_flow - min_net_cash_flow) / (max_net_cash_flow - min_net_cash_flow) ELSE 0 END) +
    (CASE WHEN max_total_rebalance_amount - min_total_rebalance_amount != 0 THEN (total_rebalance_amount - min_total_rebalance_amount) / (max_total_rebalance_amount - min_total_rebalance_amount) ELSE 0 END) +
    (CASE WHEN max_total_sector_investment - min_total_sector_investment != 0 THEN (total_sector_investment - min_total_sector_investment) / (max_total_sector_investment - min_total_sector_investment) ELSE 0 END) +
    (CASE WHEN max_risk_score - min_risk_score != 0 THEN (risk_score - min_risk_score) / (max_risk_score - min_risk_score) ELSE 0 END)
  ) / 4, 2) AS composite_score
FROM norm_base
ORDER BY composite_score DESC, investor_id
LIMIT 10
