    ip.investor_id,
    n.net_cash_flow,
    h.total_holding_gain,
    r.total_rebalance_amount,
    s.risk_score
  FROM ATOM_ENTITY_INVESTOR_PROFILE_001 ip
  INNER JOIN net_cash_flow_cte n ON ip.investor_id = n.investor_id
  INNER JOIN total_holding_gain_cte h ON ip.investor_id = h.investor_id
  INNER JOIN total_rebalance_amount_cte r ON ip.investor_id = r.investor_id
  INNER JOIN risk_score_cte s ON ip.investor_id = s.investor_id
),
normalized_components AS (
  SELECT
    investor_id,
    net_cash_flow,
    total_holding_gain,
    total_rebalance_amount,
    risk_score,
    CASE
      WHEN MAX(net_cash_flow) OVER () - MIN(net_cash_flow) OVER () = 0 THEN 0
      ELSE (net_cash_flow - MIN(net_cash_flow) OVER ()) / (MAX(net_cash_flow) OVER () - MIN(net_cash_flow) OVER ())
    END AS net_cash_flow_norm,
    CASE
      WHEN MAX(total_holding_gain) OVER () - MIN(total_holding_gain) OVER () = 0 THEN 0
      ELSE (total_holding_gain - MIN(total_holding_gain) OVER ()) / (MAX(total_holding_gain) OVER () - MIN(total_holding_gain) OVER ())
    END AS total_holding_gain_norm,
    CASE
