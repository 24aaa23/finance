[SQL GENERATE] Generated SQL: WITH cte_investors AS (
  SELECT 
    ip.investor_id AS investor_id,
    COALESCE(SUM(cf.amount), 0) AS net_cash_flow,
    COALESCE(SUM(ra.amount), 0) AS total_rebalance_amount,
    COALESCE(AVG(ph.risk_score), 0) AS risk_score,
    COALESCE(AVG(ig.shortfall), 0) AS avg_goal_shortfall
  FROM ATOM_ENTITY_INVESTOR_PROFILE_001 ip
  LEFT JOIN ATOM_EVENT_CASH_FLOW_001 cf ON ip.investor_id = cf.investor_id
  LEFT JOIN ATOM_EVENT_REBALANCING_ACTION_001 ra ON ip.investor_id = ra.investor_id
  LEFT JOIN ATOM_ENTITY_PORTFOLIO_HEALTH_001 ph ON ip.investor_id = ph.investor_id
  LEFT JOIN ATOM_ENTITY_INVESTMENT_GOAL_001 ig ON ip.investor_id = ig.investor_id
  GROUP BY ip.investor_id
),
cte_ranges AS (
  SELECT 
    MIN(net_cash_flow) AS min_net_cash_flow,
    MAX(net_cash_flow) AS max_net_cash_flow,
    MIN(total_rebalance_amount) AS min_total_rebalance_amount,
    MAX(total_rebalance_amount) AS max_total_rebalance_amount,
    MIN(risk_score) AS min_risk_score,
    MAX(risk_score) AS max_risk_score,
    MIN(avg_goal_shortfall) AS min_avg_goal_shortfall,
    MAX(avg_goal_shortfall) AS max_avg_goal_shortfall
  FROM cte_investors
),
cte_normalized AS (
  SELECT 
    i.investor_id,
    CASE 
      WHEN (r.max_net_cash_flow - r.min_net_cash_flow) = 0 THEN 0
      ELSE (i.net_cash_flow - r.min_net_cash_flow) / (r.max_net_cash_flow - r.min_net_cash_flow)
    END AS normalized_net_cash_flow,
    CASE 
      WHEN (r.max_total_rebalance_amount - r.min_total_rebalance_amount) = 0 THEN 0
      ELSE (i.total_rebalance_amount - r.min_total_rebalance_amount) / (r.max_total_rebalance_amount - r.min_total_rebalance_amount)
    END AS normalized_total_rebalance_amount,
    CASE 
      WHEN (r.max_risk_score - r.min_risk_score) = 0 THEN 0
      ELSE (i.risk_score - r.min_risk_score) / (r.max_risk_score - r.min_risk_score)
    END AS normalized_risk_score,
    CASE 
      WHEN (r.max_avg_goal_shortfall - r.min_avg_goal_shortfall) = 0 THEN 0
      ELSE (i.avg_goal_shortfall - r.min_avg_goal_shortfall) / (r.max_avg_goal_shortfall - r.min_avg_goal_shortfall)
    END AS normalized_avg_goal_shortfall
  FROM cte_investors i
  CROSS JOIN cte_ranges r
)
SELECT 
  investor_id,
  ROUND(100 * (
    (normalized_net_cash_flow + normalized_total_rebalance_amount + normalized_risk_score + (1 - normalized_avg_goal_shortfall)) / 4
  ), 2) AS composite_score
FROM cte_normalized
WHERE investor_id IS NOT NULL
ORDER BY composite_score DESC, investor_id
LIMIT 10
