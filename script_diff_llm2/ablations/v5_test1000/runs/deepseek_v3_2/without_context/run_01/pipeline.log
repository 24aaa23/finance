[SQL GENERATE] Generated SQL: WITH holding_metrics AS (
    SELECT
        investor_id,
        CASE
            WHEN cost IS NOT NULL AND current_value IS NOT NULL THEN holding_id
            ELSE NULL
        END AS valid_holding_id,
        SUM(current_value) AS investor_total_holding_value,
        SUM(
            CASE
                WHEN cost IS NOT NULL AND current_value IS NOT NULL THEN returns_pct
                ELSE 0
            END
        ) AS investor_sum_returns_pct,
        COUNT(
            CASE
                WHEN cost IS NOT NULL AND current_value IS NOT NULL THEN holding_id
            END
        ) AS investor_valid_holding_count
    FROM
        ATOM_ENTITY_PORTFOLIO_HOLDING_001
    GROUP BY
        investor_id
),
health_metrics AS (
    SELECT
        investor_id,
        risk_score
    FROM
        ATOM_ENTITY_PORTFOLIO_HEALTH_001
),
per_investor AS (
    SELECT
        ip.investor_id,
        ip.risk_tolerance,
        COALESCE(hm.investor_total_holding_value, 0) AS investor_total_holding_value,
        COALESCE(hm.investor_valid_holding_count, 0) AS investor_valid_holding_count,
        COALESCE(hm.investor_sum_returns_pct, 0) AS investor_sum_returns_pct,
        COALESCE(h.risk_score, 0) AS investor_risk_score
    FROM
        ATOM_ENTITY_INVESTOR_PROFILE_001 ip
    LEFT JOIN
        holding_metrics hm ON ip.investor_id = hm.investor_id
    LEFT JOIN
        health_metrics h ON ip.investor_id = h.investor_id
)
SELECT
    risk_tolerance,
    COUNT(DISTINCT investor_id) AS investor_count,
    AVG(investor_total_holding_value) AS total_holding_value,
    AVG(investor_sum_returns_pct) AS sum_returns_pct,
    AVG(investor_risk_score) AS risk_score
FROM
    per_investor
WHERE
    risk_tolerance IS NOT NULL
GROUP BY
    risk_tolerance
ORDER BY
    risk_tolerance;
