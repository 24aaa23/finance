[SQL GENERATE] Generated SQL: WITH investor_net_cash_flow AS (
  SELECT investor_id, SUM(amount) AS net_cash_flow_per_investor
  FROM ATOM_EVENT_CASH_FLOW_001
  GROUP BY investor_id
),
investor_avg_cash_flow_amount AS (
  SELECT investor_id, AVG(amount) AS avg_cash_flow_per_investor
  FROM ATOM_EVENT_CASH_FLOW_001
  GROUP BY investor_id
),
investor_total_holding_value AS (
  SELECT investor_id, SUM(current_value) AS total_holding_per_investor
  FROM ATOM_ENTITY_PORTFOLIO_HOLDING_001
  GROUP BY investor_id
),
investor_scenario_allocation_shift AS (
  SELECT investor_id, AVG(new_allocation_pct - current_allocation_pct) AS avg_scenario_shift_per_investor
  FROM ATOM_EVENT_SCENARIO_REBALANCING_001
  GROUP BY investor_id
),
investor_goal_progress AS (
  SELECT investor_id, AVG(progress_pct) AS avg_progress_per_investor
  FROM ATOM_ENTITY_INVESTMENT_GOAL_001
  GROUP BY investor_id
)
SELECT
  risk_tolerance,
  GROUP_CONCAT(DISTINCT investor_profile.investor_id) AS investor_ids,
  AVG(net_cash_flow.net_cash_flow_per_investor) AS avg_net_cash_flow,
  AVG(avg_cash_flow.avg_cash_flow_per_investor) AS avg_cash_flow_amount,
  AVG(total_holdings.total_holding_per_investor) AS avg_total_holding_value,
  AVG(scenario_shift.avg_scenario_shift_per_investor) AS avg_scenario_allocation_shift,
  AVG(goal_progress.avg_progress_per_investor) AS avg_goal_progress
FROM ATOM_ENTITY_INVESTOR_PROFILE_001 AS investor_profile
LEFT JOIN investor_net_cash_flow AS net_cash_flow ON investor_profile.investor_id = net_cash_flow.investor_id
LEFT JOIN investor_avg_cash_flow_amount AS avg_cash_flow ON investor_profile.investor_id = avg_cash_flow.investor_id
LEFT JOIN investor_total_holding_value AS total_holdings ON investor_profile.investor_id = total_holdings.investor_id
LEFT JOIN investor_scenario_allocation_shift AS scenario_shift ON investor_profile.investor_id = scenario_shift.investor_id
LEFT JOIN investor_goal_progress AS goal_progress ON investor_profile.investor_id = goal_progress.investor_id
GROUP BY risk_tolerance;
