[SQL GENERATE] Generated SQL: WITH net_cash_flow_agg AS (
  SELECT
    investor_id,
    SUM(amount) AS net_cash_flow
  FROM ATOM_EVENT_CASH_FLOW_001
  GROUP BY investor_id
),
total_holding_gain_agg AS (
  SELECT
    investor_id,
    SUM(current_value - cost) AS total_holding_gain
  FROM ATOM_ENTITY_PORTFOLIO_HOLDING_001
  WHERE cost > 0 AND current_value > 0
  GROUP BY investor_id
),
total_rebalance_amount_agg AS (
  SELECT
    investor_id,
    SUM(amount) AS total_rebalance_amount
  FROM ATOM_EVENT_REBALANCING_ACTION_001
  GROUP BY investor_id
),
risk_score_agg AS (
  SELECT
    investor_id,
    MAX(risk_score) AS risk_score
  FROM ATOM_ENTITY_PORTFOLIO_HEALTH_001
  GROUP BY investor_id
),
investor_components AS (
  SELECT
    ip.investor_id,
    COALESCE(n.net_cash_flow, 0) AS net_cash_flow,
    COALESCE(h.total_holding_gain, 0) AS total_holding_gain,
    COALESCE(r.total_rebalance_amount, 0) AS total_rebalance_amount,
    COALESCE(s.risk_score, 0) AS risk_score
  FROM ATOM_ENTITY_INVESTOR_PROFILE_001 ip
  INNER JOIN net_cash_flow_agg n ON ip.investor_id = n.investor_id
  INNER JOIN total_holding_gain_agg h ON ip.investor_id = h.investor_id
  INNER JOIN total_rebalance_amount_agg t ON ip.investor_id = t.investor_id
  INNER JOIN risk_score_agg s ON ip.investor_id = s.investor_id
),
normalized_components AS (
  SELECT
    investor_id,
    net_cash_flow,
    total_holding_gain,
    total_rebalance_amount,
    risk_score,
    (net_cash_flow - MIN(net_cash_flow) OVER ()) / (MAX(net_cash_flow) OVER () - MIN(net_cash_flow) OVER ()) AS net_cash_flow_norm,
    (total_holding_gain - MIN(total_holding_gain) OVER ()) / (MAX(total_holding_gain) OVER () - MIN(total_holding_gain) OVER ()) AS total_holding_gain_norm,
    (total_rebalance_amount - MIN(total_rebalance_amount) OVER ()) / (MAX(total_rebalance_amount) OVER () - MIN(total_rebalance_amount) OVER ()) AS total_rebalance_amount_norm,
    (risk_score - MIN(risk_score) OVER ()) / (MAX(risk_score) OVER () - MIN(risk_score) OVER ()) AS risk_score_norm
  FROM investor_components
),
composite_scores AS (
  SELECT
    investor_id,
    100 * ((net_cash_flow_norm + total_holding_gain_norm + total_rebalance_amount_norm + risk_score_norm) / 4) AS composite_score
  FROM normalized_components
)
SELECT
  investor_id,
  composite_score
FROM composite_scores
ORDER BY composite_score DESC, investor_id ASC
LIMIT 10
