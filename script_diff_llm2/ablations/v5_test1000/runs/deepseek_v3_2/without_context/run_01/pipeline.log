[SQL GENERATE] Generated SQL: WITH cash_flow_agg AS (
    SELECT
        investor_id,
        SUM(amount) AS net_cash_flow
    FROM ATOM_EVENT_CASH_FLOW_001
    GROUP BY investor_id
),
portfolio_agg AS (
    SELECT
        investor_id,
        SUM(current_value - cost) AS total_holding_gain
    FROM ATOM_ENTITY_PORTFOLIO_HOLDING_001
    WHERE cost > 0 AND current_value > 0
    GROUP BY investor_id
),
rebalance_agg AS (
    SELECT
        investor_id,
        SUM(amount) AS total_rebalance_amount
    FROM ATOM_EVENT_REBALANCING_ACTION_001
    GROUP BY investor_id
),
sector_agg AS (
    SELECT
        investor_id,
        SUM(total_investment) AS total_sector_investment
    FROM ATOM_ENTITY_SECTOR_ALLOCATION_001
    GROUP BY investor_id
),
combined AS (
    SELECT
        ip.investor_id,
        COALESCE(cf.net_cash_flow, 0) AS net_cash_flow,
        COALESCE(ph.total_holding_gain, 0) AS total_holding_gain,
        COALESCE(ra.total_rebalance_amount, 0) AS total_rebalance_amount,
        COALESCE(sa.total_sector_investment, 0) AS total_sector_investment
    FROM ATOM_ENTITY_INVESTOR_PROFILE_001 ip
    INNER JOIN cash_flow_agg cf ON ip.investor_id = cf.investor_id
    INNER JOIN portfolio_agg ph ON ip.investor_id = ph.investor_id
    INNER JOIN rebalance_agg ra ON ip.investor_id = ra.investor_id
    INNER JOIN sector_agg sa ON ip.investor_id = sa.investor_id
)
SELECT
    investor_id,
    net_cash_flow + total_holding_gain + total_rebalance_amount + total_sector_investment AS composite_score,
    net_cash_flow,
    total_holding_gain,
    total_rebalance_amount,
    total_sector_investment
FROM combined
ORDER BY composite_score DESC, investor_id
LIMIT 10;

