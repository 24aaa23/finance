       AVG(scenario_shift) AS avg_scenario_shift,
       AVG(scenario_count) AS avg_scenario_count,
       AVG(goal_progress) AS avg_goal_progress
FROM investor_metrics
GROUP BY risk_tolerance
ORDER BY risk_tolerance;
