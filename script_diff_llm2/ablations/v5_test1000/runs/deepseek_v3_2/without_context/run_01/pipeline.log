[SQL GENERATE] Generated SQL: WITH
cash_flow AS (
  SELECT 
    investor_id,
    SUM(CASE WHEN type IN ('Deposit', 'Lump Sum', 'SIP', 'Tax Refund', 'Dividend Reinvestment', 'Interest Credit') THEN amount ELSE -amount END) AS net_cash_flow
  FROM ATOM_EVENT_CASH_FLOW_001
  GROUP BY investor_id
),
rebalancing AS (
  SELECT 
    investor_id,
    SUM(amount) AS total_rebalance_amount
  FROM ATOM_EVENT_REBALANCING_ACTION_001
  GROUP BY investor_id
),
goals AS (
  SELECT 
    investor_id,
    AVG(shortfall) AS avg_goal_shortfall
  FROM ATOM_ENTITY_INVESTMENT_GOAL_001
  GROUP BY investor_id
),
combined AS (
  SELECT 
    ip.investor_id,
    COALESCE(cf.net_cash_flow, 0) AS net_cash_flow,
    COALESCE(rb.total_rebalance_amount, 0) AS total_rebalance_amount,
    COALESCE(g.avg_goal_shortfall, 0) AS avg_goal_shortfall
  FROM ATOM_ENTITY_INVESTOR_PROFILE_001 ip
  LEFT JOIN cash_flow cf ON ip.investor_id = cf.investor_id
  LEFT JOIN rebalancing rb ON ip.investor_id = rb.investor_id
  LEFT JOIN goals g ON ip.investor_id = g.investor_id
  WHERE ip.investor_id IN ('INV-042', 'INV-1122', 'INV-122', 'INV-1402', 'INV-482', 'INV-522', 'INV-602', 'INV-642', 'INV-762', 'INV-802')
)
SELECT
  investor_id,
  net_cash_flow,
  total_rebalance_amount,
  avg_goal_shortfall,
  (net_cash_flow + total_rebalance_amount - avg_goal_shortfall) AS composite_score
FROM combined
ORDER BY composite_score DESC, investor_id
LIMIT 10;
