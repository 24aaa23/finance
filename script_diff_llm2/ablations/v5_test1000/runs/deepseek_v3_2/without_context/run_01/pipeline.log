[SQL GENERATE] Generated SQL: WITH profile_groups AS (
    SELECT DISTINCT "investor_id", "risk_tolerance"
    FROM "ATOM_ENTITY_INVESTOR_PROFILE_001"
),
holdings_per_investor AS (
    SELECT "investor_id", COUNT("holding_id") AS "holdings_count"
    FROM "ATOM_ENTITY_PORTFOLIO_HOLDING_001"
    GROUP BY "investor_id"
),
rebalancing_per_investor AS (
    SELECT "investor_id", COUNT("rebalance_id") AS "rebalancing_count"
    FROM "ATOM_EVENT_REBALANCING_ACTION_001"
    GROUP BY "investor_id"
),
risk_score_per_investor AS (
    SELECT "investor_id", AVG("risk_score") AS "risk_score_avg"
    FROM "ATOM_ENTITY_PORTFOLIO_HEALTH_001"
    GROUP BY "investor_id"
),
investor_metrics AS (
    SELECT
        pg."investor_id",
        pg."risk_tolerance",
        COALESCE(h."holdings_count", 0) AS "holdings_count",
        COALESCE(r."rebalancing_count", 0) AS "rebalancing_count",
        ph."risk_score_avg"
    FROM profile_groups pg
    LEFT JOIN holdings_per_investor h ON pg."investor_id" = h."investor_id"
    LEFT JOIN rebalancing_per_investor r ON pg."investor_id" = r."investor_id"
    LEFT JOIN risk_score_per_investor ph ON pg."investor_id" = ph."investor_id"
)
SELECT
    "risk_tolerance",
    AVG("holdings_count") AS "avg_holdings_per_investor",
    AVG("rebalancing_count") AS "avg_rebalancing_actions_per_investor",
    AVG("risk_score_avg") AS "avg_risk_score"
FROM investor_metrics
GROUP BY "risk_tolerance";

