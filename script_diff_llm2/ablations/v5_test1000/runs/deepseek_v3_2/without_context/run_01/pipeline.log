[SQL GENERATE] Generated SQL: WITH
  profile_groups AS (
    SELECT DISTINCT investor_id, risk_tolerance
    FROM ATOM_ENTITY_INVESTOR_PROFILE_001
  ),
  cash_flow_sums AS (
    SELECT investor_id, SUM(amount) AS total_net_cash_flow, AVG(amount) AS avg_cash_flow_amount_per_inv
    FROM ATOM_EVENT_CASH_FLOW_001
    GROUP BY investor_id
  ),
  rebalance_sums AS (
    SELECT investor_id, SUM(amount) AS total_rebalance_amount_per_inv
    FROM ATOM_EVENT_REBALANCING_ACTION_001
    GROUP BY investor_id
  ),
  sector_investment_sums AS (
