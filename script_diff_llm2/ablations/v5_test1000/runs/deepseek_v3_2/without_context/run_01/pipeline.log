PREFIX wm: <https://wealth.example.org/ontology/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT ?investorId
WHERE {
  ?investor rdf:type wm:Investor .
  ?investor wm:riskTolerance "Conservative" .
  ?investor wm:investorId ?investorId .

  ?health rdf:type wm:PortfolioHealth .
  ?health wm:healthOfInvestor ?investor .
  ?health wm:liquidityScore ?liquidityScore .
  FILTER (xsd:decimal(?liquidityScore) < 25)

  {
    SELECT ?investor (COUNT(?holding) AS ?has_loss_making_position)
    WHERE {
      ?holding rdf:type wm:PortfolioHolding .
      ?holding wm:heldByInvestor ?investor .
      ?holding wm:cost ?cost .
      ?holding wm:currentValue ?currentValue .
      ?holding wm:returnsPct ?returnsPct .
      FILTER (xsd:decimal(?cost) > 0)
      FILTER (xsd:decimal(?currentValue) > 0)
      FILTER (xsd:decimal(?returnsPct) < 0)
    }
    GROUP BY ?investor
    HAVING (COUNT(?holding) > 0)
  }
}


