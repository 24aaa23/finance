PREFIX wm: <https://wealth.example.org/ontology/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?investorId
WHERE {
  {
    SELECT ?investorId (COUNT(?ph) AS ?has_portfolio_health) (COUNT(?sr) AS ?has_scenario_rebalancing)
    WHERE {
      ?investor a wm:Investor ;
                wm:investorId ?investorId .
      ?ph a wm:PortfolioHealth ;
          wm:healthOfInvestor ?investor .
      OPTIONAL {
        ?sr a wm:ScenarioRebalancing ;
            wm:scenarioRebalancingOfInvestor ?investor .
      }
    }
    GROUP BY ?investorId
  }
  FILTER (?has_portfolio_health > 0 && ?has_scenario_rebalancing = 0)
}

