[SQL GENERATE] Generated SQL: WITH investor_base AS (
    SELECT investor_id, risk_tolerance
    FROM ATOM_ENTITY_INVESTOR_PROFILE_001
),
holdings_per_investor AS (
    SELECT investor_id, COUNT(holding_id) AS holdings_count
    FROM ATOM_ENTITY_PORTFOLIO_HOLDING_001
    GROUP BY investor_id
),
cashflow_per_investor AS (
    SELECT investor_id, SUM(amount) AS net_cash_flow
    FROM ATOM_EVENT_CASH_FLOW_001
    GROUP BY investor_id
),
risk_per_investor AS (
    SELECT investor_id, AVG(risk_score) AS avg_risk_score
    FROM ATOM_ENTITY_PORTFOLIO_HEALTH_001
    GROUP BY investor_id
),
combined_metrics AS (
    SELECT 
        b.investor_id,
        b.risk_tolerance,
        COALESCE(h.holdings_count, 0) AS holdings_count,
        c.net_cash_flow,
        r.avg_risk_score
    FROM investor_base b
    LEFT JOIN holdings_per_investor h ON b.investor_id = h.investor_id
    LEFT JOIN cashflow_per_investor c ON b.investor_id = c.investor_id
    LEFT JOIN risk_per_investor r ON b.investor_id = r.investor_id
)
SELECT 
    risk_tolerance,
    AVG(holdings_count) AS avg_holdings_per_investor,
    AVG(net_cash_flow) AS avg_net_cash_flow_per_investor,
    AVG(avg_risk_score) AS avg_risk_score
FROM combined_metrics
GROUP BY risk_tolerance
ORDER BY risk_tolerance;
