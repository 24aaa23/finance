[SQL GENERATE] Generated SQL: WITH
  investor_segments AS (
    SELECT
      investor_id,
      segment
    FROM
      ATOM_ENTITY_INVESTOR_PROFILE_001
  ),
  cash_flow_net AS (
    SELECT
      investor_id,
      SUM(amount) AS net_cash_flow
    FROM
      ATOM_EVENT_CASH_FLOW_001
    GROUP BY
      investor_id
  ),
  cash_flow_signed AS (
    SELECT
      investor_id,
      AVG(amount) AS signed_cash_flow_amount
    FROM
      ATOM_EVENT_CASH_FLOW_001
    GROUP BY
      investor_id
  ),
  cash_flow_count_per_investor AS (
    SELECT
      investor_id,
      COALESCE(COUNT(DISTINCT cash_flow_id), 0) AS cash_flow_count
    FROM
      ATOM_EVENT_CASH_FLOW_001
    GROUP BY
      investor_id
  )
SELECT
  i.segment AS segment,
  AVG(c1.net_cash_flow) AS avg_net_cash_flow,
  AVG(c2.signed_cash_flow_amount) AS avg_signed_cash_flow_amount,
  AVG(c3.cash_flow_count) AS avg_cash_flow_count
FROM
  investor_segments i
  LEFT JOIN cash_flow_net c1 ON i.investor_id = c1.investor_id
  LEFT JOIN cash_flow_signed c2 ON i.investor_id = c2.investor_id
  LEFT JOIN cash_flow_count_per_investor c3 ON i.investor_id = c3.investor_id
GROUP BY
  i.segment
ORDER BY
  i.segment;
