PREFIX wm: <https://wealth.example.org/ontology/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT ?investorId
WHERE {
  ?investor rdf:type wm:Investor .
  ?investor wm:riskTolerance "Conservative" .
  ?investor wm:investorId ?investorId .

  ?investor wm:hasPortfolioHealth ?portfolioHealth .
  ?portfolioHealth wm:riskScore ?riskScore .
  FILTER (xsd:decimal(?riskScore) > 75) .

  ?investor wm:hasInvestmentGoal ?goal .
  ?goal wm:shortfall ?shortfall .
  FILTER (xsd:decimal(?shortfall) > 0) .

  {
    SELECT ?investor (MAX(?isLoss) AS ?hasLoss)
    WHERE {
      ?investor wm:hasHolding ?holding .
      ?holding wm:cost ?cost .
      ?holding wm:currentValue ?currentValue .
      FILTER (bound(?cost) && bound(?currentValue))
      BIND (IF(xsd:decimal(?currentValue) < xsd:decimal(?cost), true, false) AS ?isLoss)
    }
    GROUP BY ?investor
  }
  FILTER (?hasLoss = true)
}

