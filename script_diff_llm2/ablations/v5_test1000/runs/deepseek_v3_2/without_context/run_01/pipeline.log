  GROUP BY investor_id
),
net_cash_flow_per_investor AS (
  SELECT
    investor_id,
    SUM(amount) AS net_cash_flow
  FROM ATOM_EVENT_CASH_FLOW_001
  GROUP BY investor_id
),
risk_score_per_investor AS (
  SELECT
    investor_id,
    risk_score
  FROM ATOM_ENTITY_PORTFOLIO_HEALTH_001
),
combined_metrics AS (
  SELECT
    ip.investor_id,
    ip.category,
    COALESCE(h.num_holdings, 0) AS num_holdings,
    COALESCE(c.net_cash_flow, 0) AS net_cash_flow,
    r.risk_score
  FROM ATOM_ENTITY_INVESTOR_PROFILE_001 ip
  LEFT JOIN holdings_per_investor h ON ip.investor_id = h.investor_id
  LEFT JOIN net_cash_flow_per_investor c ON ip.investor_id = c.investor_id
  LEFT JOIN risk_score_per_investor r ON ip.investor_id = r.investor_id
)
SELECT
  category,
  AVG(num_holdings) AS avg_holdings_per_investor,
  AVG(net_cash_flow) AS avg_net_cash_flow_per_investor,
  AVG(risk_score) AS avg_risk_score
FROM combined_metrics
GROUP BY category
ORDER BY category
