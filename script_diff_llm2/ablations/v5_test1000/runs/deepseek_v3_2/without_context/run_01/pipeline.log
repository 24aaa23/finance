[SQL GENERATE] Generated SQL: WITH
  investor_risk AS (
    SELECT DISTINCT "investor_id", "risk_tolerance"
    FROM "ATOM_ENTITY_INVESTOR_PROFILE_001"
  ),
  net_cash_flow_per_investor AS (
    SELECT "investor_id",
           SUM("amount") AS "total_net_cash_flow"
    FROM "ATOM_EVENT_CASH_FLOW_001"
    GROUP BY "investor_id"
  ),
  signed_cash_flow_per_investor AS (
    SELECT "investor_id",
           AVG("amount") AS "avg_signed_cash_flow_per_entity"
    FROM "ATOM_EVENT_CASH_FLOW_001"
    GROUP BY "investor_id"
  ),
  total_holding_per_investor AS (
    SELECT "investor_id",
           SUM("current_value") AS "total_holding_value"
    FROM "ATOM_ENTITY_PORTFOLIO_HOLDING_001"
    GROUP BY "investor_id"
  ),
  rebalance_amount_per_investor AS (
    SELECT "investor_id",
           AVG("amount") AS "avg_rebalance_amount_per_entity"
    FROM "ATOM_EVENT_REBALANCING_ACTION_001"
    GROUP BY "investor_id"
  ),
  aggregated AS (
    SELECT
      ir."risk_tolerance",
      AVG(ncf."total_net_cash_flow") AS "average_net_cash_flow",
      AVG(scf."avg_signed_cash_flow_per_entity") AS "average_signed_cash_flow_amount",
      AVG(th."total_holding_value") AS "average_total_holding_value",
      AVG(ra."avg_rebalance_amount_per_entity") AS "average_rebalance_amount"
    FROM investor_risk ir
    LEFT JOIN net_cash_flow_per_investor ncf ON ir."investor_id" = ncf."investor_id"
    LEFT JOIN signed_cash_flow_per_investor scf ON ir."investor_id" = scf."investor_id"
    LEFT JOIN total_holding_per_investor th ON ir."investor_id" = th."investor_id"
    LEFT JOIN rebalance_amount_per_investor ra ON ir."investor_id" = ra."investor_id"
    GROUP BY ir."risk_tolerance"
  )
SELECT
  "risk_tolerance",
  "average_net_cash_flow",
  "average_signed_cash_flow_amount",
  "average_total_holding_value",
  "average_rebalance_amount"
FROM aggregated
ORDER BY "risk_tolerance";
