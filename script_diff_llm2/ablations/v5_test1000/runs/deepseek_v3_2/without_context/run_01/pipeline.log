PREFIX wm: <https://wealth.example.org/ontology/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT ?investorId ?investorName
WHERE {
  ?investor a wm:Investor ;
            wm:riskTolerance "Aggressive" ;
            wm:investorId ?investorId ;
            wm:investorName ?investorName .

  ?investor wm:hasPortfolioHealth ?portfolioHealth .
  ?portfolioHealth wm:diversificationScore ?diversificationScore .
  FILTER (xsd:decimal(?diversificationScore) < 25)

  ?investor wm:hasHolding ?holding .
  ?holding wm:cost ?cost ;
           wm:currentValue ?currentValue .
  FILTER (xsd:decimal(?cost) > 0 && xsd:decimal(?currentValue) > 0 && xsd:decimal(?currentValue) < xsd:decimal(?cost))

  ?investor wm:hasSectorAllocation ?allocation .
  ?allocation wm:sector "Corporate" ;
              wm:allocationPct ?allocationPct .
  FILTER (xsd:decimal(?allocationPct) > 0)
}

