PREFIX wm: <https://wealth.example.org/ontology/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?investorId
WHERE {
  ?investor rdf:type wm:Investor ;
            wm:riskTolerance "Conservative" ;
            wm:investorId ?investorId .
  ?ph rdf:type wm:PortfolioHealth ;
      wm:healthOfInvestor ?investor ;
      wm:diversificationScore ?diversificationScore .
  FILTER (?diversificationScore < 25)
  ?sr rdf:type wm:ScenarioRebalancing ;
      wm:scenarioRebalancingOfInvestor ?investor ;
      wm:scenario "Economic Growth" .
  {
    SELECT ?investor (COUNT(?goal) AS ?underfunded_goal_count)
    WHERE {
      ?goal rdf:type wm:InvestmentGoal ;
            wm:belongsToInvestor ?investor ;
            wm:shortfall ?shortfall .
      FILTER (?shortfall > 0)
    }
    GROUP BY ?investor
    HAVING (?underfunded_goal_count >= 1)
  }
}

