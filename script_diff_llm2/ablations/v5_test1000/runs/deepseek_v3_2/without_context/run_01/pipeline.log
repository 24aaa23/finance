    GROUP BY investor_id
  ),
  pre_aggregated AS (
    SELECT
      pg.investor_id,
      pg.risk_tolerance,
      COALESCE(c.total_net_cash_flow, 0) AS total_net_cash_flow_per_inv,
      c.avg_cash_flow_amount_per_inv AS avg_cash_flow_amount_per_inv,
      COALESCE(r.total_rebalance_amount_per_inv, 0) AS total_rebalance_amount_per_inv,
      s.total_sector_investment_per_inv AS total_sector_investment_per_inv
    FROM profile_groups pg
    LEFT JOIN cash_flow_sums c ON pg.investor_id = c.investor_id
    LEFT JOIN rebalance_sums r ON pg.investor_id = r.investor_id
    LEFT JOIN sector_investment_sums s ON pg.investor_id = s.investor_id
  )
SELECT
  risk_tolerance,
  AVG(total_net_cash_flow_per_inv) AS avg_net_cash_flow,
  AVG(avg_cash_flow_amount_per_inv) AS avg_cash_flow_amount,
  AVG(total_rebalance_amount_per_inv) AS avg_total_rebalance_amount,
  AVG(total_sector_investment_per_inv) AS avg_total_sector_investment
FROM pre_aggregated
