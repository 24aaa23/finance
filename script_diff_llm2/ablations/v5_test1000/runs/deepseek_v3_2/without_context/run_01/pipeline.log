[SQL GENERATE] Generated SQL: WITH profile AS (
    SELECT investor_id
    FROM ATOM_ENTITY_INVESTOR_PROFILE_001
    WHERE risk_tolerance = 'Conservative'
),
underfunded_goal AS (
    SELECT investor_id, MAX(CASE WHEN shortfall > 0 THEN 1 ELSE 0 END) AS has_underfunded_goal
    FROM ATOM_ENTITY_INVESTMENT_GOAL_001
    GROUP BY investor_id
    HAVING MAX(CASE WHEN shortfall > 0 THEN 1 ELSE 0 END) = 1
),
cash_flow_preagg AS (
    SELECT investor_id, COALESCE(SUM(amount), 0) AS net_cash_flow
    FROM ATOM_EVENT_CASH_FLOW_001
    GROUP BY investor_id
)
SELECT 
    p.investor_id,
    COALESCE(c.net_cash_flow, 0) AS net_cash_flow
FROM profile p
INNER JOIN underfunded_goal u ON p.investor_id = u.investor_id
LEFT JOIN cash_flow_preagg c ON p.investor_id = c.investor_id
ORDER BY net_cash_flow DESC, p.investor_id
LIMIT 10;
