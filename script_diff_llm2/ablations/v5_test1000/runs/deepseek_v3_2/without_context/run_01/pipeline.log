        AVG(avg_cash_flow_per_investor."avg_cash_flow") AS "avg_cash_flow_amount",
        AVG(total_rebalance_per_investor."total_rebalance_amount") AS "avg_total_rebalance_amount",
        AVG(avg_goal_progress_per_investor."avg_goal_progress") AS "avg_goal_progress"
    FROM profile_groups
    LEFT JOIN net_cash_flow_per_investor ON profile_groups."investor_id" = net_cash_flow_per_investor."investor_id"
    LEFT JOIN avg_cash_flow_per_investor ON profile_groups."investor_id" = avg_cash_flow_per_investor."investor_id"
    LEFT JOIN total_rebalance_per_investor ON profile_groups."investor_id" = total_rebalance_per_investor."investor_id"
    LEFT JOIN avg_goal_progress_per_investor ON profile_groups."investor_id" = avg_goal_progress_per_investor."investor_id"
    GROUP BY profile_groups."risk_tolerance"
)
SELECT
    "risk_tolerance",
    "avg_net_cash_flow",
    "avg_cash_flow_amount",
    "avg_total_rebalance_amount",
    "avg_goal_progress"
FROM grouped_result;
