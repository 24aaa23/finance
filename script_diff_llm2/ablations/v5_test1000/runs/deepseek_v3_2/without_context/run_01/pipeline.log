PREFIX wm: <https://wealth.example.org/ontology/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?investorId
WHERE {
  ?investor rdf:type wm:Investor .
  ?investor wm:investorId ?investorId .
  ?holding rdf:type wm:PortfolioHolding .
  ?holding wm:heldByInvestor ?investor .
  ?holding wm:category "Equity" .
  {
    SELECT ?investor (SUM(xsd:decimal(?amount)) AS ?net_cash_flow_2025)
    WHERE {
      ?cashFlow rdf:type wm:CashFlow .
      ?cashFlow wm:cashFlowOfInvestor ?investor .
      ?cashFlow wm:date ?date .
      ?cashFlow wm:amount ?amount .
      FILTER (xsd:date(?date) >= "2025-01-01"^^xsd:date && xsd:date(?date) <= "2025-12-31"^^xsd:date)
    }
    GROUP BY ?investor
    HAVING (SUM(xsd:decimal(?amount)) < 0)
  }
}

