    FROM ATOM_EVENT_SCENARIO_REBALANCING_001
    GROUP BY investor_id
),
goal_progress_per_investor AS (
    SELECT investor_id,
           AVG(progress_pct) AS per_investor_goal_progress
    FROM ATOM_ENTITY_INVESTMENT_GOAL_001
    GROUP BY investor_id
),
investor_metrics AS (
    SELECT ib.investor_id,
           ib.risk_tolerance,
           ss.per_investor_scenario_shift AS scenario_shift,
           COALESCE(ss.per_investor_scenario_count, 0) AS scenario_count,
           gp.per_investor_goal_progress AS goal_progress
    FROM investor_base ib
    LEFT JOIN scenario_shift_per_investor ss ON ib.investor_id = ss.investor_id
    LEFT JOIN goal_progress_per_investor gp ON ib.investor_id = gp.investor_id
)
