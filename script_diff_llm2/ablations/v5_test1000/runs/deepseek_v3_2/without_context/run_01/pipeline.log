SELECT
  investor_id,
  100 * ((net_cash_flow_norm + total_holding_gain_norm + total_rebalance_amount_norm + risk_score_norm) / 4) AS composite_score
FROM normalized_components
ORDER BY composite_score DESC, investor_id ASC
