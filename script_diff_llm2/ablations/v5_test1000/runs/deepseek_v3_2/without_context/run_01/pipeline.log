[SQL GENERATE] Generated SQL: WITH cash_flow AS (
    SELECT 
        investor_id,
        SUM(CASE WHEN type IN ('Deposit', 'Dividend Reinvestment', 'Interest Credit', 'Lump Sum', 'SIP', 'Tax Refund') THEN amount ELSE -amount END) AS net_cash_flow
    FROM ATOM_EVENT_CASH_FLOW_001
    GROUP BY investor_id
),
allocation_shift AS (
    SELECT 
        investor_id,
        SUM(new_allocation_pct - current_allocation_pct) AS total_allocation_shift
    FROM ATOM_EVENT_SCENARIO_REBALANCING_001
    GROUP BY investor_id
),
risk_data AS (
    SELECT 
        investor_id,
        risk_score
    FROM ATOM_ENTITY_PORTFOLIO_HEALTH_001
),
all_components AS (
    SELECT 
        cf.investor_id,
        cf.net_cash_flow,
        ash.total_allocation_shift,
        rd.risk_score
    FROM cash_flow cf
    INNER JOIN allocation_shift ash ON cf.investor_id = ash.investor_id
    INNER JOIN risk_data rd ON cf.investor_id = rd.investor_id
    WHERE cf.net_cash_flow IS NOT NULL
      AND ash.total_allocation_shift IS NOT NULL
      AND rd.risk_score IS NOT NULL
),
normalized AS (
    SELECT 
        investor_id,
        net_cash_flow,
        total_allocation_shift,
        risk_score,
        (net_cash_flow - MIN(net_cash_flow) OVER ()) / (MAX(net_cash_flow) OVER () - MIN(net_cash_flow) OVER ()) AS norm_cash_flow,
        (total_allocation_shift - MIN(total_allocation_shift) OVER ()) / (MAX(total_allocation_shift) OVER () - MIN(total_allocation_shift) OVER ()) AS norm_allocation_shift,
        (risk_score - MIN(risk_score) OVER ()) / (MAX(risk_score) OVER () - MIN(risk_score) OVER ()) AS norm_risk_score
    FROM all_components
)
SELECT 
    investor_id,
    risk_score,
    CAST((norm_cash_flow + norm_allocation_shift + norm_risk_score) / 3.0 * 100 AS DECIMAL(10,2)) AS composite_score
FROM normalized
ORDER BY composite_score DESC, investor_id ASC
LIMIT 10
