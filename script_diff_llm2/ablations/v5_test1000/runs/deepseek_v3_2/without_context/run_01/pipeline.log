    SELECT "investor_id", AVG("returns_pct") AS avg_holding_return_per_investor
    FROM "ATOM_ENTITY_PORTFOLIO_HOLDING_001"
    WHERE "cost" > 0 AND "current_value" > 0
    GROUP BY "investor_id"
),
goal_progress AS (
    SELECT "investor_id", AVG("progress_pct") AS avg_goal_progress_per_investor
    FROM "ATOM_ENTITY_INVESTMENT_GOAL_001"
    GROUP BY "investor_id"
),
joined AS (
    SELECT 
        profile_groups."risk_tolerance",
        holding_total.total_holding_value,
        holding_return.avg_holding_return_per_investor,
        goal_progress.avg_goal_progress_per_investor
    FROM profile_groups
    LEFT JOIN holding_total 
        ON profile_groups."investor_id" = holding_total."investor_id"
    LEFT JOIN holding_return 
        ON profile_groups."investor_id" = holding_return."investor_id"
    LEFT JOIN goal_progress 
        ON profile_groups."investor_id" = goal_progress."investor_id"
)
SELECT 
    "risk_tolerance",
    AVG(total_holding_value) AS avg_total_holding_value,
    AVG(avg_holding_return_per_investor) AS avg_holding_return,
    AVG(avg_goal_progress_per_investor) AS avg_goal_progress
FROM joined
GROUP BY "risk_tolerance"
ORDER BY "risk_tolerance";
