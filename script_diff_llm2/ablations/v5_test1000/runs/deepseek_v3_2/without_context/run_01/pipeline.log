[SQL GENERATE] Generated SQL: WITH
  -- Base grouping table: all investor profiles with risk tolerance
  profile_groups AS (
    SELECT
      "investor_id",
      "risk_tolerance"
    FROM "ATOM_ENTITY_INVESTOR_PROFILE_001"
  ),
  -- Measure 0: Average rebalance amount per investor
  metric_source_0 AS (
    SELECT
      "investor_id",
      AVG("amount") AS "per_investor_avg_rebalance_amount"
    FROM "ATOM_EVENT_REBALANCING_ACTION_001"
    GROUP BY "investor_id"
  ),
  -- Measure 1: Average rebalance shift per investor
  metric_source_1 AS (
    SELECT
      "investor_id",
      AVG("target_allocation_pct" - "current_allocation_pct") AS "per_investor_avg_rebalance_shift"
    FROM "ATOM_EVENT_REBALANCING_ACTION_001"
    GROUP BY "investor_id"
  ),
  -- Measure 2: Total sector investment per investor (sum across sectors)
  metric_source_2 AS (
    SELECT
      "investor_id",
      SUM("total_investment") AS "per_investor_total_sector_investment"
    FROM "ATOM_ENTITY_SECTOR_ALLOCATION_001"
    GROUP BY "investor_id"
  )
SELECT
  profile_groups."risk_tolerance",
  -- Final operation: Average across investors within risk tolerance group
  AVG(metric_source_0."per_investor_avg_rebalance_amount") AS "avg_rebalance_amount",
  AVG(metric_source_1."per_investor_avg_rebalance_shift") AS "avg_rebalance_shift",
  AVG(metric_source_2."per_investor_total_sector_investment") AS "avg_total_sector_investment"
FROM profile_groups
-- LEFT JOIN each per-investor metric CTE (preserve all investors)
LEFT JOIN metric_source_0
  ON profile_groups."investor_id" = metric_source_0."investor_id"
LEFT JOIN metric_source_1
  ON profile_groups."investor_id" = metric_source_1."investor_id"
LEFT JOIN metric_source_2
  ON profile_groups."investor_id" = metric_source_2."investor_id"
GROUP BY profile_groups."risk_tolerance";
