  AVG(COALESCE(metric_source_1."per_investor_avg_gain", 0)) AS "avg_holding_gain",
  AVG(COALESCE(metric_source_0."per_investor_total_dividends", 0)) AS "avg_dividends"
FROM profile_base
LEFT JOIN metric_source_0 ON profile_base."investor_id" = metric_source_0."investor_id"
LEFT JOIN metric_source_1 ON profile_base."investor_id" = metric_source_1."investor_id"
GROUP BY profile_base."risk_tolerance";
