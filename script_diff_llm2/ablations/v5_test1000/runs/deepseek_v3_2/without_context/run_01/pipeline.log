    investor_id,
    AVG(shortfall) AS avg_goal_shortfall
  FROM ATOM_ENTITY_INVESTMENT_GOAL_001
  GROUP BY investor_id
),
investors_with_all_three AS (
  SELECT 
    c.investor_id,
    c.net_cash_flow,
    s.total_scenario_allocation_shift,
    g.avg_goal_shortfall
  FROM net_cash_flow_per_investor c
  INNER JOIN total_scenario_allocation_shift_per_investor s 
    ON c.investor_id = s.investor_id
  INNER JOIN avg_goal_shortfall_per_investor g 
    ON c.investor_id = g.investor_id
),
normalized_components AS (
  SELECT 
    investor_id,
    net_cash_flow,
    total_scenario_allocation_shift,
    avg_goal_shortfall,
    (net_cash_flow - MIN(net_cash_flow) OVER ()) * 1.0 / 
      (MAX(net_cash_flow) OVER () - MIN(net_cash_flow) OVER ()) AS norm_cash_flow,
    (total_scenario_allocation_shift - MIN(total_scenario_allocation_shift) OVER ()) * 1.0 / 
      (MAX(total_scenario_allocation_shift) OVER () - MIN(total_scenario_allocation_shift) OVER ()) AS norm_allocation_shift,
    1.0 - ((avg_goal_shortfall - MIN(avg_goal_shortfall) OVER ()) * 1.0 / 
      (MAX(avg_goal_shortfall) OVER () - MIN(avg_goal_shortfall) OVER ())) AS norm_goal_shortfall
  FROM investors_with_all_three
)
SELECT 
  investor_id,
  net_cash_flow,
  total_scenario_allocation_shift,
  avg_goal_shortfall,
  ROUND(100.0 * ((norm_cash_flow + norm_allocation_shift + norm_goal_shortfall) / 3.0), 1) AS composite_score
FROM normalized_components
ORDER BY 
  composite_score DESC,
  investor_id
LIMIT 10
