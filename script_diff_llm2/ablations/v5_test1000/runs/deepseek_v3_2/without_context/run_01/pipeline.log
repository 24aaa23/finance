[SQL GENERATE] Generated SQL: WITH
  investor_profiles AS (
    SELECT
      investor_id,
      time_horizon
    FROM ATOM_ENTITY_INVESTOR_PROFILE_001
  ),
  per_investor_total_value_and_dividends AS (
    SELECT
      investor_id,
      SUM(current_value) AS investor_total_current_value,
      SUM(dividends) AS investor_total_dividends
    FROM ATOM_ENTITY_PORTFOLIO_HOLDING_001
    GROUP BY investor_id
  ),
  per_investor_return_and_gain AS (
    SELECT
      investor_id,
      AVG(returns_pct) AS investor_avg_return_pct,
      AVG(current_value - cost) AS investor_avg_gain
    FROM ATOM_ENTITY_PORTFOLIO_HOLDING_001
    WHERE cost > 0 AND current_value > 0
    GROUP BY investor_id
  )
SELECT
  p.time_horizon,
  AVG(t.investor_total_current_value) AS avg_total_holding_value,
  AVG(r.investor_avg_return_pct) AS avg_holding_return,
  AVG(r.investor_avg_gain) AS avg_holding_gain,
  AVG(t.investor_total_dividends) AS avg_dividends
FROM investor_profiles p
LEFT JOIN per_investor_total_value_and_dividends t
  ON p.investor_id = t.investor_id
LEFT JOIN per_investor_return_and_gain r
  ON p.investor_id = r.investor_id
GROUP BY p.time_horizon
ORDER BY p.time_horizon;

