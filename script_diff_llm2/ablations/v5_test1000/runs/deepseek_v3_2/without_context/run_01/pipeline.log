[SQL GENERATE] Generated SQL: WITH aggregated_measures AS (
    SELECT
        investor_id,
        SUM(amount) AS net_cash_flow,
        risk_score
    FROM
        (
            SELECT
                investor_id,
                amount
            FROM
                ATOM_EVENT_CASH_FLOW_001
            WHERE
                investor_id IN (SELECT investor_id FROM ATOM_ENTITY_PORTFOLIO_HEALTH_001 WHERE risk_score IS NOT NULL)
            GROUP BY
                investor_id,
                amount
        ) AS cash_flows
    LEFT JOIN
        (
            SELECT
                investor_id,
                risk_score
            FROM
                ATOM_ENTITY_PORTFOLIO_HEALTH_001
            WHERE
                investor_id IN (SELECT investor_id FROM ATOM_ENTITY_INVESTOR_PROFILE_001)
                AND risk_score IS NOT NULL
            GROUP BY
                investor_id,
                risk_score
        ) AS risk_scores ON cash_flows.investor_id = risk_scores.investor_id
    GROUP BY
        investor_id,
        risk_score
),
normalized_measures AS (
    SELECT
        investor_id,
        net_cash_flow,
        risk_score,
        (net_cash_flow - MIN(net_cash_flow) OVER ()) / (MAX(net_cash_flow) OVER () - MIN(net_cash_flow) OVER ()) AS normalized_net_cash_flow,
        (risk_score - MIN(risk_score) OVER ()) / (MAX(risk_score) OVER () - MIN(risk_score) OVER ()) AS normalized_risk_score
    FROM
        aggregated_measures
    WHERE
        investor_id IN (SELECT investor_id FROM ATOM_EVENT_CASH_FLOW_001)
        AND investor_id IN (SELECT investor_id FROM ATOM_ENTITY_PORTFOLIO_HEALTH_001 WHERE risk_score IS NOT NULL)
),
composite_scores AS (
    SELECT
        investor_id,
        normalized_net_cash_flow,
        normalized_risk_score,
        100 * ((normalized_net_cash_flow + normalized_risk_score) / 2) AS composite_score
    FROM
        normalized_measures
)
SELECT
    investor_id,
    composite_score
FROM
    composite_scores
ORDER BY
    composite_score DESC,
    investor_id
LIMIT 10;
