[SQL GENERATE] Generated SQL: WITH mut_fund_investors AS (
    SELECT DISTINCT investor_id
    FROM ATOM_ENTITY_PORTFOLIO_HOLDING_001
    WHERE investment_type = 'Mutual Fund'
),
bull_market_investors AS (
    SELECT DISTINCT investor_id
    FROM ATOM_EVENT_SCENARIO_REBALANCING_001
    WHERE scenario = 'Bull Market'
),
high_risk_investors AS (
    SELECT DISTINCT ph.investor_id
    FROM ATOM_ENTITY_PORTFOLIO_HEALTH_001 ph
    WHERE ph.risk_score > 25
),
eligible_investors AS (
    SELECT DISTINCT ip.investor_id,
            ip.risk_tolerance
    FROM ATOM_ENTITY_INVESTOR_PROFILE_001 ip
    INNER JOIN mut_fund_investors mf ON ip.investor_id = mf.investor_id
    INNER JOIN bull_market_investors bm ON ip.investor_id = bm.investor_id
    INNER JOIN high_risk_investors hr ON ip.investor_id = hr.investor_id
)
SELECT risk_tolerance,
       COUNT(DISTINCT investor_id) AS distinct_investor_count
FROM eligible_investors
GROUP BY risk_tolerance
ORDER BY risk_tolerance
