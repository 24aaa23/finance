investors_low_diversification AS (
  SELECT DISTINCT ph.investor_id
  FROM ATOM_ENTITY_PORTFOLIO_HEALTH_001 ph
  JOIN aggressive_investors ai ON ph.investor_id = ai.investor_id
  WHERE ph.diversification_score < 25
),
investors_with_loss AS (
  SELECT DISTINCT ph.investor_id
  FROM ATOM_ENTITY_PORTFOLIO_HOLDING_001 ph
  JOIN aggressive_investors ai ON ph.investor_id = ai.investor_id
  WHERE ph.cost IS NOT NULL
