PREFIX wm: <https://wealth.example.org/ontology/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?investorId
WHERE {
  ?investor rdf:type wm:Investor .
  ?investor wm:timeHorizon "Long-term" .
  ?investor wm:investorId ?investorId .
  {
    SELECT ?investor (SUM(xsd:decimal(?amount)) AS ?net_cash_flow_2024)
    WHERE {
      ?cashFlow rdf:type wm:CashFlow .
      ?cashFlow wm:cashFlowOfInvestor ?investor .
      ?cashFlow wm:date ?date .
      FILTER (xsd:date(?date) >= "2024-01-01"^^xsd:date && xsd:date(?date) <= "2024-12-31"^^xsd:date)
      ?cashFlow wm:amount ?amount .
    }
    GROUP BY ?investor
    HAVING (SUM(xsd:decimal(?amount)) < 0)
  }
}

