  )
),
min_max AS (
  SELECT
    MIN(net_cash_flow) AS min_ncf,
    MAX(net_cash_flow) AS max_ncf,
    MIN(total_sector_investment) AS min_tsi,
    MAX(total_sector_investment) AS max_tsi,
    MIN(scenario_allocation_shift) AS min_sas,
    MAX(scenario_allocation_shift) AS max_sas
  FROM investor_components
),
normalized_components AS (
  SELECT
    ic.investor_id,
    (ic.net_cash_flow - mm.min_ncf) / NULLIF(mm.max_ncf - mm.min_ncf, 0) AS normalized_net_cash_flow,
    (ic.total_sector_investment - mm.min_tsi) / NULLIF(mm.max_tsi - mm.min_tsi, 0) AS normalized_total_sector_investment,
    (ic.scenario_allocation_shift - mm.min_sas) / NULLIF(mm.max_sas - mm.min_sas, 0) AS normalized_scenario_allocation_shift
  FROM investor_components ic, min_max mm
),
composite_scores AS (
  SELECT
    investor_id,
    100.0 * ((normalized_net_cash_flow + normalized_total_sector_investment + normalized_scenario_allocation_shift) / 3.0) AS composite_score
  FROM normalized_components
)
SELECT
  investor_id,
  composite_score
FROM composite_scores
ORDER BY composite_score DESC, investor_id
LIMIT 10

