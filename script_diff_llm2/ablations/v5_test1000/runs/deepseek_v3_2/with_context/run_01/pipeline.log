    INNER JOIN holding_gains_per_investor hg ON ip.investor_id = hg.investor_id
    INNER JOIN rebalance_amounts_per_investor ra ON ip.investor_id = ra.investor_id
ORDER BY
    composite_score DESC,
    ip.investor_id
LIMIT 10;
