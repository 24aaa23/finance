[SQL GENERATE] Generated SQL: WITH total_holding_value_per_investor AS (
  SELECT
    investor_id,
    SUM(current_value) AS total_holding_value
  FROM ATOM_ENTITY_PORTFOLIO_HOLDING_001
  GROUP BY investor_id
),
avg_return_per_investor AS (
  SELECT
    investor_id,
    AVG(returns_pct) AS avg_holding_return_per_investor
  FROM ATOM_ENTITY_PORTFOLIO_HOLDING_001
  GROUP BY investor_id
),
holding_gain_per_investor AS (
  SELECT
    investor_id,
    AVG(current_value - cost) AS avg_holding_gain_per_investor
  FROM ATOM_ENTITY_PORTFOLIO_HOLDING_001
  WHERE cost > 0 AND current_value > 0
  GROUP BY investor_id
),
dividends_per_investor AS (
  SELECT
    investor_id,
    SUM(dividends) AS total_dividends
  FROM ATOM_ENTITY_PORTFOLIO_HOLDING_001
  GROUP BY investor_id
)
SELECT
  p.risk_tolerance,
  AVG(thv.total_holding_value) AS avg_total_holding_value,
  AVG(ar.avg_holding_return_per_investor) AS avg_holding_return,
  AVG(hg.avg_holding_gain_per_investor) AS avg_holding_gain,
  AVG(d.total_dividends) AS avg_dividends
FROM ATOM_ENTITY_INVESTOR_PROFILE_001 p
LEFT JOIN total_holding_value_per_investor thv ON p.investor_id = thv.investor_id
LEFT JOIN avg_return_per_investor ar ON p.investor_id = ar.investor_id
LEFT JOIN holding_gain_per_investor hg ON p.investor_id = hg.investor_id
LEFT JOIN dividends_per_investor d ON p.investor_id = d.investor_id
GROUP BY p.risk_tolerance;
