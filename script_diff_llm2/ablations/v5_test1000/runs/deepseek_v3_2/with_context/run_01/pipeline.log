)
SELECT
    risk_tolerance,
    scenario,
    COUNT(DISTINCT investor_id) AS distinct_investor_count
FROM investors_with_scenarios
GROUP BY risk_tolerance, scenario
ORDER BY risk_tolerance, scenario
