[SQL GENERATE] Generated SQL: WITH 
  holding_summary AS (
    SELECT 
      investor_id, 
      SUM(current_value) AS total_holding_value_per_investor
    FROM 
      ATOM_ENTITY_PORTFOLIO_HOLDING_001
    GROUP BY 
      investor_id
  ),
  
  return_summary AS (
    SELECT 
      investor_id, 
      AVG(returns_pct) AS avg_return_per_investor
    FROM 
      ATOM_ENTITY_PORTFOLIO_HOLDING_001
    WHERE 
      cost > 0 
      AND current_value > 0
    GROUP BY 
      investor_id
  ),
  
  rebalance_summary AS (
    SELECT 
      investor_id, 
      SUM(amount) AS total_rebalance_amount_per_investor
    FROM 
      ATOM_EVENT_REBALANCING_ACTION_001
    GROUP BY 
      investor_id
  ),
  
  scenario_summary AS (
    SELECT 
      investor_id, 
      AVG(
        new_allocation_pct - current_allocation_pct
      ) AS avg_allocation_shift_per_investor
    FROM 
      ATOM_EVENT_SCENARIO_REBALANCING_001
    GROUP BY 
      investor_id
  ),
  
  final_aggregation AS (
    SELECT 
      p.risk_tolerance,
      
      AVG(
        COALESCE(h.total_holding_value_per_investor, 0)
      ) AS avg_total_holding_value,
      
      AVG(
        r.avg_return_per_investor
      ) AS avg_holding_return,
      
      AVG(
        COALESCE(rb.total_rebalance_amount_per_investor, 0)
      ) AS avg_total_rebalance_amount,
      
      AVG(
        s.avg_allocation_shift_per_investor
      ) AS avg_scenario_allocation_shift
    FROM 
      ATOM_ENTITY_INVESTOR_PROFILE_001 AS p
      LEFT JOIN holding_summary AS h ON p.investor_id = h.investor_id
      LEFT JOIN return_summary AS r ON p.investor_id = r.investor_id
      LEFT JOIN rebalance_summary AS rb ON p.investor_id = rb.investor_id
      LEFT JOIN scenario_summary AS s ON p.investor_id = s.investor_id
    GROUP BY 
      p.risk_tolerance
  )

SELECT 
  risk_tolerance,
  avg_total_holding_value,
  avg_holding_return,
  avg_total_rebalance_amount,
  avg_scenario_allocation_shift
FROM 
  final_aggregation
ORDER BY 
  risk_tolerance;
