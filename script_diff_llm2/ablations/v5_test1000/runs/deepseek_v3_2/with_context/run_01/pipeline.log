  GROUP BY investor_id
),
profile_base AS (
  SELECT investor_id, risk_tolerance
  FROM ATOM_ENTITY_INVESTOR_PROFILE_001
)
SELECT 
  p.risk_tolerance,
  AVG(ncf.per_inv_net_cash_flow) AS avg_net_cash_flow,
  AVG(cfa.per_inv_cash_flow_amount) AS avg_cash_flow_amount,
  AVG(thv.per_inv_total_holding_value) AS avg_total_holding_value,
  AVG(sas.per_inv_scenario_allocation_shift) AS avg_scenario_allocation_shift,
  AVG(gp.per_inv_goal_progress) AS avg_goal_progress
FROM profile_base p
LEFT JOIN investor_per_net_cash_flow ncf ON p.investor_id = ncf.investor_id
LEFT JOIN investor_per_cash_flow_amount cfa ON p.investor_id = cfa.investor_id
LEFT JOIN investor_per_total_holding_value thv ON p.investor_id = thv.investor_id
LEFT JOIN investor_per_scenario_allocation_shift sas ON p.investor_id = sas.investor_id
LEFT JOIN investor_per_goal_progress gp ON p.investor_id = gp.investor_id
GROUP BY p.risk_tolerance
ORDER BY p.risk_tolerance;
