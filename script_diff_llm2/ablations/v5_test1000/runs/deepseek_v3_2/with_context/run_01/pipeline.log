[SQL GENERATE] Generated SQL: WITH
cash_flow_agg AS (
    SELECT investor_id,
           SUM(amount) AS net_cash_flow
    FROM ATOM_EVENT_CASH_FLOW_001
    GROUP BY investor_id
),
holding_gain_agg AS (
    SELECT investor_id,
           SUM(current_value - cost) AS total_holding_gain
    FROM ATOM_ENTITY_PORTFOLIO_HOLDING_001
    WHERE cost > 0 AND current_value > 0
    GROUP BY investor_id
),
sector_investment_agg AS (
    SELECT investor_id,
           SUM(total_investment) AS total_sector_investment
    FROM ATOM_ENTITY_SECTOR_ALLOCATION_001
    GROUP BY investor_id
),
risk_score_agg AS (
    SELECT investor_id,
           AVG(risk_score) AS risk_score
    FROM ATOM_ENTITY_PORTFOLIO_HEALTH_001
    GROUP BY investor_id
),
investor_components AS (
    SELECT ip.investor_id,
           cf.net_cash_flow,
           hg.total_holding_gain,
           si.total_sector_investment,
           rs.risk_score
    FROM ATOM_ENTITY_INVESTOR_PROFILE_001 ip
    INNER JOIN cash_flow_agg cf ON ip.investor_id = cf.investor_id
    INNER JOIN holding_gain_agg hg ON ip.investor_id = hg.investor_id
    INNER JOIN sector_investment_agg si ON ip.investor_id = si.investor_id
    INNER JOIN risk_score_agg rs ON ip.investor_id = rs.investor_id
),
normalized_components AS (
    SELECT investor_id,
           net_cash_flow,
           total_holding_gain,
           total_sector_investment,
           risk_score,
           CASE
               WHEN (MAX(net_cash_flow) OVER () - MIN(net_cash_flow) OVER ()) = 0 THEN 0
               ELSE (net_cash_flow - MIN(net_cash_flow) OVER ()) / (MAX(net_cash_flow) OVER () - MIN(net_cash_flow) OVER ())
           END AS norm_net_cash_flow,
           CASE
               WHEN (MAX(total_holding_gain) OVER () - MIN(total_holding_gain) OVER ()) = 0 THEN 0
               ELSE (total_holding_gain - MIN(total_holding_gain) OVER ()) / (MAX(total_holding_gain) OVER () - MIN(total_holding_gain) OVER ())
           END AS norm_total_holding_gain,
           CASE
               WHEN (MAX(total_sector_investment) OVER () - MIN(total_sector_investment) OVER ()) = 0 THEN 0
               ELSE (total_sector_investment - MIN(total_sector_investment) OVER ()) / (MAX(total_sector_investment) OVER () - MIN(total_sector_investment) OVER ())
           END AS norm_total_sector_investment,
           CASE
               WHEN (MAX(risk_score) OVER () - MIN(risk_score) OVER ()) = 0 THEN 0
               ELSE (risk_score - MIN(risk_score) OVER ()) / (MAX(risk_score) OVER () - MIN(risk_score) OVER ())
           END AS norm_risk_score
    FROM investor_components
),
final_scores AS (
    SELECT investor_id,
           100 * ((norm_net_cash_flow + norm_total_holding_gain + norm_total_sector_investment + norm_risk_score) / 4) AS composite_score
    FROM normalized_components
)
SELECT investor_id,
       composite_score
FROM final_scores
ORDER BY composite_score DESC, investor_id
LIMIT 10
