[SQL GENERATE] Generated SQL: WITH metric_source_0 AS (
  SELECT "investor_id", SUM("total_investment") AS "total_sector_allocation_investment"
  FROM "ATOM_ENTITY_SECTOR_ALLOCATION_001"
  GROUP BY "investor_id"
),
metric_source_1 AS (
  SELECT "investor_id", AVG("returns_pct") AS "holding_return_per_investor"
  FROM "ATOM_ENTITY_PORTFOLIO_HOLDING_001"
  WHERE "cost" > 0 AND "current_value" > 0
  GROUP BY "investor_id"
),
metric_source_2 AS (
  SELECT "investor_id", AVG("risk_score") AS "risk_score_per_investor"
  FROM "ATOM_ENTITY_PORTFOLIO_HEALTH_001"
  GROUP BY "investor_id"
),
pre_aggregated AS (
  SELECT IP."investor_id", IP."time_horizon",
         m0."total_sector_allocation_investment",
         m1."holding_return_per_investor",
         m2."risk_score_per_investor"
  FROM "ATOM_ENTITY_INVESTOR_PROFILE_001" IP
  LEFT JOIN metric_source_0 m0 ON IP."investor_id" = m0."investor_id"
  LEFT JOIN metric_source_1 m1 ON IP."investor_id" = m1."investor_id"
  LEFT JOIN metric_source_2 m2 ON IP."investor_id" = m2."investor_id"
)
SELECT "time_horizon",
       AVG("total_sector_allocation_investment") AS "avg_total_sector_allocation_investment",
       AVG("holding_return_per_investor") AS "avg_holding_return_per_investor",
       AVG("risk_score_per_investor") AS "avg_risk_score"
FROM pre_aggregated
GROUP BY "time_horizon";
