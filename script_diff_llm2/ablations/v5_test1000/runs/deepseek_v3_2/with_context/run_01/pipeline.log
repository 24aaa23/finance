[SQL GENERATE] Generated SQL: WITH
  measure_net_cash_flow AS (
    SELECT
      investor_id,
      SUM(amount) AS net_cash_flow
    FROM ATOM_EVENT_CASH_FLOW_001
    GROUP BY investor_id
  ),
  measure_total_holding_gain AS (
    SELECT
      investor_id,
      SUM(current_value - cost) AS total_holding_gain
    FROM ATOM_ENTITY_PORTFOLIO_HOLDING_001
    WHERE cost IS NOT NULL
      AND current_value IS NOT NULL
    GROUP BY investor_id
  ),
  measure_total_rebalance_amount AS (
    SELECT
      investor_id,
      SUM(amount) AS total_rebalance_amount
    FROM ATOM_EVENT_REBALANCING_ACTION_001
    GROUP BY investor_id
  ),
  measure_total_sector_investment AS (
    SELECT
      investor_id,
      SUM(total_investment) AS total_sector_investment
    FROM ATOM_ENTITY_SECTOR_ALLOCATION_001
    GROUP BY investor_id
  )
SELECT
  ip.investor_id AS investor_id,
  (
    COALESCE(m1.net_cash_flow, 0)
    + COALESCE(m2.total_holding_gain, 0)
    + COALESCE(m3.total_rebalance_amount, 0)
    + COALESCE(m4.total_sector_investment, 0)
  ) AS composite_score
FROM ATOM_ENTITY_INVESTOR_PROFILE_001 ip
JOIN measure_net_cash_flow m1 ON ip.investor_id = m1.investor_id
JOIN measure_total_holding_gain m2 ON ip.investor_id = m2.investor_id
JOIN measure_total_rebalance_amount m3 ON ip.investor_id = m3.investor_id
JOIN measure_total_sector_investment m4 ON ip.investor_id = m4.investor_id
ORDER BY composite_score DESC, ip.investor_id
LIMIT 10
