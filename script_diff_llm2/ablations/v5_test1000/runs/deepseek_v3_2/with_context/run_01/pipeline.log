PREFIX wm: <https://wealth.example.org/ontology/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT ?investorId ?investorName
WHERE {
  ?investor rdf:type wm:Investor .
  ?investor wm:riskTolerance "Conservative" .
  ?investor wm:investorId ?investorId .
  ?investor wm:investorName ?investorName .

  ?portfolioHealth rdf:type wm:PortfolioHealth .
  ?portfolioHealth wm:healthOfInvestor ?investor .
  ?portfolioHealth wm:riskScore ?riskScore .
  FILTER (xsd:decimal(?riskScore) > 75)

  {
    SELECT ?investor (MAX(?lossFlag) AS ?has_loss_making_position)
    WHERE {
      ?holding rdf:type wm:PortfolioHolding .
      ?holding wm:heldByInvestor ?investor .
      ?holding wm:currentValue ?currentValue .
      ?holding wm:cost ?cost .
      FILTER (BOUND(?currentValue) && BOUND(?cost))
      FILTER (xsd:decimal(?currentValue) < xsd:decimal(?cost))
      BIND (1 AS ?lossFlag)
    }
    GROUP BY ?investor
    HAVING (MAX(?lossFlag) > 0)
  }

  {
    SELECT ?investor (MAX(xsd:decimal(?shortfall)) AS ?has_underfunded_goal)
    WHERE {
      ?goal rdf:type wm:InvestmentGoal .
      ?goal wm:belongsToInvestor ?investor .
      ?goal wm:shortfall ?shortfall .
    }
    GROUP BY ?investor
    HAVING (MAX(xsd:decimal(?shortfall)) > 0)
  }

  FILTER (BOUND(?has_loss_making_position) && BOUND(?has_underfunded_goal))
}

