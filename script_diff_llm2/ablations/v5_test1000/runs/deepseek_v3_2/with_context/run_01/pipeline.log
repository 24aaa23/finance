INNER JOIN investors_low_diversification ld ON ai.investor_id = ld.investor_id
INNER JOIN investors_with_loss wl ON ai.investor_id = wl.investor_id
INNER JOIN investors_banking_allocation ba ON ai.investor_id = ba.investor_id
