[SQL GENERATE] Generated SQL: WITH profile_groups AS (
  SELECT DISTINCT "investor_id", "risk_tolerance"
  FROM "ATOM_ENTITY_INVESTOR_PROFILE_001"
),
holding_totals AS (
  SELECT "investor_id", 
         SUM("current_value") AS investor_total_holding_value
  FROM "ATOM_ENTITY_PORTFOLIO_HOLDING_001"
  GROUP BY "investor_id"
),
holding_returns AS (
  SELECT "investor_id", 
         AVG("returns_pct") AS investor_avg_holding_return
  FROM "ATOM_ENTITY_PORTFOLIO_HOLDING_001"
  WHERE "cost" > 0 AND "current_value" > 0
  GROUP BY "investor_id"
),
rebalance_totals AS (
  SELECT "investor_id", 
         SUM("amount") AS investor_total_rebalance_amount
  FROM "ATOM_EVENT_REBALANCING_ACTION_001"
  GROUP BY "investor_id"
),
sector_investments AS (
  SELECT "investor_id", 
         SUM("total_investment") AS investor_total_sector_investment
  FROM "ATOM_ENTITY_SECTOR_ALLOCATION_001"
  GROUP BY "investor_id"
),
joined_data AS (
  SELECT pg."risk_tolerance",
         ht.investor_total_holding_value,
         hr.investor_avg_holding_return,
         rt.investor_total_rebalance_amount,
         si.investor_total_sector_investment
  FROM profile_groups pg
  LEFT JOIN holding_totals ht ON pg."investor_id" = ht."investor_id"
  LEFT JOIN holding_returns hr ON pg."investor_id" = hr."investor_id"
  LEFT JOIN rebalance_totals rt ON pg."investor_id" = rt."investor_id"
  LEFT JOIN sector_investments si ON pg."investor_id" = si."investor_id"
)
SELECT "risk_tolerance",
       AVG(investor_total_holding_value) AS "avg_total_holding_value",
       AVG(investor_avg_holding_return) AS "avg_holding_return",
       AVG(investor_total_rebalance_amount) AS "avg_total_rebalance_amount",
       AVG(investor_total_sector_investment) AS "avg_total_sector_investment"
FROM joined_data
GROUP BY "risk_tolerance";
