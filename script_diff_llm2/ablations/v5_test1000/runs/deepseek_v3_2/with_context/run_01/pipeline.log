[SQL GENERATE] Generated SQL: WITH goal_investors AS (
  SELECT DISTINCT investor_id
  FROM ATOM_ENTITY_INVESTMENT_GOAL_001
  WHERE investment_goal = 'Growth'
),
mf_investors AS (
  SELECT DISTINCT investor_id
  FROM ATOM_ENTITY_PORTFOLIO_HOLDING_001
  WHERE investment_type = 'Mutual Fund'
),
common_investors AS (
  SELECT gi.investor_id
  FROM goal_investors gi
  INNER JOIN mf_investors mf ON gi.investor_id = mf.investor_id
)
SELECT
  ip.risk_tolerance,
  COUNT(DISTINCT ip.investor_id) AS distinct_investor_count
FROM ATOM_ENTITY_INVESTOR_PROFILE_001 ip
INNER JOIN common_investors ci ON ip.investor_id = ci.investor_id
GROUP BY ip.risk_tolerance
ORDER BY ip.risk_tolerance
