      wm:allocationOfInvestor ?investor ;
      wm:sector "Consumer Goods" ;
      wm:allocationPct ?allocationPct .
  FILTER (xsd:decimal(?allocationPct) > 0)

  {
    SELECT ?investor (MAX(?isLossMaking) AS ?has_loss_making_holding)
    WHERE {
      ?holding a wm:PortfolioHolding ;
               wm:heldByInvestor ?investor ;
               wm:cost ?cost ;
               wm:currentValue ?currentValue .
      FILTER (xsd:decimal(?cost) > 0 && xsd:decimal(?currentValue) > 0)
      BIND (IF(xsd:decimal(?currentValue) < xsd:decimal(?cost), 1, 0) AS ?isLossMaking)
    }
    GROUP BY ?investor
    HAVING (MAX(?isLossMaking) > 0)
  }
}

