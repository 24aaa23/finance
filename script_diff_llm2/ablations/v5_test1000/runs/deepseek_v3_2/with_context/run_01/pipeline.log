    AND ra.action IN ('Aggressive Entry', 'Asset Reallocation', 'Buy', 'Cash Deployment', 'De-risking', 'Defensive Shift', 'Dividend Reinvestment', 'Goal Alignment Buy', 'Goal Alignment Sell', 'Hold', 'Partial Exit', 'Portfolio Trim', 'Profit Booking', 'Rebalance Buy', 'Rebalance Sell', 'Sector Rotation Buy', 'Sector Rotation Sell', 'Sell', 'Stop Loss Exit', 'Switch In', 'Switch Out', 'Tactical Decrease', 'Tactical Increase')
    AND ip.segment IN ('Diversified', 'Large Cap', 'Mid Cap', 'Small Cap')
),
per_entity AS (
  SELECT
    mp.investor_id,
    ip.segment,
    ra.action AS rebalancing_action
  FROM measures_prep AS mp
  INNER JOIN ATOM_ENTITY_INVESTOR_PROFILE_001 AS ip ON mp.investor_id = ip.investor_id
  INNER JOIN ATOM_EVENT_REBALANCING_ACTION_001 AS ra ON mp.investor_id = ra.investor_id
  WHERE 
    ra.action IN ('Aggressive Entry', 'Asset Reallocation', 'Buy', 'Cash Deployment', 'De-risking', 'Defensive Shift', 'Dividend Reinvestment', 'Goal Alignment Buy', 'Goal Alignment Sell', 'Hold', 'Partial Exit', 'Portfolio Trim', 'Profit Booking', 'Rebalance Buy', 'Rebalance Sell', 'Sector Rotation Buy', 'Sector Rotation Sell', 'Sell', 'Stop Loss Exit', 'Switch In', 'Switch Out', 'Tactical Decrease', 'Tactical Increase')
    AND ip.segment IN ('Diversified', 'Large Cap', 'Mid Cap', 'Small Cap')
)
SELECT
  segment,
  rebalancing_action,
  COUNT(DISTINCT investor_id) AS distinct_investor_count
FROM per_entity
GROUP BY segment, rebalancing_action
