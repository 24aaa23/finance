[SQL GENERATE] Generated SQL: WITH 
  profile_groups AS (
    SELECT DISTINCT "investor_id", "segment" 
    FROM "ATOM_ENTITY_INVESTOR_PROFILE_001"
  ),
  metric_source_0 AS (
    SELECT "investor_id", 
           COUNT("holding_id") AS "avg_holdings_per_investor" 
    FROM "ATOM_ENTITY_PORTFOLIO_HOLDING_001" 
    GROUP BY "investor_id"
  ),
  metric_source_1 AS (
    SELECT "investor_id", 
           SUM("amount") AS "avg_net_cash_flow_per_investor" 
    FROM "ATOM_EVENT_CASH_FLOW_001" 
    GROUP BY "investor_id"
  ),
  metric_source_2 AS (
    SELECT "investor_id", 
           AVG("risk_score") AS "avg_risk_score" 
    FROM "ATOM_ENTITY_PORTFOLIO_HEALTH_001" 
    GROUP BY "investor_id"
  ),
  grouped_result AS (
    SELECT 
      profile_groups."segment" AS "segment",
      AVG(metric_source_0."avg_holdings_per_investor") AS "avg_holdings_per_investor",
      AVG(metric_source_1."avg_net_cash_flow_per_investor") AS "avg_net_cash_flow_per_investor",
      AVG(metric_source_2."avg_risk_score") AS "avg_risk_score"
    FROM profile_groups 
    LEFT JOIN metric_source_0 ON profile_groups."investor_id" = metric_source_0."investor_id"
    LEFT JOIN metric_source_1 ON profile_groups."investor_id" = metric_source_1."investor_id"
    LEFT JOIN metric_source_2 ON profile_groups."investor_id" = metric_source_2."investor_id"
    GROUP BY profile_groups."segment"
  )
SELECT 
  "segment",
  "avg_holdings_per_investor",
  "avg_net_cash_flow_per_investor",
  "avg_risk_score" 
FROM grouped_result;
