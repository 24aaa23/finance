[SQL GENERATE] Generated SQL: WITH rebalance_agg AS (
  SELECT
    investor_id,
    SUM(amount) AS total_rebalance_amount
  FROM ATOM_EVENT_REBALANCING_ACTION_001
  GROUP BY investor_id
),
scenario_agg AS (
  SELECT
    investor_id,
    SUM(new_allocation_pct - current_allocation_pct) AS total_scenario_shift
  FROM ATOM_EVENT_SCENARIO_REBALANCING_001
  GROUP BY investor_id
),
joined_metrics AS (
  SELECT
    ra.investor_id,
    ra.total_rebalance_amount,
    sa.total_scenario_shift
  FROM rebalance_agg ra
  INNER JOIN scenario_agg sa ON ra.investor_id = sa.investor_id
),
normalized_metrics AS (
  SELECT
    investor_id,
    total_rebalance_amount,
    total_scenario_shift,
    (
      (total_rebalance_amount - MIN(total_rebalance_amount) OVER())
      / NULLIF((MAX(total_rebalance_amount) OVER() - MIN(total_rebalance_amount) OVER()), 0)
    ) AS normalized_rebalance_amount,
    (
      (total_scenario_shift - MIN(total_scenario_shift) OVER())
      / NULLIF((MAX(total_scenario_shift) OVER() - MIN(total_scenario_shift) OVER()), 0)
    ) AS normalized_scenario_shift
  FROM joined_metrics
),
ranked AS (
  SELECT
    investor_id,
    total_rebalance_amount,
    total_scenario_shift,
    100 * ((normalized_rebalance_amount + normalized_scenario_shift) / 2) AS composite_score
  FROM normalized_metrics
  ORDER BY composite_score DESC, investor_id
  LIMIT 10
)
SELECT
  investor_id,
  total_rebalance_amount,
