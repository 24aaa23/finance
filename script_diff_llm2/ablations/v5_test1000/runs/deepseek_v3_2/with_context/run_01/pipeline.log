    FROM "ATOM_EVENT_REBALANCING_ACTION_001"
    GROUP BY "investor_id"
),
scenario_shift_per_investor AS (
    SELECT "investor_id", AVG("new_allocation_pct" - "current_allocation_pct") AS "investor_scenario_allocation_shift"
    FROM "ATOM_EVENT_SCENARIO_REBALANCING_001"
    GROUP BY "investor_id"
),
aggregated AS (
    SELECT 
        ir."risk_tolerance",
        AVG(ncf."investor_net_cash_flow") AS "avg_net_cash_flow",
        AVG(cfa."investor_avg_cash_flow_amount") AS "avg_cash_flow_amount",
        AVG(thv."investor_total_holding_value") AS "avg_total_holding_value",
        AVG(trb."investor_total_rebalance_amount") AS "avg_total_rebalance_amount",
        AVG(ss."investor_scenario_allocation_shift") AS "avg_scenario_allocation_shift"
    FROM investor_risk ir
    LEFT JOIN net_cash_flow_per_investor ncf ON ir."investor_id" = ncf."investor_id"
    LEFT JOIN cash_flow_amount_per_investor cfa ON ir."investor_id" = cfa."investor_id"
    LEFT JOIN total_holding_value_per_investor thv ON ir."investor_id" = thv."investor_id"
    LEFT JOIN total_rebalance_amount_per_investor trb ON ir."investor_id" = trb."investor_id"
    LEFT JOIN scenario_shift_per_investor ss ON ir."investor_id" = ss."investor_id"
    GROUP BY ir."risk_tolerance"
)
SELECT "risk_tolerance", "avg_net_cash_flow", "avg_cash_flow_amount", "avg_total_holding_value", "avg_total_rebalance_amount", "avg_scenario_allocation_shift"
