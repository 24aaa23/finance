  SELECT investor_id, AVG(amount) AS investor_avg_cash_flow_amount
  FROM ATOM_EVENT_CASH_FLOW_001
  GROUP BY investor_id
),
total_sector_investment_per_inv AS (
  SELECT investor_id, SUM(total_investment) AS investor_total_sector_investment
  FROM ATOM_ENTITY_SECTOR_ALLOCATION_001
  GROUP BY investor_id
),
scenario_allocation_shift_per_inv AS (
  SELECT investor_id, AVG(new_allocation_pct - current_allocation_pct) AS investor_scenario_allocation_shift
  FROM ATOM_EVENT_SCENARIO_REBALANCING_001
  GROUP BY investor_id
)
SELECT 
  profile.risk_tolerance,
  AVG(net_cash.investor_net_cash_flow) AS avg_net_cash_flow,
  AVG(avg_cash.investor_avg_cash_flow_amount) AS avg_cash_flow_amount,
  AVG(sector.investor_total_sector_investment) AS avg_total_sector_investment,
  AVG(shift.investor_scenario_allocation_shift) AS avg_scenario_allocation_shift
FROM ATOM_ENTITY_INVESTOR_PROFILE_001 profile
LEFT JOIN net_cash_flow_per_inv net_cash ON profile.investor_id = net_cash.investor_id
LEFT JOIN avg_cash_flow_amount_per_inv avg_cash ON profile.investor_id = avg_cash.investor_id
LEFT JOIN total_sector_investment_per_inv sector ON profile.investor_id = sector.investor_id
LEFT JOIN scenario_allocation_shift_per_inv shift ON profile.investor_id = shift.investor_id
GROUP BY profile.risk_tolerance;
