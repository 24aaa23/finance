[SQL GENERATE] Generated SQL: WITH profile_groups AS (
  SELECT DISTINCT
    "investor_id",
    "risk_tolerance" AS "risk_tolerance"
  FROM "ATOM_ENTITY_INVESTOR_PROFILE_001"
),
holdings_per_investor AS (
  SELECT
    "investor_id",
    COUNT("holding_id") AS "holdings_count"
  FROM "ATOM_ENTITY_PORTFOLIO_HOLDING_001"
  GROUP BY "investor_id"
),
cash_flow_per_investor AS (
  SELECT
    "investor_id",
    SUM("amount") AS "net_cash_flow"
  FROM "ATOM_EVENT_CASH_FLOW_001"
  GROUP BY "investor_id"
),
risk_per_investor AS (
  SELECT
    "investor_id",
    AVG("risk_score") AS "investor_risk_score"
  FROM "ATOM_ENTITY_PORTFOLIO_HEALTH_001"
  GROUP BY "investor_id"
),
grouped_result AS (
  SELECT
    p."risk_tolerance",
    AVG(COALESCE(h."holdings_count", 0)) AS "avg_holdings_per_investor",
    AVG(c."net_cash_flow") AS "avg_net_cash_flow_per_investor",
    AVG(r."investor_risk_score") AS "avg_risk_score"
  FROM profile_groups p
  LEFT JOIN holdings_per_investor h
    ON p."investor_id" = h."investor_id"
  LEFT JOIN cash_flow_per_investor c
    ON p."investor_id" = c."investor_id"
  LEFT JOIN risk_per_investor r
    ON p."investor_id" = r."investor_id"
  GROUP BY p."risk_tolerance"
)
SELECT
  "risk_tolerance",
  "avg_holdings_per_investor",
  "avg_net_cash_flow_per_investor",
  "avg_risk_score"
FROM grouped_result;

