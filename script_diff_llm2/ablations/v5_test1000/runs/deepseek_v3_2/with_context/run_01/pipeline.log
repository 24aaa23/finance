[SQL GENERATE] Generated SQL: WITH holdings_per_investor AS (
  SELECT
    investor_id,
    COUNT(holding_id) AS holdings_count
  FROM ATOM_ENTITY_PORTFOLIO_HOLDING_001
  GROUP BY investor_id
),
cash_flow_per_investor AS (
  SELECT
    investor_id,
    SUM(amount) AS net_cash_flow
  FROM ATOM_EVENT_CASH_FLOW_001
  GROUP BY investor_id
),
risk_scores AS (
  SELECT
    investor_id,
    risk_score
  FROM ATOM_ENTITY_PORTFOLIO_HEALTH_001
)
SELECT
  ip.time_horizon,
  AVG(COALESCE(hpi.holdings_count, 0)) AS avg_holdings_per_investor,
  AVG(cfi.net_cash_flow) AS avg_net_cash_flow_per_investor,
  AVG(rs.risk_score) AS avg_risk_score
FROM ATOM_ENTITY_INVESTOR_PROFILE_001 ip
LEFT JOIN holdings_per_investor hpi ON ip.investor_id = hpi.investor_id
LEFT JOIN cash_flow_per_investor cfi ON ip.investor_id = cfi.investor_id
LEFT JOIN risk_scores rs ON ip.investor_id = rs.investor_id
GROUP BY ip.time_horizon
ORDER BY ip.time_horizon
