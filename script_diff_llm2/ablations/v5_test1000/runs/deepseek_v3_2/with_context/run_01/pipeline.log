  AVG(aa.allocation_pct_avg) AS avg_allocation_pct,
  AVG(ss.scenario_shift_avg) AS avg_scenario_shift
FROM investor_profile ip
LEFT JOIN total_investment_per_investor ti ON ip.investor_id = ti.investor_id
LEFT JOIN avg_allocation_per_investor aa ON ip.investor_id = aa.investor_id
LEFT JOIN scenario_shift_per_investor ss ON ip.investor_id = ss.investor_id
GROUP BY ip.risk_tolerance
ORDER BY ip.risk_tolerance;
