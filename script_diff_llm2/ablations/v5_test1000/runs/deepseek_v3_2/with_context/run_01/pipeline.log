[SQL GENERATE] Generated SQL: WITH measure_portfolio AS (
    SELECT 
        ph.investor_id,
        COUNT(DISTINCT investor_id) AS investor_ids_per_entity
    FROM ATOM_ENTITY_PORTFOLIO_HEALTH_001 AS ph
    WHERE ph.risk_score > 25
    GROUP BY ph.investor_id
),
measure_holding AS (
    SELECT 
        h.investor_id,
        COUNT(DISTINCT investor_id) AS investor_ids_per_entity
    FROM ATOM_ENTITY_PORTFOLIO_HOLDING_001 AS h
    WHERE h.investment_type = 'Corporate Bond'
    GROUP BY h.investor_id
),
measure_cash_flow AS (
    SELECT 
        cf.investor_id,
        COUNT(DISTINCT investor_id) AS investor_ids_per_entity
    FROM ATOM_EVENT_CASH_FLOW_001 AS cf
    WHERE cf.type = 'Withdrawal'
    GROUP BY cf.investor_id
)
SELECT 
    ip.risk_tolerance AS risk_tolerance,
    COUNT(DISTINCT ip.investor_id) AS investor_ids
FROM ATOM_ENTITY_INVESTOR_PROFILE_001 AS ip
INNER JOIN measure_portfolio AS mp ON ip.investor_id = mp.investor_id
INNER JOIN measure_holding AS mh ON ip.investor_id = mh.investor_id
INNER JOIN measure_cash_flow AS mcf ON ip.investor_id = mcf.investor_id
GROUP BY ip.risk_tolerance

