[SQL GENERATE] Generated SQL: WITH net_cash_flow_cte AS (
  SELECT investor_id, SUM(amount) AS net_cash_flow
  FROM ATOM_EVENT_CASH_FLOW_001
  GROUP BY investor_id
),
total_sector_investment_cte AS (
  SELECT investor_id, SUM(total_investment) AS total_sector_investment
  FROM ATOM_ENTITY_SECTOR_ALLOCATION_001
  GROUP BY investor_id
),
scenario_allocation_shift_cte AS (
  SELECT investor_id, SUM(new_allocation_pct - current_allocation_pct) AS scenario_allocation_shift
  FROM ATOM_EVENT_SCENARIO_REBALANCING_001
  GROUP BY investor_id
),
investor_components AS (
  SELECT 
    ip.investor_id,
    ncf.net_cash_flow,
    tsi.total_sector_investment,
    sas.scenario_allocation_shift
  FROM ATOM_ENTITY_INVESTOR_PROFILE_001 ip
  INNER JOIN net_cash_flow_cte ncf ON ip.investor_id = ncf.investor_id
  INNER JOIN total_sector_investment_cte tsi ON ip.investor_id = tsi.investor_id
  INNER JOIN scenario_allocation_shift_cte sas ON ip.investor_id = sas.investor_id
  WHERE ip.investor_id IN (SELECT investor_id FROM ATOM_ENTITY_INVESTOR_PROFILE_001)
  AND ip.investor_id IN (SELECT investor_id FROM net_cash_flow_cte)
  AND ip.investor_id IN (SELECT investor_id FROM total_sector_investment_cte)
  AND ip.investor_id IN (SELECT investor_id FROM scenario_allocation_shift_cte)
),
min_max AS (
  SELECT 
    MIN(net_cash_flow) AS min_ncf,
    MAX(net_cash_flow) AS max_ncf,
    MIN(total_sector_investment) AS min_tsi,
    MAX(total_sector_investment) AS max_tsi,
    MIN(scenario_allocation_shift) AS min_sas,
    MAX(scenario_allocation_shift) AS max_sas
  FROM investor_components
),
normalized_components AS (
  SELECT 
    ic.investor_id,
    (ic.net_cash_flow - mm.min_ncf) / NULLIF(mm.max_ncf - mm.min_ncf, 0) AS normalized_net_cash_flow,
    (ic.total_sector_investment - mm.min_tsi) / NULLIF(mm.max_tsi - mm.min_tsi, 0) AS normalized_total_sector_investment,
    (ic.scenario_allocation_shift - mm.min_sas) / NULLIF(mm.max_sas - mm.min_sas, 0) AS normalized_scenario_allocation_shift
  FROM investor_components ic
  CROSS JOIN min_max mm
),
composite_scores AS (
  SELECT 
    investor_id,
    100.0 * ((normalized_net_cash_flow + normalized_total_sector_investment + normalized_scenario_allocation_shift) / 3.0) AS composite_score
  FROM normalized_components
)
SELECT 
  investor_id,
  composite_score
FROM composite_scores
ORDER BY composite_score DESC, investor_id
LIMIT 10
