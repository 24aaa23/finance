PREFIX wm: <https://wealth.example.org/ontology/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?investorId
WHERE {
  ?investor rdf:type wm:Investor ;
            wm:riskTolerance "Moderate" ;
            wm:investorId ?investorId .
  {
    SELECT ?investor (MAX(xsd:decimal(?shortfall)) AS ?has_underfunded_goal)
    WHERE {
      ?goal rdf:type wm:InvestmentGoal ;
            wm:belongsToInvestor ?investor ;
            wm:shortfall ?shortfall .
      FILTER(xsd:decimal(?shortfall) > 0)
    }
    GROUP BY ?investor
  }
  {
    SELECT ?investor (SUM(xsd:decimal(?amount)) AS ?net_cash_flow_2025)
    WHERE {
      ?cashFlow rdf:type wm:CashFlow ;
                wm:cashFlowOfInvestor ?investor ;
                wm:date ?date ;
                wm:amount ?amount .
      FILTER(CONTAINS(STR(?date), "2025"))
    }
    GROUP BY ?investor
    HAVING (SUM(xsd:decimal(?amount)) < 0)
  }
}

