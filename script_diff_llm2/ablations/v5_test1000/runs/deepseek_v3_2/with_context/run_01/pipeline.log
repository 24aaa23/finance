        SUM("amount") AS "investor_net_cash_flow"
    FROM "ATOM_EVENT_CASH_FLOW_001"
    GROUP BY "investor_id"
),
per_investor_signed_cash_flow_amount AS (
    SELECT
        "investor_id",
        AVG("amount") AS "investor_signed_cash_flow_amount"
    FROM "ATOM_EVENT_CASH_FLOW_001"
    GROUP BY "investor_id"
),
per_investor_cash_flow_count AS (
    SELECT
        "investor_id",
        COUNT("cash_flow_id") AS "investor_cash_flow_count"
    FROM "ATOM_EVENT_CASH_FLOW_001"
    GROUP BY "investor_id"
),
final_grouped AS (
    SELECT
        prof."segment" AS "segment",
        AVG(net_cf."investor_net_cash_flow") AS "avg_net_cash_flow",
        AVG(signed_cf."investor_signed_cash_flow_amount") AS "avg_signed_cash_flow_amount",
        AVG(COALESCE(count_cf."investor_cash_flow_count", 0)) AS "avg_cash_flow_count"
    FROM "ATOM_ENTITY_INVESTOR_PROFILE_001" AS prof
    LEFT JOIN per_investor_net_cash_flow AS net_cf
        ON prof."investor_id" = net_cf."investor_id"
    LEFT JOIN per_investor_signed_cash_flow_amount AS signed_cf
        ON prof."investor_id" = signed_cf."investor_id"
    LEFT JOIN per_investor_cash_flow_count AS count_cf
        ON prof."investor_id" = count_cf."investor_id"
    GROUP BY prof."segment"
    ORDER BY prof."segment" ASC
)
SELECT
    "segment",
    "avg_net_cash_flow",
    "avg_signed_cash_flow_amount",
    "avg_cash_flow_count"
FROM final_grouped;
