  AVG(si.total_sector_investment) AS average_total_sector_investment_per_investor,
  AVG(hr.avg_returns) AS average_holding_return_per_investor,
  AVG(rs.avg_risk_score) AS average_risk_score
FROM ATOM_ENTITY_INVESTOR_PROFILE_001 p
LEFT JOIN sector_investment si ON p.investor_id = si.investor_id
LEFT JOIN holding_returns hr ON p.investor_id = hr.investor_id
LEFT JOIN risk_scores rs ON p.investor_id = rs.investor_id
GROUP BY p.time_horizon
