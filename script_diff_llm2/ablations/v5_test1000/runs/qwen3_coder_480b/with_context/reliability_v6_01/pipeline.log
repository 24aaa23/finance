[SQL GENERATE] Generated SQL: WITH cash_in AS (
  SELECT
    investor_id,
    SUM(amount) AS total_cash_in
  FROM ATOM_EVENT_CASH_FLOW_001
  WHERE type IN ('Deposit', 'Dividend Reinvestment', 'Interest Credit', 'Lump Sum', 'SIP', 'Tax Refund')
  GROUP BY investor_id
),
cash_out AS (
  SELECT
    investor_id,
    SUM(amount) AS total_cash_out
  FROM ATOM_EVENT_CASH_FLOW_001
  WHERE type IN ('Redemption', 'Withdrawal')
  GROUP BY investor_id
),
cash_flow AS (
  SELECT
    investor_id,
    SUM(amount) AS total_cash_flow_amount
  FROM ATOM_EVENT_CASH_FLOW_001
  GROUP BY investor_id
),
holdings AS (
  SELECT
    investor_id,
    SUM(current_value) AS total_holding_value
  FROM ATOM_ENTITY_PORTFOLIO_HOLDING_001
  GROUP BY investor_id
),
rebalances AS (
  SELECT
    investor_id,
    SUM(amount) AS total_rebalance_amount
  FROM ATOM_EVENT_REBALANCING_ACTION_001
  GROUP BY investor_id
),
risk_scores AS (
  SELECT
    investor_id,
    AVG(risk_score) AS average_risk_score
  FROM ATOM_ENTITY_PORTFOLIO_HEALTH_001
  GROUP BY investor_id
)
SELECT
  p.risk_tolerance,
  AVG(COALESCE(ci.total_cash_in, 0) - COALESCE(co.total_cash_out, 0)) AS average_net_cash_flow,
  AVG(COALESCE(cf.total_cash_flow_amount, 0)) AS average_cash_flow_amount,
  AVG(COALESCE(h.total_holding_value, 0)) AS average_total_holding_value,
  AVG(COALESCE(r.total_rebalance_amount, 0)) AS average_total_rebalance_amount,
  AVG(COALESCE(rs.average_risk_score, 0)) AS average_risk_score
FROM ATOM_ENTITY_INVESTOR_PROFILE_001 p
LEFT JOIN cash_in ci ON p.investor_id = ci.investor_id
LEFT JOIN cash_out co ON p.investor_id = co.investor_id
LEFT JOIN cash_flow cf ON p.investor_id = cf.investor_id
LEFT JOIN holdings h ON p.investor_id = h.investor_id
LEFT JOIN rebalances r ON p.investor_id = r.investor_id
LEFT JOIN risk_scores rs ON p.investor_id = rs.investor_id
GROUP BY p.risk_tolerance

