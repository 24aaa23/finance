[SQL GENERATE] Generated SQL: WITH cash_flow AS (
  SELECT
    investor_id,
    SUM(amount) AS net_cash_flow
  FROM ATOM_EVENT_CASH_FLOW_001
  GROUP BY investor_id
),
rebalance AS (
  SELECT
    investor_id,
    SUM(amount) AS total_rebalance_amount
  FROM ATOM_EVENT_REBALANCING_ACTION_001
  GROUP BY investor_id
),
risk_scores AS (
  SELECT
    investor_id,
    AVG(risk_score) AS risk_score
  FROM ATOM_ENTITY_PORTFOLIO_HEALTH_001
  GROUP BY investor_id
),
goal_shortfall AS (
  SELECT
    investor_id,
    AVG(shortfall) AS average_goal_shortfall
  FROM ATOM_ENTITY_INVESTMENT_GOAL_001
  GROUP BY investor_id
),
all_metrics AS (
  SELECT
    ip.investor_id,
    cf.net_cash_flow,
    rb.total_rebalance_amount,
    rs.risk_score,
    gs.average_goal_shortfall
  FROM ATOM_ENTITY_INVESTOR_PROFILE_001 ip
  INNER JOIN cash_flow cf ON ip.investor_id = cf.investor_id
  INNER JOIN rebalance rb ON ip.investor_id = rb.investor_id
  INNER JOIN risk_scores rs ON ip.investor_id = rs.investor_id
  INNER JOIN goal_shortfall gs ON ip.investor_id = gs.investor_id
),
normalized_scores AS (
  SELECT
    investor_id,
    (net_cash_flow - MIN(net_cash_flow) OVER ()) / (MAX(net_cash_flow) OVER () - MIN(net_cash_flow) OVER ()) AS net_cash_flow_normalized,
    (total_rebalance_amount - MIN(total_rebalance_amount) OVER ()) / (MAX(total_rebalance_amount) OVER () - MIN(total_rebalance_amount) OVER ()) AS total_rebalance_amount_normalized,
    (risk_score - MIN(risk_score) OVER ()) / (MAX(risk_score) OVER () - MIN(risk_score) OVER ()) AS risk_score_normalized,
    (average_goal_shortfall - MIN(average_goal_shortfall) OVER ()) / (MAX(average_goal_shortfall) OVER () - MIN(average_goal_shortfall) OVER ()) AS average_goal_shortfall_normalized
  FROM all_metrics
),
final_scores AS (
  SELECT
    ns.investor_id,
    100 * ((ns.net_cash_flow_normalized + ns.total_rebalance_amount_normalized + ns.risk_score_normalized + (1 - ns.average_goal_shortfall_normalized)) / 4) AS composite_score
  FROM normalized_scores ns
)
SELECT
  fs.investor_id,
  fs.composite_score
FROM final_scores fs
ORDER BY fs.composite_score DESC, fs.investor_id ASC
LIMIT 10;

