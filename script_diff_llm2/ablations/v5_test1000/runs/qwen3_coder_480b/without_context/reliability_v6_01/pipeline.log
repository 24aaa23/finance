[SQL GENERATE] Generated SQL: WITH cash_flow_totals AS (
  SELECT 
    investor_id,
    SUM(CASE WHEN type IN ('Deposit', 'Dividend Reinvestment', 'Interest Credit', 'Lump Sum', 'SIP', 'Tax Refund') THEN amount ELSE 0 END) AS total_cash_in,
    SUM(CASE WHEN type IN ('Redemption', 'Withdrawal') THEN amount ELSE 0 END) AS total_cash_out
  FROM ATOM_EVENT_CASH_FLOW_001
  GROUP BY investor_id
),
investor_cash_flow AS (
  SELECT 
    investor_id,
    AVG(amount) AS average_cash_flow_amount
  FROM ATOM_EVENT_CASH_FLOW_001
  GROUP BY investor_id
),
investor_holdings AS (
  SELECT 
    investor_id,
    SUM(current_value) AS total_holding_value
  FROM ATOM_ENTITY_PORTFOLIO_HOLDING_001
  GROUP BY investor_id
),
investor_risk AS (
  SELECT 
    investor_id,
    AVG(risk_score) AS average_risk_score
  FROM ATOM_ENTITY_PORTFOLIO_HEALTH_001
  GROUP BY investor_id
)
SELECT 
  p.risk_tolerance,
  AVG(cft.total_cash_in - cft.total_cash_out) AS average_net_cash_flow,
  AVG(icf.average_cash_flow_amount) AS average_cash_flow_amount,
  AVG(ih.total_holding_value) AS average_total_holding_value,
  AVG(ir.average_risk_score) AS average_risk_score
FROM ATOM_ENTITY_INVESTOR_PROFILE_001 p
JOIN cash_flow_totals cft ON p.investor_id = cft.investor_id
JOIN investor_cash_flow icf ON p.investor_id = icf.investor_id
JOIN investor_holdings ih ON p.investor_id = ih.investor_id
JOIN investor_risk ir ON p.investor_id = ir.investor_id
GROUP BY p.risk_tolerance;
