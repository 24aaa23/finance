[SQL GENERATE] Generated SQL: WITH net_cash_flow_agg AS (
  SELECT investor_id, SUM(amount) AS net_cash_flow
  FROM ATOM_EVENT_CASH_FLOW_001
  GROUP BY investor_id
),
total_sector_investment_agg AS (
  SELECT investor_id, SUM(total_investment) AS total_sector_investment
  FROM ATOM_ENTITY_SECTOR_ALLOCATION_001
  GROUP BY investor_id
),
total_scenario_allocation_shift_agg AS (
  SELECT investor_id, SUM(new_allocation_pct - current_allocation_pct) AS total_scenario_allocation_shift
  FROM ATOM_EVENT_SCENARIO_REBALANCING_001
  GROUP BY investor_id
),
risk_score_agg AS (
  SELECT investor_id, MAX(risk_score) AS risk_score
  FROM ATOM_ENTITY_PORTFOLIO_HEALTH_001
  GROUP BY investor_id
),
joined_data AS (
  SELECT 
    ip.investor_id,
    ncf.net_cash_flow,
    tsi.total_sector_investment,
    tsas.total_scenario_allocation_shift,
    rs.risk_score
  FROM ATOM_ENTITY_INVESTOR_PROFILE_001 ip
  INNER JOIN net_cash_flow_agg ncf ON ip.investor_id = ncf.investor_id
  INNER JOIN total_sector_investment_agg tsi ON ip.investor_id = tsi.investor_id
  INNER JOIN total_scenario_allocation_shift_agg tsas ON ip.investor_id = tsas.investor_id
  INNER JOIN risk_score_agg rs ON ip.investor_id = rs.investor_id
)
SELECT 
  investor_id,
  100 * ((
    (net_cash_flow - MIN(net_cash_flow) OVER ()) / (MAX(net_cash_flow) OVER () - MIN(net_cash_flow) OVER ()) +
    (total_sector_investment - MIN(total_sector_investment) OVER ()) / (MAX(total_sector_investment) OVER () - MIN(total_sector_investment) OVER ()) +
    (total_scenario_allocation_shift - MIN(total_scenario_allocation_shift) OVER ()) / (MAX(total_scenario_allocation_shift) OVER () - MIN(total_scenario_allocation_shift) OVER ()) +
    (risk_score - MIN(risk_score) OVER ()) / (MAX(risk_score) OVER () - MIN(risk_score) OVER ())
  ) / 4) AS composite_score
FROM joined_data
ORDER BY composite_score DESC, investor_id
LIMIT 10;
