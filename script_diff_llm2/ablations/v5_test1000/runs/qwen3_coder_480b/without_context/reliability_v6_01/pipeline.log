JOIN per_investor_cash_flow pcfa ON ip.investor_id = pcfa.investor_id
JOIN per_investor_risk_score prs ON ip.investor_id = prs.investor_id
JOIN per_investor_goal_progress pgp ON ip.investor_id = pgp.investor_id
