[SQL GENERATE] Generated SQL: WITH rebalance_metrics AS (
  SELECT investor_id, 
         AVG(amount) AS avg_rebalance_amount,
         AVG(target_allocation_pct - current_allocation_pct) AS avg_rebalance_shift
  FROM ATOM_EVENT_REBALANCING_ACTION_001
  GROUP BY investor_id
),
goal_progress AS (
  SELECT investor_id, 
         AVG(progress_pct) AS avg_goal_progress
  FROM ATOM_ENTITY_INVESTMENT_GOAL_001
  GROUP BY investor_id
)
SELECT p.risk_tolerance,
       AVG(r.avg_rebalance_amount) AS average_rebalance_amount,
       AVG(r.avg_rebalance_shift) AS average_rebalance_shift,
       AVG(g.avg_goal_progress) AS average_goal_progress
FROM ATOM_ENTITY_INVESTOR_PROFILE_001 p
JOIN rebalance_metrics r ON p.investor_id = r.investor_id
JOIN goal_progress g ON p.investor_id = g.investor_id
GROUP BY p.risk_tolerance
