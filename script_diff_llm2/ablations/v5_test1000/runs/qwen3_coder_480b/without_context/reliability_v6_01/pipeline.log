    AVG(progress_pct) AS average_goal_progress
  FROM ATOM_ENTITY_INVESTMENT_GOAL_001
  GROUP BY investor_id
)
SELECT 
  ip.risk_tolerance,
  AVG(cfs.total_deposits - cfs.total_withdrawals) AS average_net_cash_flow,
  AVG(pcfa.average_cash_flow_amount) AS average_cash_flow_amount,
