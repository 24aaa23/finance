    (ss.total_scenario_allocation_shift - MIN(ss.total_scenario_allocation_shift) OVER ()) / 
    (MAX(ss.total_scenario_allocation_shift) OVER () - MIN(ss.total_scenario_allocation_shift) OVER ())
  ) / 2 AS composite_score
FROM ATOM_ENTITY_INVESTOR_PROFILE_001 ip
JOIN rebalance_amounts ra ON ip.investor_id = ra.investor_id
JOIN scenario_shifts ss ON ip.investor_id = ss.investor_id
ORDER BY composite_score DESC, ip.investor_id
