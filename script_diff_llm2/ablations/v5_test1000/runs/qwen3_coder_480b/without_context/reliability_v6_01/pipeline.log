[SQL GENERATE] Generated SQL: WITH cash_flow AS (
  SELECT
    investor_id,
    SUM(amount) AS net_cash_flow
  FROM ATOM_EVENT_CASH_FLOW_001
  GROUP BY investor_id
),
holding_gain AS (
  SELECT
    investor_id,
    SUM(current_value - cost) AS total_holding_gain
  FROM ATOM_ENTITY_PORTFOLIO_HOLDING_001
  WHERE cost IS NOT NULL AND current_value IS NOT NULL
  GROUP BY investor_id
),
scenario_shift AS (
  SELECT
    investor_id,
    SUM(new_allocation_pct - current_allocation_pct) AS total_scenario_allocation_shift
  FROM ATOM_EVENT_SCENARIO_REBALANCING_001
  GROUP BY investor_id
),
all_metrics AS (
  SELECT
    ip.investor_id,
    cf.net_cash_flow,
    hg.total_holding_gain,
    ss.total_scenario_allocation_shift
  FROM ATOM_ENTITY_INVESTOR_PROFILE_001 ip
  INNER JOIN cash_flow cf ON ip.investor_id = cf.investor_id
  INNER JOIN holding_gain hg ON ip.investor_id = hg.investor_id
  INNER JOIN scenario_shift ss ON ip.investor_id = ss.investor_id
),
normalized_scores AS (
  SELECT
    investor_id,
    net_cash_flow,
    total_holding_gain,
    total_scenario_allocation_shift,
    (net_cash_flow - MIN(net_cash_flow) OVER ()) / (MAX(net_cash_flow) OVER () - MIN(net_cash_flow) OVER ()) AS net_cash_flow_normalized,
