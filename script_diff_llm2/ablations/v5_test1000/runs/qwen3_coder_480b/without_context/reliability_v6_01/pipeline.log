[SQL GENERATE] Generated SQL: WITH holdings_per_investor AS (
  SELECT investor_id, COUNT(holding_id) AS num_holdings
  FROM ATOM_ENTITY_PORTFOLIO_HOLDING_001
  GROUP BY investor_id
),
cash_flow_per_investor AS (
  SELECT investor_id, SUM(amount) AS net_cash_flow
  FROM ATOM_EVENT_CASH_FLOW_001
  GROUP BY investor_id
),
risk_scores AS (
  SELECT investor_id, risk_score
  FROM ATOM_ENTITY_PORTFOLIO_HEALTH_001
)
SELECT 
  p.time_horizon,
  AVG(h.num_holdings) AS average_number_of_holdings_per_investor,
  AVG(c.net_cash_flow) AS average_net_cash_flow_amount_per_investor,
  AVG(r.risk_score) AS average_risk_score
FROM ATOM_ENTITY_INVESTOR_PROFILE_001 p
JOIN holdings_per_investor h ON p.investor_id = h.investor_id
JOIN cash_flow_per_investor c ON p.investor_id = c.investor_id
JOIN risk_scores r ON p.investor_id = r.investor_id
GROUP BY p.time_horizon;
[SQL GENERATE] Using physical tables: ['ATOM_ENTITY_INVESTMENT_GOAL_001', 'ATOM_ENTITY_INVESTOR_PROFILE_001', 'ATOM_ENTITY_PORTFOLIO_HEALTH_001', 'ATOM_ENTITY_PORTFOLIO_HOLDING_001', 'ATOM_ENTITY_SECTOR_ALLOCATION_001', 'ATOM_EVENT_CASH_FLOW_001', 'ATOM_EVENT_REBALANCING_ACTION_001', 'ATOM_EVENT_SCENARIO_REBALANCING_001']
[SQL GENERATE] Generated SQL: WITH sector_investment AS (
  SELECT
    investor_id,
    SUM(total_investment) AS total_sector_investment
  FROM ATOM_ENTITY_SECTOR_ALLOCATION_001
  GROUP BY investor_id
),
holding_returns AS (
  SELECT
    investor_id,
    AVG(returns_pct) AS avg_holding_return
  FROM ATOM_ENTITY_PORTFOLIO_HOLDING_001
  WHERE cost IS NOT NULL AND current_value IS NOT NULL
  GROUP BY investor_id
),
risk_scores AS (
  SELECT
    investor_id,
    AVG(risk_score) AS avg_risk_score
  FROM ATOM_ENTITY_PORTFOLIO_HEALTH_001
  GROUP BY investor_id
)
SELECT
  p.risk_tolerance,
  AVG(s.total_sector_investment) AS average_total_sector_investment_per_investor,
  AVG(h.avg_holding_return) AS average_holding_return_per_investor,
  AVG(r.avg_risk_score) AS average_risk_score
FROM ATOM_ENTITY_INVESTOR_PROFILE_001 p
LEFT JOIN sector_investment s ON p.investor_id = s.investor_id
LEFT JOIN holding_returns h ON p.investor_id = h.investor_id
LEFT JOIN risk_scores r ON p.investor_id = r.investor_id
GROUP BY p.risk_tolerance;
