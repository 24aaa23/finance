[SQL GENERATE] Generated SQL: WITH cash_flow AS (
  SELECT investor_id, SUM(amount) AS net_cash_flow
  FROM ATOM_EVENT_CASH_FLOW_001
  GROUP BY investor_id
),
rebalance_amount AS (
  SELECT investor_id, SUM(amount) AS total_rebalance_amount
  FROM ATOM_EVENT_REBALANCING_ACTION_001
  GROUP BY investor_id
),
risk_scores AS (
  SELECT investor_id, AVG(risk_score) AS risk_score
  FROM ATOM_ENTITY_PORTFOLIO_HEALTH_001
  GROUP BY investor_id
),
goal_shortfall AS (
  SELECT investor_id, AVG(shortfall) AS average_goal_shortfall
  FROM ATOM_ENTITY_INVESTMENT_GOAL_001
  GROUP BY investor_id
),
common_investors AS (
  SELECT ip.investor_id
  FROM ATOM_ENTITY_INVESTOR_PROFILE_001 ip
  INNER JOIN cash_flow cf ON ip.investor_id = cf.investor_id
  INNER JOIN rebalance_amount ra ON ip.investor_id = ra.investor_id
  INNER JOIN risk_scores rs ON ip.investor_id = rs.investor_id
  INNER JOIN goal_shortfall gs ON ip.investor_id = gs.investor_id
),
aggregates AS (
  SELECT
    ci.investor_id,
    cf.net_cash_flow,
    ra.total_rebalance_amount,
    rs.risk_score,
    gs.average_goal_shortfall
  FROM common_investors ci
  INNER JOIN cash_flow cf ON ci.investor_id = cf.investor_id
  INNER JOIN rebalance_amount ra ON ci.investor_id = ra.investor_id
  INNER JOIN risk_scores rs ON ci.investor_id = rs.investor_id
  INNER JOIN goal_shortfall gs ON ci.investor_id = gs.investor_id
),
normalized AS (
  SELECT
    investor_id,
    net_cash_flow,
    total_rebalance_amount,
    risk_score,
    average_goal_shortfall,
    (net_cash_flow - MIN(net_cash_flow) OVER ()) / NULLIF(MAX(net_cash_flow) OVER () - MIN(net_cash_flow) OVER (), 0) AS net_cash_flow_normalized,
    (total_rebalance_amount - MIN(total_rebalance_amount) OVER ()) / NULLIF(MAX(total_rebalance_amount) OVER () - MIN(total_rebalance_amount) OVER (), 0) AS total_rebalance_amount_normalized,
    (risk_score - MIN(risk_score) OVER ()) / NULLIF(MAX(risk_score) OVER () - MIN(risk_score) OVER (), 0) AS risk_score_normalized,
    (average_goal_shortfall - MIN(average_goal_shortfall) OVER ()) / NULLIF(MAX(average_goal_shortfall) OVER () - MIN(average_goal_shortfall) OVER (), 0) AS average_goal_shortfall_normalized
  FROM aggregates
)
SELECT
  investor_id,
  100 * ((net_cash_flow_normalized + total_rebalance_amount_normalized + risk_score_normalized + (1 - average_goal_shortfall_normalized)) / 4) AS composite_score
FROM normalized
ORDER BY composite_score DESC, investor_id
LIMIT 10;
