  SELECT investor_id, SUM(new_allocation_pct - current_allocation_pct) AS total_scenario_shift
  FROM ATOM_EVENT_SCENARIO_REBALANCING_001
  GROUP BY investor_id
),
avg_goal_shortfall_agg AS (
  SELECT investor_id, AVG(shortfall) AS avg_goal_shortfall
  FROM ATOM_ENTITY_INVESTMENT_GOAL_001
  GROUP BY investor_id
),
joined_metrics AS (
  SELECT 
    ncf.investor_id,
    ncf.net_cash_flow,
    trb.total_rebalance_amount,
    tss.total_scenario_shift,
    ags.avg_goal_shortfall
  FROM net_cash_flow_agg AS ncf
  INNER JOIN total_rebalance_amount_agg AS trb ON ncf.investor_id = trb.investor_id
  INNER JOIN total_scenario_shift_agg AS tss ON ncf.investor_id = tss.investor_id
  INNER JOIN avg_goal_shortfall_agg AS ags ON ncf.investor_id = ags.investor_id
)
SELECT 
  investor_id,
  100.0 * (
    (net_cash_flow - MIN(net_cash_flow) OVER ()) / (MAX(net_cash_flow) OVER () - MIN(net_cash_flow) OVER ()) +
    (total_rebalance_amount - MIN(total_rebalance_amount) OVER ()) / (MAX(total_rebalance_amount) OVER () - MIN(total_rebalance_amount) OVER ()) +
    (total_scenario_shift - MIN(total_scenario_shift) OVER ()) / (MAX(total_scenario_shift) OVER () - MIN(total_scenario_shift) OVER ()) +
    (1 - (avg_goal_shortfall - MIN(avg_goal_shortfall) OVER ()) / (MAX(avg_goal_shortfall) OVER () - MIN(avg_goal_shortfall) OVER ()))
  ) / 4.0 AS composite_score
FROM joined_metrics
ORDER BY composite_score DESC, investor_id
LIMIT 10;

