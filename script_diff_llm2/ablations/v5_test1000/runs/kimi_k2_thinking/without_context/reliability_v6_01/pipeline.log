PREFIX wm: <https://wealth.example.org/ontology/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?investorId ?investorName
WHERE {
  ?investor rdf:type wm:Investor ;
            wm:investorId ?investorId ;
            wm:investorName ?investorName ;
            wm:riskTolerance "Conservative" .
  
  {
    SELECT ?investor (AVG(?liquidityScore) AS ?avgLiquidity)
    WHERE {
      ?investor wm:hasPortfolioHealth ?health .
      ?health wm:liquidityScore ?liquidityScore .
    }
    GROUP BY ?investor
  }
  FILTER(?avgLiquidity < 25)
  
  {
    SELECT ?investor (SUM(?shortfall) AS ?totalShortfall)
    WHERE {
      ?investor wm:hasInvestmentGoal ?goal .
      ?goal wm:shortfall ?shortfall .
    }
    GROUP BY ?investor
  }
  FILTER(?totalShortfall > 0)
  
  {
    SELECT ?investor (COUNT(*) AS ?buyActionCount)
    WHERE {
      ?investor wm:hasRebalancingAction ?action .
      ?action wm:action "Buy" .
    }
    GROUP BY ?investor
  }
  FILTER(?buyActionCount > 0)
  
  {
    SELECT ?investor (SUM(?lossFlag) AS ?lossMakingHoldings)
    WHERE {
      ?investor wm:hasHolding ?holding .
      ?holding wm:currentValue ?currentValue ;
               wm:cost ?cost .
      BIND(IF(xsd:decimal(?currentValue) < xsd:decimal(?cost), 1, 0) AS ?lossFlag)
    }
    GROUP BY ?investor
  }
  FILTER(?lossMakingHoldings > 0)
}

