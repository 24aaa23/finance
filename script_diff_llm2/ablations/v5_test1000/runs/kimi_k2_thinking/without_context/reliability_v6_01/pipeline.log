[SQL GENERATE] Generated SQL: WITH cash_flow_net AS (
  SELECT
    investor_id,
    SUM(CASE
      WHEN type IN ('Deposit', 'Dividend Reinvestment', 'Interest Credit', 'Lump Sum', 'SIP', 'Tax Refund') THEN amount
      WHEN type IN ('Redemption', 'Withdrawal') THEN -amount
      ELSE 0
    END) AS net_cash_flow_per_investor
  FROM ATOM_EVENT_CASH_FLOW_001
  GROUP BY investor_id
),
cash_flow_total AS (
  SELECT
    investor_id,
    SUM(amount) AS total_cash_flow_per_investor
  FROM ATOM_EVENT_CASH_FLOW_001
  GROUP BY investor_id
),
holding_value AS (
  SELECT
    investor_id,
    SUM(current_value) AS total_holding_value_per_investor
  FROM ATOM_ENTITY_PORTFOLIO_HOLDING_001
  GROUP BY investor_id
),
rebalance_amount AS (
  SELECT
    investor_id,
    SUM(amount) AS total_rebalance_amount_per_investor
  FROM ATOM_EVENT_REBALANCING_ACTION_001
  GROUP BY investor_id
),
goal_progress AS (
  SELECT
    investor_id,
    AVG(progress_pct) AS avg_goal_progress_per_investor
  FROM ATOM_ENTITY_INVESTMENT_GOAL_001
  GROUP BY investor_id
)
SELECT
  ip.risk_tolerance,
  AVG(cfn.net_cash_flow_per_investor) AS average_net_cash_flow,
