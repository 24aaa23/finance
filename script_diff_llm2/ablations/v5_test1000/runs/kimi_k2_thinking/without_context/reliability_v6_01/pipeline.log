  AVG(COALESCE(ms0."avg_net_cash_flow", 0)) AS "avg_net_cash_flow",
  AVG(ms0."avg_cash_flow_amount") AS "avg_cash_flow_amount",
  AVG(COALESCE(ms1."avg_total_rebalance_amount", 0)) AS "avg_total_rebalance_amount",
  AVG(COALESCE(ms2."avg_total_sector_investment", 0)) AS "avg_total_sector_investment",
  AVG(ms3."avg_risk_score") AS "avg_risk_score"
FROM "profile_groups" pg
LEFT JOIN "metric_source_0" ms0 ON pg."investor_id" = ms0."investor_id"
LEFT JOIN "metric_source_1" ms1 ON pg."investor_id" = ms1."investor_id"
LEFT JOIN "metric_source_2" ms2 ON pg."investor_id" = ms2."investor_id"
LEFT JOIN "metric_source_3" ms3 ON pg."investor_id" = ms3."investor_id"
GROUP BY pg."risk_tolerance"
ORDER BY pg."risk_tolerance";
