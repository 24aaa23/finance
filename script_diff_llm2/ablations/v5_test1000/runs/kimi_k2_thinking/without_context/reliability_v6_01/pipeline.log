LEFT JOIN cash_flow_total cft ON ip.investor_id = cft.investor_id
LEFT JOIN holding_value hv ON ip.investor_id = hv.investor_id
LEFT JOIN rebalance_amount ra ON ip.investor_id = ra.investor_id
LEFT JOIN goal_progress gp ON ip.investor_id = gp.investor_id
GROUP BY ip.risk_tolerance
