PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX wm: <https://wealth.example.org/ontology/>

SELECT ?investorId ?investorName
WHERE {
  ?investor rdf:type wm:Investor ;
            wm:investorId ?investorId ;
            wm:investorName ?investorName ;
            wm:riskTolerance "Aggressive"^^xsd:string .
  
  ?investor wm:hasPortfolioHealth ?portfolioHealth .
  ?portfolioHealth wm:liquidityScore ?liquidityScore .
  FILTER(?liquidityScore < 25)
  
  {
    SELECT ?investor (SUM(?loss_flag) AS ?loss_making_holding_count)
    WHERE {
      ?holding rdf:type wm:PortfolioHolding ;
               wm:heldByInvestor ?investor ;
               wm:cost ?cost ;
               wm:currentValue ?currentValue .
      FILTER(BOUND(?cost) && BOUND(?currentValue))
      BIND(IF(?currentValue < ?cost, 1, 0) AS ?loss_flag)
    }
    GROUP BY ?investor
  }
  
  {
    SELECT ?investor (COUNT(?goal) AS ?underfunded_goal_count)
    WHERE {
      ?goal rdf:type wm:InvestmentGoal ;
            wm:belongsToInvestor ?investor ;
            wm:shortfall ?shortfall .
      FILTER(?shortfall > 0)
    }
    GROUP BY ?investor
  }
  
  {
    SELECT ?investor (COUNT(?action) AS ?aggressive_entry_action_count)
    WHERE {
      ?action rdf:type wm:RebalancingAction ;
              wm:rebalancingActionOfInvestor ?investor ;
              wm:action "Aggressive Entry"^^xsd:string .
    }
    GROUP BY ?investor
  }
  
  FILTER(?loss_making_holding_count > 0)
  FILTER(?underfunded_goal_count > 0)
  FILTER(?aggressive_entry_action_count > 0)
}
GROUP BY ?investorId ?investorName

