  LEFT JOIN metric_source_3 ON profile_groups."investor_id" = metric_source_3."investor_id"
  GROUP BY profile_groups."risk_tolerance"
)
SELECT "risk_tolerance", "avg_net_cash_flow", "avg_cash_flow_amount", "avg_total_rebalance_amount", "avg_total_sector_investment", "avg_scenario_allocation_shift"
