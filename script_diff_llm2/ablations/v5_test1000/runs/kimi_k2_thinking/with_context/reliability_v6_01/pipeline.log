PREFIX wm: <https://wealth.example.org/ontology/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

SELECT ?investorId ?investorName
WHERE {
  ?investor rdf:type wm:Investor ;
            wm:investorId ?investorId ;
            wm:investorName ?investorName ;
            wm:timeHorizon "Long-term" .
  
  {
    SELECT ?investorId (MAX(xsd:decimal(?riskScore)) AS ?max_risk_score)
    WHERE {
      ?inv wm:hasPortfolioHealth ?health .
      ?health wm:riskScore ?riskScore .
      ?inv wm:investorId ?investorId .
    }
    GROUP BY ?investorId
  }
  
  {
    SELECT ?investorId (COUNT(DISTINCT ?holdingId) AS ?equity_holding_count)
    WHERE {
      ?inv wm:hasHolding ?holding .
      ?holding wm:investmentType "Equity" ;
                wm:holdingId ?holdingId .
      ?inv wm:investorId ?investorId .
    }
    GROUP BY ?investorId
  }
  
  {
    SELECT ?investorId (COUNT(DISTINCT ?rebalanceId) AS ?rebalancing_action_count)
    WHERE {
      ?inv wm:hasRebalancingAction ?action .
      ?action wm:rebalanceId ?rebalanceId .
      ?inv wm:investorId ?investorId .
    }
    GROUP BY ?investorId
  }
  
  FILTER (?max_risk_score > 50)
  FILTER (?equity_holding_count >= 1)
  FILTER (?rebalancing_action_count >= 1)
}

