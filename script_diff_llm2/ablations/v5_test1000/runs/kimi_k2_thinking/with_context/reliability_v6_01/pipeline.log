),
combined_measures AS (
    SELECT 
        ip.investor_id,
        cf.net_cash_flow,
        sc.total_scenario_allocation_shift,
        r.risk_score
    FROM ATOM_ENTITY_INVESTOR_PROFILE_001 AS ip
    INNER JOIN cash_flow_agg AS cf ON ip.investor_id = cf.investor_id
    INNER JOIN scenario_agg AS sc ON ip.investor_id = sc.investor_id
    INNER JOIN risk_agg AS r ON ip.investor_id = r.investor_id
),
min_max AS (
    SELECT
        MIN(net_cash_flow) AS min_cash_flow,
        MAX(net_cash_flow) AS max_cash_flow,
        MIN(total_scenario_allocation_shift) AS min_allocation_shift,
        MAX(total_scenario_allocation_shift) AS max_allocation_shift,
        MIN(risk_score) AS min_risk_score,
        MAX(risk_score) AS max_risk_score
    FROM combined_measures
)
SELECT 
    cm.investor_id,
    100.0 * (
        CASE 
            WHEN mm.max_cash_flow - mm.min_cash_flow = 0 THEN 0
            ELSE (cm.net_cash_flow - mm.min_cash_flow) / (mm.max_cash_flow - mm.min_cash_flow)
        END +
        CASE 
            WHEN mm.max_allocation_shift - mm.min_allocation_shift = 0 THEN 0
            ELSE (cm.total_scenario_allocation_shift - mm.min_allocation_shift) / (mm.max_allocation_shift - mm.min_allocation_shift)
        END +
        CASE 
            WHEN mm.max_risk_score - mm.min_risk_score = 0 THEN 0
            ELSE (cm.risk_score - mm.min_risk_score) / (mm.max_risk_score - mm.min_risk_score)
        END
    ) / 3.0 AS composite_score,
    cm.net_cash_flow,
    cm.total_scenario_allocation_shift,
    cm.risk_score,
    CASE 
        WHEN mm.max_cash_flow - mm.min_cash_flow = 0 THEN 0
        ELSE (cm.net_cash_flow - mm.min_cash_flow) / (mm.max_cash_flow - mm.min_cash_flow)
    END AS normalized_cash_flow,
    CASE 
        WHEN mm.max_allocation_shift - mm.min_allocation_shift = 0 THEN 0
        ELSE (cm.total_scenario_allocation_shift - mm.min_allocation_shift) / (mm.max_allocation_shift - mm.min_allocation_shift)
    END AS normalized_allocation_shift,
    CASE 
        WHEN mm.max_risk_score - mm.min_risk_score = 0 THEN 0
        ELSE (cm.risk_score - mm.min_risk_score) / (mm.max_risk_score - mm.min_risk_score)
    END AS normalized_risk_score
FROM combined_measures AS cm
CROSS JOIN min_max AS mm
ORDER BY 
    composite_score DESC,
    cm.investor_id ASC
LIMIT 10;
