  SELECT investor_id, SUM(amount) AS net_cash_flow
  FROM ATOM_EVENT_CASH_FLOW_001
  WHERE investor_id IS NOT NULL
  GROUP BY investor_id
),
risk_agg AS (
  SELECT investor_id, MIN(risk_score) AS risk_score
  FROM ATOM_ENTITY_PORTFOLIO_HEALTH_001
  WHERE investor_id IS NOT NULL AND risk_score IS NOT NULL
  GROUP BY investor_id
),
goal_agg AS (
  SELECT investor_id, AVG(shortfall) AS avg_goal_shortfall
  FROM ATOM_ENTITY_INVESTMENT_GOAL_001
  WHERE investor_id IS NOT NULL AND shortfall IS NOT NULL
  GROUP BY investor_id
),
investor_measures AS (
  SELECT
    ip.investor_id,
    cf.net_cash_flow,
    r.risk_score,
    g.avg_goal_shortfall
  FROM ATOM_ENTITY_INVESTOR_PROFILE_001 AS ip
  INNER JOIN cash_flow_agg AS cf ON ip.investor_id = cf.investor_id
  INNER JOIN risk_agg AS r ON ip.investor_id = r.investor_id
  INNER JOIN goal_agg AS g ON ip.investor_id = g.investor_id
),
normalized_scores AS (
  SELECT
    investor_id,
    CASE
      WHEN MAX(net_cash_flow) OVER () = MIN(net_cash_flow) OVER ()
      THEN 0.5
      ELSE (net_cash_flow - MIN(net_cash_flow) OVER ()) * 1.0 / (MAX(net_cash_flow) OVER () - MIN(net_cash_flow) OVER ())
    END AS normalized_net_cash_flow,
    CASE
      WHEN MAX(risk_score) OVER () = MIN(risk_score) OVER ()
      THEN 0.5
      ELSE (risk_score - MIN(risk_score) OVER ()) * 1.0 / (MAX(risk_score) OVER () - MIN(risk_score) OVER ())
    END AS normalized_risk_score,
    CASE
      WHEN MAX(avg_goal_shortfall) OVER () = MIN(avg_goal_shortfall) OVER ()
      THEN 0.5
      ELSE (avg_goal_shortfall - MIN(avg_goal_shortfall) OVER ()) * 1.0 / (MAX(avg_goal_shortfall) OVER () - MIN(avg_goal_shortfall) OVER ())
    END AS normalized_avg_shortfall
  FROM investor_measures
)
SELECT
  investor_id,
  100.0 * (
    normalized_net_cash_flow +
    normalized_risk_score +
    (1 - normalized_avg_shortfall)
  ) / 3.0 AS composite_score
FROM normalized_scores
ORDER BY composite_score DESC, investor_id ASC
LIMIT 10
