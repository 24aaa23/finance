      AVG(shortfall) AS average_goal_shortfall
    FROM ATOM_ENTITY_INVESTMENT_GOAL_001
    GROUP BY investor_id
  )
SELECT 
  i.investor_id,
  cf.net_cash_flow,
  si.total_sector_investment,
  gs.average_goal_shortfall,
  (cf.net_cash_flow + si.total_sector_investment - gs.average_goal_shortfall) AS composite_score
FROM investors AS i
INNER JOIN cash_flow AS cf ON i.investor_id = cf.investor_id
INNER JOIN sector_investment AS si ON i.investor_id = si.investor_id
INNER JOIN goal_shortfall AS gs ON i.investor_id = gs.investor_id
ORDER BY 
  composite_score DESC,
  i.investor_id ASC
LIMIT 10;
