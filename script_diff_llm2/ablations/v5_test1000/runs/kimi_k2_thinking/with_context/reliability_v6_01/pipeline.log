WITH cash_flow_agg AS (
    SELECT
        investor_id,
        SUM(amount) AS net_cash_flow
    FROM ATOM_EVENT_CASH_FLOW_001
    GROUP BY investor_id
),
scenario_agg AS (
    SELECT
        investor_id,
        SUM(new_allocation_pct - current_allocation_pct) AS scenario_allocation_shift
    FROM ATOM_EVENT_SCENARIO_REBALANCING_001
    GROUP BY investor_id
),
joined AS (
    SELECT
        p.investor_id,
        MIN(p.investor_name) AS investor_name,
        cf.net_cash_flow,
        sc.scenario_allocation_shift
    FROM ATOM_ENTITY_INVESTOR_PROFILE_001 AS p
    INNER JOIN cash_flow_agg AS cf ON p.investor_id = cf.investor_id
    INNER JOIN scenario_agg AS sc ON p.investor_id = sc.investor_id
    GROUP BY p.investor_id
)
SELECT
    investor_id,
    investor_name,
    net_cash_flow,
    scenario_allocation_shift,
    CASE
        WHEN (MAX(net_cash_flow) OVER () - MIN(net_cash_flow) OVER ()) = 0 THEN 0
        ELSE (net_cash_flow - MIN(net_cash_flow) OVER ()) / (MAX(net_cash_flow) OVER () - MIN(net_cash_flow) OVER ())
    END AS normalized_net_cash_flow,
    CASE
        WHEN (MAX(scenario_allocation_shift) OVER () - MIN(scenario_allocation_shift) OVER ()) = 0 THEN 0
        ELSE (scenario_allocation_shift - MIN(scenario_allocation_shift) OVER ()) / (MAX(scenario_allocation_shift) OVER () - MIN(scenario_allocation_shift) OVER ())
    END AS normalized_scenario_shift,
    100.0 * (
        CASE
            WHEN (MAX(net_cash_flow) OVER () - MIN(net_cash_flow) OVER ()) = 0 THEN 0
            ELSE (net_cash_flow - MIN(net_cash_flow) OVER ()) / (MAX(net_cash_flow) OVER () - MIN(net_cash_flow) OVER ())
        END +
        CASE
            WHEN (MAX(scenario_allocation_shift) OVER () - MIN(scenario_allocation_shift) OVER ()) = 0 THEN 0
            ELSE (scenario_allocation_shift - MIN(scenario_allocation_shift) OVER ()) / (MAX(scenario_allocation_shift) OVER () - MIN(scenario_allocation_shift) OVER ())
        END
    ) / 2 AS composite_score
FROM joined
ORDER BY composite_score DESC, investor_id ASC
LIMIT 10;
