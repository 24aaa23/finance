Q1:Subquery(SQL),Q1:Subquery(SQL),[],"{""query_type"": ""set_logic"", ""base_entity"": ""ATOM_ENTITY_INVESTOR_PROFILE_001"", ""entity_key"": ""investor_id"", ""join_policy"": ""inner_join"", ""grain"": {""pre_aggregate_by"": [""investor_id""], ""final_group_by"": [""investor_id""]}, ""group_by"": [], ""filters"": [{""source_class"": ""ATOM_ENTITY_INVESTOR_PROFILE_001"", ""field"": ""risk_tolerance"", ""operator"": ""="", ""value"": ""Aggressive"", ""value_type"": ""string""}, {""source_class"": ""ATOM_ENTITY_PORTFOLIO_HEALTH_001"", ""field"": ""diversification_score"", ""operator"": ""<"", ""value"": 25, ""value_type"": ""number""}, {""source_class"": ""ATOM_EVENT_SCENARIO_REBALANCING_001"", ""field"": ""scenario"", ""operator"": ""="", ""value"": ""Currency Depreciation"", ""value_type"": ""string""}, {""source_class"": ""ATOM_ENTITY_INVESTMENT_GOAL_001"", ""field"": ""shortfall"", ""operator"": "">"", ""value"": 0, ""value_type"": ""number""}], ""measures"": [], ""ranking"": {""required"": false, ""metric"": null, ""direction"": null, ""limit"": null}, ""required_classes"": [""ATOM_ENTITY_INVESTOR_PROFILE_001"", ""ATOM_ENTITY_PORTFOLIO_HEALTH_001"", ""ATOM_EVENT_SCENARIO_REBALANCING_001"", ""ATOM_ENTITY_INVESTMENT_GOAL_001""], ""execution_strategy"": ""preaggregate_sql"", ""output_schema"": [""investor_id"", ""investor_name""], ""requirements"": [{""text"": ""Aggressive investors"", ""implemented_by"": [""filters.0""]}, {""text"": ""diversification score below 25"", ""implemented_by"": [""filters.1""]}, {""text"": ""Currency Depreciation scenario record"", ""implemented_by"": [""filters.2""]}, {""text"": ""at least one underfunded goal"", ""implemented_by"": [""filters.3""]}], ""unresolved_requirements"": [], ""reason"": ""The query asks for investors meeting multiple conditions across investor profile, portfolio health, scenario rebalancing, and investment goals. We pre-aggregate each table by investor_id, apply the respective filters, inner join the results, and deduplicate by investor_id to return each qualifying investor."", ""structural_repairs"": [], ""contract_errors"": [], ""contract_warnings"": [], ""domain_context_trace"": {""fingerprint"": ""17431387871b488d8ce132ac8b0fe19f6f5a82b41806145ebcec8814c193f17e"", ""available_rules"": []}}","WITH 
-- Pre-aggregate: investors with diversification score below 25
low_div AS (
  SELECT investor_id
  FROM ATOM_ENTITY_PORTFOLIO_HEALTH_001
  WHERE diversification_score < 25
  GROUP BY investor_id
),

-- Pre-aggregate: investors with Currency Depreciation scenario
curr_dep AS (
  SELECT investor_id
  FROM ATOM_EVENT_SCENARIO_REBALANCING_001
  WHERE scenario = 'Currency Depreciation'
  GROUP BY investor_id
),

-- Pre-aggregate: investors with underfunded goals
underfund AS (
  SELECT investor_id
  FROM ATOM_ENTITY_INVESTMENT_GOAL_001
  WHERE shortfall > 0
  GROUP BY investor_id
)

-- Main query: find Aggressive investors meeting all conditions
SELECT DISTINCT ip.investor_id, ip.investor_name
FROM ATOM_ENTITY_INVESTOR_PROFILE_001 ip
INNER JOIN low_div d ON ip.investor_id = d.investor_id
INNER JOIN curr_dep c ON ip.investor_id = c.investor_id
INNER JOIN underfund g ON ip.investor_id = g.investor_id
WHERE ip.risk_tolerance = 'Aggressive'",True,Valid,,success,11.0,,"[{""investor_id"": ""INV-1306"", ""investor_name"": ""Deepak Mehta""}, {""investor_id"": ""INV-1465"", ""investor_name"": ""Amit Gupta""}, {""investor_id"": ""INV-264"", ""investor_name"": ""Meena Pandey""}, {""investor_id"": ""INV-407"", ""investor_name"": ""Akshay Chauhan""}, {""investor_id"": ""INV-502"", ""investor_name"": ""Dipti Pandey""}, {""investor_id"": ""INV-582"", ""investor_name"": ""Amit Bhat""}, {""investor_id"": ""INV-682"", ""investor_name"": ""Chetan Kulkarni""}, {""investor_id"": ""INV-794"", ""investor_name"": ""Sneha Singh""}, {""investor_id"": ""INV-804"", ""investor_name"": ""Vikram Bhat""}, {""investor_id"": ""INV-825"", ""investor_name"": ""Sneha Kulkarni""}, {""investor_id"": ""INV-909"", ""investor_name"": ""Rahul Yadav""}]",[],{},,True,Result rows satisfy the Query_Spec output shape checks.,0,,,success,"{""Q1"": ""success""}","{""Q1"": []}","[[""Q1""]]","{""Q1"": ""SQL""}","{""Q1"": {""node_id"": ""Q1"", ""description"": ""Which Aggressive investors have a diversification score below 25, a Currency Depreciation scenario record, and at least one underfunded goal?"", ""operator"": ""Subquery"", ""backend"": ""SQL"", ""declared_inputs"": [], ""declared_outputs"": [], ""dependencies"": [], ""query_spec"": {""query_type"": ""set_logic"", ""base_entity"": ""ATOM_ENTITY_INVESTOR_PROFILE_001"", ""entity_key"": ""investor_id"", ""join_policy"": ""inner_join"", ""grain"": {""pre_aggregate_by"": [""investor_id""], ""final_group_by"": [""investor_id""]}, ""group_by"": [], ""filters"": [{""source_class"": ""ATOM_ENTITY_INVESTOR_PROFILE_001"", ""field"": ""risk_tolerance"", ""operator"": ""="", ""value"": ""Aggressive"", ""value_type"": ""string""}, {""source_class"": ""ATOM_ENTITY_PORTFOLIO_HEALTH_001"", ""field"": ""diversification_score"", ""operator"": ""<"", ""value"": 25, ""value_type"": ""number""}, {""source_class"": ""ATOM_EVENT_SCENARIO_REBALANCING_001"", ""field"": ""scenario"", ""operator"": ""="", ""value"": ""Currency Depreciation"", ""value_type"": ""string""}, {""source_class"": ""ATOM_ENTITY_INVESTMENT_GOAL_001"", ""field"": ""shortfall"", ""operator"": "">"", ""value"": 0, ""value_type"": ""number""}], ""measures"": [], ""ranking"": {""required"": false, ""metric"": null, ""direction"": null, ""limit"": null}, ""required_classes"": [""ATOM_ENTITY_INVESTOR_PROFILE_001"", ""ATOM_ENTITY_PORTFOLIO_HEALTH_001"", ""ATOM_EVENT_SCENARIO_REBALANCING_001"", ""ATOM_ENTITY_INVESTMENT_GOAL_001""], ""execution_strategy"": ""preaggregate_sql"", ""output_schema"": [""investor_id"", ""investor_name""], ""requirements"": [{""text"": ""Aggressive investors"", ""implemented_by"": [""filters.0""]}, {""text"": ""diversification score below 25"", ""implemented_by"": [""filters.1""]}, {""text"": ""Currency Depreciation scenario record"", ""implemented_by"": [""filters.2""]}, {""text"": ""at least one underfunded goal"", ""implemented_by"": [""filters.3""]}], ""unresolved_requirements"": [], ""reason"": ""The query asks for investors meeting multiple conditions across investor profile, portfolio health, scenario rebalancing, and investment goals. We pre-aggregate each table by investor_id, apply the respective filters, inner join the results, and deduplicate by investor_id to return each qualifying investor."", ""structural_repairs"": [], ""contract_errors"": [], ""contract_warnings"": [], ""domain_context_trace"": {""fingerprint"": ""17431387871b488d8ce132ac8b0fe19f6f5a82b41806145ebcec8814c193f17e"", ""available_rules"": []}}, ""generated_sql"": ""WITH \n-- Pre-aggregate: investors with diversification score below 25\nlow_div AS (\n  SELECT investor_id\n  FROM ATOM_ENTITY_PORTFOLIO_HEALTH_001\n  WHERE diversification_score < 25\n  GROUP BY investor_id\n),\n\n-- Pre-aggregate: investors with Currency Depreciation scenario\ncurr_dep AS (\n  SELECT investor_id\n  FROM ATOM_EVENT_SCENARIO_REBALANCING_001\n  WHERE scenario = 'Currency Depreciation'\n  GROUP 