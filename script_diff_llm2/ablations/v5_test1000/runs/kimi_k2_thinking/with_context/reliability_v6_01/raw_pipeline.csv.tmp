n    investor_id,\\n    COUNT(scenario_rebalance_id) as economic_growth_scenario_count\\n  FROM ATOM_EVENT_SCENARIO_REBALANCING_001\\n  WHERE scenario = 'Economic Growth'\\n  GROUP BY investor_id\\n),\\nunderfunded_goals AS (\\n  SELECT \\n    investor_id,\\n    COUNT(goal_id) as underfunded_goal_count\\n  FROM ATOM_ENTITY_INVESTMENT_GOAL_001\\n  WHERE shortfall > 0\\n  GROUP BY investor_id\\n)\\nSELECT \\n  ip.investor_id,\\n  ip.investor_name"", ""pre_scan_validation_is_valid"": true, ""pre_scan_validation_reason"": ""Valid"", ""scan_status"": ""success"", ""scan_row_count"": 8, ""scan_error"": """", ""scan_error_type"": """", ""scan_raw_rows"": ""[{\""investor_id\"": \""INV-1433\"", \""investor_name\"": \""Vivek Bhat\""}, {\""investor_id\"": \""INV-1440\"", \""investor_name\"": \""Bhavna Mehta\""}, {\""investor_id\"": \""INV-1465\"", \""investor_name\"": \""Amit Gupta\""}, {\""investor_id\"": \""INV-168\"", \""investor_name\"": \""Rahul Reddy\""}, {\""investor_id\"": \""INV-682\"", \""investor_name\"": \""Chetan Kulkarni\""}, {\""investor_id\"": \""INV-768\"", \""investor_name\"": \""Amrita Reddy\""}, {\""investor_id\"": \""INV-775\"", \""investor_name\"": \""Rajesh Rao\""}, {\""investor_id\"": \""INV-822\"", \""investor_name\"": \""Sneha Iyer\""}]"", ""self_heal_attempts"": 1, ""failure_stage"": """", ""validation_is_valid"": true, ""validation_reason"": ""Result rows satisfy the Query_Spec output shape checks."", ""bound_inputs"": {}, ""attempts"": [{""stage"": ""Generate_SQL"", ""attempt"": 1, ""output_present"": false, ""parse_error"": ""Unterminated string starting at: line 2 column 10 (char 11)""}, {""stage"": ""Pre_Scan_Validate_SQL"", ""attempt"": 1, ""is_valid"": false, ""severity"": ""hard_error"", ""reason"": ""No SQL provided.""}, {""stage"": ""Generate_SQL"", ""attempt"": 2, ""output_present"": true, ""parse_error"": """"}, {""stage"": ""Pre_Scan_Validate_SQL"", ""attempt"": 2, ""is_valid"": true, ""severity"": ""valid"", ""reason"": ""Valid""}, {""s