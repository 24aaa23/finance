ith inner joins to ensure all conditions are met. Pre-aggregation strategy prevents fanout from the one-to-many investor-to-holdings relationship. Output includes investor_id and investor_name for each qualifying investor."", ""structural_repairs"": [{""path"": ""plan.base_entity"", ""from"": ""investor"", ""to"": ""ATOM_ENTITY_INVESTOR_PROFILE_001"", ""evidence"": ""unique explicit owner of projected or distinctly counted entity key""}], ""preserve_null_groups"": true, ""contract_errors"": [], ""contract_warnings"": [""group_by.0 has no quoted requirement."", ""group_by.1 has no quoted requirement.""], ""domain_context_trace"": {""fingerprint"": ""17431387871b488d8ce132ac8b0fe19f6f5a82b41806145ebcec8814c193f17e"", ""available_rules"": []}}","WITH equity_holdings AS (
  SELECT investor_id
  FROM ATOM_ENTITY_PORTFOLIO_HOLDING_001
  WHERE investment_type = 'Equity'
  GROUP BY investor_id
)
SELECT 
  ip.investor_id,
  ip.investor_name
FROM ATOM_ENTITY_INVESTOR_PROFILE_001 ip
INNER JOIN ATOM_ENTITY_PORTFOLIO_HEALTH_001 ph 
  ON ip.investor_id = ph.investor_id
INNER JOIN equity_holdings eh 
  ON ip.investor_id = eh.investor_id
WHERE ip.risk_tolerance = 'Moderate'
  AND ph.risk_score > 75
GROUP BY ip.investor_id;",True,Valid,,success,41.0,,"[{""investor_id"": ""INV-053"", ""investor_name"": ""Anita Iyer""}, {""investor_id"": ""INV-058"", ""investor_name"": ""Meena Bhat""}, {""investor_id"": ""INV-072"", ""investor_name"": ""Siddharth Gupta""}, {""investor_id"": ""INV-1014"", ""investor_name"": ""Sneha Hegde""}, {""investor_id"": ""INV-1015"", ""investor_name"": ""Siddharth Deshmukh""}, {""investor_id"": ""INV-1021"", ""investor_name"": ""Amit Joshi""}, {""investor_id"": ""INV-1047"", ""investor_name"": ""Anjali Hegde""}, {""investor_id"": ""INV-1079"", ""investor_name"": ""Amit Reddy""}, {""investor_id"": ""INV-1101"", ""investor_name"": ""Rahul Verma""}, {""investor_id"": ""INV-1159"", ""investor_name"": ""Anand Sharma""}, {""investor_id"": ""INV-1241"", ""investor_name"": ""Sneha Hegde""}, {""investor_id"": ""INV-1287"", ""investor_name"": ""Ishita Mehta""}, {""investor_id"": ""INV-1349"", ""investor_name"": ""Dipti Pandey""}, {""investor_id"": ""INV-1461"", ""investor_name"": ""Amit Yadav""}, {""investor_id"": ""INV-1498"", ""investor_name"": ""Anand Mehta""}, {""investor_id"": ""INV-220"", ""investor_name"": ""Amit Joshi""}, {""investor_id"": ""INV-269"", ""investor_name"": ""Amrita Verma""}, {""investor_id"": ""INV-310"", ""investor_name"": ""Siddharth Nair""}, {""investor_id"": ""INV-373"", ""investor_name"": ""Priyanka Bhat""}, {""investor_id"": ""INV-374"", ""investor_name"": ""Anjali Pandey""}, {""investor_id"": ""INV-391"", ""investor_name"": ""Vivek Kulkarni""}, {""investor_id"": ""INV-412"", ""investor_name"": ""Kavita Verma""}, {""investor_id"": ""INV-418"", ""investor_name"": ""Akshay Mishra""}, {""investor_id"": ""INV-430"", ""investor_name"": ""Abhishek Verma""}, {""investor_id"": ""INV-441"", ""investor_name"": ""Ramesh Patel""}, {""investor_id"": ""INV-474"", ""investor_name"": ""Meena Kulkarni""}, {""investor_id"": ""INV-546"", ""investor_name"": ""Anand Mishra""}, {""investor_id"": ""INV-597"", ""investor_name"": ""Suresh Rao""}, 