es.0.operand_kind"", ""from"": null, ""to"": ""physical"", ""evidence"": ""operand names resolve against the declared source or planned aliases""}, {""path"": ""measures.1.operand_kind"", ""from"": null, ""to"": ""physical"", ""evidence"": ""operand names resolve against the declared source or planned aliases""}, {""path"": ""measures.2.operand_kind"", ""from"": null, ""to"": ""physical"", ""evidence"": ""operand names resolve against the declared source or planned aliases""}, {""path"": ""measures.3.operand_kind"", ""from"": null, ""to"": ""physical"", ""evidence"": ""operand names resolve against the declared source or planned aliases""}], ""contract_errors"": [], ""contract_warnings"": [""measures.0 has no quoted requirement."", ""measures.1 has no quoted requirement.""], ""domain_context_trace"": {""fingerprint"": ""17431387871b488d8ce132ac8b0fe19f6f5a82b41806145ebcec8814c193f17e"", ""available_rules"": []}}","WITH economic_growth_scenarios AS (
  SELECT 
    investor_id,
    COUNT(scenario_rebalance_id) as economic_growth_scenario_count
  FROM ATOM_EVENT_SCENARIO_REBALANCING_001
  WHERE scenario = 'Economic Growth'
  GROUP BY investor_id
),
underfunded_goals AS (
  SELECT 
    investor_id,
    COUNT(goal_id) as underfunded_goal_count
  FROM ATOM_ENTITY_INVESTMENT_GOAL_001
  WHERE shortfall > 0
  GROUP BY investor_id
)
SELECT 
  ip.investor_id,
  ip.investor_name
FROM ATOM_ENTITY_INVESTOR_PROFILE_001 ip
INNER JOIN ATOM_ENTITY_PORTFOLIO_HEALTH_001 ph 
  ON ip.investor_id = ph.investor_id
INNER JOIN economic_growth_scenarios eg 
  ON ip.investor_id = eg.investor_id
INNER JOIN underfunded_goals ug 
  ON ip.investor_id = ug.investor_id
WHERE 
  ip.risk_tolerance = 'Aggressive'
  AND ph.diversification_score < 25
  AND eg.economic_growth_scenario_count > 0
  AND ug.underfunded_goal_count > 0",True,Valid,,success,8.0,,"[{""investor_id"": ""INV-1433"", ""investor_name"": ""Vivek Bhat""}, {""investor_id"": ""INV-1440"", ""investor_name"": ""Bhavna Mehta""}, {""investor_id"": ""INV-1465"", ""investor_name"": ""Amit Gupta""}, {""investor_id"": ""INV-168"", ""investor_name"": ""Rahul Reddy""}, {""investor_id"": ""INV-682"", ""investor_name"": ""Chetan Kulkarni""}, {""investor_id"": ""INV-768"", ""investor_name"": ""Amrita Reddy""}, {""investor_id"": ""INV-775"", ""investor_name"": ""Rajesh Rao""}, {""investor_id"": ""INV-822"", ""investor_name"": ""Sneha Iyer""}]",[],{},,True,Result rows satisfy the Query_Spec output shape checks.,1,,,success,"{""Q1"": ""success""}","{""Q1"": []}","[[""Q1""]]","{""Q1"": ""SQL""}","{""Q1"": {""node_id"": ""Q1"", ""description"": ""Which Aggressive investors have a diversification score below 25, a Economic Growth scenario record, and at least one underfunded goal?"", ""operator"": ""Subquery"", ""backend"": ""SQL"", ""declared_inputs"": [], ""declared_outputs"": [], ""dependencies"": [], ""query_spec"": {""query_type"": ""set_logic"", ""base_entity"": ""ATOM_ENTITY_INVESTOR_PROFILE_001"", ""entity_key"": ""investor_id"", ""join_policy"": ""inner_join"", ""grain"": {""pre_aggregate_by"": [""investor_id""], ""final_group_by"": [""investor_id""]}, ""filters"": [{""source_class"": ""ATOM_ENTITY_INVESTOR_PROFILE_001"", ""field"": ""risk_tolerance"", ""operator"": ""="", ""value"": ""Aggressive"", ""value_type"": ""string""}, {""source_class"": ""ATOM_ENTITY_PORTFOLIO_HEALTH_001"", ""field"": ""diversification_score"", ""operator"": ""<"", ""value"": 25, ""value_type"": ""number""}], ""measures"": [{""output_name"": ""investor_id"", ""source_class"": ""ATOM_ENTITY_INVESTOR_PROFILE_001"", ""field"": ""investor_id"", ""formula"": null, ""formula_fields"": [], ""formula_stage"": null, ""population_filters"": [], ""aggregate_filters"": [], ""missing_entity_value"": null, ""unit"": null, ""per_entity_o