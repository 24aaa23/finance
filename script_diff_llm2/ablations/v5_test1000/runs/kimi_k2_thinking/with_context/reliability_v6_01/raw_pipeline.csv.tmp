"ranking"": {""required"": false, ""metric"": null, ""direction"": null, ""limit"": null}, ""required_classes"": [""ATOM_ENTITY_INVESTOR_PROFILE_001"", ""ATOM_ENTITY_PORTFOLIO_HEALTH_001""], ""execution_strategy"": ""single_sql"", ""output_schema"": [""investor_id"", ""investor_name"", ""liquidity_score""], ""requirements"": [{""text"": ""List investors whose portfolio liquidity score is critically low, below 25."", ""implemented_by"": [""filters.0""]}], ""unresolved_requirements"": [], ""reason"": ""Select investors by joining investor profile with portfolio health data using inner join on investor_id, then filter for liquidity_score < 25. Group by investor_id to ensure one row per investor. Output includes investor identification and their liquidity score to demonstrate they meet the criteria."", ""structural_repairs"": [], ""contract_errors"": [], ""contract_warnings"": [], ""domain_context_trace"": {""fingerprint"": ""17431387871b488d8ce132ac8b0fe19f6f5a82b41806145ebcec8814c193f17e"", ""available_rules"": []}}","SELECT 
  ip.investor_id,
  ip.investor_name,
  MIN(ph.liquidity_score) AS liquidity_score
FROM ATOM_ENTITY_INVESTOR_PROFILE_001 AS ip
INNER JOIN ATOM_ENTITY_PORTFOLIO_HEALTH_001 AS ph
  ON ip.investor_id = ph.investor_id
WHERE ph.liquidity_score < 25
