: null, ""to"": ""physical"", ""evidence"": ""operand names resolve against the declared source or planned aliases""}, {""path"": ""measures.1.operand_kind"", ""from"": null, ""to"": ""physical"", ""evidence"": ""operand names resolve against the declared source or planned aliases""}, {""path"": ""measures.2.operand_kind"", ""from"": null, ""to"": ""physical"", ""evidence"": ""operand names resolve against the declared source or planned aliases""}], ""preserve_null_groups"": true, ""contract_errors"": [], ""contract_warnings"": [""group_by.0 has no quoted requirement."", ""group_by.1 has no quoted requirement.""], ""domain_context_trace"": {""fingerprint"": ""17431387871b488d8ce132ac8b0fe19f6f5a82b41806145ebcec8814c193f17e"", ""available_rules"": []}}","PREFIX wm: <https://wealth.example.org/ontology/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

SELECT ?investorId ?investorName
WHERE {
  ?investor rdf:type wm:Investor ;
            wm:investorId ?investorId ;
            wm:investorName ?investorName ;
            wm:timeHorizon ""Long-term"" .
  
  {
    SELECT ?investorId (MAX(xsd:decimal(?riskScore)) AS ?max_risk_score)
    WHERE {
      ?inv wm:hasPortfolioHealth ?health .
      ?health wm:riskScore ?riskScore .
      ?inv wm:investorId ?investorId .
    }
    GROUP BY ?investorId
  }
  
  {
    SELECT ?investorId (COUNT(DISTINCT ?holdingId) AS ?equity_holding_count)
    WHERE {
      ?inv wm:hasHolding ?holding .
      ?holding wm:investmentType ""Equity"" ;
                wm:holdingId ?holdingId .
      ?inv wm:investorId ?investorId .
    }
    GROUP BY ?investorId
  }
  
  {
    SELECT ?investorId (COUNT(DISTINCT ?rebalanceId) AS ?rebalancing_action_count)
    WHERE {
      ?inv wm:hasRebalancingAction ?action .
      ?action wm:rebalanceId ?rebalanceId .
      ?inv wm:investorId ?investorId .
    }
    GROUP BY ?investorId
  }
  
  FILTER (?max_risk_score > 50)
  FILTER (?equity_holding_count >= 1)
  FILTER (?rebalancing_action_count >= 1)
}",True,"SPARQL correctly implements all measures, filters, and groupings as per the Query_Spec. Each measure (max_risk_score, equity_holding_count, rebalancing_action_count) is computed with the required aggregation, distinctness, and post-aggregation filters. The inner joins satisfy the inner_join policy, and the output schema matches the requested fields.",,success,85.0,,"[{""investorId"": ""INV-245"", ""investorName"": ""Chetan Patel""}, {""investorId"": ""INV-269"", ""investorName"": ""Amrita Verma""}, {""investorId"": ""INV-1236"", ""investorName"": ""Dipti Yadav""}, {""investorId"": ""INV-761"", ""investorName"": ""Meena Gupta""}, {""investorId"": ""INV-652"", ""investorName"": ""Geeta Pandey""}, {""investorId"": ""INV-1016"", ""investorName"": ""Ankita Joshi""}, {""investorId"": ""INV-870"", ""investorName"": ""Bhavna Yadav""}, {""investorId"": ""INV-1154"", ""investorName"": ""Ishita Hegde""}, {""investorId"": ""INV-164"", ""investorName"": ""Rahul Hegde""}, {""investorId"": ""INV-950"", ""investorName"": ""Ishita Iyer""}, {""investorId"": ""INV-908"", ""investorName"": ""Arjun Sharma""}, {""investorId"": ""INV-741"", ""investorName"": ""Vivek Kulkarni""}, {""investorId"": ""INV-327"", ""investorName"": ""Anjali Sharma""}, {""investorId"": ""INV-197"", ""investorName"": ""Amrita Nair""}, {""investorId"": ""INV-632"", ""investorName"": ""Priyanka Reddy""}, {""investorId"": ""INV-547"", ""investorName"": ""Rajesh Arora""}, {""investorId"": ""INV-658"", ""investorName"": ""Ankita Gupta""}, {""investorId"": ""INV-514"", ""investorName"": ""Arjun Deshmukh""}, {""investorId"": ""INV-1196"", ""investorName"": ""Arvind Verma""}, {""investorId"": ""INV-273"", ""investorName"": ""Ankita Yadav""}, {""investorId"": ""INV-1176"", ""investorName"": ""Vikram Mishra""}, {""investorId"": ""INV-1067"", ""investorName"": ""Arvind Patel""}, {""investorId"": ""INV-976"", ""investorName"": ""Rohan Sharma""}, {""investorId"": ""INV-418"", ""investorName"": ""Akshay Mishra""}, {""