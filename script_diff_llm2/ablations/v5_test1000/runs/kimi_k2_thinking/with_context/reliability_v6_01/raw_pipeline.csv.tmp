"", ""investor_name"": ""Aishwarya Gupta""}, {""investor_id"": ""INV-712"", ""investor_name"": ""Aishwarya Mehta""}, {""investor_id"": ""INV-733"", ""investor_name"": ""Amit Arora""}, {""investor_id"": ""INV-781"", ""investor_name"": ""Dipti Reddy""}, {""investor_id"": ""INV-874"", ""investor_name"": ""Rajesh Bhat""}, {""investor_id"": ""INV-891"", ""investor_name"": ""Anita Deshmukh""}, {""investor_id"": ""INV-895"", ""investor_name"": ""Dipti Verma""}, {""investor_id"": ""INV-936"", ""investor_name"": ""Amrita Joshi""}, {""investor_id"": ""INV-945"", ""investor_name"": ""Siddharth Mehta""}, {""investor_id"": ""INV-960"", ""investor_name"": ""Arvind Patel""}, {""investor_id"": ""INV-969"", ""investor_name"": ""Vikram Mishra""}, {""investor_id"": ""INV-972"", ""investor_name"": ""Aishwarya Kulkarni""}]",PIPELINE_SUCCESS,NEW_BENCHMARK,Raw pipeline output saved; run the separate grader script for MATCH/MISMATCH/PARTIAL.,2026-10-06T00:46:04,212.777,Q1:Subquery(SQL),Q1:Subquery(SQL),[],"{""query_type"": ""set_logic"", ""base_entity"": ""ATOM_ENTITY_INVESTOR_PROFILE_001"", ""entity_key"": ""investor_id"", ""join_policy"": ""inner_join"", ""grain"": {""pre_aggregate_by"": [], ""final_group_by"": [""investor_id""]}, ""group_by"": [], ""filters"": [{""source_class"": ""ATOM_ENTITY_INVESTOR_PROFILE_001"", ""field"": ""risk_tolerance"", ""operator"": ""="", ""value"": ""Moderate"", ""value_type"": ""string""}, {""source_class"": ""ATOM_ENTITY_PORTFOLIO_HEALTH_001"", ""field"": ""risk_score"", ""operator"": "">"", ""value"": 75, ""value_type"": ""number""}, {""source_class"": ""ATOM_ENTITY_PORTFOLIO_HOLDING_001"", ""field"": ""investment_type"", ""operator"": ""="", ""value"": ""Corporate Bond"", ""value_type"": ""string""}], ""measures"": [], ""ranking"": {""required"": false, ""metric"": null, ""direction"": null, ""limit"": null}, ""required_classes"": [""ATOM_ENTITY_INVESTOR_PROFILE_001"", ""ATOM_ENTITY_PORTFOLIO_HEALTH_001"", ""ATOM_ENTITY_PORTFOLIO_HOLDING_001""], ""execution_strategy"": ""single_sql"", ""output_schema"": [""investor_id"", ""investor_name""], ""requirements"": [{""text"": ""Moderate investors"", ""implemented_by"": [""filters.0""]}, {""text"": ""risk score above 75"", ""implemented_by"": [""filters.1""]}, {""text"": ""hold a Corporate Bond"", ""implemented_by"": [""filters.2""]}, {""text"": ""Which investors"", ""implemented_by"": [""grain.final_group_by.0"", ""output_schema.0"", ""output_schema.1""]}], ""unresolved_requirements"": [], ""reason"": ""The query selects investors who meet three conditions: moderate risk tolerance (filter on ATOM_ENTITY_INVESTOR_PROFILE_001.risk_tolerance), risk score above 75 (filter on ATOM_ENTITY_PORTFOLIO_HEALTH_001.risk_score), and holding at least one Corporate Bond (filter on ATOM_ENTITY_PORTFOLIO_HOLDING_001.investment_type). Inner joins ensure all conditions must be met. The result is grouped by investor_id to return distinct investors, with output schema providing investor identification fields."", ""structural_repairs"": [], ""contract_errors"": [], ""contract_warnings"": [], ""domain_context_trace"": {""fingerprint"": ""17431387871b488d8ce132ac8b0fe19f6f5a82b41806145ebcec8814c193f17e"", ""available_rules"": []}}","SELECT 
  p.investor_id,
  p.investor_name
FROM ATOM_ENTITY_INVESTOR_PROFILE_001 AS p
INNER JOIN ATOM_ENTITY_PORTFOLIO_HEALTH_001 AS h 
  ON p.investor_id = h.investor_id
INNER JOIN ATOM_ENTITY_PORTFOLIO_HOLDING_001 AS ph 
  ON p.investor_id = ph.investor_id
WHERE p.risk_tolerance = 'Moderate'
