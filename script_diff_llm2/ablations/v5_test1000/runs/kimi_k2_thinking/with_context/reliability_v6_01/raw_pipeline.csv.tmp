icit owner of projected or distinctly counted entity key""}, {""path"": ""measures.0.operand_kind"", ""from"": null, ""to"": ""physical"", ""evidence"": ""operand names resolve against the declared source or planned aliases""}], ""preserve_null_groups"": true, ""contract_errors"": [], ""contract_warnings"": [""group_by.0 has no quoted requirement."", ""group_by.1 has no quoted requirement.""], ""domain_context_trace"": {""fingerprint"": ""17431387871b488d8ce132ac8b0fe19f6f5a82b41806145ebcec8814c193f17e"", ""available_rules"": []}}","WITH rebalancing_counts AS (
  SELECT 
    investor_id,
    COUNT(rebalance_id) AS rebalancing_action_count
  FROM ATOM_EVENT_REBALANCING_ACTION_001
  GROUP BY investor_id
  HAVING COUNT(rebalance_id) > 0
)
SELECT 
  ip.investor_id,
  ip.investor_name
FROM ATOM_ENTITY_INVESTOR_PROFILE_001 ip
INNER JOIN ATOM_ENTITY_PORTFOLIO_HEALTH_001 ph ON ip.investor_id = ph.investor_id
INNER JOIN ATOM_ENTITY_PORTFOLIO_HOLDING_001 h ON ip.investor_id = h.investor_id
INNER JOIN rebalancing_counts rc ON ip.investor_id = rc.investor_id
WHERE ip.time_horizon = 'Long-term'
  AND ph.risk_score > 50
  AND h.investment_type = 'ETF'
GROUP BY ip.investor_id, ip.investor_name",True,Valid,,success,91.0,,"[{""investor_id"": ""INV-010"", ""investor_name"": ""Ankita Kulkarni""}, {""investor_id"": ""INV-026"", ""investor_name"": ""Sneha Pandey""}, {""investor_id"": ""INV-034"", ""investor_name"": ""Sneha Reddy""}, {""investor_id"": ""INV-040"", ""investor_name"": ""Anita Joshi""}, {""investor_id"": ""INV-064"", ""investor_name"": ""Arvind Singh""}, {""investor_id"": ""INV-076"", ""investor_name"": ""Aishwarya Kulkarni""}, {""investor_id"": ""INV-088"", ""investor_name"": ""Anjali Mishra""}, {""investor_id"": ""INV-091"", ""investor_name"": ""Akshay Iyer""}, {""investor_id"": ""INV-1005"", ""investor_name"": ""Siddharth Chauhan""}, {""investor_id"": ""INV-1015"", ""investor_name"": ""Siddharth Deshmukh""}, {""investor_id"": ""INV-1024"", ""investor_name"": ""Geeta Gupta""}, {""investor_id"": ""INV-1033"", ""investor_name"": ""Arjun Kulkarni""}, {""investor_id"": ""INV-1052"", ""investor_name"": ""Amit Reddy""}, {""investor_id"": ""INV-1059"", ""investor_name"": ""Rahul Sharma""}, {""investor_id"": ""INV-1061"", ""investor_name"": ""Vikram Verma""}, {""investor_id"": ""INV-1067"", ""investor_name"": ""Arvind Patel""}, {""investor_id"": ""INV-1072"", ""investor_name"": ""Amrita Kulkarni""}, {""investor_id"": ""INV-1099"", ""investor_name"": ""Anita Deshmukh""}, {""investor_id"": ""INV-1108"", ""investor_name"": ""Ramesh Iyer""}, {""investor_id"": ""INV-1119"", ""investor_name"": ""Ishita Nair""}, {""investor_id"": ""INV-1121"", ""investor_name"": ""Rajesh Arora""}, {""investor_id"": ""INV-113"", ""investor_name"": ""Anand Rao""}, {""investor_id"": ""INV-1153"", ""investor_name"": ""Arvind Sharma""}, {""investor_id"": ""INV-1154"", ""investor_name"": ""Ishita Hegde""}, {""investor_id"": ""INV-116"", ""investor_name"": ""Ankita Deshmukh""}, {""investor_id"": ""INV-1161"", ""investor_name"": ""Geeta Chauhan""}, {""investor_id"": ""INV-1164"", ""investor_name"": ""Sneha Singh""}, {""investor_id"": ""INV-1181