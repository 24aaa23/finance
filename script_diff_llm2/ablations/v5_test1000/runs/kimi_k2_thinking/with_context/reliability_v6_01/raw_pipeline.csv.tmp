PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?investorId ?investorName
WHERE {
  ?investor rdf:type wm:Investor ;
            wm:investorId ?investorId ;
            wm:investorName ?investorName ;
            wm:riskTolerance ""Aggressive"" .
  
  FILTER EXISTS {
    ?investor wm:hasPortfolioHealth ?health .
    ?health wm:riskScore ?riskScore .
    FILTER(?riskScore > 50)
  }
  
  FILTER EXISTS {
    ?investor wm:hasHolding ?holding .
    ?holding wm:investmentType ""Gold"" .
  }
  
  FILTER EXISTS {
    ?investor wm:hasRebalancingAction ?rebalancingAction .
    ?rebalancingAction wm:action ""De-risking"" .
  }
  
  FILTER EXISTS {
    ?investor wm:hasInvestmentGoal ?goal .
    ?goal wm:shortfall ?shortfall .
    FILTER(?shortfall > 0)
  }
}
GROUP BY ?investorId ?investorName",True,"SPARQL correctly implements all filters, joins, and output schema. All required classes are referenced, and the query returns the requested investorId and investorName.",,success,18.0,,"[{""investorId"": ""INV-561"", ""investorName"": ""Ishita Kulkarni""}, {""investorId"": ""INV-925"", ""investorName"": ""Anand Mishra""}, {""investorId"": ""INV-1233"", ""investorName"": ""Suresh Rao""}, {""investorId"": ""INV-1219"", ""investorName"": ""Rajesh Mishra""}, {""investorId"": ""INV-1440"", ""investorName"": ""Bhavna Mehta""}, {""investorId"": ""INV-1165"", ""investorName"": ""Bhavna Mishra""}, {""investorId"": ""INV-040"", ""investorName"": ""Anita Joshi""}, {""investorId"": ""INV-164"", ""investorName"": ""Rahul Hegde""}, {""investorId"": ""INV-1033"", ""investorName"": ""Arjun Kulkarni""}, {""investorId"": ""INV-079"", ""investorName"": ""Ankita Rao""}, {""investorId"": ""INV-906"", ""investorName"": ""Dipti Verma""}, {""investorId"": ""INV-1140"", ""investorName"": ""Ishita Gupta""}, {""investorId"": ""INV-1279"", ""investorName"": ""Aishwarya Mehta""}, {""investorId"": ""INV-869"", ""investorName"": ""Deepak Patel""}, {""investorId"": ""INV-574"", ""investorName"": ""Vivek Nair""}, {""investorId"": ""INV-1360"", ""investorName"": ""Dipti Bhat""}, {""investorId"": ""INV-1397"", ""investorName"": ""Rajesh Kulkarni""}, {""investorId"": ""INV-049"", ""investorName"": ""Deepak Mehta""}]",[],{},,True,Result rows satisfy the Query_Spec output shape checks.,0,,,success,"{""Q1"": ""success""}","{""Q1"": []}","[[""Q1""]]","{""Q1"": ""KG""}","{""Q1"": {""node_id"": ""Q1"", ""description"": ""Which Aggressive investors have a risk score above 50, hold a Gold position, have a 'De-risking' rebalancing action, and an underfunded goal?"", ""operator"": ""Subquery"", ""backend"": ""KG"", ""declared_inputs"": [], ""declared_outputs"": [], ""dependencies"": [], ""retrieved_classes"": [""Investor"", ""PortfolioHealth"", ""PortfolioHolding"", ""R