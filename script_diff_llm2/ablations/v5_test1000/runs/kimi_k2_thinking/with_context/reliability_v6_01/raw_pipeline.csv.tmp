value_type"": ""string""}], ""measures"": [{""output_name"": ""investor_count"", ""source_class"": ""ATOM_ENTITY_INVESTOR_PROFILE_001"", ""field"": ""investor_id"", ""formula"": null, ""formula_fields"": [], ""formula_stage"": null, ""population_filters"": [], ""aggregate_filters"": [], ""missing_entity_value"": null, ""unit"": null, ""per_entity_operation"": ""COUNT"", ""final_operation"": ""COUNT"", ""requires_distinct"": true, ""operand_kind"": ""physical""}], ""ranking"": {""required"": false, ""metric"": null, ""direction"": null, ""limit"": null}, ""required_classes"": [""ATOM_ENTITY_INVESTOR_PROFILE_001"", ""ATOM_ENTITY_PORTFOLIO_HEALTH_001"", ""ATOM_ENTITY_PORTFOLIO_HOLDING_001"", ""ATOM_EVENT_REBALANCING_ACTION_001""], ""execution_strategy"": ""preaggregate_sql"", ""output_schema"": [""investor_id"", ""investor_name""], ""requirements"": [{""text"": ""Long-term investors"", ""implemented_by"": [""filters.0""]}, {""text"": ""risk score above 50"", ""implemented_by"": [""filters.1""]}, {""text"": ""hold a Corporate Bond"", ""implemented_by"": [""filters.2""]}, {""text"": ""have at least one rebalancing action"", ""implemented_by"": [""join_policy"", ""required_classes.3""]}], ""unresolved_requirements"": [], ""reason"": ""The query identifies investors meeting multiple criteria across different tables. We use inner joins to ensure all conditions are met, including existence of rebalancing actions. Pre-aggregation by investor_id prevents fanout from the one-to-many relationships with holdings and rebalancing actions. The output returns distinct investor identifiers and names."", ""structural_repairs"": [{""path"": ""measures.0.operand_kind"", ""from"": null, ""to"": ""physical"", ""evidence"": ""operand names resolve against the declared source or planned aliases""}], ""preserve_null_groups"": true, ""contract_errors"": [], ""contract_warnings"": [""group_by.0 has no quoted requirement."", ""group_by.1 has no quoted requirement."", ""measures.0 has no quoted requirement.""], ""domain_context_trace"": {""fingerprint"": ""17431387871b488d8ce132ac8b0fe19f6f5a82b41806145ebcec8814c193f17e"", ""available_rules"": []}}","WITH base_investors AS (
  SELECT investor_id, investor_name
  FROM ATOM_ENTITY_INVESTOR_PROFILE_001
  WHERE time_horizon = 'Long-term'
),
risk_investors AS (
  SELECT investor_id
  FROM ATOM_ENTITY_PORTFOLIO_HEALTH_001
  WHERE risk_score > 50
  GROUP BY investor_id
),
bond_investors AS (
  SELECT investor_id
  FROM ATOM_ENTITY_PORTFOLIO_HOLDING_001
  WHERE investment_type = 'Corporate Bond'
  GROUP BY investor_id
),
rebalance_investors AS (
  SELECT investor_id
  FROM ATOM_EVENT_REBALANCING_ACTION_001
  GROUP BY investor_id
)
SELECT 
  b.investor_id,
  MIN(b.investor_name) AS investor_name
FROM base_investors b
INNER JOIN risk_investors r ON b.investor_id = r.investor_id
INNER JOIN bond_investors bn ON b.investor_id = bn.investor_id
