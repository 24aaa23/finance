:59,215.925,Q1:Subquery(SQL),Q1:Subquery(SQL),[],"{""query_type"": ""set_logic"", ""base_entity"": ""ATOM_ENTITY_INVESTOR_PROFILE_001"", ""entity_key"": ""investor_id"", ""join_policy"": ""inner_join"", ""grain"": {""pre_aggregate_by"": [], ""final_group_by"": []}, ""group_by"": [], ""filters"": [{""source_class"": ""ATOM_ENTITY_INVESTOR_PROFILE_001"", ""field"": ""risk_tolerance"", ""operator"": ""="", ""value"": ""Conservative"", ""value_type"": ""string""}, {""source_class"": ""ATOM_ENTITY_PORTFOLIO_HEALTH_001"", ""field"": ""diversification_score"", ""operator"": ""<"", ""value"": 25, ""value_type"": ""number""}, {""source_class"": ""ATOM_EVENT_SCENARIO_REBALANCING_001"", ""field"": ""scenario"", ""operator"": ""="", ""value"": ""Economic Growth"", ""value_type"": ""string""}], ""measures"": [{""output_name"": ""has_underfunded_goal"", ""source_class"": ""ATOM_ENTITY_INVESTMENT_GOAL_001"", ""field"": ""goal_id"", ""formula"": ""CASE WHEN current_value < target_amount THEN 1 ELSE 0 END"", ""formula_fields"": [""current_value"", ""target_amount""], ""formula_stage"": ""row"", ""population_filters"": [], ""aggregate_filters"": [{""field"": ""has_underfunded_goal"", ""operator"": ""="", ""value"": 1, ""stage"": ""entity"", ""scope"": ""population""}], ""missing_entity_value"": null, ""unit"": null, ""per_entity_operation"": ""MAX"", ""final_operation"": null, ""requires_distinct"": false, ""operand_kind"": ""physical""}], ""ranking"": {""required"": false, ""metric"": null, ""direction"": null, ""limit"": null}, ""required_classes"": [""ATOM_ENTITY_INVESTOR_PROFILE_001"", ""ATOM_ENTITY_PORTFOLIO_HEALTH_001"", ""ATOM_EVENT_SCENARIO_REBALANCING_001"", ""ATOM_ENTITY_INVESTMENT_GOAL_001""], ""execution_strategy"": ""preaggregate_sql"", ""output_schema"": [""investor_id"", ""investor_name""], ""requirements"": [{""text"": ""Conservative investors"", ""implemented_by"": [""filters.0""]}, {""text"": ""diversification score below 25"", ""implemented_by"": [""filters.1""]}, {""text"": ""Economic Growth scenario record"", ""implemented_by"": [""filters.2""]}, {""text"": ""at least one underfunded goal"", ""implemented_by"": [""measures.0""]}], ""unresolved_requirements"": [], ""reason"": ""The query filters investors based on four required conditions. Inner joins ensure all conditions must be met. The 'at least one underfunded goal' condition is implemented using a MAX aggregation on a row-level CASE expression that identifies underfunded goals (current_value < target_amount), with an aggregate filter requiring the result to be 1. Preaggregate_sql strategy is chosen to properly handle one-to-many relationships with scenario_rebalancing and investment_goals tables by grouping before final join to avoid fanout and ensure correct entity-level evaluation."", ""structural_repairs"": [{""path"": ""measures.0.operand_kind"", ""from"": null, ""to"": ""physical"", ""evidence"": ""operand names resolve against the declared source or planned aliases""}], ""contract_errors"": [], ""contract_warnings"": [], ""domain_context_trace"": {""fingerprint"": ""17431387871b488d8ce132ac8b0fe19f6f5a82b41806145ebcec8814c193f17e"", ""available_rules"": []}}","WITH 
  investors AS (
    SELECT investor_id, investor_name
    FROM ATOM_ENTITY_INVESTOR_PROFILE_001
    WHERE risk_tolerance = 'Conservative'
  ),
  portfolio_health AS (
    SELECT investor_id
    FROM ATOM_ENTITY_PORTFOLIO_HEALTH_001
    WHERE diversification_score < 25
    GROUP BY investor_id
  ),
  scenario_rebalancing AS (
    SELECT investor_id
    FROM ATOM_EVENT_SCENARIO_REBALANCING_001
    WHERE scenario = 'Economic Growth'
    GROUP BY investor_id
  ),
  underfunded_goals AS (
    SELECT 
      investor_id,
      MAX(CASE WHEN current_value < target_amount THEN 1 ELSE 0 END) as has_underfunded_goal
    FROM ATOM_ENTITY_INVESTMENT_GOAL_001
    GROUP BY investor_id
    HAVING has_underfunded_goal = 1
  )
SELECT 
  i.investor_id,
  i.investor_name
FROM investors i
INNER JOIN portfolio_health ph ON i.investor_id = ph.investor_id
INNER JOIN scenario_rebalancing sr ON i.investor_id = sr.investor_id
