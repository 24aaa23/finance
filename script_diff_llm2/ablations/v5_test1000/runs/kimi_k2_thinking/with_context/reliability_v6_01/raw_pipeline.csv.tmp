ll_groups"": true, ""contract_errors"": [], ""contract_warnings"": [""group_by.0 has no quoted requirement."", ""group_by.1 has no quoted requirement.""], ""domain_context_trace"": {""fingerprint"": ""17431387871b488d8ce132ac8b0fe19f6f5a82b41806145ebcec8814c193f17e"", ""available_rules"": []}}","WITH SCENARIO_COUNTS AS (
    SELECT INVESTOR_ID,
           COUNT(SCENARIO_REBALANCE_ID) AS CT
    FROM ATOM_EVENT_SCENARIO_REBALANCING_001
    WHERE SCENARIO = 'Bear Market'
    GROUP BY INVESTOR_ID
),
UNDERFUNDED_COUNTS AS (
    SELECT INVESTOR_ID,
           SUM(CASE WHEN CURRENT_VALUE < TARGET_AMOUNT THEN 1 ELSE 0 END) AS UNDERFUNDED_SUM
    FROM ATOM_ENTITY_INVESTMENT_GOAL_001
    GROUP BY INVESTOR_ID
)
SELECT p.INVESTOR_ID,
       p.INVESTOR_NAME
FROM ATOM_ENTITY_INVESTOR_PROFILE_001 p
LEFT JOIN ATOM_ENTITY_PORTFOLIO_HEALTH_001 ph
    ON p.INVESTOR_ID = ph.INVESTOR_ID
LEFT JOIN SCENARIO_COUNTS s
    ON p.INVESTOR_ID = s.INVESTOR_ID
LEFT JOIN UNDERFUNDED_COUNTS g
    ON p.INVESTOR_ID = g.INVESTOR_ID
WHERE p.RISK_TOLERANCE = 'Aggressive'
  AND ph.DIVERSIFICATION_SCORE < 25
GROUP BY p.INVESTOR_ID, p.INVESTOR_NAME
HAVING MIN(COALESCE(s.CT, 0)) > 0
   AND MIN(COALESCE(g.UNDERFUNDED_SUM, 0)) > 0;",True,"Valid. The SQL correctly implements all requirements: filters for Aggressive risk_tolerance and diversification_score < 25, validates existence of Bear Market scenarios and underfunded goals via HAVING clauses on pre-aggregated CTEs, and returns the required output schema. The preserve_null_groups flag in the spec contradicts the explicit existence requirements (>0), but the query correctly prioritizes the logical requirements over this metadata flag. Column name case differences are acceptable in SQLite.",,success,11.0,,"[{""investor_id"": ""INV-030"", ""investor_name"": ""Ramesh Rao""}, {""investor_id"": ""INV-068"", ""investor_name"": ""Vikram Yadav""}, {""investor_id"": ""INV-133"", ""investor_name"": ""Rohan Arora""}, {""investor_id"": ""INV-1485"", ""investor_name"": ""Geeta Rao""}, {""investor_id"": ""INV-182"", ""investor_name"": ""Bhavna Verma""}, {""investor_id"": ""INV-386"", ""investor_name"": ""Siddharth Iyer""}, {""investor_id"": ""INV-482"", ""investor_name"": ""Deepak Mishra""}, {""investor_id"": ""INV-485"", ""investor_name"": ""Vivek Pandey""}, {""investor_id"": ""INV-645"", ""investor_name"": ""Kavita Mishra""}, {""investor_id"": ""INV-653"", ""investor_name"": ""Suresh Bhat""}, {""investor_id"": ""INV-892"", ""investor_name"": ""Anita Nair""}]",[],{},,True,Result rows satisfy the Query_Spec output shape checks.,1,,,success,"{""Q1"": ""success""}","{""Q1"": []}","[[""Q1""]]","{""Q1"": ""SQL""}","{""Q1"": {""node_id"": ""Q1"", ""description"": ""Which Aggressive investors have a diversification score below 25, a Bear Market scenario record, and at least one underfunded goal?"", ""operator"": ""Subquery"", ""backend"": ""SQL"", ""declared_inputs"": [], ""declared_outputs"": [], ""dependencies"": [], ""query_spec"": {""query_type"": ""set_logic"", ""base_entity"": ""ATOM_ENTITY_INVESTOR_PROFILE_001"", ""entity_key"": ""investor_id"", ""join_policy"": ""left_join"", ""grain"": {""pre_aggregate_by"