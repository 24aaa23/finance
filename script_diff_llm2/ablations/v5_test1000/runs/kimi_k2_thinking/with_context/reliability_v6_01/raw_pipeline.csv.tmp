ROFILE_001"", ""ATOM_ENTITY_PORTFOLIO_HEALTH_001"", ""ATOM_ENTITY_PORTFOLIO_HOLDING_001""], ""execution_strategy"": ""single_sql"", ""output_schema"": [""investor_id"", ""investor_name""], ""requirements"": [{""text"": ""Aggressive investors"", ""implemented_by"": [""filters.0""]}, {""text"": ""risk score above 75"", ""implemented_by"": [""filters.1""]}, {""text"": ""hold a Corporate Bond"", ""implemented_by"": [""filters.2""]}], ""unresolved_requirements"": [], ""reason"": ""The query identifies investors who simultaneously satisfy three conditions: having an aggressive risk tolerance, a risk score above 75, and holding at least one Corporate Bond. This requires inner joins across three tables and filtering on each table's relevant fields. The result is a list of distinct investors matching all criteria."", ""structural_repairs"": [], ""preserve_null_groups"": true, ""contract_errors"": [], ""contract_warnings"": [""group_by.0 has no quoted requirement.""], ""domain_context_trace"": {""fingerprint"": ""17431387871b488d8ce132ac8b0fe19f6f5a82b41806145ebcec8814c193f17e"", ""available_rules"": []}}","SELECT 
  ip.investor_id,
  ip.investor_name
FROM ATOM_ENTITY_INVESTOR_PROFILE_001 ip
INNER JOIN ATOM_ENTITY_PORTFOLIO_HEALTH_001 ph ON ip.investor_id = ph.investor_id
INNER JOIN ATOM_ENTITY_PORTFOLIO_HOLDING_001 h ON ip.investor_id = h.investor_id
WHERE ip.risk_tolerance = 'Aggressive'
