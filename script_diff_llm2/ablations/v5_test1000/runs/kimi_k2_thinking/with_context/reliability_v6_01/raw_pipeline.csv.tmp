with Gold holdings, then applies the remaining filters via inner joins to produce the final eligible investor set."", ""structural_repairs"": [], ""contract_errors"": [], ""contract_warnings"": [], ""domain_context_trace"": {""fingerprint"": ""17431387871b488d8ce132ac8b0fe19f6f5a82b41806145ebcec8814c193f17e"", ""available_rules"": []}}","WITH 
  high_risk_investors AS (
    SELECT investor_id
    FROM ATOM_ENTITY_PORTFOLIO_HEALTH_001
    WHERE risk_score > 75
    GROUP BY investor_id
  ),
  gold_holders AS (
    SELECT investor_id
