_INVESTOR_PROFILE_001"", ""ATOM_ENTITY_PORTFOLIO_HEALTH_001"", ""ATOM_ENTITY_PORTFOLIO_HOLDING_001""], ""execution_strategy"": ""preaggregate_sql"", ""output_schema"": [""investor_id"", ""investor_name""], ""requirements"": [{""text"": ""Aggressive investors"", ""implemented_by"": [""filters.0""]}, {""text"": ""risk score above 75"", ""implemented_by"": [""filters.1""]}, {""text"": ""hold a Gold"", ""implemented_by"": [""filters.2""]}], ""unresolved_requirements"": [], ""reason"": ""The query identifies investors meeting three intersection conditions: aggressive risk tolerance, risk score exceeding 75, and possession of gold holdings. Inner joins across profile, health, and holdings tables ensure all criteria are satisfied. Pre-aggregation strategy prevents fanout from the one-to-many holdings relationship. The output projects investor identifiers and names for the qualifying population."", ""structural_repairs"": [], ""preserve_null_groups"": true, ""contract_errors"": [], ""contract_warnings"": [""group_by.0 has no quoted requirement."", ""group_by.1 has no quoted requirement.""], ""domain_context_trace"": {""fingerprint"": ""17431387871b488d8ce132ac8b0fe19f6f5a82b41806145ebcec8814c193f17e"", ""available_rules"": []}}","WITH holdings_gold AS (
  SELECT investor_id
  FROM ATOM_ENTITY_PORTFOLIO_HOLDING_001
  WHERE investment_type = 'Gold'
  GROUP BY investor_id
),
health_high_risk AS (
  SELECT investor_id
  FROM ATOM_ENTITY_PORTFOLIO_HEALTH_001
  WHERE risk_score > 75
  GROUP BY investor_id
),
profile_aggressive AS (
  SELECT investor_id, investor_name
  FROM ATOM_ENTITY_INVESTOR_PROFILE_001
  WHERE risk_tolerance = 'Aggressive'
  GROUP BY investor_id, investor_name
)
SELECT p.investor_id, p.investor_name
FROM profile_aggressive AS p
INNER JOIN health_high_risk AS h ON p.investor_id = h.investor_id
INNER JOIN holdings_gold AS g ON p.investor_id = g.investor_id
GROUP BY p.investor_id, p.investor_name;",True,Valid,,success,46.0,,"[{""investor_id"": ""INV-010"", ""investor_name"": ""Ankita Kulkarni""}, {""investor_id"": ""INV-061"", ""investor_name"": ""Kavita Sharma""}, {""investor_id"": ""INV-068"", ""investor_name"": ""Vikram Yadav""}, {""investor_id"": ""INV-073"", ""investor_name"": ""Abhishek Mehta""}, {""investor_id"": ""INV-079"", ""investor_name"": ""Ankita Rao""}, {""investor_id"": ""INV-1075"", ""investor_name"": ""Amrita Iyer""}, {""investor_id"": ""INV-1104"", ""investor_name"": ""Arjun Patel""}, {""investor_id"": ""INV-1133"", ""investor_name"": ""Rajesh Chauhan""}, {""investor_id"": ""INV-1164"", ""investor_name"": ""Sneha Singh""}, {""investor_id"": ""INV-1184"", ""investor_name"": ""Amrita Mehta""}, {""investor_id"": ""INV-1219"", ""investor_name"": ""Rajesh Mishra""}, {""investor_id"": ""INV-1236"", ""investor_name"": ""Dipti Yadav""}, {""investor_id"": ""INV-1248"", ""investor_name"": ""Siddharth Deshmukh""}, {""investor_id"": ""INV-130"", ""investor_name"": ""Abhishek Verma""}, {""investor_id"": ""INV-1360"", ""investor_name"": ""Dipti Bhat""}, {""investor_id"": ""INV-1397"", ""investor_name"": ""Rajesh Kulkarni""}, {""investor_id"": ""INV-1497"", ""investor_name"": ""Dipti Arora""}, {""investor_id"": ""INV-181"", ""investor_name"": ""Suresh Reddy""}, {""investor_id"": ""INV-189"", ""investor_name"": ""Meena Hegde""}, {""investor_id"": ""INV-246"", ""investor_name"": ""Ishita Hegde""}, {""investor_id"": ""INV-281"", ""investor_name"": ""Sunita Pandey""}, {""investor_id"": ""INV-306"", ""investor_name"": ""Ishita Deshmukh""}, {""investor_id"": ""INV-327"", ""investor_name"": ""Anjali Sharma""}, {""investor_id"": ""INV-349"", ""investor_name"": ""Arvind Kulkarni""}, {""investor_id"": ""INV-377"", ""investor_name"": ""Anita Singh""}, {""investor_id"": ""INV-434"", ""investor_name"": ""Siddharth Reddy""}, {""investor_id"": ""INV-457"", ""investor_name"": ""Kavita Hegde""}, {""investor_id"": ""INV-507"", ""inv