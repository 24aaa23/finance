ue_type"": ""string""}, {""source_class"": ""ATOM_ENTITY_PORTFOLIO_HEALTH_001"", ""field"": ""risk_score"", ""operator"": "">"", ""value"": 75, ""value_type"": ""number""}, {""source_class"": ""ATOM_ENTITY_PORTFOLIO_HOLDING_001"", ""field"": ""investment_type"", ""operator"": ""="", ""value"": ""Government Bond"", ""value_type"": ""string""}], ""measures"": [{""output_name"": ""investor_count"", ""source_class"": ""ATOM_ENTITY_INVESTOR_PROFILE_001"", ""field"": ""investor_id"", ""formula"": null, ""formula_fields"": [], ""formula_stage"": null, ""population_filters"": [], ""aggregate_filters"": [], ""missing_entity_value"": null, ""unit"": null, ""per_entity_operation"": ""COUNT"", ""final_operation"": null, ""requires_distinct"": true, ""operand_kind"": ""physical""}], ""ranking"": {""required"": false, ""metric"": null, ""direction"": null, ""limit"": null}, ""required_classes"": [""ATOM_ENTITY_INVESTOR_PROFILE_001"", ""ATOM_ENTITY_PORTFOLIO_HEALTH_001"", ""ATOM_ENTITY_PORTFOLIO_HOLDING_001""], ""execution_strategy"": ""preaggregate_sql"", ""output_schema"": [""investor_id"", ""investor_name""], ""requirements"": [{""text"": ""Which Moderate investors have a risk score above 75 and hold a Government Bond?"", ""implemented_by"": [""filters.0"", ""filters.1"", ""filters.2"", ""group_by.0"", ""group_by.1""]}], ""unresolved_requirements"": [], ""reason"": ""The query identifies investors with Moderate risk tolerance, risk score > 75, and at least one Government Bond holding. We use inner joins across three tables (investor profile, portfolio health, and holdings) filtered on the respective conditions. Results are grouped by investor_id and investor_name to return unique investor records. A distinct count measure is included to satisfy schema requirements while the primary output remains the investor identifiers."", ""structural_repairs"": [{""path"": ""measures.0.operand_kind"", ""from"": null, ""to"": ""physical"", ""evidence"": ""operand names resolve against the declared source or planned aliases""}], ""preserve_null_groups"": true, ""contract_errors"": [], ""contract_warnings"": [""measures.0 has no quoted requirement.""], ""domain_context_trace"": {""fingerprint"": ""17431387871b488d8ce132ac8b0fe19f6f5a82b41806145ebcec8814c193f17e"", ""available_rules"": []}}","SELECT
  ip.investor_id,
  ip.investor_name
FROM ATOM_ENTITY_INVESTOR_PROFILE_001 AS ip
INNER JOIN ATOM_ENTITY_PORTFOLIO_HEALTH_001 AS ph
  ON ip.investor_id = ph.investor_id
INNER JOIN ATOM_ENTITY_PORTFOLIO_HOLDING_001 AS h
  ON ip.investor_id = h.investor_id
WHERE
  ip.risk_tolerance = 'Moderate'
  AND ph.risk_score > 75
  AND h.investment_type = 'Government Bond'
