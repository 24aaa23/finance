E_001"", ""entity_key"": ""investor_id"", ""join_policy"": ""inner_join"", ""grain"": {""pre_aggregate_by"": [""investor_id""], ""final_group_by"": [""investor_id""]}, ""group_by"": [{""output_name"": ""investor_id"", ""source_class"": ""ATOM_ENTITY_INVESTOR_PROFILE_001"", ""field"": ""investor_id""}, {""output_name"": ""investor_name"", ""source_class"": ""ATOM_ENTITY_INVESTOR_PROFILE_001"", ""field"": ""investor_name""}], ""filters"": [{""source_class"": ""ATOM_ENTITY_INVESTOR_PROFILE_001"", ""field"": ""risk_tolerance"", ""operator"": ""="", ""value"": ""Moderate"", ""value_type"": ""string""}, {""source_class"": ""ATOM_ENTITY_PORTFOLIO_HEALTH_001"", ""field"": ""diversification_score"", ""operator"": ""<"", ""value"": 25, ""value_type"": ""number""}, {""source_class"": ""ATOM_EVENT_SCENARIO_REBALANCING_001"", ""field"": ""scenario"", ""operator"": ""="", ""value"": ""Currency Depreciation"", ""value_type"": ""string""}], ""measures"": [{""output_name"": ""underfunded_goal_count"", ""source_class"": ""ATOM_ENTITY_INVESTMENT_GOAL_001"", ""field"": ""goal_id"", ""formula"": null, ""formula_fields"": [], ""formula_stage"": null, ""population_filters"": [{""source_class"": ""ATOM_ENTITY_INVESTMENT_GOAL_001"", ""field"": ""shortfall"", ""operator"": "">"", ""value"": 0, ""value_type"": ""number""}], ""aggregate_filters"": [{""field"": ""underfunded_goal_count"", ""operator"": "">="", ""value"": 1, ""stage"": ""entity"", ""scope"": ""population""}], ""missing_entity_value"": 0, ""unit"": null, ""per_entity_operation"": ""COUNT"", ""final_operation"": null, ""requires_distinct"": false, ""operand_kind"": ""physical""}], ""ranking"": {""required"": false, ""metric"": null, ""direction"": null, ""limit"": null}, ""required_classes"": [""ATOM_ENTITY_INVESTOR_PROFILE_001"", ""ATOM_ENTITY_PORTFOLIO_HEALTH_001"", ""ATOM_EVENT_SCENARIO_REBALANCING_001"", ""ATOM_ENTITY_INVESTMENT_GOAL_001""], ""execution_strategy"": ""preaggregate_sql"", ""output_schema"": [""investor_id"", ""investor_name""], ""requirements"": [{""text"": ""Moderate investors"", ""implemented_by"": [""filters.0""]}, {""text"": ""diversification score below 25"", ""implemented_by"": [""filters.1""]}, {""text"": ""Currency Depreciation scenario record"", ""implemented_by"": [""filters.2""]}, {""text"": ""at least one underfunded goal"", ""implemented_by"": [""measures.0""]}], ""unresolved_requirements"": [], ""reason"": ""The query asks for investors meeting multiple conditions across different tables. We use inner joins to ensure all conditions are met, filter for Moderate risk tolerance and diversification score < 25, check for Currency Depreciation scenario records, and count underfunded goals per investor using the shortfall field with a threshold of >=1."", ""structural_repairs"": [{""path"": ""measures.0.operand_kind"", ""from"": null, ""to"": ""physical"", ""evidence"": ""operand names resolve against the declared source or planned aliases""}], ""preserve_null_groups"": true, ""contract_errors"": [], ""contract_warnings"": [""group_by.0 has no quoted requirement."", ""group_by.1 has no quoted requirement.""], ""domain_context_trace"": {""fingerprint"": ""17431387871b488d8ce132ac8b0fe19f6f5a82b41806145ebcec8814c193f17e"", ""available_rules"": []}}","WITH underfunded_goals AS (
  SELECT 
    investor_id,
    COUNT(goal_id) as underfunded_goal_count
  FROM ATOM_ENTITY_INVESTMENT_GOAL_001
  WHERE shortfall > 0
  GROUP BY investor_id
)
SELECT 
  ip.investor_id,
  ip.investor_name
FROM ATOM_ENTITY_INVESTOR_PROFILE_001 ip
INNER JOIN ATOM_ENTITY_PORTFOLIO_HEALTH_001 ph 
  ON ip.investor_id = ph.investor_id
INNER JOIN ATOM_EVENT_SCENARIO_REBALANCING_001 sr 
  ON ip.investor_id = sr.investor_id
INNER JOIN underfunded_goals ug 
  ON ip.investor_id = ug.investor_id
WHERE ip.risk_tolerance = 'Moderate'
  AND ph.diversification_score < 25
  AND sr.scenario = 'Currency Depreciation'
  AND ug.underfunded_goal_count >= 1
GROUP BY 
  ip.investor_id,
