  AND h.risk_score > 75
  AND ho.investment_type = 'Government Bond'
GROUP BY p.investor_id",True,Valid,,success,65.0,,"[{""investor_id"": ""INV-047"", ""investor_name"": ""Aishwarya Reddy""}, {""investor_id"": ""INV-069"", ""investor_name"": ""Sunita Patel""}, {""investor_id"": ""INV-071"", ""investor_name"": ""Anita Iyer""}, {""investor_id"": ""INV-1025"", ""investor_name"": ""Rohan Arora""}, {""investor_id"": ""INV-1045"", ""investor_name"": ""Arvind Nair""}, {""investor_id"": ""INV-1061"", ""investor_name"": ""Vikram Verma""}, {""investor_id"": ""INV-1071"", ""investor_name"": ""Anand Joshi""}, {""investor_id"": ""INV-1072"", ""investor_name"": ""Amrita Kulkarni""}, {""investor_id"": ""INV-1093"", ""investor_name"": ""Akshay Yadav""}, {""investor_id"": ""INV-1120"", ""investor_name"": ""Arjun Bhat""}, {""investor_id"": ""INV-1121"", ""investor_name"": ""Rajesh Arora""}, {""investor_id"": ""INV-1129"", ""investor_name"": ""Akshay Hegde""}, {""investor_id"": ""INV-1138"", ""investor_name"": ""Sneha Reddy""}, {""investor_id"": ""INV-1148"", ""investor_name"": ""Rohan Rao""}, {""investor_id"": ""INV-1154"", ""investor_name"": ""Ishita Hegde""}, {""investor_id"": ""INV-1176"", ""investor_name"": ""Vikram Mishra""}, {""investor_id"": ""INV-1198"", ""investor_name"": ""Anita Verma""}, {""investor_id"": ""INV-1238"", ""investor_name"": ""Bhavna Bhat""}, {""investor_id"": ""INV-124"", ""investor_name"": ""Rajesh Kulkarni""}, {""investor_id"": ""INV-1281"", ""investor_name"": ""Ankita Rao""}, {""investor_id"": ""INV-1347"", ""investor_name"": ""Rohan Hegde""}, {""investor_id"": ""INV-1348"", ""investor_name"": ""Anand Deshmukh""}, {""investor_id"": ""INV-1378"", ""investor_name"": ""Anjali Joshi""}, {""investor_id"": ""INV-141"", ""investor_name"": ""Geeta Verma""}, {""investor_id"": ""INV-1434"", ""investor_name"": ""Arjun Mishra""}, {""investor_id"": ""INV-1446"", ""investor_name"": ""Arvind Arora""}, {""investor_id"": ""INV-1481"", ""investor_name"": ""Amit Mishra""}, {""investor_id"": ""INV-1484"", ""investor_name"": ""Geeta Bhat""}, {