: ""INV-630"", ""investor_name"": ""Bhavna Nair""}, {""investor_id"": ""INV-648"", ""investor_name"": ""Deepak Kulkarni""}, {""investor_id"": ""INV-692"", ""investor_name"": ""Ramesh Joshi""}, {""investor_id"": ""INV-696"", ""investor_name"": ""Rajesh Chauhan""}, {""investor_id"": ""INV-725"", ""investor_name"": ""Ishita Patel""}, {""investor_id"": ""INV-761"", ""investor_name"": ""Meena Gupta""}, {""investor_id"": ""INV-796"", ""investor_name"": ""Rohan Mishra""}, {""investor_id"": ""INV-817"", ""investor_name"": ""Meena Arora""}, {""investor_id"": ""INV-821"", ""investor_name"": ""Amit Iyer""}, {""investor_id"": ""INV-832"", ""investor_name"": ""Rohan Kulkarni""}, {""investor_id"": ""INV-848"", ""investor_name"": ""Sneha Patel""}, {""investor_id"": ""INV-876"", ""investor_name"": ""Anand Joshi""}, {""investor_id"": ""INV-885"", ""investor_name"": ""Sneha Nair""}, {""investor_id"": ""INV-886"", ""investor_name"": ""Rohan Pandey""}, {""investor_id"": ""INV-941"", ""investor_name"": ""Rahul Iyer""}]",PIPELINE_SUCCESS,NEW_BENCHMARK,Raw pipeline output saved; run the separate grader script for MATCH/MISMATCH/PARTIAL.,2026-10-06T00:30:29,751.514,Q1:Subquery(SQL),Q1:Subquery(SQL),[],"{""query_type"": ""set_logic"", ""base_entity"": ""ATOM_ENTITY_INVESTOR_PROFILE_001"", ""entity_key"": ""investor_id"", ""join_policy"": ""inner_join"", ""grain"": {""pre_aggregate_by"": [], ""final_group_by"": [""investor_id""]}, ""group_by"": [{""output_name"": ""investor_id"", ""source_class"": ""ATOM_ENTITY_INVESTOR_PROFILE_001"", ""field"": ""investor_id""}, {""output_name"": ""investor_name"", ""source_class"": ""ATOM_ENTITY_INVESTOR_PROFILE_001"", ""field"": ""investor_name""}], ""filters"": [{""source_class"": ""ATOM_ENTITY_INVESTOR_PROFILE_001"", ""field"": ""risk_tolerance"", ""operator"": ""="", ""value"": ""Conservative"", ""value_type"": ""string""}, {""source_class"": ""ATOM_ENTITY_PORTFOLIO_HEALTH_001"", ""field"": ""risk_score"", ""operator"": "">"", ""value"": 75, ""value_type"": ""number""}, {""source_class"": ""ATOM_ENTITY_PORTFOLIO_HOLDING_001"", ""field"": ""investment_type"", ""operator"": ""="", ""value"": ""Corporate Bond"", ""value_type"": ""string""}], ""measures"": [], ""ranking"": {""required"": false, ""metric"": null, ""direction"": null, ""limit"": null}, ""required_classes"": [""ATOM_ENTITY_INVESTOR_PROFILE_001"", ""ATOM_ENTITY_PORTFOLIO_HEALTH_001"", ""ATOM_ENTITY_PORTFOLIO_HOLDING_001""], ""execution_strategy"": ""preaggregate_sql"", ""output_schema"": [""investor_id"", ""investor_name""], ""requirements"": [{""text"": ""Conservative investors"", ""implemented_by"": [""filters.0""]}, {""text"": ""risk score above 75"", ""implemented_by"": [""filters.1""]}, {""text"": ""hold a Corporate Bond"", ""implemented_by"": [""filters.2""]}], ""unresolved_requirements"": [], ""reason"": ""The query identifies Conservative investors by filtering risk_tolerance, intersects with those having risk_score > 75 from portfolio health, and further intersects with investors holding Corporate Bond investments. Inner joins ensure all conditions are met, and results are grouped by investor_id to return unique investor identifiers and names."", ""structural_repairs"": [], ""preserve_null_groups"": true, ""contract_errors"": [], ""contract_warnings"": [""group_by.0 has no quoted requirement."", ""group_by.1 has no quoted requirement.""], ""domain_context_trace"": {""fingerprint"": ""17431387871b488d8ce132ac8b0fe19f6f5a82b41806145ebcec8814c193f17e"", ""available_rules"": []}}","WITH investors_with_high_risk_score AS (
  SELECT investor_id
  FROM ATOM_ENTITY_PORTFOLIO_HEALTH_001
  WHERE risk_score > 75
  GROUP BY investor_id
),
investors_with_corporate_bonds AS (
  SELECT investor_id
  FROM ATOM_ENTITY_PORTFOLIO_HOLDING_001
  WHERE investment_type = 'Corporate Bond'
  GROUP BY investor_id
)
SELECT 
  p.investor_id,
  p.investor_name
FROM 
  ATOM_ENTITY_INVESTOR_PROFILE_001 p
INNER JOIN 
  investors_with_high_risk_score hr ON p.investor_id = hr.investor_id
INNER JOIN 
  investors_with_corporate_bonds cb ON p.investor_id = cb.investor_id
WHERE 
  p.risk_tolerance = 'Conservative'
GROUP BY 
