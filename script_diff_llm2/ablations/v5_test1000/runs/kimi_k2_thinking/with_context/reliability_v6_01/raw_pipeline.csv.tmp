iltering the investor profile table, then intersects with investors who have low diversification scores, Bear Market scenario records, and underfunded goals using inner joins across portfolio health, scenario rebalancing, and investment goal tables. The final grouping ensures unique investor records are returned."", ""structural_repairs"": [{""path"": ""measures.0.operand_kind"", ""from"": null, ""to"": ""physical"", ""evidence"": ""operand names resolve against the declared source or planned aliases""}], ""preserve_null_groups"": true, ""contract_errors"": [], ""contract_warnings"": [""group_by.0 has no quoted requirement."", ""group_by.1 has no quoted requirement."", ""measures.0 has no quoted requirement.""], ""domain_context_trace"": {""fingerprint"": ""17431387871b488d8ce132ac8b0fe19f6f5a82b41806145ebcec8814c193f17e"", ""available_rules"": []}}","WITH investor_measures AS (
  SELECT
    ip.investor_id,
    ip.investor_name,
    COUNT(DISTINCT ip.investor_id) AS investor_count
  FROM ATOM_ENTITY_INVESTOR_PROFILE_001 ip
  INNER JOIN ATOM_ENTITY_PORTFOLIO_HEALTH_001 ph
    ON ip.investor_id = ph.investor_id
  INNER JOIN ATOM_EVENT_SCENARIO_REBALANCING_001 sr
    ON ip.investor_id = sr.investor_id
  INNER JOIN ATOM_ENTITY_INVESTMENT_GOAL_001 ig
    ON ip.investor_id = ig.investor_id
  WHERE ip.risk_tolerance = 'Moderate'
    AND ph.diversification_score < 25
    AND sr.scenario = 'Bear Market'
    AND ig.shortfall > 0
  GROUP BY ip.investor_id, ip.investor_name
)
SELECT investor_id, investor_name
FROM investor_measures
