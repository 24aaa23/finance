, {""text"": ""sector allocation above 0% in Consumer Goods"", ""implemented_by"": [""filters.2"", ""filters.3""]}], ""unresolved_requirements"": [], ""reason"": ""The query identifies a set of investors meeting three concurrent conditions: aggressive risk tolerance, low liquidity score, and positive allocation to Consumer Goods sector. Starting with the investor profile table as base, inner joins to portfolio health and sector allocation tables enforce all constraints. Filters are applied on each table's relevant columns. Results are grouped by investor to ensure distinct investor records in the output."", ""structural_repairs"": [], ""preserve_null_groups"": true, ""contract_errors"": [], ""contract_warnings"": [""group_by.0 has no quoted requirement."", ""group_by.1 has no quoted requirement.""], ""domain_context_trace"": {""fingerprint"": ""17431387871b488d8ce132ac8b0fe19f6f5a82b41806145ebcec8814c193f17e"", ""available_rules"": []}}","WITH qualified_investors AS (
  SELECT
    ip.investor_id
  FROM ATOM_ENTITY_INVESTOR_PROFILE_001 ip
  INNER JOIN ATOM_ENTITY_PORTFOLIO_HEALTH_001 ph 
    ON ip.investor_id = ph.investor_id
  INNER JOIN ATOM_ENTITY_SECTOR_ALLOCATION_001 sa 
    ON ip.investor_id = sa.investor_id
  WHERE ip.risk_tolerance = 'Aggressive'
    AND ph.liquidity_score < 50
    AND sa.sector = 'Consumer Goods'
    AND sa.allocation_pct > 0
  GROUP BY ip.investor_id
)
SELECT
  ip.investor_id,
  ip.investor_name
FROM ATOM_ENTITY_INVESTOR_PROFILE_001 ip
