mplemented_by"": [""filters.3""]}], ""unresolved_requirements"": [], ""reason"": ""The query identifies Conservative investors meeting three specific conditions: low diversification score, exposure to currency depreciation scenario, and having underfunded goals. We use inner joins across four tables to enforce all conditions simultaneously, filtering each table appropriately before joining. The grain is per investor_id and investor_name, returning distinct investors who satisfy all criteria. The preaggregate_sql strategy ensures efficient multi-table filtering before final grouping."", ""structural_repairs"": [{""path"": ""plan.base_entity"", ""from"": ""investor"", ""to"": ""ATOM_ENTITY_INVESTOR_PROFILE_001"", ""evidence"": ""unique explicit owner of projected or distinctly counted entity key""}], ""preserve_null_groups"": true, ""contract_errors"": [], ""contract_warnings"": [], ""domain_context_trace"": {""fingerprint"": ""17431387871b488d8ce132ac8b0fe19f6f5a82b41806145ebcec8814c193f17e"", ""available_rules"": []}}","WITH portfolio_scores AS (
  SELECT investor_id
  FROM ATOM_ENTITY_PORTFOLIO_HEALTH_001
  WHERE diversification_score < 25
  GROUP BY investor_id
),
scenario_records AS (
  SELECT investor_id
  FROM ATOM_EVENT_SCENARIO_REBALANCING_001
  WHERE scenario = 'Currency Depreciation'
  GROUP BY investor_id
),
underfunded_goals AS (
  SELECT investor_id
  FROM ATOM_ENTITY_INVESTMENT_GOAL_001
  WHERE progress_pct < 100
  GROUP BY investor_id
)
SELECT
  ip.investor_id,
  ip.investor_name
FROM ATOM_ENTITY_INVESTOR_PROFILE_001 AS ip
INNER JOIN portfolio_scores AS ps ON ip.investor_id = ps.investor_id
INNER JOIN scenario_records AS sr ON ip.investor_id = sr.investor_id
INNER JOIN underfunded_goals AS ug ON ip.investor_id = ug.investor_id
WHERE ip.risk_tolerance = 'Conservative'
GROUP BY ip.investor_id, ip.investor_name",True,Valid,,success,11.0,,"[{""investor_id"": ""INV-1025"", ""investor_name"": ""Rohan Arora""}, {""investor_id"": ""INV-1132"", ""investor_name"": ""Deepak Bhat""}, {""investor_id"": ""INV-1406"", ""investor_name"": ""Meena Sharma""}, {""investor_id"": ""INV-1482"", ""investor_name"": ""Aishwarya Joshi""}, {""investor_id"": ""INV-1505"", ""investor_name"": ""Akshay Nair""}, {""investor_id"": ""INV-1535"", ""investor_name"": ""Chetan Verma""}, {""investor_id"": ""INV-302"", ""investor_name"": ""Ankita Sharma""}, {""investor_id"": ""INV-473"", ""investor_name"": ""Rohan Rao""}, {""investor_id"": ""INV-832"", ""investor_name"": ""Rohan Kulkarni""}, {""investor_id"": ""INV-837"", ""investor_name"": ""Aishwarya Mishra""}, {""investor_id"": ""INV-947"", ""investor_name"": ""Deepak Singh""}]",[],{},,True,Result rows satisfy the Query_Spec output shape checks.,0,,,success,"{""Q1"": ""success""}","{""Q1"": []}","[[""Q1""]]","{""Q1"": ""SQL""}","{""Q1"": {""node_id"": ""Q1"", ""description"": ""Which Conservative investors have a diversification score below 25, a Currency Depreciation scenario record, and at least one underfunded goal?"", ""operator"": ""Subquery"", ""backend"": ""SQL"", ""declared_inputs"": [], ""declared_outputs"": [], ""dependencies"": [], ""query_spec"": {""query_type"": ""set_logic"", ""base_entity"": ""ATOM_ENTITY_INVESTOR_PROFILE_001"", ""entity_key"": ""investor_id"", ""join_policy"": ""inner_join"", ""grain"": {""pre_aggregate_by"": [""investor_id""], ""final_group_by"": [""investor_id"", ""investor_name""]}, ""group_by"": [{""output_name"": ""investor_id"", ""source_class"": ""ATOM_ENTITY_INVESTOR_PROFILE_001"", ""field"": ""investor_id""}, {""output_name"": ""investor_name"", ""source_class"": ""ATOM_ENTITY_INVESTOR_PROFILE_001"", ""field"": ""investor_name""}], ""filters"": [{""source_class"": ""ATOM_ENTITY_INVESTOR_PROFILE_001"", ""field"": ""risk_tolerance"", ""operator"": ""="", ""value"": ""Conservat