ore below 25"", ""implemented_by"": [""measures.0.population_filters.0""]}, {""text"": ""Economic Growth scenario record"", ""implemented_by"": [""measures.1.population_filters.0"", ""measures.1.aggregate_filters.0""]}, {""text"": ""at least one underfunded goal"", ""implemented_by"": [""measures.2.population_filters.0"", ""measures.2.aggregate_filters.0""]}], ""unresolved_requirements"": [], ""reason"": ""The query identifies Moderate investors by filtering on risk_tolerance, then requires three additional conditions: a low diversification score, presence of an Economic Growth scenario record, and at least one underfunded goal. Each condition is implemented as a separate measure with population filters to select qualifying rows and aggregate filters to enforce existence (count >= 1). Pre-aggregate SQL strategy prevents join fanout from the one-to-many relationships."", ""group_by"": [], ""structural_repairs"": [{""path"": ""measures.0.operand_kind"", ""from"": null, ""to"": ""physical"", ""evidence"": ""operand names resolve against the declared source or planned aliases""}, {""path"": ""measures.1.operand_kind"", ""from"": null, ""to"": ""physical"", ""evidence"": ""operand names resolve against the declared source or planned aliases""}, {""path"": ""measures.2.operand_kind"", ""from"": null, ""to"": ""physical"", ""evidence"": ""operand names resolve against the declared source or planned aliases""}], ""contract_errors"": [], ""contract_warnings"": [], ""domain_context_trace"": {""fingerprint"": ""17431387871b488d8ce132ac8b0fe19f6f5a82b41806145ebcec8814c193f17e"", ""available_rules"": []}}","WITH 
moderate_investors AS (
  SELECT investor_id, investor_name
  FROM ATOM_ENTITY_INVESTOR_PROFILE_001
  WHERE risk_tolerance = 'Moderate'
),
portfolio_health_check AS (
  SELECT DISTINCT investor_id
  FROM ATOM_ENTITY_PORTFOLIO_HEALTH_001
  WHERE diversification_score < 25
),
scenario_count AS (
  SELECT 
    investor_id,
    COUNT(*) AS economic_growth_scenario_count
  FROM ATOM_EVENT_SCENARIO_REBALANCING_001
  WHERE scenario = 'Economic Growth'
  GROUP BY investor_id
  HAVING COUNT(*) >= 1
),
goal_count AS (
  SELECT 
    investor_id,
    COUNT(*) AS underfunded_goal_count
  FROM ATOM_ENTITY_INVESTMENT_GOAL_001
  WHERE shortfall > 0
  GROUP BY investor_id
  HAVING COUNT(*) >= 1
)
SELECT 
  mi.investor_id,
  mi.investor_name
FROM moderate_investors mi
INNER JOIN portfolio_health_check ph ON mi.investor_id = ph.investor_id
INNER JOIN scenario_count sc ON mi.investor_id = sc.investor_id
INNER JOIN goal_count gc ON mi.investor_id = gc.investor_id",True,Valid,,success,4.0,,"[{""investor_id"": ""INV-042"", ""investor_name"": ""Suresh Bhat""}, {""investor_id"": ""INV-1038"", ""investor_name"": ""Rahul Iyer""}, {""investor_id"": ""INV-499"", ""investor_name"": ""Arjun Patel""}, {""investor_id"": ""INV-745"", ""investor_name"": ""Sunita Mehta""}]",[],{},,True,Result rows satisfy the Query_Spec output shape checks.,0,,,success,"{""Q1"": ""success""}","{""Q1"": []}","[[""Q1""]]","{""Q1"": ""SQL""}","{""Q1"": {""node_id"": ""Q1"", ""description"": ""Which Moderate investors have a diversification score below 25, a Economic Growth scenario record, and at least one underfunded goal?"", ""operator"": ""Subquery"", ""backend"": ""SQL"", ""declared_inputs"": [], ""declared_outputs"": [], ""dependencies"": [], ""query_spec"": {""query_type"": ""set_logic"", ""base_entity"": ""ATOM_ENTITY_INVESTOR_PROFILE_001"", ""entity_key"": ""investor_id"", ""join_policy"": ""inner_join"", ""grain"": {""pre_aggregate_by"": [""investor_id""], ""final_group_by"": []}, ""filters"": [{""source_class"": ""ATOM_ENTITY_INVESTOR_PROFILE_001"", ""field"": ""risk_tolerance"", ""operator"": ""="", ""value"": ""Moderate"", ""value_type"": ""string""}], ""measures"": [{""output_name"": ""diversification_score"", ""source_class"": ""ATOM_ENTITY_PORTFOLIO_HEALTH_001"", ""field"": ""diversification_score"", ""formula"": null, ""formula_fields"": [], ""formula_stage"": null, ""population_filters"": [{""source_class"": ""ATOM_ENTITY_PORTFOLIO_HEALTH_001"", ""field"": ""diversification_score"", ""operator"": ""<"", ""value"": 25, ""value_type"": ""number""}], ""aggregate_filters"": [], ""missing_entity_value"": null, ""unit"": null, ""per_entity_operation"": null, ""final_operation"": null, ""requires_distinct"": false, ""operand_kind"": ""physical""}, {""output_name"": ""economic_growth_scenario_count"", ""source_class"": ""ATOM_EVENT_SCENARIO_REBALANCING_001"", ""field"": ""scenario_rebalance_