  SELECT investor_id
  FROM ATOM_ENTITY_PORTFOLIO_HEALTH_001
  WHERE risk_score > 75
  GROUP BY investor_id
),
inverstors_with_gold AS (
  SELECT investor_id
  FROM ATOM_ENTITY_PORTFOLIO_HOLDING_001
  WHERE investment_type = 'Gold'
  GROUP BY investor_id
)
SELECT DISTINCT
  ip.investor_id,
  ip.investor_name
FROM ATOM_ENTITY_INVESTOR_PROFILE_001 AS ip
INNER JOIN investors_with_high_risk AS ihr ON ip.investor_id = ihr.investor_id
INNER JOIN inverstors_with_gold AS ig ON ip.investor_id = ig.investor_id
WHERE ip.risk_tolerance = 'Conservative'",True,Valid,,success,64.0,,"[{""investor_id"": ""INV-021"", ""investor_name"": ""Arvind Chauhan""}, {""investor_id"": ""INV-071"", ""investor_name"": ""Anita Iyer""}, {""investor_id"": ""INV-1012"", ""investor_name"": ""Amrita Iyer""}, {""investor_id"": ""INV-1025"", ""investor_name"": ""Rohan Arora""}, {""investor_id"": ""INV-1045"", ""investor_name"": ""Arvind Nair""}, {""investor_id"": ""INV-1048"", ""investor_name"": ""Geeta Pandey""}, {""investor_id"": ""INV-1072"", ""investor_name"": ""Amrita Kulkarni""}, {""investor_id"": ""INV-1120"", ""investor_name"": ""Arjun Bhat""}, {""investor_id"": ""INV-1121"", ""investor_name"": ""Rajesh Arora""}, {""investor_id"": ""INV-1138"", ""investor_name"": ""Sneha Reddy""}, {""investor_id"": ""INV-1139"", ""investor_name"": ""Rahul Chauhan""}, {""investor_id"": ""INV-114"", ""investor_name"": ""Ishita Singh""}, {""investor_id"": ""INV-1148"", ""investor_name"": ""Rohan Rao""}, {""investor_id"": ""INV-118"", ""investor_name"": ""Vivek Rao""}, {""investor_id"": ""INV-1198"", ""investor_name"": ""Anita Verma""}, {""investor_id"": ""INV-1221"", ""investor_name"": ""Aishwarya Kulkarni""}, {""investor_id"": ""INV-1238"", ""investor_name"": ""Bhavna Bhat""}, {""investor_id"": ""INV-124"", ""investor_name"": ""Rajesh Kulkarni""}, {""investor_id"": ""INV-1281"", ""investor_name"": ""Ankita Rao""}, {""investor_id"": ""INV-1310"", ""investor_name"": ""Sneha Iyer""}, {""investor_id"": ""INV-1312"", ""investor_name"": ""Amit Verma""}, {""investor_id"": ""INV-1321"", ""investor_name"": ""Sunita Verma""}, {""investor_id"": ""INV-1348"", ""investor_name"": ""Anand Deshmukh""}, {""investor_id"": ""INV-141"", ""investor_name"": ""Geeta Verma""}, {""investor_id"": ""INV-1421"", ""investor_name"": ""Meena Mishra""}, {""investor_id"": ""INV-1481"", ""investor_name"": ""Amit Mishra""}, {""investor_id"": ""INV-149"", ""investor_name"": ""Deepak Pandey""}, {""investor_id"": ""INV-1492"", ""investor_name"": ""