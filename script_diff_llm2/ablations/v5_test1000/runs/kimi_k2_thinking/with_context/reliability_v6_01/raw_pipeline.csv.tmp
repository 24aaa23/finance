"", ""to"": ""ATOM_ENTITY_INVESTOR_PROFILE_001"", ""evidence"": ""unique explicit owner of projected or distinctly counted entity key""}], ""preserve_null_groups"": true, ""contract_errors"": [], ""contract_warnings"": [""group_by.0 has no quoted requirement.""], ""domain_context_trace"": {""fingerprint"": ""17431387871b488d8ce132ac8b0fe19f6f5a82b41806145ebcec8814c193f17e"", ""available_rules"": []}}","WITH health_filter AS (
  SELECT investor_id
  FROM ATOM_ENTITY_PORTFOLIO_HEALTH_001
  WHERE risk_score > 50
  GROUP BY investor_id
),
holding_filter AS (
  SELECT investor_id
  FROM ATOM_ENTITY_PORTFOLIO_HOLDING_001
  WHERE investment_type = 'Gold'
  GROUP BY investor_id
),
rebalancing_filter AS (
  SELECT investor_id
  FROM ATOM_EVENT_REBALANCING_ACTION_001
  WHERE action = 'Aggressive Entry'
  GROUP BY investor_id
),
goal_filter AS (
  SELECT investor_id
  FROM ATOM_ENTITY_INVESTMENT_GOAL_001
  WHERE shortfall > 0
  GROUP BY investor_id
)
SELECT p.investor_id
FROM ATOM_ENTITY_INVESTOR_PROFILE_001 AS p
INNER JOIN health_filter AS h ON p.investor_id = h.investor_id
INNER JOIN holding_filter AS ph ON p.investor_id = ph.investor_id
INNER JOIN rebalancing_filter AS ra ON p.investor_id = ra.investor_id
INNER JOIN goal_filter AS g ON p.investor_id = g.investor_id
WHERE p.risk_tolerance = 'Conservative'
GROUP BY p.investor_id",True,Valid,,success,9.0,,"[{""investor_id"": ""INV-012""}, {""investor_id"": ""INV-1238""}, {""investor_id"": ""INV-1321""}, {""investor_id"": ""INV-1348""}, {""investor_id"": ""INV-1481""}, {""investor_id"": ""INV-212""}, {""investor_id"": ""INV-456""}, {""investor_id"": ""INV-491""}, {""investor_id"": ""INV-947""}]",[],{},,True,Result rows satisfy the Query_Spec output shape checks.,0,,,success,"{""Q1"": ""success""}","{""Q1"": []}","[[""Q1""]]","{""Q1"": ""SQL""}","{""Q1"": {""node_id"": ""Q1"", ""description"": ""Which Conservative investors have a risk score above 50, hold a Gold position, have a 'Aggressive Entry' rebalancing action, and an underfunded goal?"", ""operator"": ""Subquery"", ""backend"": ""SQL"", ""declared_inputs"": [], ""declared_outputs"": [], ""dependencies"": [], ""query_spec"": {""query_type"": ""set_logic"", ""base_entity"": ""ATOM_ENTITY_INVESTOR_PROFILE_001"", ""entity_key"": ""investor_id"", ""join_policy"": ""inner_join"", ""grain"": {""pre_aggregate_by"": [""investor_id""], ""final_group_by"": [""investor_id""]}, ""group_by"": [{""output_name"": ""investor_id"", ""source_class"": ""ATOM_ENTITY_INVESTOR_PROFILE_001"", ""field"": ""investor_id""}], ""filters"": [{""source_class"": ""ATOM_ENTITY_INVESTOR_PROFILE_001"", ""field"": ""risk_tolerance"", ""operator"": ""="", ""value"": ""Conservative"", ""value_type"": ""string""}, {""source_class"": ""ATOM_ENTITY_PORTFOLIO_HEALTH_001"", ""field"": ""risk_score"", ""operator"": "">"", ""value"": 50, ""value_type"": ""number""}, {""source_class"": ""ATOM_ENTITY_PORTFOLIO_HOLDING_001"", ""field"": ""investment_type"", ""operator"": ""="", ""value"": ""Gold"", ""value_type"": ""string""}, {""source_class"": ""ATOM_EVENT_REBALANCING_ACTION_001"", ""field"": ""action"", ""operator"": ""="", ""value"": ""Aggressive Entry"", ""value_type"": ""string""}, {""source_class"": ""ATOM_ENTITY_INVESTMENT_GOAL_001"", ""field"": ""shortfall"", ""operator"": "">"", ""value"": 0, ""value