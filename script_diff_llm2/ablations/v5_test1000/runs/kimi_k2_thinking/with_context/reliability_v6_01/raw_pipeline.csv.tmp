ilters"": [], ""aggregate_filters"": [], ""missing_entity_value"": null, ""unit"": null, ""per_entity_operation"": ""COUNT"", ""final_operation"": ""COUNT"", ""requires_distinct"": true, ""operand_kind"": ""physical""}], ""ranking"": {""required"": false, ""metric"": null, ""direction"": null, ""limit"": null}, ""required_classes"": [""ATOM_ENTITY_INVESTOR_PROFILE_001"", ""ATOM_ENTITY_PORTFOLIO_HEALTH_001"", ""ATOM_ENTITY_PORTFOLIO_HOLDING_001"", ""ATOM_EVENT_REBALANCING_ACTION_001""], ""execution_strategy"": ""preaggregate_sql"", ""output_schema"": [""investor_id"", ""investor_name""], ""requirements"": [{""text"": ""Long-term investors"", ""implemented_by"": [""filters.0""]}, {""text"": ""risk score above 50"", ""implemented_by"": [""filters.1""]}, {""text"": ""hold a Corporate Bond"", ""implemented_by"": [""filters.2""]}, {""text"": ""have at least one rebalancing action"", ""implemented_by"": [""join_policy"", ""required_classes.3""]}], ""unresolved_requirements"": [], ""reason"": ""The query identifies investors meeting multiple criteria across different tables. We use inner joins to ensure all conditions are met, including existence of rebalancing actions. Pre-aggregation by investor_id prevents fanout from the one-to-many relationships with holdings and rebalancing actions. The output returns distinct investor identifiers and names."", ""structural_repairs"": [{""path"": ""measures.0.operand_kind"", ""from"": null, ""to"": ""physical"", ""evidence"": ""operand names resolve against the declared source or planned aliases""}], ""preserve_null_groups"": true, ""contract_errors"": [], ""contract_warnings"": [""group_by.0 has no quoted requirement."", ""group_by.1 has no quoted requirement."", ""measures.0 has no quoted requirement.""], ""domain_context_trace"": {""fingerprint"": ""17431387871b488d8ce132ac8b0fe19f6f5a82b41806145ebcec8814c193f17e"", ""available_rules"": []}}, ""generated_sql"": ""WITH base_investors AS (\n  SELECT investor_id, investor_name\n  FROM ATOM_ENTITY_INVESTOR_PROFILE_001\n  WHERE time_horizon = 'Long-term'\n),\nrisk_investors AS (\n  SELECT investor_id\n  FROM ATOM_ENTITY_PORTFOLIO_HEALTH_001\n  WHERE risk_score > 50\n  GROUP BY investor_id\n),\nbond_investors AS (\n  SELECT investor_id\n  FROM ATOM_ENTITY_PORTFOLIO_HOLDING_001\n  WHERE investment_type = 'Corporate Bond'\n  GROUP BY investor_id\n),\nrebalance_investors AS (\n  SELECT investor_id\n  FROM ATOM_EVENT_REBALANCING_ACTION_001\n  GROUP BY investor_id\n)\nSELECT \n  b.investor_id,\n  MIN(b.investor_name) AS investor_name\nFROM base_investors b\nINNER JOIN risk_investors r ON b.investor_id = r.investor_id\nINNER JOIN bond_investors bn ON b.investor_id = bn.investor_id\nINNER JOIN rebalance_investors rb ON b.investor_id = rb.investor_id\nGROUP BY b.investor_id"", ""generate_sql_reasoning"": ""Filters investors with Long-term time horizon from the profile table, then pre-aggregates the one-to-many relationships (portfolio health, holdings, and rebalancing actions) into distinct investor_id lists to prevent fanout. INNER JOINs enforce all four conditions simultaneously. The final GROUP BY uses only investor_id as specified in final_group_by, while investor_name is aggregated with MIN to satisfy SELECT requirements without adding it to the GROUP BY clause. The investor_count measure from query_spec is not included in the final SELECT since it is absent from output_schema, aligning with the contract requirements."", ""generate_sql_parse_error"": """", ""generate_sql_raw_response_preview"": "" ```json\n{\n  \""sql\"": \""WITH base_investors AS (\\n  SELECT investor_id, investor_name\\n  FROM ATOM_ENTITY_INVESTOR_PROFILE_001\\n  WHERE time_horizon = 'Long-term'\\n),\\nrisk_investors AS (\\n  SELECT investor_id\\n  FROM ATOM_ENTITY_PORTFOLIO_HEALTH_001\\n  WHERE risk_score > 50\\n  GROUP BY investor_id\\n),\\nbond_investors AS (\\n  SELECT investor_id\\n  FROM ATOM_ENTITY_PORTFOLIO_HOLDING_001\\n  WHERE investment_type = 'Corporate Bond'\\n  GROUP BY investor_id\\n),\\nrebalance_investors AS (\\n  SELECT invest"", ""pre_scan_validation_is_valid"": true, ""pre_scan_validation_reason"": ""Valid"", ""scan_status"": ""success"", ""scan_row_count"": 90, ""scan_error"": """", ""scan_error_type"": """", ""scan_raw_rows"": ""[{\""investor_id\"": \""INV-034\"", \""investor_name\"": \""Sneha Reddy\""}, {\""investor_id\"": \""INV-056\"", \""investor_name\"": \""Amrita Hegde\""}, {\""investor_id\"": \""INV-064\"", \""investor_name\"": \""Arvind Singh\""}, {\""investor_id\"": \""INV-081\"", \""investor_name\"": \""Bhavna Pandey\""}, {\""investor_id\"": \""INV-098\"", \""investor_name\"": \""Arvind Singh\""}, {\""investor_id\"": \""INV-1005\"", \""investor_name\"": \""Siddharth Chauhan\""}, {\""investor_id\"": \""INV-1015\"", \""investor_name\"": \""Siddharth Deshmukh\""}, {\""investor_id\"": \""INV-1041\"", \""investor_name\"": \""Deepak Kulkarni\""}, {\""investor_id\"": \""INV-1061\"", \""investor_name\"": \""Vikram Verma\""}, {\""investor_id\"": \""INV-1064\"", \""investor_name\"": \""Rohan Bhat\""}, {\""investor_id\"": \""INV-1067\"", \""investor_name\"": \""Arvind Patel\""}, {\""investor_id\"": \""INV-1099\"", \""investor_name\"": \""Anita Deshmukh\""}, {\""investor_id\"": \""INV-110\"", \""investor_name\"": \""Vikram Iyer\""}, {\""investor_id\"": \""INV-1113\"", \""investor_name\"": \""Suresh Rao\""}, {\""investor_id\"": \""INV-1128\"", \""investor_name\"": \""Rajesh Arora\""}, {\""investor_id\"": \""INV-113\"", \""investor_name\"": \""Anand Rao\""}, {\""investor_id\"": \""INV-114\"", \""investor_name\"": \""Ishita Singh\""}, {\""investor_id\"": \""INV-1140\"", \""investor_name\"": \""Ishita Gupta\""}, {\""investor_id\"": \""INV-1153\"", \""investor_name\"": \""Arvind Sharma\""}, {\""investor_id\"": \""INV-1154\"", \""investor_name\"": \""Ishita Hegde\""}, {\""investor_id\"": \""INV-116\"", \""investor_name\"": \""Ankita Deshmukh\""}, {\""investor_id\"": \""INV-1165\"", \""investor_name\"": \""Bhavna Mishra\""}, {\""i