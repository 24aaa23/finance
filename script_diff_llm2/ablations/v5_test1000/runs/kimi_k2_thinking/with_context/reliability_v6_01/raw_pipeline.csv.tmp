ull, ""requires_distinct"": false, ""operand_kind"": ""physical""}], ""ranking"": {""required"": false, ""metric"": null, ""direction"": null, ""limit"": null}, ""required_classes"": [""ATOM_ENTITY_INVESTOR_PROFILE_001"", ""ATOM_ENTITY_PORTFOLIO_HEALTH_001"", ""ATOM_EVENT_SCENARIO_REBALANCING_001"", ""ATOM_ENTITY_INVESTMENT_GOAL_001""], ""execution_strategy"": ""preaggregate_sql"", ""output_schema"": [""investor_id"", ""investor_name""], ""requirements"": [{""text"": ""Aggressive investors"", ""implemented_by"": [""filters.0""]}, {""text"": ""diversification score below 25"", ""implemented_by"": [""filters.1""]}, {""text"": ""Approaching Goal scenario record"", ""implemented_by"": [""measures.0.population_filters.0"", ""measures.0.aggregate_filters.0""]}, {""text"": ""at least one underfunded goal"", ""implemented_by"": [""measures.1.population_filters.0"", ""measures.1.aggregate_filters.0""]}], ""unresolved_requirements"": [], ""reason"": ""The query identifies Aggressive investors by filtering risk_tolerance, joins portfolio health to check diversification_score, and uses pre-aggregated counts with thresholds to verify existence of Approaching Goal scenario records and underfunded goals. Preaggregate_sql strategy prevents fanout from one-to-many joins."", ""structural_repairs"": [{""path"": ""measures.0.operand_kind"", ""from"": null, ""to"": ""physical"", ""evidence"": ""operand names resolve against the declared source or planned aliases""}, {""path"": ""measures.1.operand_kind"", ""from"": null, ""to"": ""physical"", ""evidence"": ""operand names resolve against the declared source or planned aliases""}], ""preserve_null_groups"": true, ""contract_errors"": [], ""contract_warnings"": [""group_by.0 has no quoted requirement."", ""group_by.1 has no quoted requirement.""], ""domain_context_trace"": {""fingerprint"": ""17431387871b488d8ce132ac8b0fe19f6f5a82b41806145ebcec8814c193f17e"", ""available_rules"": []}}","WITH m1_scenario AS (
  SELECT 
    investor_id,
    COUNT(scenario_rebalance_id) AS scenario_count
  FROM ATOM_EVENT_SCENARIO_REBALANCING_001
  WHERE scenario = 'Approaching Goal'
  GROUP BY investor_id
),
m2_goals AS (
  SELECT 
    investor_id,
    COUNT(goal_id) AS underfunded_goal_count
  FROM ATOM_ENTITY_INVESTMENT_GOAL_001
  WHERE shortfall > 0
  GROUP BY investor_id
)
SELECT 
  ip.investor_id AS investor_id,
  ip.investor_name AS investor_name
FROM ATOM_ENTITY_INVESTOR_PROFILE_001 AS ip
INNER JOIN ATOM_ENTITY_PORTFOLIO_HEALTH_001 AS ph 
  ON ip.investor_id = ph.investor_id
INNER JOIN m1_scenario AS s 
  ON ip.investor_id = s.investor_id
INNER JOIN m2_goals AS g 
  ON ip.investor_id = g.investor_id
WHERE 
  ip.risk_tolerance = 'Aggressive'
  AND ph.diversification_score < 25
  AND s.scenario_count >= 1
  AND g.underfunded_goal_count >= 1
GROUP BY 
  ip.investor_id,
  ip.investor_name",True,Valid,,success,10.0,,"[{""investor_id"": ""INV-014"", ""investor_name"": ""Rohan Chauhan""}, {""investor_id"": ""INV-030"", ""investor_name"": ""Ramesh Rao""}, {""investor_id"": ""INV-055"", ""investor_name"": ""Ramesh Bhat""}, {""investor_id"": ""INV-068"", ""investor_name"": ""Vikram Yadav""}, {""investor_id"": ""INV-1027"", ""investor_name"": ""Aishwarya Deshmukh""}, {""investor_id"": ""INV-1189"", ""investor_name"": ""Rajesh Kulkarni""}, {""investor_id"": ""INV-1248"", ""investor_name"": ""Siddharth Deshmukh""}, {""investor_id"": ""INV-130"", ""investor_name"": ""Abhishek Verma""}, {""investor_id"": ""INV-1532"", ""investor_name"": ""Ramesh Bhat""}, {""investor_id"": ""INV-164"", ""investor_name"": ""Rahul Hegde""}]",[],{},,True,Result rows satisfy the Query_Spec output shape checks.,0,,,success,"{""Q1"": ""success""}","{""Q1"": []}","[[""Q1""]]","{""Q1"": ""SQL""}","{""Q1"": {""node_id"": ""Q1"", ""description"": ""Which Aggressive investors have a diversification score below 25, a Approaching Goal scenario record, and at least one underfunded goal?"", ""operator"": ""Subquery"", ""backend"": ""SQL"", ""declared_inputs"": [], ""declared_outputs"": [], ""dependencies"": [], ""query_spec"": {""query_type"": ""set_logic"", ""base_entity"": ""ATOM_ENTITY_INVESTOR_PROFILE_001"", ""entity_key"": ""investor_id"", ""join_policy"": ""inner_join"", ""grain"": {""pre_aggregate_by"": [""investor_id""], ""final_group_by"": [""investor_id""]}, ""group_by"": [{""output_name"": ""investor_id"", ""source_class"": ""ATOM_ENTITY_INVESTOR_PROFILE_001"", ""field"": ""investor_id""}, {""output_name"": ""investor_name"", ""source_class"": ""ATOM_ENTITY_INVESTOR_PROFILE_001"", ""field"": ""investor_name""}], ""filters"": [{""source_class"": ""ATOM_ENTITY_INVESTOR_PROFILE_001"", ""field"": ""risk_tolerance"", ""operator"": ""="", ""value"": ""Aggressive"", ""value_type"": ""string""}, {""source_class"": ""ATOM_ENTITY_PORTFOLIO_HEALTH_001"", ""field"": ""diversi