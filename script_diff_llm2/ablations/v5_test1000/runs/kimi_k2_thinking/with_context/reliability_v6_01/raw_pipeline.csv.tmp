esh Bhat""}, {""investor_id"": ""INV-878"", ""investor_name"": ""Vikram Kulkarni""}, {""investor_id"": ""INV-881"", ""investor_name"": ""Aishwarya Rao""}, {""investor_id"": ""INV-887"", ""investor_name"": ""Deepak Mishra""}, {""investor_id"": ""INV-888"", ""investor_name"": ""Anjali Hegde""}, {""investor_id"": ""INV-908"", ""investor_name"": ""Arjun Sharma""}]",PIPELINE_SUCCESS,NEW_BENCHMARK,Raw pipeline output saved; run the separate grader script for MATCH/MISMATCH/PARTIAL.,2026-10-06T00:29:37,746.773,Q1:Subquery(SQL),Q1:Subquery(SQL),[],"{""query_type"": ""set_logic"", ""base_entity"": ""ATOM_ENTITY_INVESTOR_PROFILE_001"", ""entity_key"": ""investor_id"", ""join_policy"": ""inner_join"", ""grain"": {""pre_aggregate_by"": [""investor_id""], ""final_group_by"": [""investor_id"", ""investor_name""]}, ""group_by"": [{""output_name"": ""investor_id"", ""source_class"": ""ATOM_ENTITY_INVESTOR_PROFILE_001"", ""field"": ""investor_id""}, {""output_name"": ""investor_name"", ""source_class"": ""ATOM_ENTITY_INVESTOR_PROFILE_001"", ""field"": ""investor_name""}], ""filters"": [{""source_class"": ""ATOM_ENTITY_INVESTOR_PROFILE_001"", ""field"": ""risk_tolerance"", ""operator"": ""="", ""value"": ""Aggressive"", ""value_type"": ""string""}, {""source_class"": ""ATOM_ENTITY_PORTFOLIO_HEALTH_001"", ""field"": ""risk_score"", ""operator"": "">"", ""value"": 75, ""value_type"": ""number""}, {""source_class"": ""ATOM_ENTITY_PORTFOLIO_HOLDING_001"", ""field"": ""investment_type"", ""operator"": ""="", ""value"": ""Government Bond"", ""value_type"": ""string""}], ""measures"": [], ""ranking"": {""required"": false, ""metric"": null, ""direction"": null, ""limit"": null}, ""required_classes"": [""ATOM_ENTITY_INVESTOR_PROFILE_001"", ""ATOM_ENTITY_PORTFOLIO_HEALTH_001"", ""ATOM_ENTITY_PORTFOLIO_HOLDING_001""], ""execution_strategy"": ""preaggregate_sql"", ""output_schema"": [""investor_id"", ""investor_name""], ""requirements"": [{""text"": ""Aggressive investors"", ""implemented_by"": [""filters.0""]}, {""text"": ""risk score above 75"", ""implemented_by"": [""filters.1""]}, {""text"": ""hold a Government Bond"", ""implemented_by"": [""filters.2""]}], ""unresolved_requirements"": [], ""reason"": ""The query identifies investors satisfying three intersection conditions: Aggressive risk tolerance, risk score >75, and holding Government Bonds. This requires inner joins across three tables. Preaggregate strategy ensures proper handling of the one-to-many holdings relationship before final grouping by investor."", ""structural_repairs"": [], ""preserve_null_groups"": true, ""contract_errors"": [], ""contract_warnings"": [""group_by.0 has no quoted requirement."", ""group_by.1 has no quoted requirement.""], ""domain_context_trace"": {""fingerprint"": ""17431387871b488d8ce132ac8b0fe19f6f5a82b41806145ebcec8814c193f17e"", ""available_rules"": []}}","WITH health_agg AS (
  SELECT investor_id
  FROM ATOM_ENTITY_PORTFOLIO_HEALTH_001
  WHERE risk_score > 75
  GROUP BY investor_id
),
holdings_agg AS (
  SELECT investor_id
  FROM ATOM_ENTITY_PORTFOLIO_HOLDING_001
  WHERE investment_type = 'Government Bond'
  GROUP BY investor_id
)
SELECT
  ip.investor_id,
  ip.investor_name
FROM ATOM_ENTITY_INVESTOR_PROFILE_001 AS ip
INNER JOIN health_agg AS h ON ip.investor_id = h.investor_id
INNER JOIN holdings_agg AS ho ON ip.investor_id = ho.investor_id
