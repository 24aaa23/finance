or_id and investor_name for identification. Pre-aggregation prevents fanout from one-to-many relationships between investors and their holdings/goals/actions."", ""structural_repairs"": [{""path"": ""plan.base_entity"", ""from"": ""investor"", ""to"": ""ATOM_ENTITY_INVESTOR_PROFILE_001"", ""evidence"": ""unique explicit owner of projected or distinctly counted entity key""}], ""preserve_null_groups"": true, ""contract_errors"": [], ""contract_warnings"": [""group_by.0 has no quoted requirement."", ""group_by.1 has no quoted requirement.""], ""domain_context_trace"": {""fingerprint"": ""17431387871b488d8ce132ac8b0fe19f6f5a82b41806145ebcec8814c193f17e"", ""available_rules"": []}}","WITH profile_pre AS (
  SELECT 
    investor_id,
    MAX(investor_name) AS investor_name
  FROM ATOM_ENTITY_INVESTOR_PROFILE_001
  WHERE risk_tolerance = 'Aggressive'
  GROUP BY investor_id
),
health_pre AS (
  SELECT 
    investor_id
  FROM ATOM_ENTITY_PORTFOLIO_HEALTH_001
  WHERE risk_score > 50
  GROUP BY investor_id
),
holding_pre AS (
  SELECT 
    investor_id
  FROM ATOM_ENTITY_PORTFOLIO_HOLDING_001
  WHERE investment_type = 'Gold'
  GROUP BY investor_id
),
rebalancing_pre AS (
  SELECT 
    investor_id
  FROM ATOM_EVENT_REBALANCING_ACTION_001
  WHERE action = 'Cash Deployment'
  GROUP BY investor_id
),
goal_pre AS (
  SELECT 
    investor_id
  FROM ATOM_ENTITY_INVESTMENT_GOAL_001
  WHERE shortfall > 0
  GROUP BY investor_id
)
SELECT 
  p.investor_id,
  p.investor_name
FROM profile_pre p
INNER JOIN health_pre h ON p.investor_id = h.investor_id
INNER JOIN holding_pre ho ON p.investor_id = ho.investor_id
INNER JOIN rebalancing_pre r ON p.investor_id = r.investor_id
INNER JOIN goal_pre g ON p.investor_id = g.investor_id",True,Valid,,success,22.0,,"[{""investor_id"": ""INV-049"", ""investor_name"": ""Deepak Mehta""}, {""investor_id"": ""INV-068"", ""investor_name"": ""Vikram Yadav""}, {""investor_id"": ""INV-1104"", ""investor_name"": ""Arjun Patel""}, {""investor_id"": ""INV-1360"", ""investor_name"": ""Dipti Bhat""}, {""investor_id"": ""INV-181"", ""investor_name"": ""Suresh Reddy""}, {""investor_id"": ""INV-189"", ""investor_name"": ""Meena Hegde""}, {""investor_id"": ""INV-257"", ""investor_name"": ""Chetan Kulkarni""}, {""investor_id"": ""INV-306"", ""investor_name"": ""Ishita Deshmukh""}, {""investor_id"": ""INV-312"", ""investor_name"": ""Priyanka Pandey""}, {""investor_id"": ""INV-377"", ""investor_name"": ""Anita Singh""}, {""investor_id"": ""INV-445"", ""investor_name"": ""Sneha Sharma""}, {""investor_id"": ""INV-578"", ""investor_name"": ""Amit Pandey""}, {""investor_id"": ""INV-580"", ""investor_name"": ""Anita Patel""}, {""investor_id"": ""INV-585"", ""investor_name"": ""Arjun Yadav""}, {""investor_id"": ""INV-635"", ""investor_name"": ""Rohan Yadav""}, {""investor_id"": ""INV-721"", ""investor_name"": ""Amrita Reddy""}, {""investor_id"": ""INV-773"", ""investor_name"": ""Arvind Joshi""}, {""investor_id"": ""INV-798"", ""investor_name"": ""Aishwarya Singh""}, {""investor_id"": ""INV-849"", ""investor_name"": ""Arvind Bhat""}, {""investor_id"": ""INV-869"", ""investor_name"": ""Deepak Patel""}, {""investor_id"": ""INV-878"", ""investor_name"": ""Vikram Kulkarni""}, {""investor_id"": ""INV-887"", ""investor_name"": ""Deepak Mishra""}]",[],{},,True,Result rows satisfy the Query_Spec output shape checks.,0,,,success,"{""Q1"": ""success""}","{""Q1"": []}","[[""Q1""]]","{""Q1"": ""SQL""}","{""Q1"": {""node_id"": ""Q1"", ""description"": ""Which Aggressive investors have a risk score above 50, hold a Gold position, have a 'Cash Deployment' rebalancing action, and an underfunded goal?"", ""operator"": ""Subquery"", ""backen