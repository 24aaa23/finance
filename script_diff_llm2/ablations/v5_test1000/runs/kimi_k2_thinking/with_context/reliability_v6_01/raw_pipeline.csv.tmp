n Consumer Goods"", ""implemented_by"": [""filters.2"", ""filters.3""]}], ""unresolved_requirements"": [], ""reason"": ""The query identifies investors meeting three intersection conditions: Conservative risk tolerance, liquidity score < 50, and positive allocation to Consumer Goods sector. We inner join three tables on investor_id, filter each appropriately, and return distinct investors. Pre-aggregate strategy ensures correct results despite potential one-to-many relationships."", ""structural_repairs"": [{""path"": ""plan.base_entity"", ""from"": ""investor"", ""to"": ""ATOM_ENTITY_INVESTOR_PROFILE_001"", ""evidence"": ""unique explicit owner of projected or distinctly counted entity key""}], ""preserve_null_groups"": true, ""contract_errors"": [], ""contract_warnings"": [""group_by.0 has no quoted requirement."", ""group_by.1 has no quoted requirement.""], ""domain_context_trace"": {""fingerprint"": ""17431387871b488d8ce132ac8b0fe19f6f5a82b41806145ebcec8814c193f17e"", ""available_rules"": []}}","WITH m1 AS (
  SELECT investor_id
  FROM ATOM_ENTITY_PORTFOLIO_HEALTH_001
  WHERE liquidity_score < 50
  GROUP BY investor_id
),
m2 AS (
  SELECT investor_id
  FROM ATOM_ENTITY_SECTOR_ALLOCATION_001
  WHERE sector = 'Consumer Goods' AND allocation_pct > 0
  GROUP BY investor_id
)
SELECT 
  ip.investor_id,
  ip.investor_name
FROM ATOM_ENTITY_INVESTOR_PROFILE_001 AS ip
