PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT ?investorId ?investorName
WHERE {
  ?investor rdf:type wm:Investor ;
            wm:investorId ?investorId ;
            wm:investorName ?investorName ;
            wm:riskTolerance ""Aggressive""^^xsd:string .
  
  ?investor wm:hasPortfolioHealth ?health .
  ?health wm:riskScore ?riskScoreRaw .
  FILTER(xsd:decimal(?riskScoreRaw) > 50)
  
  ?investor wm:hasHolding ?holding .
  ?holding wm:investmentType ""Gold""^^xsd:string .
  
  ?investor wm:hasRebalancingAction ?rebalance .
  ?rebalance wm:action ""Asset Reallocation""^^xsd:string .
  
  ?investor wm:hasInvestmentGoal ?goal .
  ?goal wm:shortfall ?shortfallRaw .
  FILTER(xsd:decimal(?shortfallRaw) > 0)
