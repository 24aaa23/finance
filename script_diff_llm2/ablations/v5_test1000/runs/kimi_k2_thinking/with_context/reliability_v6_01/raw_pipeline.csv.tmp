", ""investor_name"": ""Rajesh Kulkarni""}, {""investor_id"": ""INV-987"", ""investor_name"": ""Sneha Bhat""}, {""investor_id"": ""INV-993"", ""investor_name"": ""Arvind Rao""}]",[],{},,True,Result rows satisfy the Query_Spec output shape checks.,0,,,success,"{""Q1"": ""success""}","{""Q1"": []}","[[""Q1""]]","{""Q1"": ""SQL""}","{""Q1"": {""node_id"": ""Q1"", ""description"": ""Which Moderate investors have a risk score above 75 and hold a Gold?"", ""operator"": ""Subquery"", ""backend"": ""SQL"", ""declared_inputs"": [], ""declared_outputs"": [], ""dependencies"": [], ""query_spec"": {""query_type"": ""set_logic"", ""base_entity"": ""ATOM_ENTITY_INVESTOR_PROFILE_001"", ""entity_key"": ""investor_id"", ""join_policy"": ""inner_join"", ""grain"": {""pre_aggregate_by"": [""investor_id""], ""final_group_by"": []}, ""group_by"": [], ""filters"": [{""source_class"": ""ATOM_ENTITY_INVESTOR_PROFILE_001"", ""field"": ""risk_tolerance"", ""operator"": ""="", ""value"": ""Moderate"", ""value_type"": ""string""}, {""source_class"": ""ATOM_ENTITY_PORTFOLIO_HEALTH_001"", ""field"": ""risk_score"", ""operator"": "">"", ""value"": 75, ""value_type"": ""number""}, {""source_class"": ""ATOM_ENTITY_PORTFOLIO_HOLDING_001"", ""field"": ""investment_type"", ""operator"": ""="", ""value"": ""Gold"", ""value_type"": ""string""}], ""measures"": [], ""ranking"": {""required"": false, ""metric"": null, ""direction"": null, ""limit"": null}, ""required_classes"": [""ATOM_ENTITY_INVESTOR_PROFILE_001"", ""ATOM_ENTITY_PORTFOLIO_HEALTH_001"", ""ATOM_ENTITY_PORTFOLIO_HOLDING_001""], ""execution_strategy"": ""preaggregate_sql"", ""output_schema"": [""investor_id"", ""investor_name""], ""requirements"": [{""text"": ""Which Moderate investors have a risk score above 75 and hold a Gold?"", ""implemented_by"": [""filters.0"", ""filters.1"", ""filters.2""]}, {""text"": ""Moderate investors"", ""implemented_by"": [""filters.0""]}, {""text"": ""risk score above 75"", ""implemented_by"": [""filters.1""]}, {""text"": ""hold a Gold"", ""implemented_by"": [""filters.2""]}], ""unresolved_requirements"": [], ""reason"": ""The query identifies investors meeting three intersection conditions: risk_tolerance='Moderate' from investor profile, risk_score>75 from portfolio health metrics, and existence of at least one Gold holding. The portfolio holdings table has a one-to-many relationship with investors, requiring preaggregate_sql to prevent join fanout. The strategy first identifies distinct investors with Gold holdings, then applies the remaining filters via inner joins to produce the final eligible investor set."", ""structural_repairs"": [], ""contract_errors"": [], ""contract_warnings"": [], ""domain_context_trace"": {""fingerprint"": ""17431387871b488d8ce132ac8b0fe19f6f5a82b41806145ebcec8814c193f17e"", ""available_rules"": []}}, ""generated_sql"": ""WITH \n  high_risk_investors AS (\n    SELECT investor_id\n    FROM ATOM_ENTITY_PORTFOLIO_HEALTH_001\n    WHERE risk_score > 75\n    GROUP BY investor_id\n  ),\n  gold_holders AS (\n    SELECT investor_id\n    FROM ATOM_ENTITY_PORTFOLIO_HOLDING_001\n    WHERE investment_type = 'Gold'\n    GROUP BY investor_id\n  )\nSELECT \n  ip.investor_id,\n  ip.investor_name\nFROM ATOM_ENTITY_INVESTOR_PROFILE_001 AS ip\nINNER JOIN high_risk_investors AS h ON ip.investor_id = h.investor_id\nINNER JOIN gold_holders AS g ON ip.investor_id = g.investor_id\nWHERE ip.risk_tolerance = 'Moderate';"", ""generate_sql_reasoning"": ""The query implements a two-level aggregation strategy to prevent join fanout from the one-to-many portfolio holdings relationship. First, it creates two CTEs that pre-filter and group the portfolio health and holdings tables by investor_id. The holdings CTE uses GROUP BY to collapse multiple Gold holdings per investor into a single row. Then the main query joins the base investor profile table with these two CTEs using inner joins, intersecting the three conditions: risk_tolerance='Moderate', risk_score>75, and holding Gold. The final select projects the required investor_id and investor_name columns."", ""generate_sql_parse_error"": """", ""generate_sql_raw_response_preview"": "" ```json\n{\n  \""sql\"": \""WITH \\n  high_risk_investors AS (\\n    SELECT investor_id\\n    FROM ATOM_ENTITY_PORTFOLIO_HEALTH_001\\n    WHERE risk_score > 75\\n    GROUP BY investor_id\\n  ),\\n  gold_holders AS (\\n    SELECT investor_id\\n    FROM ATOM_ENTITY_PORTFOLIO_HOLDING_001\\n    WHERE investment_type = 'Gold'\\n    GROUP BY investor_id\\n  )\\nSELECT \\n  ip.investor_id,\\n  ip.investor_name\\nFROM ATOM_ENTITY_INVESTOR_PROFILE_001 AS ip\\nINNER JOIN high_risk_investors AS h ON ip.investor_id = h.investor_id"", ""pre_scan_validation_is_valid"": true, ""pre_scan_validation_reason"": ""Valid. The SQL query correctly implements all specified filters through pre-aggregated CTEs to prevent join fanout, uses valid table and column names from the physical schema, and returns the required output schema. The execution strategy matches the 'preaggregate_sql' specification."", ""scan_status"": ""success"", ""scan_row_count"": 55, ""scan_error"": """", ""scan_error_type"": """", ""scan_raw_rows"": ""[{\""investor_id\"": \""INV-053\"", \""investor_name\"": \""Anita Iyer\""}, {\""investor_id\"": \""INV-058\"", \""investor_name\"": \""Meena Bhat\""}, {\""investor_id\"": \""INV-072\"", \""investor_name\"": \""Siddharth Gupta\""}, {\""investor_id\"": \""INV-091\"", \""investor_name\"": \""Akshay Iyer\""}, {\""investor_id\"": \""INV-1014\"", \""investor_name\"": \""Sneha Hegde\""}, {\""investor_id\"": \""INV-1015\"", \""investor_name\"": \""Siddharth Deshmukh\""}, {\""investor_id\"": \""INV-1021\"", \""investor_name\"": \""Amit Joshi\""}, {\""investor_id\"": \""INV-1049\"", \""investor_name\"": \""Abhishek Yadav\""}, {\""investor_id\"": \""INV-1079\"", \""investor_name\"": \""Amit Reddy\""}, {\""investor_id\"": \""INV-1099\"", \""investor_name\"": \""Anita Deshmukh\""}, {\""investor_id\"": \""INV-1112\"", \""in