ROUP BY investor_id\n)\nSELECT \n  p.investor_id,\n  p.investor_name\nFROM profile_pre p\nINNER JOIN health_pre h ON p.investor_id = h.investor_id\nINNER JOIN holding_pre ho ON p.investor_id = ho.investor_id\nINNER JOIN rebalancing_pre r ON p.investor_id = r.investor_id\nINNER JOIN goal_pre g ON p.investor_id = g.investor_id"", ""generate_sql_reasoning"": ""The query identifies Aggressive investors meeting all four conditions using pre-aggregated CTEs per table to prevent fanout from one-to-many relationships, then inner joins them to find the intersection set, returning distinct investor_id and investor_name."", ""generate_sql_parse_error"": """", ""generate_sql_raw_response_preview"": "" ```json\n{\n  \""sql\"": \""WITH profile_pre AS (\\n  SELECT \\n    investor_id,\\n    MAX(investor_name) AS investor_name\\n  FROM ATOM_ENTITY_INVESTOR_PROFILE_001\\n  WHERE risk_tolerance = 'Aggressive'\\n  GROUP BY investor_id\\n),\\nhealth_pre AS (\\n  SELECT \\n    investor_id\\n  FROM ATOM_ENTITY_PORTFOLIO_HEALTH_001\\n  WHERE risk_score > 50\\n  GROUP BY investor_id\\n),\\nholding_pre AS (\\n  SELECT \\n    investor_id\\n  FROM ATOM_ENTITY_PORTFOLIO_HOLDING_001\\n  WHERE investment_type = 'Gold'\\n  GROUP BY invest"", ""pre_scan_validation_is_valid"": true, ""pre_scan_validation_reason"": ""Valid"", ""scan_status"": ""success"", ""scan_row_count"": 22, ""scan_error"": """", ""scan_error_type"": """", ""scan_raw_rows"": ""[{\""investor_id\"": \""INV-049\"", \""investor_name\"": \""Deepak Mehta\""}, {\""investor_id\"": \""INV-068\"", \""investor_name\"": \""Vikram Yadav\""}, {\""investor_id\"": \""INV-1104\"", \""investor_name\"": \""Arjun Patel\""}, {\""investor_id\"": \""INV-1360\"", \""investor_name\"": \""Dipti Bhat\""}, {\""investor_id\"": \""INV-181\"", \""investor_name\"": \""Suresh Reddy\""}, {\""investor_id\"": \""INV-189\"", \""investor_name\"": \""Meena Hegde\""}, {\""investor_id\"": \""INV-257\"", \""investor_name\"": \""Chetan Kulkarni\""}, {\""investor_id\"": \"