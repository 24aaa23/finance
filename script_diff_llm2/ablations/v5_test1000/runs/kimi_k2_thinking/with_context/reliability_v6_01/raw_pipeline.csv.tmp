 ""direction"": null, ""limit"": null}, ""required_classes"": [""Investor"", ""PortfolioHealth""], ""execution_strategy"": ""single_sparql"", ""output_schema"": [""investorId"", ""investorName"", ""goalMatchPct""], ""requirements"": [{""text"": ""goal-match percentage is weak, below 10"", ""implemented_by"": [""filters.0""]}], ""unresolved_requirements"": [], ""reason"": ""The query selects investors whose portfolio health goal-match percentage is below 10. This requires joining Investor with PortfolioHealth via the hasPortfolioHealth relationship and filtering on the goalMatchPct field. The output includes investor identification and the matching percentage value."", ""structural_repairs"": [], ""contract_errors"": [], ""contract_warnings"": [], ""domain_context_trace"": {""fingerprint"": ""17431387871b488d8ce132ac8b0fe19f6f5a82b41806145ebcec8814c193f17e"", ""available_rules"": []}}","PREFIX wm: <https://wealth.example.org/ontology/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?investorId ?investorName ?goalMatchPct
WHERE {
  ?investor rdf:type wm:Investor ;
            wm:investorId ?investorId ;
            wm:investorName ?investorName ;
