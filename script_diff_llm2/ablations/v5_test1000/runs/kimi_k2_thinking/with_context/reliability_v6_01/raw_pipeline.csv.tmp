 ""value_type"": ""string""}], ""aggregate_filters"": [{""field"": ""approaching_goal_scenario_count"", ""operator"": "">"", ""value"": 0, ""stage"": ""entity"", ""scope"": ""population""}], ""missing_entity_value"": 0, ""unit"": null, ""per_entity_operation"": ""COUNT"", ""final_operation"": null, ""requires_distinct"": false, ""operand_kind"": ""physical""}, {""output_name"": ""underfunded_goal_count"", ""source_class"": ""ATOM_ENTITY_INVESTMENT_GOAL_001"", ""field"": ""goal_id"", ""formula"": null, ""formula_fields"": [], ""formula_stage"": null, ""population_filters"": [{""source_class"": ""ATOM_ENTITY_INVESTMENT_GOAL_001"", ""field"": ""shortfall"", ""operator"": "">"", ""value"": 0, ""value_type"": ""number""}], ""aggregate_filters"": [{""field"": ""underfunded_goal_count"", ""operator"": "">"", ""value"": 0, ""stage"": ""entity"", ""scope"": ""population""}], ""missing_entity_value"": 0, ""unit"": null, ""per_entity_operation"": ""COUNT"", ""final_operation"": null, ""requires_distinct"": false, ""operand_kind"": ""physical""}], ""ranking"": {""required"": false, ""metric"": null, ""direction"": null, ""limit"": null}, ""required_classes"": [""ATOM_ENTITY_INVESTOR_PROFILE_001"", ""ATOM_ENTITY_PORTFOLIO_HEALTH_001"", ""ATOM_EVENT_SCENARIO_REBALANCING_001"", ""ATOM_ENTITY_INVESTMENT_GOAL_001""], ""execution_strategy"": ""preaggregate_sql"", ""output_schema"": [""investor_id"", ""investor_name""], ""requirements"": [{""text"": ""Moderate investors"", ""implemented_by"": [""filters.0""]}, {""text"": ""diversification score below 25"", ""implemented_by"": [""measures.0.population_filters.0""]}, {""text"": ""Approaching Goal scenario record"", ""implemented_by"": [""measures.1.population_filters.0"", ""measures.1.aggregate_filters.0""]}, {""text"": ""at least one underfunded goal"", ""implemented_by"": [""measures.2.population_filters.0"", ""measures.2.aggregate_filters.0""]}], ""unresolved_requirements"": [], ""reason"": ""The query identifies investors meeting multiple existence and attribute conditions across profile, portfolio health, scenario events, and investment goals. We use inner joins to enforce all conditions, pre-aggregate detail tables by investor_id to prevent fanout, and apply aggregate filters to ensure 'at least one' existence constraints. The diversification score condition is applied as a population filter on the portfolio health table. Underfunded goals are identified by positive shortfall values."", ""structural_repairs"": [{""path"": ""measures.0.operand_kind"", ""from"": null, ""to"": ""physical"", ""evidence"": ""operand names resolve against the declared source or planned aliases""}, {""path"": ""measures.1.operand_kind"", ""from"": null, ""to"": ""physical"", ""evidence"": ""operand names resolve against the declared source or planned aliases""}, {""path"": ""measures.2.operand_kind"", ""from"": null, ""to"": ""physical"", ""evidence"": ""operand names resolve against the declared source or planned aliases""}], ""preserve_null_groups"": true, ""contract_errors"": [], ""contract_warnings"": [""group_by.0 has no quoted requirement."", ""group_by.1 has no quoted requirement.""], ""domain_context_trace"": {""fingerprint"": ""17431387871b488d8ce132ac8b0fe19f6f5a82b41806145ebcec8814c193f17e"", ""available_rules"": []}}","WITH 
m0 AS (
  SELECT 
    investor_id,
    AVG(diversification_score) AS diversification_score
  FROM ATOM_ENTITY_PORTFOLIO_HEALTH_001
  WHERE diversification_score < 25
  GROUP BY investor_id
),
m1 AS (
  SELECT 
    investor_id,
    COUNT(scenario_rebalance_id) AS approaching_goal_scenario_count
  FROM ATOM_EVENT_SCENARIO_REBALANCING_001
  WHERE scenario = 'Approaching Goal'
  GROUP BY investor_id
),
m2 AS (
  SELECT 
    investor_id,
    COUNT(goal_id) AS underfunded_goal_count
  FROM ATOM_ENTITY_INVESTMENT_GOAL_001
  WHERE shortfall > 0
  GROUP BY investor_id
)
SELECT 
  ip.investor_id,
  ip.investor_name
FROM ATOM_ENTITY_INVESTOR_PROFILE_001 AS ip
INNER JOIN m0 ON ip.investor_id = m0.investor_id
INNER JOIN m1 ON ip.investor_id = m1.investor_id
INNER JOIN m2 ON ip.investor_id = m2.investor_id
WHERE ip.risk_tolerance = 'Moderate'
  AND m1.approaching_goal_scenario_count > 0
  AND m2.underfunded_goal_count > 0
