e intersection conditions. We filter the Investor class for Moderate risk tolerance, join to PortfolioHealth for risk score > 50, join to PortfolioHolding for Gold investment type, join to RebalancingAction for Aggressive Entry action, and join to InvestmentGoal for underfunded goals (interpreted as shortfall > 0). Inner join policy ensures all conditions must be met. Output includes investor identifier and name."", ""structural_repairs"": [], ""contract_errors"": [], ""contract_warnings"": [], ""domain_context_trace"": {""fingerprint"": ""17431387871b488d8ce132ac8b0fe19f6f5a82b41806145ebcec8814c193f17e"", ""available_rules"": []}}","PREFIX wm: <https://wealth.example.org/ontology/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT ?investorId ?investorName
WHERE {
  ?investor rdf:type wm:Investor ;
            wm:investorId ?investorId ;
            wm:investorName ?investorName ;
            wm:riskTolerance ""Moderate"" ;
            wm:hasPortfolioHealth ?portfolioHealth ;
            wm:hasHolding ?holding ;
            wm:hasRebalancingAction ?rebalancingAction ;
            wm:hasInvestmentGoal ?investmentGoal .
  
  ?portfolioHealth wm:riskScore ?riskScore .
  FILTER(?riskScore > 50)
  
  ?holding wm:investmentType ""Gold"" .
  
  ?rebalancingAction wm:action ""Aggressive Entry"" .
  
  ?investmentGoal wm:shortfall ?shortfall .
  FILTER(?shortfall > 0)
}",True,"SPARQL correctly implements all filters, inner joins, and projections specified in the Query_Spec. All required classes are present, the base entity is properly typed, and the output schema matches the requested fields.",,success,12.0,,"[{""investorId"": ""INV-857"", ""investorName"": ""Ankita Yadav""}, {""investorId"": ""INV-1040"", ""investorName"": ""Bhavna Pandey""}, {""investorId"": ""INV-220"", ""investorName"": ""Amit Joshi""}, {""investorId"": ""INV-1126"", ""investorName"": ""Anita Iyer""}, {""investorId"": ""INV-1021"", ""investorName"": ""Amit Joshi""}, {""investorId"": ""INV-781"", ""investorName"": ""Dipti Reddy""}, {""investorId"": ""INV-373"", ""investorName"": ""Priyanka Bhat""}, {""investorId"": ""INV-474"", ""investorName"": ""Meena Kulkarni""}, {""investorId"": ""INV-1539"", ""investorName"": ""Amrita Chauhan""}, {""investorId"": ""INV-418"", ""investorName"": ""Akshay Mishra""}, {""investorId"": ""INV-779"", ""investorName"": ""Deepak Chauhan""}, {""investorId"": ""INV-993"", ""investorName"": ""Arvind Rao""}]",[],{},,True,Result rows satisfy the Query_Spec output shape checks.,1,,,success,"{""Q1"": ""success""}","{""Q1"": []}","[[""Q1""]]","{""Q1"": ""KG""}","{""Q1"": {""node_id"": ""Q1"", ""description"": ""Which Moderate investors have a risk score above 50, hold a Gold position, have a 'Aggressive Entry' rebalancing action, and an underfunded goal?"", ""operator"": ""Subquery"", ""backend"": ""KG"", ""declared_inputs"": [], ""declared_outputs"": [], ""dependencies"": [], ""retrieved_classes"": [""Investor"", ""PortfolioHealth"", ""PortfolioHolding"", ""RebalancingAction"", ""InvestmentGoal""], ""query_spec"": {""query_type"": ""set_logic"", ""base_entity"": ""Investor"", ""entity_key"": ""investorId"", ""join_policy"": ""inner_join"", ""grain"": {""pre_aggregate_by"": [], ""final_group_by"": []}, ""group_by"": [], ""filters"": [{""source_class"": ""Investor"", ""field"": ""riskTolerance"", ""operator"": ""="", ""value"": ""Moderate""