# Copy this file to azure.env in the same directory, then fill in the values.
# Keep exported credentials out of chat and source control.

# Preferred: the Azure OpenAI resource endpoint from the deployed model's page.
AZURE_OPENAI_ENDPOINT=

# Optional alternative: Foundry RESOURCE inference endpoint.
# A project URL ending /api/projects/... is not an inference endpoint.
AZURE_FOUNDRY_ENDPOINT=

# Key for the resource hosting the deployment above.
AZURE_OPENAI_API_KEY=

# EXACT deployment name from Foundry, which may differ from the catalog model ID.
AZURE_GPT_OSS_DEPLOYMENT=
