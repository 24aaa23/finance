ORDER BY composite_score DESC, investor_id ASC
LIMIT 10;
[SQL SCHEMA] Relevant tables: ['ATOM_ENTITY_INVESTMENT_GOAL_001', 'ATOM_ENTITY_INVESTOR_PROFILE_001', 'ATOM_ENTITY_PORTFOLIO_HEALTH_001', 'ATOM_ENTITY_PORTFOLIO_HOLDING_001', 'ATOM_ENTITY_SECTOR_ALLOCATION_001', 'ATOM_EVENT_CASH_FLOW_001', 'ATOM_EVENT_REBALANCING_ACTION_001', 'ATOM_EVENT_SCENARIO_REBALANCING_001']
[SQL GENERATE] Using physical tables: ['ATOM_ENTITY_INVESTMENT_GOAL_001', 'ATOM_ENTITY_INVESTOR_PROFILE_001', 'ATOM_ENTITY_PORTFOLIO_HEALTH_001', 'ATOM_ENTITY_PORTFOLIO_HOLDING_001', 'ATOM_ENTITY_SECTOR_ALLOCATION_001', 'ATOM_EVENT_CASH_FLOW_001', 'ATOM_EVENT_REBALANCING_ACTION_001', 'ATOM_EVENT_SCENARIO_REBALANCING_001']
[SQL GENERATE] Generated SQL: WITH total_gain AS (
    SELECT investor_id,
           SUM(current_value - cost) AS total_gain
    FROM ATOM_ENTITY_PORTFOLIO_HOLDING_001
    WHERE cost IS NOT NULL
      AND current_value IS NOT NULL
    GROUP BY investor_id
),
risk AS (
    SELECT investor_id,
           AVG(risk_score) AS risk_score
    FROM ATOM_ENTITY_PORTFOLIO_HEALTH_001
    WHERE risk_score IS NOT NULL
    GROUP BY investor_id
),
joined AS (
    SELECT g.investor_id,
           g.total_gain,
           r.risk_score
    FROM total_gain g
    INNER JOIN risk r ON g.investor_id = r.investor_id
),
norms AS (
    SELECT investor_id,
           total_gain,
           risk_score,
           (total_gain - MIN(total_gain) OVER ()) / NULLIF(MAX(total_gain) OVER () - MIN(total_gain) OVER (), 0) AS norm_gain,
           (risk_score - MIN(risk_score) OVER ()) / NULLIF(MAX(risk_score) OVER () - MIN(risk_score) OVER (), 0) AS norm_risk
    FROM joined
)
SELECT investor_id,
       100.0 * ((norm_gain + norm_risk) / 2.0) AS composite_score
FROM norms
ORDER BY composite_score DESC, investor_id ASC
LIMIT 10;
