FROM risk_groups rg
LEFT JOIN net_cash_by_risk nc      ON rg.risk_tolerance = nc.risk_tolerance
LEFT JOIN cash_flow_amount_by_risk cf ON rg.risk_tolerance = cf.risk_tolerance
LEFT JOIN total_holding_by_risk th   ON rg.risk_tolerance = th.risk_tolerance
LEFT JOIN scenario_shift_by_risk ss ON rg.risk_tolerance = ss.risk_tolerance
LEFT JOIN goal_progress_by_risk gp   ON rg.risk_tolerance = gp.risk_tolerance
