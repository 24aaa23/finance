[SQL GENERATE] Generated SQL: WITH cash AS (
    SELECT investor_id,
           SUM(amount) AS net_cash_flow
    FROM ATOM_EVENT_CASH_FLOW_001
    GROUP BY investor_id
),
holding AS (
    SELECT investor_id,
           SUM(current_value - cost) AS total_holding_gain
    FROM ATOM_ENTITY_PORTFOLIO_HOLDING_001
    WHERE cost IS NOT NULL AND current_value IS NOT NULL
    GROUP BY investor_id
),
risk AS (
    SELECT investor_id,
           risk_score
    FROM ATOM_ENTITY_PORTFOLIO_HEALTH_001
)
SELECT investor_id,
       100.0 * (
           COALESCE((net_cash_flow - min_cash) / NULLIF(max_cash - min_cash, 0), 0) +
           COALESCE((total_holding_gain - min_gain) / NULLIF(max_gain - min_gain, 0), 0) +
           COALESCE((risk_score - min_risk) / NULLIF(max_risk - min_risk, 0), 0)
       ) / 3.0 AS composite_score
FROM (
    SELECT i.investor_id,
           cash.net_cash_flow,
           holding.total_holding_gain,
           risk.risk_score,
           MIN(cash.net_cash_flow) OVER () AS min_cash,
           MAX(cash.net_cash_flow) OVER () AS max_cash,
           MIN(holding.total_holding_gain) OVER () AS min_gain,
           MAX(holding.total_holding_gain) OVER () AS max_gain,
           MIN(risk.risk_score) OVER () AS min_risk,
           MAX(risk.risk_score) OVER () AS max_risk
    FROM ATOM_ENTITY_INVESTOR_PROFILE_001 i
    INNER JOIN cash ON i.investor_id = cash.investor_id
    INNER JOIN holding ON i.investor_id = holding.investor_id
    INNER JOIN risk ON i.investor_id = risk.investor_id
) sub
ORDER BY composite_score DESC, investor_id ASC
LIMIT 10;
