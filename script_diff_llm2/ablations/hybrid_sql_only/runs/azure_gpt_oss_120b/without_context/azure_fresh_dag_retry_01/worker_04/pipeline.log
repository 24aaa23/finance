[SQL GENERATE] Generated SQL: WITH
  cash AS (
    SELECT investor_id, SUM(amount) AS net_cash_flow
    FROM ATOM_EVENT_CASH_FLOW_001
    GROUP BY investor_id
  ),
  hold AS (
    SELECT investor_id, SUM(current_value - cost) AS total_holding_gain
    FROM ATOM_ENTITY_PORTFOLIO_HOLDING_001
    WHERE cost IS NOT NULL AND current_value IS NOT NULL
    GROUP BY investor_id
  ),
  scenario AS (
    SELECT investor_id, SUM(new_allocation_pct - current_allocation_pct) AS total_scenario_shift
    FROM ATOM_EVENT_SCENARIO_REBALANCING_001
    GROUP BY investor_id
  ),
  risk AS (
    SELECT investor_id, risk_score
    FROM ATOM_ENTITY_PORTFOLIO_HEALTH_001
  ),
  base AS (
    SELECT ip.investor_id,
           c.net_cash_flow,
           h.total_holding_gain,
           s.total_scenario_shift,
           r.risk_score
    FROM ATOM_ENTITY_INVESTOR_PROFILE_001 ip
    INNER JOIN cash c ON ip.investor_id = c.investor_id
    INNER JOIN hold h ON ip.investor_id = h.investor_id
    INNER JOIN scenario s ON ip.investor_id = s.investor_id
    INNER JOIN risk r ON ip.investor_id = r.investor_id
  )
SELECT
  investor_id,
  100.0 * ((norm_net_cash_flow + norm_holding_gain + norm_scenario_shift + norm_risk_score) / 4.0) AS composite_score
FROM (
  SELECT
    investor_id,
    net_cash_flow,
    total_holding_gain,
    total_scenario_shift,
    risk_score,
    (net_cash_flow - MIN(net_cash_flow) OVER ()) / NULLIF(MAX(net_cash_flow) OVER () - MIN(net_cash_flow) OVER (), 0) AS norm_net_cash_flow,
    (total_holding_gain - MIN(total_holding_gain) OVER ()) / NULLIF(MAX(total_holding_gain) OVER () - MIN(total_holding_gain) OVER (), 0) AS norm_holding_gain,
    (total_scenario_shift - MIN(total_scenario_shift) OVER ()) / NULLIF(MAX(total_scenario_shift) OVER () - MIN(total_scenario_shift) OVER (), 0) AS norm_scenario_shift,
    (risk_score - MIN(risk_score) OVER ()) / NULLIF(MAX(risk_score) OVER () - MIN(risk_score) OVER (), 0) AS norm_risk_score
  FROM base
) t
ORDER BY composite_score DESC, investor_id ASC
