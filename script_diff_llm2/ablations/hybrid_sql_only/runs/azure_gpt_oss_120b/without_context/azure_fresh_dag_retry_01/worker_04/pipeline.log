    FROM ATOM_ENTITY_INVESTOR_PROFILE_001 ip
    LEFT JOIN holding_sum h_sum
           ON ip.investor_id = h_sum.investor_id
    GROUP BY ip.risk_tolerance
 ),
-- per‑investor average scenario allocation shift
 scenario_shift_per_inv AS (
    SELECT investor_id,
           AVG(new_allocation_pct - current_allocation_pct) AS avg_shift
