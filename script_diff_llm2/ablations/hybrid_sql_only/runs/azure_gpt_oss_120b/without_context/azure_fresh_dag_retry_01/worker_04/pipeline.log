    FROM ATOM_ENTITY_INVESTOR_PROFILE_001 ip
    LEFT JOIN scenario_shift_per_inv ss
           ON ip.investor_id = ss.investor_id
    GROUP BY ip.risk_tolerance
 ),
-- per‑investor average goal progress
 goal_progress_per_inv AS (
    SELECT investor_id,
           AVG(progress_pct) AS avg_progress
