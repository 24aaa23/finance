[SQL GENERATE] Generated SQL: WITH
    net_cash_per_investor AS (
        SELECT investor_id,
               SUM(amount) AS net_cash_sum
        FROM ATOM_EVENT_CASH_FLOW_001
        GROUP BY investor_id
    ),
    avg_net_cash_by_risk AS (
        SELECT ip.risk_tolerance,
               AVG(nc.net_cash_sum) AS avg_net_cash_flow
        FROM ATOM_ENTITY_INVESTOR_PROFILE_001 ip
        LEFT JOIN net_cash_per_investor nc ON ip.investor_id = nc.investor_id
        GROUP BY ip.risk_tolerance
    ),
    avg_signed_cash_by_risk AS (
        SELECT ip.risk_tolerance,
               AVG(cf.amount) AS avg_signed_cash_flow_amount
        FROM ATOM_ENTITY_INVESTOR_PROFILE_001 ip
        LEFT JOIN ATOM_EVENT_CASH_FLOW_001 cf ON ip.investor_id = cf.investor_id
        GROUP BY ip.risk_tolerance
    ),
    avg_risk_score_by_risk AS (
        SELECT ip.risk_tolerance,
               AVG(ph.risk_score) AS avg_risk_score
        FROM ATOM_ENTITY_INVESTOR_PROFILE_001 ip
        LEFT JOIN ATOM_ENTITY_PORTFOLIO_HEALTH_001 ph ON ip.investor_id = ph.investor_id
        GROUP BY ip.risk_tolerance
    ),
    distinct_risk AS (
        SELECT DISTINCT risk_tolerance
        FROM ATOM_ENTITY_INVESTOR_PROFILE_001
    )
SELECT dr.risk_tolerance,
       anc.avg_net_cash_flow,
       ascf.avg_signed_cash_flow_amount,
       ars.avg_risk_score
FROM distinct_risk dr
LEFT JOIN avg_net_cash_by_risk anc ON dr.risk_tolerance IS anc.risk_tolerance
LEFT JOIN avg_signed_cash_by_risk ascf ON dr.risk_tolerance IS ascf.risk_tolerance
LEFT JOIN avg_risk_score_by_risk ars ON dr.risk_tolerance IS ars.risk_tolerance
ORDER BY dr.risk_tolerance;
