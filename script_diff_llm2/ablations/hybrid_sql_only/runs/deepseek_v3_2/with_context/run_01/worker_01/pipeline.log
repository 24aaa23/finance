[SQL GENERATE] Generated SQL: WITH net_cash_flow_cte AS (
    SELECT investor_id, SUM(amount) AS net_cash_flow
    FROM ATOM_EVENT_CASH_FLOW_001
    GROUP BY investor_id
),
total_holding_gain_cte AS (
    SELECT investor_id, SUM(current_value - cost) AS total_holding_gain
    FROM ATOM_ENTITY_PORTFOLIO_HOLDING_001
    WHERE cost IS NOT NULL AND current_value IS NOT NULL
    GROUP BY investor_id
),
total_sector_investment_cte AS (
    SELECT investor_id, SUM(total_investment) AS total_sector_investment
    FROM ATOM_ENTITY_SECTOR_ALLOCATION_001
    GROUP BY investor_id
),
total_scenario_allocation_shift_cte AS (
    SELECT investor_id, SUM(new_allocation_pct - current_allocation_pct) AS total_scenario_allocation_shift
    FROM ATOM_EVENT_SCENARIO_REBALANCING_001
    GROUP BY investor_id
),
all_components AS (
    SELECT 
        ip.investor_id,
        COALESCE(ncf.net_cash_flow, 0) AS net_cash_flow,
        COALESCE(thg.total_holding_gain, 0) AS total_holding_gain,
        COALESCE(tsi.total_sector_investment, 0) AS total_sector_investment,
        COALESCE(tsas.total_scenario_allocation_shift, 0) AS total_scenario_allocation_shift
    FROM ATOM_ENTITY_INVESTOR_PROFILE_001 ip
    INNER JOIN net_cash_flow_cte ncf ON ip.investor_id = ncf.investor_id
    INNER JOIN total_holding_gain_cte thg ON ip.investor_id = thg.investor_id
    INNER JOIN total_sector_investment_cte tsi ON ip.investor_id = tsi.investor_id
    INNER JOIN total_scenario_allocation_shift_cte tsas ON ip.investor_id = tsas.investor_id
),
normalized AS (
    SELECT 
        investor_id,
        net_cash_flow,
        total_holding_gain,
        total_sector_investment,
        total_scenario_allocation_shift,
        (net_cash_flow - MIN(net_cash_flow) OVER ()) / NULLIF((MAX(net_cash_flow) OVER ()) - MIN(net_cash_flow) OVER (), 0) AS net_cash_flow_norm,
        (total_holding_gain - MIN(total_holding_gain) OVER ()) / NULLIF((MAX(total_holding_gain) OVER ()) - MIN(total_holding_gain) OVER (), 0) AS total_holding_gain_norm,
        (total_sector_investment - MIN(total_sector_investment) OVER ()) / NULLIF((MAX(total_sector_investment) OVER ()) - MIN(total_sector_investment) OVER (), 0) AS total_sector_investment_norm,
        (total_scenario_allocation_shift - MIN(total_scenario_allocation_shift) OVER ()) / NULLIF((MAX(total_scenario_allocation_shift) OVER ()) - MIN(total_scenario_allocation_shift) OVER (), 0) AS total_scenario_allocation_shift_norm
    FROM all_components
)
SELECT 
    investor_id,
    100 * ((COALESCE(net_cash_flow_norm, 0) + COALESCE(total_holding_gain_norm, 0) + COALESCE(total_sector_investment_norm, 0) + COALESCE(total_scenario_allocation_shift_norm, 0)) / 4) AS composite_score
FROM normalized
ORDER BY composite_score DESC, investor_id
LIMIT 10
