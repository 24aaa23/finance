[SQL GENERATE] Generated SQL: WITH cash_flow_agg AS (
  SELECT investor_id, SUM(amount) AS net_cash_flow
  FROM ATOM_EVENT_CASH_FLOW_001
  GROUP BY investor_id
),
scenario_rebalancing_agg AS (
  SELECT investor_id, SUM(new_allocation_pct - current_allocation_pct) AS total_scenario_allocation_shift
  FROM ATOM_EVENT_SCENARIO_REBALANCING_001
  GROUP BY investor_id
),
goal_shortfall_agg AS (
  SELECT investor_id, AVG(shortfall) AS avg_goal_shortfall
  FROM ATOM_ENTITY_INVESTMENT_GOAL_001
  GROUP BY investor_id
),
investor_base AS (
  SELECT DISTINCT investor_id
  FROM ATOM_EVENT_CASH_FLOW_001
  INTERSECT
  SELECT DISTINCT investor_id
  FROM ATOM_EVENT_SCENARIO_REBALANCING_001
  INTERSECT
  SELECT DISTINCT investor_id
  FROM ATOM_ENTITY_INVESTMENT_GOAL_001
),
investor_components AS (
  SELECT 
    ib.investor_id,
    cf.net_cash_flow,
    sr.total_scenario_allocation_shift,
    gs.avg_goal_shortfall
  FROM investor_base ib
  INNER JOIN cash_flow_agg cf ON ib.investor_id = cf.investor_id
  INNER JOIN scenario_rebalancing_agg sr ON ib.investor_id = sr.investor_id
  INNER JOIN goal_shortfall_agg gs ON ib.investor_id = gs.investor_id
),
normalized_components AS (
  SELECT 
    investor_id,
    net_cash_flow,
    total_scenario_allocation_shift,
    avg_goal_shortfall,
    (net_cash_flow - MIN(net_cash_flow) OVER ()) / (MAX(net_cash_flow) OVER () - MIN(net_cash_flow) OVER ()) AS normalized_net_cash_flow,
    (total_scenario_allocation_shift - MIN(total_scenario_allocation_shift) OVER ()) / (MAX(total_scenario_allocation_shift) OVER () - MIN(total_scenario_allocation_shift) OVER ()) AS normalized_total_scenario_allocation_shift,
    (avg_goal_shortfall - MIN(avg_goal_shortfall) OVER ()) / (MAX(avg_goal_shortfall) OVER () - MIN(avg_goal_shortfall) OVER ()) AS normalized_avg_goal_shortfall
  FROM investor_components
),
final_scores AS (
  SELECT 
    investor_id,
    100 * ((normalized_net_cash_flow + normalized_total_scenario_allocation_shift + (1 - normalized_avg_goal_shortfall)) / 3) AS composite_score
  FROM normalized_components
)
SELECT investor_id, composite_score
FROM final_scores
ORDER BY composite_score DESC, investor_id
LIMIT 10
