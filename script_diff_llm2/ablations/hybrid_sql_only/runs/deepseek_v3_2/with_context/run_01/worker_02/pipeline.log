  grouped_result AS (
    SELECT
      ip.risk_tolerance,
      AVG(COALESCE(m0.per_investor_holding_count, 0)) AS avg_holdings_per_investor,
      AVG(m1.per_investor_net_cash_flow) AS avg_net_cash_flow_per_investor,
      AVG(m2.per_investor_risk_score) AS avg_risk_score
    FROM ATOM_ENTITY_INVESTOR_PROFILE_001 ip
    LEFT JOIN metric_source_0 m0 ON ip.investor_id = m0.investor_id
    LEFT JOIN metric_source_1 m1 ON ip.investor_id = m1.investor_id
    LEFT JOIN metric_source_2 m2 ON ip.investor_id = m2.investor_id
    GROUP BY ip.risk_tolerance
  )
SELECT
  risk_tolerance,
  avg_holdings_per_investor,
  avg_net_cash_flow_per_investor,
  avg_risk_score
