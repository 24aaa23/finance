[SQL GENERATE] Using physical tables: ['ATOM_ENTITY_INVESTMENT_GOAL_001', 'ATOM_ENTITY_INVESTOR_PROFILE_001', 'ATOM_ENTITY_PORTFOLIO_HEALTH_001', 'ATOM_ENTITY_PORTFOLIO_HOLDING_001', 'ATOM_ENTITY_SECTOR_ALLOCATION_001', 'ATOM_EVENT_CASH_FLOW_001', 'ATOM_EVENT_REBALANCING_ACTION_001', 'ATOM_EVENT_SCENARIO_REBALANCING_001']
[SQL GENERATE] Generated SQL: WITH
-- Compute net cash flow per investor
cash_flow_agg AS (
    SELECT
        investor_id,
        SUM(amount) AS net_cash_flow
    FROM ATOM_EVENT_CASH_FLOW_001
    GROUP BY investor_id
),
-- Compute total holding gain per investor (only holdings with cost and current value)
holding_gain_agg AS (
    SELECT
        investor_id,
        SUM(current_value - cost) AS total_holding_gain
    FROM ATOM_ENTITY_PORTFOLIO_HOLDING_001
    WHERE cost IS NOT NULL
        AND current_value IS NOT NULL
    GROUP BY investor_id
),
-- Compute total rebalance amount per investor
rebalance_agg AS (
    SELECT
        investor_id,
        SUM(amount) AS total_rebalance_amount
    FROM ATOM_EVENT_REBALANCING_ACTION_001
    GROUP BY investor_id
),
-- Compute total scenario allocation shift per investor
scenario_shift_agg AS (
    SELECT
        investor_id,
        SUM(new_allocation_pct - current_allocation_pct) AS total_scenario_allocation_shift
    FROM ATOM_EVENT_SCENARIO_REBALANCING_001
    GROUP BY investor_id
),
-- Join all components (inner join ensures investors with all 4 components)
joined_components AS (
    SELECT
        i.investor_id,
        COALESCE(cf.net_cash_flow, 0) AS net_cash_flow,
        COALESCE(hg.total_holding_gain, 0) AS total_holding_gain,
        COALESCE(rb.total_rebalance_amount, 0) AS total_rebalance_amount,
        COALESCE(ss.total_scenario_allocation_shift, 0) AS total_scenario_allocation_shift
    FROM ATOM_ENTITY_INVESTOR_PROFILE_001 AS i
    INNER JOIN cash_flow_agg AS cf ON i.investor_id = cf.investor_id
    INNER JOIN holding_gain_agg AS hg ON i.investor_id = hg.investor_id
    INNER JOIN rebalance_agg AS rb ON i.investor_id = rb.investor_id
    INNER JOIN scenario_shift_agg AS ss ON i.investor_id = ss.investor_id
),
-- Compute min-max normalized components
normalized_components AS (
    SELECT
        investor_id,
        net_cash_flow,
        total_holding_gain,
        total_rebalance_amount,
        total_scenario_allocation_shift,
        (net_cash_flow - MIN(net_cash_flow) OVER ()) / 
            NULLIF(MAX(net_cash_flow) OVER () - MIN(net_cash_flow) OVER (), 0) AS normalized_net_cash_flow,
        (total_holding_gain - MIN(total_holding_gain) OVER ()) / 
            NULLIF(MAX(total_holding_gain) OVER () - MIN(total_holding_gain) OVER (), 0) AS normalized_total_holding_gain,
        (total_rebalance_amount - MIN(total_rebalance_amount) OVER ()) / 
            NULLIF(MAX(total_rebalance_amount) OVER () - MIN(total_rebalance_amount) OVER (), 0) AS normalized_total_rebalance_amount,
        (total_scenario_allocation_shift - MIN(total_scenario_allocation_shift) OVER ()) / 
            NULLIF(MAX(total_scenario_allocation_shift) OVER () - MIN(total_scenario_allocation_shift) OVER (), 0) AS normalized_total_scenario_allocation_shift
    FROM joined_components
)
-- Compute composite score and rank
SELECT
    investor_id,
    ROUND(100.0 * (
        normalized_net_cash_flow +
        normalized_total_holding_gain +
        normalized_total_rebalance_amount +
        normalized_total_scenario_allocation_shift
    ) / 4, 2) AS composite_score
FROM normalized_components
ORDER BY composite_score DESC, investor_id
LIMIT 10;
