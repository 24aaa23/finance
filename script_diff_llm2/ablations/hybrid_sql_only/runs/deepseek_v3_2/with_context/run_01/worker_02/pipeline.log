[SQL GENERATE] Generated SQL: WITH
  -- Base entity table with grouping dimension
  base_investors AS (
    SELECT
      investor_id,
      time_horizon
    FROM ATOM_ENTITY_INVESTOR_PROFILE_001
  ),
  
  -- Per-investor aggregates for rebalance amount
  rebalance_amount_per_investor AS (
    SELECT
      investor_id,
      AVG(amount) AS avg_rebalance_amount_per_inv
    FROM ATOM_EVENT_REBALANCING_ACTION_001
    GROUP BY investor_id
  ),
  
  -- Per-investor aggregates for rebalance shift
  rebalance_shift_per_investor AS (
    SELECT
      investor_id,
      AVG(target_allocation_pct - current_allocation_pct) AS avg_rebalance_shift_per_inv
    FROM ATOM_EVENT_REBALANCING_ACTION_001
    GROUP BY investor_id
  ),
  
  -- Per-investor aggregates for rebalance count
  rebalance_count_per_investor AS (
    SELECT
      investor_id,
      COUNT(DISTINCT rebalance_id) AS rebalance_count_per_inv
    FROM ATOM_EVENT_REBALANCING_ACTION_001
    GROUP BY investor_id
  ),
  
  -- Join per-investor aggregates to base table with LEFT JOIN
  investor_metrics AS (
    SELECT
      b.investor_id,
      b.time_horizon,
      COALESCE(ra.avg_rebalance_amount_per_inv, 0) AS avg_rebalance_amount_per_inv,
      COALESCE(rs.avg_rebalance_shift_per_inv, 0) AS avg_rebalance_shift_per_inv,
      COALESCE(rc.rebalance_count_per_inv, 0) AS rebalance_count_per_inv
    FROM base_investors b
    LEFT JOIN rebalance_amount_per_investor ra
      ON b.investor_id = ra.investor_id
    LEFT JOIN rebalance_shift_per_investor rs
      ON b.investor_id = rs.investor_id
    LEFT JOIN rebalance_count_per_investor rc
      ON b.investor_id = rc.investor_id
  )
  
SELECT
  time_horizon,
  AVG(avg_rebalance_amount_per_inv) AS avg_rebalance_amount,
  AVG(avg_rebalance_shift_per_inv) AS avg_rebalance_shift,
  AVG(rebalance_count_per_inv) AS avg_rebalance_count
FROM investor_metrics
GROUP BY time_horizon
ORDER BY time_horizon;
