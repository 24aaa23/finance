  metric_source_0 AS (
    SELECT
      investor_id,
      COUNT(holding_id) AS per_investor_holding_count
    FROM ATOM_ENTITY_PORTFOLIO_HOLDING_001
    GROUP BY investor_id
  ),
  metric_source_1 AS (
    SELECT
      investor_id,
      SUM(
        CASE
          WHEN type IN ('Deposit', 'SIP', 'Interest Credit', 'Tax Refund', 'Lump Sum', 'Dividend Reinvestment') THEN amount
