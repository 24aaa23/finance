   [SQL] Running SQL pipeline for node 'Q1'...
[SQL SCHEMA] Relevant tables: ['ATOM_ENTITY_INVESTMENT_GOAL_001', 'ATOM_ENTITY_INVESTOR_PROFILE_001', 'ATOM_ENTITY_PORTFOLIO_HEALTH_001', 'ATOM_ENTITY_PORTFOLIO_HOLDING_001', 'ATOM_ENTITY_SECTOR_ALLOCATION_001', 'ATOM_EVENT_CASH_FLOW_001', 'ATOM_EVENT_REBALANCING_ACTION_001', 'ATOM_EVENT_SCENARIO_REBALANCING_001']
[SQL GENERATE] Using physical tables: ['ATOM_ENTITY_INVESTMENT_GOAL_001', 'ATOM_ENTITY_INVESTOR_PROFILE_001', 'ATOM_ENTITY_PORTFOLIO_HEALTH_001', 'ATOM_ENTITY_PORTFOLIO_HOLDING_001', 'ATOM_ENTITY_SECTOR_ALLOCATION_001', 'ATOM_EVENT_CASH_FLOW_001', 'ATOM_EVENT_REBALANCING_ACTION_001', 'ATOM_EVENT_SCENARIO_REBALANCING_001']
[SQL GENERATE] Generated SQL: WITH cash AS (
        SELECT investor_id,
               SUM(amount) AS net_cash_flow
        FROM ATOM_EVENT_CASH_FLOW_001
        GROUP BY investor_id
    ),
    sector AS (
        SELECT investor_id,
               SUM(total_investment) AS total_sector_investment
        FROM ATOM_ENTITY_SECTOR_ALLOCATION_001
        GROUP BY investor_id
    ),
    shift AS (
        SELECT investor_id,
               SUM(new_allocation_pct - current_allocation_pct) AS total_scenario_shift
        FROM ATOM_EVENT_SCENARIO_REBALANCING_001
        GROUP BY investor_id
    )
SELECT investor_id,
       composite_score
FROM (
    SELECT p.investor_id,
           100.0 * (
               (
                   (c.net_cash_flow - MIN(c.net_cash_flow) OVER())
                   / NULLIF(MAX(c.net_cash_flow) OVER() - MIN(c.net_cash_flow) OVER(), 0)
               ) +
               (
                   (s.total_sector_investment - MIN(s.total_sector_investment) OVER())
                   / NULLIF(MAX(s.total_sector_investment) OVER() - MIN(s.total_sector_investment) OVER(), 0)
               ) +
               (
                   (sh.total_scenario_shift - MIN(sh.total_scenario_shift) OVER())
                   / NULLIF(MAX(sh.total_scenario_shift) OVER() - MIN(sh.total_scenario_shift) OVER(), 0)
               )
           ) / 3.0) AS composite_score
    FROM ATOM_ENTITY_INVESTOR_PROFILE_001 p
    INNER JOIN cash   c ON p.investor_id = c.investor_id
    INNER JOIN sector s ON p.investor_id = s.investor_id
    INNER JOIN shift  sh ON p.investor_id = sh.investor_id
) ranked
ORDER BY composite_score DESC, investor_id ASC
LIMIT 10;
