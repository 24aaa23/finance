[SQL GENERATE] Using physical tables: ['ATOM_ENTITY_INVESTMENT_GOAL_001', 'ATOM_ENTITY_INVESTOR_PROFILE_001', 'ATOM_ENTITY_PORTFOLIO_HEALTH_001', 'ATOM_ENTITY_PORTFOLIO_HOLDING_001', 'ATOM_ENTITY_SECTOR_ALLOCATION_001', 'ATOM_EVENT_CASH_FLOW_001', 'ATOM_EVENT_REBALANCING_ACTION_001', 'ATOM_EVENT_SCENARIO_REBALANCING_001']
[SQL GENERATE] Generated SQL: WITH cash_flow_per_investor AS (
        SELECT investor_id,
               SUM(amount) AS sum_amount
        FROM ATOM_EVENT_CASH_FLOW_001
        GROUP BY investor_id
    ),
    goal_progress_per_investor AS (
        SELECT investor_id,
               AVG(progress_pct) AS avg_progress
        FROM ATOM_ENTITY_IMPLEMENTATION_GOAL_001
        GROUP BY investor_id
    ),
    risk_score_per_investor AS (
        SELECT investor_id,
               AVG(risk_score) AS avg_risk_score
        FROM ATOM_ENTITY_PORTFOLIO_HEALTH_001
        GROUP BY investor_id
    )
SELECT
    p.category AS category,
    AVG(cf.sum_amount) AS avg_net_cash_flow_per_investor,
    AVG(gp.avg_progress) AS avg_goal_progress_per_investor,
    AVG(rp.avg_risk_score) AS avg_risk_score_per_investor
FROM ATOM_ENTITY_INVESTOR_PROFILE_001 AS p
LEFT JOIN cash_flow_per_investor cf ON p.investor_id = cf.investor_id
LEFT JOIN goal_progress_per_investor gp ON p.investor_id = gp.investor_id
LEFT JOIN risk_score_per_investor rp ON p.investor_id = rp.investor_id
GROUP BY p.category
ORDER BY p.category;
