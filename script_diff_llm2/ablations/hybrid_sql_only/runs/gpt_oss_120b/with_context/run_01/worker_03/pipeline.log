[SQL GENERATE] Using physical tables: ['ATOM_ENTITY_INVESTMENT_GOAL_001', 'ATOM_ENTITY_INVESTOR_PROFILE_001', 'ATOM_ENTITY_PORTFOLIO_HEALTH_001', 'ATOM_ENTITY_PORTFOLIO_HOLDING_001', 'ATOM_ENTITY_SECTOR_ALLOCATION_001', 'ATOM_EVENT_CASH_FLOW_001', 'ATOM_EVENT_REBALANCING_ACTION_001', 'ATOM_EVENT_SCENARIO_REBALANCING_001']
[SQL GENERATE] Generated SQL: WITH
  net_cash_flow_per_inv AS (
    SELECT investor_id,
           SUM(amount) AS sum_amount
    FROM ATOM_EVENT_CASH_FLOW_001
    GROUP BY investor_id
  ),
  total_holding_per_inv AS (
    SELECT investor_id,
           SUM(current_value) AS sum_current_value
    FROM ATOM_ENTITY_PORTFOLIO_HOLDING_001
    GROUP BY investor_id
  ),
  base_groups AS (
    SELECT DISTINCT risk_tolerance
    FROM ATOM_ENTITY_INVESTOR_PROFILE_001
  ),
  avg_net_cash AS (
    SELECT b.risk_tolerance,
           AVG(nc.sum_amount) AS avg_net_cash_flow
    FROM ATOM_ENTITY_INVESTOR_PROFILE_001 b
    LEFT JOIN net_cash_flow_per_inv nc ON b.investor_id = nc.investor_id
    GROUP BY b.risk_tolerance
  ),
  avg_total_holding AS (
    SELECT b.risk_tolerance,
           AVG(th.sum_current_value) AS avg_total_holding_value
    FROM ATOM_ENTITY_INVESTOR_PROFILE_001 b
    LEFT JOIN total_holding_per_inv th ON b.investor_id = th.investor_id
    GROUP BY b.risk_tolerance
  ),
  avg_cash_flow AS (
    SELECT b.risk_tolerance,
           AVG(cf.amount) AS avg_cash_flow_amount
    FROM ATOM_ENTITY_INVESTOR_PROFILE_001 b
    JOIN ATOM_EVENT_CASH_FLOW_001 cf ON b.investor_id = cf.investor_id
    GROUP BY b.risk_tolerance
  ),
  avg_scenario_shift AS (
    SELECT b.risk_tolerance,
           AVG(sr.new_allocation_pct - sr.current_allocation_pct) AS avg_scenario_allocation_shift
    FROM ATOM_ENTITY_INVESTOR_PROFILE_001 b
    JOIN ATOM_EVENT_SCENARIO_REBALANCING_001 sr ON b.investor_id = sr.investor_id
    GROUP BY b.risk_tolerance
  ),
  avg_risk_score AS (
    SELECT b.risk_tolerance,
           AVG(ph.risk_score) AS avg_risk_score
    FROM ATOM_ENTITY_INVESTOR_PROFILE_001 b
    JOIN ATOM_ENTITY_PORTFOLIO_HEALTH_001 ph ON b.investor_id = ph.investor_id
    GROUP BY b.risk_tolerance
  )
SELECT bg.risk_tolerance,
       an.avg_net_cash_flow,
       ac.avg_cash_flow_amount,
       ah.avg_total_holding_value,
       ashift.avg_scenario_allocation_shift,
       ar.avg_risk_score
FROM base_groups bg
LEFT JOIN avg_net_cash an      ON bg.risk_tolerance = an.risk_tolerance
LEFT JOIN avg_total_holding ah ON bg.risk_tolerance = ah.risk_tolerance
LEFT JOIN avg_cash_flow ac     ON bg.risk_tolerance = ac.risk_tolerance
LEFT JOIN avg_scenario_shift ashift ON bg.risk_tolerance = ashift.risk_tolerance
LEFT JOIN avg_risk_score ar    ON bg.risk_tolerance = ar.risk_tolerance
ORDER BY bg.risk_tolerance;
