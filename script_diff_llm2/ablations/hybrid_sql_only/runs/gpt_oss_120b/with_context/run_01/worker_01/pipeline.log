[SQL SCHEMA] Relevant tables: ['ATOM_ENTITY_INVESTMENT_GOAL_001', 'ATOM_ENTITY_INVESTOR_PROFILE_001', 'ATOM_ENTITY_PORTFOLIO_HEALTH_001', 'ATOM_ENTITY_PORTFOLIO_HOLDING_001', 'ATOM_ENTITY_SECTOR_ALLOCATION_001', 'ATOM_EVENT_CASH_FLOW_001', 'ATOM_EVENT_REBALANCING_ACTION_001', 'ATOM_EVENT_SCENARIO_REBALANCING_001']
[SQL GENERATE] Using physical tables: ['ATOM_ENTITY_INVESTMENT_GOAL_001', 'ATOM_ENTITY_INVESTOR_PROFILE_001', 'ATOM_ENTITY_PORTFOLIO_HEALTH_001', 'ATOM_ENTITY_PORTFOLIO_HOLDING_001', 'ATOM_ENTITY_SECTOR_ALLOCATION_001', 'ATOM_EVENT_CASH_FLOW_001', 'ATOM_EVENT_REBALANCING_ACTION_001', 'ATOM_EVENT_SCENARIO_REBALANCING_001']
[SQL GENERATE] Generated SQL: WITH
base_groups AS (
  SELECT DISTINCT risk_tolerance FROM ATOM_ENTITY_INVESTOR_PROFILE_001
),
-- Net cash flow per investor (SUM), then average per risk tolerance
investor_net AS (
  SELECT investor_id, SUM(amount) AS net_cash_flow
  FROM ATOM_EVENT_CASH_FLOW_001
  GROUP BY investor_id
),
avg_net AS (
  SELECT p.risk_tolerance,
         AVG(investor_net.net_cash_flow) AS avg_net_cash_flow
  FROM ATOM_ENTITY_INVESTOR_PROFILE_001 p
  LEFT JOIN investor_net ON p.investor_id = investor_net.investor_id
  GROUP BY p.risk_tolerance
),
-- Direct average of cash‑flow amounts per risk tolerance
avg_cash AS (
  SELECT p.risk_tolerance,
         AVG(c.amount) AS avg_cash_flow_amount
  FROM ATOM_ENTITY_INVESTOR_PROFILE_001 p
  LEFT JOIN ATOM_EVENT_CASH_FLOW_001 c ON p.investor_id = c.investor_id
  GROUP BY p.risk_tolerance
),
-- Average scenario allocation shift (new - current) per risk tolerance
avg_scenario AS (
  SELECT p.risk_tolerance,
         AVG(s.new_allocation_pct - s.current_allocation_pct) AS avg_scenario_allocation_shift
  FROM ATOM_ENTITY_INVESTOR_PROFILE_001 p
  LEFT JOIN ATOM_EVENT_SCENARIO_REBALANCING_001 s ON p.investor_id = s.investor_id
  GROUP BY p.risk_tolerance
),
-- Average risk score per risk tolerance
avg_risk AS (
  SELECT p.risk_tolerance,
         AVG(r.risk_score) AS avg_risk_score
  FROM ATOM_ENTITY_INVESTOR_PROFILE_001 p
  LEFT JOIN ATOM_ENTITY_PORTFOLIO_HEALTH_001 r ON p.investor_id = r.investor_id
  GROUP BY p.risk_tolerance
)
SELECT
  bg.risk_tolerance,
  an.avg_net_cash_flow,
  ac.avg_cash_flow_amount,
  ascen.avg_scenario_allocation_shift,
  ar.avg_risk_score
FROM base_groups bg
LEFT JOIN avg_net an      ON bg.risk_tolerance = an.risk_tolerance
LEFT JOIN avg_cash ac    ON bg.risk_tolerance = ac.risk_tolerance
LEFT JOIN avg_scenario ascen ON bg.risk_tolerance = ascen.risk_tolerance
LEFT JOIN avg_risk ar    ON bg.risk_tolerance = ar.risk_tolerance
ORDER BY bg.risk_tolerance;
