[SQL GENERATE] Generated SQL: WITH cash AS (
    SELECT investor_id,
           SUM(amount) AS net_cash_flow_raw
    FROM ATOM_EVENT_CASH_FLOW_001
    GROUP BY investor_id
),
sector AS (
    SELECT investor_id,
           SUM(total_investment) AS total_sector_investment_raw
    FROM ATOM_ENTITY_SECTOR_ALLOCATION_001
    GROUP BY investor_id
),
scenario AS (
    SELECT investor_id,
           SUM(new_allocation_pct - current_allocation_pct) AS total_scenario_shift_raw
    FROM ATOM_EVENT_SCENARIO_REBALANCING_001
    GROUP BY investor_id
),
risk AS (
    SELECT investor_id,
           MAX(risk_score) AS risk_score_raw
    FROM ATOM_ENTITY_PORTFOLIO_HEALTH_001
    GROUP BY investor_id
)
SELECT
    sub.investor_id,
    100.0 * ((sub.net_norm + sub.sector_norm + sub.scenario_norm + sub.risk_norm) / 4.0) AS composite_score
FROM (
    SELECT
        i.investor_id,
        c.net_cash_flow_raw,
        s.total_sector_investment_raw,
        sc.total_scenario_shift_raw,
        r.risk_score_raw,
        (c.net_cash_flow_raw - MIN(c.net_cash_flow_raw) OVER()) /
            NULLIF(MAX(c.net_cash_flow_raw) OVER() - MIN(c.net_cash_flow_raw) OVER(), 0) AS net_norm,
        (s.total_sector_investment_raw - MIN(s.total_sector_investment_raw) OVER()) /
            NULLIF(MAX(s.total_sector_investment_raw) OVER() - MIN(s.total_sector_investment_raw) OVER(), 0) AS sector_norm,
        (sc.total_scenario_shift_raw - MIN(sc.total_scenario_shift_raw) OVER()) /
            NULLIF(MAX(sc.total_scenario_shift_raw) OVER() - MIN(sc.total_scenario_shift_raw) OVER(), 0) AS scenario_norm,
        (r.risk_score_raw - MIN(r.risk_score_raw) OVER()) /
            NULLIF(MAX(r.risk_score_raw) OVER() - MIN(r.risk_score_raw) OVER(), 0) AS risk_norm
    FROM ATOM_ENTITY_INVESTOR_PROFILE_001 i
    INNER JOIN cash c ON i.investor_id = c.investor_id
    INNER JOIN sector s ON i.investor_id = s.investor_id
    INNER JOIN scenario sc ON i.investor_id = sc.investor_id
    INNER JOIN risk r ON i.investor_id = r.investor_id
) sub
ORDER BY composite_score DESC, investor_id ASC
LIMIT 10;
