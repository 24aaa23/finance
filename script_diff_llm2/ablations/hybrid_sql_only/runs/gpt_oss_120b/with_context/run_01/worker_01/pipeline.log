[SQL GENERATE] Using physical tables: ['ATOM_ENTITY_INVESTMENT_GOAL_001', 'ATOM_ENTITY_INVESTOR_PROFILE_001', 'ATOM_ENTITY_PORTFOLIO_HEALTH_001', 'ATOM_ENTITY_PORTFOLIO_HOLDING_001', 'ATOM_ENTITY_SECTOR_ALLOCATION_001', 'ATOM_EVENT_CASH_FLOW_001', 'ATOM_EVENT_REBALANCING_ACTION_001', 'ATOM_EVENT_SCENARIO_REBALANCING_001']
[SQL GENERATE] Generated SQL: WITH cash AS (
        SELECT investor_id,
               SUM(amount) AS net_cash_flow
        FROM ATOM_EVENT_CASH_FLOW_001
        GROUP BY investor_id
    ),
    rebalance AS (
        SELECT investor_id,
               SUM(amount) AS total_rebalance_amount
        FROM ATOM_EVENT_REBALANCING_ACTION_001
        GROUP BY investor_id
    ),
    sector AS (
        SELECT investor_id,
               SUM(total_investment) AS total_sector_investment
        FROM ATOM_ENTITY_SECTOR_ALLOCATION_001
        GROUP BY investor_id
    ),
    goal AS (
        SELECT investor_id,
               AVG(shortfall) AS avg_goal_shortfall
        FROM ATOM_ENTITY_INVESTMENT_GOAL_001
        GROUP BY investor_id
    )
SELECT i.investor_id,
       (cash.net_cash_flow + rebalance.total_rebalance_amount + sector.total_sector_investment - goal.avg_goal_shortfall) AS composite_score
FROM ATOM_ENTITY_INVESTOR_PROFILE_001 AS i
INNER JOIN cash ON i.investor_id = cash.investor_id
INNER JOIN rebalance ON i.investor_id = rebalance.investor_id
INNER JOIN sector ON i.investor_id = sector.investor_id
INNER JOIN goal ON i.investor_id = goal.investor_id
ORDER BY composite_score DESC, i.investor_id ASC
LIMIT 10;
