ns9:amfi_code a owl:DatatypeProperty ;
    dcterms:description "AMFI scheme code. MUTUAL FUNDS ONLY." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_product_unified_cat> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "amfi_code" ;
    meta:sourceSqlType "VARCHAR" .

ns9:co_code a owl:DatatypeProperty ;
    dcterms:description "Equity data vendor company code -> dim_cmot_company_mstr.co_code. WARNING: the same column name in dim_cmot_index_prices identifies an INDEX, not a company. Populated on 30 of 98 rows: all 25 Direct Equity products (every one matches dim_cmot_company_mstr.co_code), plus 3 REITs (1050, 1051, 1052) and 2 InvITs (1053, 1054), whose codes do NOT appear in the supplied company master. Blank for every other product type. Whether those five codes should reference dim_cmot_company_mstr (company export incomplete) or another table is not stated by the source and must be confirmed with the data team. Preserve each original co_code; leave the five unmatched - do not invent company records or guess another target." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_product_unified_cat> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "co_code" ;
    meta:sourceSqlType "INTEGER" .

ns9:mstar_id a owl:DatatypeProperty ;
    dcterms:description "Morningstar identifier -> dim_mf_fund_complete.mstar_id. MUTUAL FUNDS ONLY. This is the crosswalk that reaches the NAV and returns history." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_product_unified_cat> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "mstar_id" ;
    meta:sourceSqlType "VARCHAR" .

ns9:rta_code a owl:DatatypeProperty ;
    dcterms:description "Registrar & Transfer Agent scheme code (CAMS/KFin). MUTUAL FUNDS ONLY - NULL on equity rows." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_product_unified_cat> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "rta_code" ;
    meta:sourceSqlType "VARCHAR" .

ns9:sector a owl:DatatypeProperty ;
    dcterms:description "Sector as a bare NAME with no code. NAMING TRAP: dim_cmot_company_mstr splits the same concept into sector_code + sector_name, giving two representations to reconcile. No dim_sector table exists." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_product_unified_cat> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "sector" ;
    meta:sourceSqlType "VARCHAR" .

