    dcterms:description "Lineage: name of the ORIGIN object in the SOURCE system, not this table. Proven by dim_client_master rows carrying 'clients'. Present in all 21 tables. NEVER join or filter business logic on this." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_employee_profile> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "source_table" ;
    meta:sourceSqlType "VARCHAR" .

ns22:sublob_id a owl:DatatypeProperty ;
    dcterms:description "-> dim_lob_hierarchy.sub_lob_id. NAMING TRAP: spelled 'sublob_id' HERE but 'sub_lob_id' in dim_client_master and dim_lob_hierarchy. Same concept, three characters different. Any generated join on matching column names will SILENTLY OMIT this edge." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_employee_profile> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "sublob_id" ;
    meta:sourceSqlType "INTEGER" .

ns22:sublob_name a owl:DatatypeProperty ;
    dcterms:description "Denormalised sub-LOB label. Same naming trap as sublob_id." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_employee_profile> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "sublob_name" ;
    meta:sourceSqlType "VARCHAR" .

ns20:co_code a owl:DatatypeProperty ;
    dcterms:description "-> dim_cmot_company_mstr.co_code. Part of the grain." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_equity_price_latest> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "co_code" ;
    meta:sourceSqlType "INTEGER" .

ns20:company_name a owl:DatatypeProperty ;
    dcterms:description "Denormalised." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_equity_price_latest> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "company_name" ;
    meta:sourceSqlType "VARCHAR" .

ns20:exchange a owl:DatatypeProperty ;
    dcterms:description "PART OF THE GRAIN. The same company trades on both NSE and BSE at slightly different prices, so the key is (co_code, exchange, nav_date), NOT (co_code, nav_date). This is a fan-out hazard on every join." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_equity_price_latest> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "exchange" ;
    meta:sourceSqlType "VARCHAR" .

ns20:isin a owl:DatatypeProperty ;
    dcterms:description "Equity ISIN. NOT UNIQUE in this table - the same ISIN trades on BOTH NSE and BSE, so joining on isin + date alone DOUBLES the position. Always pin exchange." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_equity_price_latest> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "isin" ;
    meta:sourceSqlType "VARCHAR" .

ns20:nav_close a owl:DatatypeProperty ;
    dcterms:description "Closing price. Should reconcile to client_holdings.current_price for a direct equity holding on the same date - a good ongoing data-quality check. Compare with a TOLERANCE: current_price is double precision while this is real." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_equity_price_latest> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "nav_close" ;
    meta:sourceSqlType "FLOAT" .

ns20:nav_date a owl:DatatypeProperty ;
    dcterms:description "THE TABLE NAME SAYS _latest BUT THE STRUCTURE SAYS HISTORY. A date column plus full OHLCV is the signature of a time series. The schema documentation CANNOT settle whether this holds one current row per instrument or full history. Run: SELECT co_code, COUNT(*) FROM dim_equity_price_latest GROUP BY 1 ORDER BY 2 DESC LIMIT 5 - the answer changes every query you write against it. Settled in this data: 25 rows, one per co_code, all dated 2026-05-19." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_equity_price_latest> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "nav_date" ;
    meta:sourceSqlType "DATE" .

ns20:nav_high a owl:DatatypeProperty ;
    dcterms:description "Intraday high. Unlike dim_mf_nav_history this table has full OHLC, because exchange-traded instruments do have intraday ranges - so intraday volatility, true-range and gap analysis ARE possible for equity but not for funds." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_equity_price_latest> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "nav_high" ;
    meta:sourceSqlType "FLOAT" .

ns20:nav_low a owl:DatatypeProperty ;
    dcterms:description "Intraday low." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_equity_price_latest> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "nav_low" ;
    meta:sourceSqlType "FLOAT" .

ns20:nav_open a owl:DatatypeProperty ;
    dcterms:description "Opening price. The nav_ prefix is a MISNOMER for equities - NAV is mutual-fund terminology; equities have a market price. The prefix was copied from the MF tables. Harmless once known, but a search for 'price' columns will miss this table entirely." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_equity_price_latest> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "nav_open" ;
    meta:sourceSqlType "FLOAT" .

ns20:nav_volume a owl:DatatypeProperty ;
    dcterms:description "TYPE DEFECT (latent): declared integer, capped at ~2.15 billion. A heavily traded penny stock can exceed 2.15bn shares in a day and would OVERFLOW. bigint would have been the safe choice." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_equity_price_latest> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "nav_volume" ;
    meta:sourceSqlType "INTEGER" .

ns20:row_hash a owl:DatatypeProperty ;
    dcterms:description "64-bit change-detection fingerprint; samples are 16 lowercase hex chars. Used for change-detecting upsert. Present in all 14 dim_* tables, none of the client_* facts. NEVER join on this." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_equity_price_latest> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "row_hash" ;
    meta:sourceSqlType "VARCHAR" .

ns20:source_load_ts a owl:DatatypeProperty ;
    dcterms:description "ETL load timestamp, WITHOUT TIME ZONE - no timezone is recorded anywhere, so IST vs UTC is a convention held outside the DB. Present in 12 of 14 dim_* tables; absent from both MF history tables and from all 7 client_* facts." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_equity_price_latest> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "source_load_ts" ;
    meta:sourceSqlType "TIMESTAMP" .

ns20:source_table a owl:DatatypeProperty ;
    dcterms:description "Lineage: name of the ORIGIN object in the SOURCE system, not this table. Proven by dim_client_master rows carrying 'clients'. Present in all 21 tables. NEVER join or filter business logic on this." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_equity_price_latest> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "source_table" ;
    meta:sourceSqlType "VARCHAR" .

ns14:is_active a owl:DatatypeProperty ;
    dcterms:description "Note this table has is_active but NO is_deleted, unlike the client and employee dimensions - the soft-delete convention is applied inconsistently across the schema." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_lob_hierarchy> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "is_active" ;
    meta:sourceSqlType "BOOLEAN" .

ns14:lob_code a owl:DatatypeProperty ;
    dcterms:description "Short business code for the LOB." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_lob_hierarchy> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "lob_code" ;
    meta:sourceSqlType "VARCHAR" .

ns14:lob_id a owl:DatatypeProperty ;
    dcterms:description "Line of Business, the MIDDLE level. NOT UNIQUE in this table - the grain is sub-LOB, so LOB columns repeat across every sub-LOB. This is the single most likely cause of inflated totals in the whole schema." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_lob_hierarchy> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "lob_id" ;
    meta:sourceSqlType "INTEGER" .

ns14:lob_name a owl:DatatypeProperty ;
    dcterms:description "LOB display name. SELECT lob_name FROM dim_lob_hierarchy RETURNS DUPLICATES." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_lob_hierarchy> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "lob_name" ;
    meta:sourceSqlType "VARCHAR" .

ns14:row_hash a owl:DatatypeProperty ;
    dcterms:description "64-bit change-detection fingerprint; samples are 16 lowercase hex chars. Used for change-detecting upsert. Present in all 14 dim_* tables, none of the client_* facts. NEVER join on this." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_lob_hierarchy> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "row_hash" ;
    meta:sourceSqlType "VARCHAR" .

ns14:sbu_name a owl:DatatypeProperty ;
    dcterms:description "Strategic Business Unit, the TOP level. Has NO accompanying sbu_id or sbu_code - the top of the hierarchy is identified by NAME ONLY, so SBU rollups group on a text label vulnerable to whitespace and casing, and the SBU cannot be renamed safely." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_lob_hierarchy> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "sbu_name" ;
    meta:sourceSqlType "VARCHAR" .

ns14:source_load_ts a owl:DatatypeProperty ;
    dcterms:description "ETL load timestamp, WITHOUT TIME ZONE - no timezone is recorded anywhere, so IST vs UTC is a convention held outside the DB. Present in 12 of 14 dim_* tables; absent from both MF history tables and from all 7 client_* facts." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_lob_hierarchy> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "source_load_ts" ;
    meta:sourceSqlType "TIMESTAMP" .

ns14:source_table a owl:DatatypeProperty ;
    dcterms:description "Lineage: name of the ORIGIN object in the SOURCE system, not this table. Proven by dim_client_master rows carrying 'clients'. Present in all 21 tables. NEVER join or filter business logic on this." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_lob_hierarchy> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "source_table" ;
    meta:sourceSqlType "VARCHAR" .

ns14:sub_lob_code a owl:DatatypeProperty ;
    dcterms:description "Short business code for the sub-LOB." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_lob_hierarchy> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "sub_lob_code" ;
    meta:sourceSqlType "VARCHAR" .

ns14:sub_lob_id a owl:DatatypeProperty ;
    dcterms:description "Sub-LOB, the LEAF level and the true grain of this table. Samples: 10 = Private Wealth, 11 = Family Office." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_lob_hierarchy> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "sub_lob_id" ;
    meta:sourceSqlType "INTEGER" .

ns14:sub_lob_name a owl:DatatypeProperty ;
    dcterms:description "Sub-LOB display name." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_lob_hierarchy> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "sub_lob_name" ;
    meta:sourceSqlType "VARCHAR" .

ns18:is_active a owl:DatatypeProperty ;
    dcterms:description "Soft-delete pair lets retired enum values be hidden from pickers while remaining resolvable for historical rows - a genuinely useful property." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_master_enums> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "is_active" ;
    meta:sourceSqlType "BOOLEAN" .

ns18:row_hash a owl:DatatypeProperty ;
    dcterms:description "64-bit change-detection fingerprint; samples are 16 lowercase hex chars. Used for change-detecting upsert. Present in all 14 dim_* tables, none of the client_* facts. NEVER join on this." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_master_enums> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "row_hash" ;
    meta:sourceSqlType "VARCHAR" .

ns18:source_load_ts a owl:DatatypeProperty ;
    dcterms:description "ETL load timestamp, WITHOUT TIME ZONE - no timezone is recorded anywhere, so IST vs UTC is a convention held outside the DB. Present in 12 of 14 dim_* tables; absent from both MF history tables and from all 7 client_* facts." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_master_enums> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "source_load_ts" ;
    meta:sourceSqlType "TIMESTAMP" .

ns18:source_table a owl:DatatypeProperty ;
    dcterms:description "Lineage: name of the ORIGIN object in the SOURCE system, not this table. Proven by dim_client_master rows carrying 'clients'. Present in all 21 tables. NEVER join or filter business logic on this." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_master_enums> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "source_table" ;
    meta:sourceSqlType "VARCHAR" .

ns17:amc_code a owl:DatatypeProperty ;
    dcterms:description "Fund house short code." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_mf_fund_complete> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "amc_code" ;
    meta:sourceSqlType "VARCHAR" .

ns17:amc_id a owl:DatatypeProperty ;
    dcterms:description "Asset Management Company key. No dim_amc table exists." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_mf_fund_complete> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "amc_id" ;
    meta:sourceSqlType "INTEGER" .

ns17:amc_name a owl:DatatypeProperty ;
    dcterms:description "Fund house name. NAMING TRAP: dim_product_unified_cat calls this 'amc_display_name'." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_mf_fund_complete> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "amc_name" ;
    meta:sourceSqlType "VARCHAR" .

ns17:asset_alloc_bond_net a owl:DatatypeProperty ;
    dcterms:description "Look-through bond weight, net." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_mf_fund_complete> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "asset_alloc_bond_net" ;
    meta:sourceSqlType "FLOAT" .

ns17:asset_alloc_cash_net a owl:DatatypeProperty ;
    dcterms:description "Look-through cash weight, net. These three cover equity, bond and cash ONLY - there is no other/alternatives bucket, so they need NOT sum to 100%." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_mf_fund_complete> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "asset_alloc_cash_net" ;
    meta:sourceSqlType "FLOAT" .

ns17:asset_alloc_equity_net a owl:DatatypeProperty ;
    dcterms:description "Look-through equity weight. The _net suffix implies NET of derivative and short positions, so a value can in principle exceed 100% or go negative. Main analytical use: TRUE asset-allocation look-through - a client's equity exposure is their direct equity PLUS fund_value * asset_alloc_equity_net for every fund held. This is how you reconcile bottom-up allocation against client_aum's splits." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_mf_fund_complete> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "asset_alloc_equity_net" ;
    meta:sourceSqlType "FLOAT" .

ns17:benchmark_name a owl:DatatypeProperty ;
    dcterms:description "Intended link to dim_cmot_index_prices.index_name by FREE-TEXT MATCH - which, by exact match, finds nothing in this data (see below). NAMING TRAP: dim_product_unified_cat calls this 'benchmark'. The differing names suggest the two were populated by different processes with different conventions, which makes the text join even more fragile. Populated on all 30 rows with 16 distinct values (e.g. 'Nifty 500 TRI' 7, 'Nifty 50 TRI' 3, 'Nifty 100 TRI' 3, 'Nifty Midcap 150 TRI' 3). NONE equals an index_name exactly (0 of 30). It differs from dim_product_unified_cat.benchmark for 19 of the 30 funds (matched on isin). Preserve each label and its unmatched status in stored data and the KG - never strip ' TRI' or store an alias. The ' TRI' strip in 01_domain_and_business_rules.md §3.8 is a QUERY-TIME house rule only, which an equivalent KG query must reproduce exactly as the SQL does." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_mf_fund_complete> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "benchmark_name" ;
    meta:sourceSqlType "VARCHAR" .

ns17:category a owl:DatatypeProperty ;
    dcterms:description "SEBI's mandated scheme classification (Equity -> Flexi Cap / Large Cap / Mid Cap; Debt -> Liquid / Short Duration; Hybrid; Solution-Oriented). A primary axis for peer comparison." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_mf_fund_complete> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "category" ;
    meta:sourceSqlType "VARCHAR" .

ns17:expense_ratio a owl:DatatypeProperty ;
    dcterms:description "Annual cost. Essential for net-of-fee analysis and for the Regular-vs-Direct plan comparison that drives much advisory conversation." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_mf_fund_complete> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "expense_ratio" ;
    meta:sourceSqlType "FLOAT" .

ns17:fund_id a owl:DatatypeProperty ;
    dcterms:description "Internal integer fund key; also carried by dim_mf_returns_history but NOT by dim_mf_nav_history." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_mf_fund_complete> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "fund_id" ;
    meta:sourceSqlType "INTEGER" .

ns17:fund_manager_name a owl:DatatypeProperty ;
    dcterms:description "A single free-text column - it CANNOT represent co-managed funds cleanly, and there is no dim_fund_manager, so manager-level analysis relies on exact string matching." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_mf_fund_complete> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "fund_manager_name" ;
    meta:sourceSqlType "VARCHAR" .

ns17:fund_name a owl:DatatypeProperty ;
    dcterms:description "Sample names carry plan and option explicitly, e.g. 'Kotak Flexi Cap Fund - Direct Growth'." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_mf_fund_complete> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "fund_name" ;
    meta:sourceSqlType "VARCHAR" .

ns17:inception_date a owl:DatatypeProperty ;
    dcterms:description "Fund launch date." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_mf_fund_complete> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "inception_date" ;
    meta:sourceSqlType "DATE" .

ns17:is_active a owl:DatatypeProperty ;
    dcterms:description "RECORD status - the row is current in the warehouse. Note there is NO is_deleted here, unlike the client, employee, enum and unified-product tables." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_mf_fund_complete> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "is_active" ;
    meta:sourceSqlType "BOOLEAN" .

ns17:is_obsolete a owl:DatatypeProperty ;
    dcterms:description "MARKET status - the scheme was wound up or merged away. Independent of is_active, which is the RECORD status; the schema documentation does not define their interaction." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_mf_fund_complete> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "is_obsolete" ;
    meta:sourceSqlType "BOOLEAN" .

ns17:isin a owl:DatatypeProperty ;
    dcterms:description "The grain key. MF ISINs begin INF while equity ISINs begin INE - the standard Indian convention (IN country code, then F for funds, E for equities), and a cheap way to route an ISIN when product_type is missing." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_mf_fund_complete> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "isin" ;
    meta:sourceSqlType "VARCHAR" .

ns17:mstar_id a owl:DatatypeProperty ;
    dcterms:description "Morningstar identifier - THE key that ties this table to dim_mf_nav_history and dim_mf_returns_history." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_mf_fund_complete> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "mstar_id" ;
    meta:sourceSqlType "VARCHAR" .

ns17:row_hash a owl:DatatypeProperty ;
    dcterms:description "64-bit change-detection fingerprint; samples are 16 lowercase hex chars. Used for change-detecting upsert. Present in all 14 dim_* tables, none of the client_* facts. NEVER join on this." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_mf_fund_complete> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "row_hash" ;
    meta:sourceSqlType "VARCHAR" .

ns17:rta_code a owl:DatatypeProperty ;
    dcterms:description "Registrar's scheme code." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_mf_fund_complete> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "rta_code" ;
    meta:sourceSqlType "VARCHAR" .

ns17:source_load_ts a owl:DatatypeProperty ;
    dcterms:description "ETL load timestamp, WITHOUT TIME ZONE - no timezone is recorded anywhere, so IST vs UTC is a convention held outside the DB. Present in 12 of 14 dim_* tables; absent from both MF history tables and from all 7 client_* facts." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_mf_fund_complete> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "source_load_ts" ;
    meta:sourceSqlType "TIMESTAMP" .

ns17:source_table a owl:DatatypeProperty ;
    dcterms:description "Lineage: name of the ORIGIN object in the SOURCE system, not this table. Proven by dim_client_master rows carrying 'clients'. Present in all 21 tables. NEVER join or filter business logic on this." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_mf_fund_complete> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "source_table" ;
    meta:sourceSqlType "VARCHAR" .

ns17:sub_category a owl:DatatypeProperty ;
