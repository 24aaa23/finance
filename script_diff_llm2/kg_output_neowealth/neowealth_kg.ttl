<https://wealth.example.org/neowealth/declared-attribute/main/dim_mf_fund_complete/mstar_id> a meta:DeclaredAttribute ;
    meta:rawYaml """attribute_type: identifier
description: Morningstar identifier - THE key that ties this table to dim_mf_nav_history
  and dim_mf_returns_history.
