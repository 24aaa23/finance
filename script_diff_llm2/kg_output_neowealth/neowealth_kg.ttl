    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "master_category_name" ;
    meta:sourceSqlType "VARCHAR" .

ns18:master_type_key a owl:DatatypeProperty ;
    dcterms:description "The presence of TWO key-ish columns (type_key and master_type_key) suggests a two-level structure, but this is moot: in this data every enum payload column (id, type_key, master_category_name, name, master_type_key) is NULL - the 25 rows carry only company-master is_active / lineage values - so the table cannot be used to resolve labels regardless of key structure. Read coded values directly from the label already stored on the client/product tables." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_master_enums> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "master_type_key" ;
    meta:sourceSqlType "VARCHAR" .

ns18:name a owl:DatatypeProperty ;
