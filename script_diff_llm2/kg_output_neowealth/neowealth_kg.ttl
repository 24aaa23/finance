@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix meta: <https://wealth.example.org/conversion-metadata/> .
@prefix ns1: <https://wealth.example.org/neowealth/column/main/client_transactions/> .
@prefix ns10: <https://wealth.example.org/neowealth/column/main/dim_cmot_company_mstr/> .
@prefix ns11: <https://wealth.example.org/neowealth/column/main/dim_mf_returns_history/> .
@prefix ns12: <https://wealth.example.org/neowealth/column/main/dim_cmot_index_prices/> .
@prefix ns13: <https://wealth.example.org/neowealth/column/main/dim_product_segment_map/> .
@prefix ns14: <https://wealth.example.org/neowealth/column/main/dim_lob_hierarchy/> .
@prefix ns15: <https://wealth.example.org/neowealth/column/main/client_realized_gain/> .
@prefix ns16: <https://wealth.example.org/neowealth/column/main/dim_client_master/> .
@prefix ns17: <https://wealth.example.org/neowealth/column/main/dim_mf_fund_complete/> .
@prefix ns18: <https://wealth.example.org/neowealth/column/main/dim_master_enums/> .
@prefix ns19: <https://wealth.example.org/neowealth/column/main/dim_client_account_map/> .
@prefix ns2: <https://wealth.example.org/neowealth/relationship/> .
@prefix ns20: <https://wealth.example.org/neowealth/column/main/dim_equity_price_latest/> .
@prefix ns21: <https://wealth.example.org/neowealth/column/main/dim_product_credit_rtng/> .
@prefix ns22: <https://wealth.example.org/neowealth/column/main/dim_employee_profile/> .
@prefix ns3: <https://wealth.example.org/neowealth/column/main/dim_mf_nav_history/> .
@prefix ns4: <https://wealth.example.org/neowealth/column/main/client_holdings/> .
@prefix ns5: <https://wealth.example.org/neowealth/column/main/client_valuations/> .
@prefix ns6: <https://wealth.example.org/neowealth/column/main/client_revenue/> .
@prefix ns7: <https://wealth.example.org/neowealth/column/main/client_net_new_money/> .
@prefix ns8: <https://wealth.example.org/neowealth/column/main/client_aum/> .
@prefix ns9: <https://wealth.example.org/neowealth/column/main/dim_product_unified_cat/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

meta:SourceMatch a owl:Class .

meta:hasDeclaredAttribute a owl:ObjectProperty .

meta:identityMethod a owl:DatatypeProperty .

meta:joinDefinition a owl:DatatypeProperty .

meta:nullColumn a owl:ObjectProperty .

meta:nullable a owl:DatatypeProperty .

meta:rawYaml a owl:DatatypeProperty .

meta:relationshipKind a owl:DatatypeProperty .

meta:sha256 a owl:DatatypeProperty .

meta:sourceColumn a owl:DatatypeProperty .

meta:sourceFile a owl:DatatypeProperty .

meta:sourceRowNumber a owl:DatatypeProperty .

meta:sourceSqlType a owl:DatatypeProperty .

meta:sourceTable a owl:ObjectProperty .

ns8:as_on_date a owl:DatatypeProperty ;
    dcterms:description "MONTH-START dated monthly snapshot (2025-12-01, 2026-01-01, ... 2026-05-01). HAZARD: client_holdings.as_on_date is a DAILY date - equi-joining the two on date returns nothing or wrong rows. Align with DATE_TRUNC('month', ...)." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_aum> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "as_on_date" ;
    meta:sourceSqlType "DATE" .

ns8:aum_alternatives a owl:DatatypeProperty ;
    dcterms:description "Alternatives component of aum_value." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_aum> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "aum_alternatives" ;
    meta:sourceSqlType "DOUBLE" .

ns8:aum_equity a owl:DatatypeProperty ;
    dcterms:description "Equity component of aum_value. Part of the exhaustive 3-way split that reconciles to the total." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_aum> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "aum_equity" ;
    meta:sourceSqlType "DOUBLE" .

ns8:aum_fixed_income a owl:DatatypeProperty ;
    dcterms:description "Fixed-income component of aum_value." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_aum> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "aum_fixed_income" ;
    meta:sourceSqlType "DOUBLE" .

ns8:aum_value a owl:DatatypeProperty ;
    dcterms:description "Total AUM. VERIFIED IDENTITY on all 10 sample rows: aum_value = aum_equity + aum_fixed_income + aum_alternatives, exactly. Usable as a production data-quality assertion with a tolerance." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_aum> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "aum_value" ;
    meta:sourceSqlType "DOUBLE" .

ns8:client_id a owl:DatatypeProperty ;
    dcterms:description "-> dim_client_master.id. Confirmed by sample data (7001, 7002 fall inside the master's 7001-7010 range). Nullable: an inner join can silently drop rows." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_aum> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "client_id" ;
    meta:sourceSqlType "INTEGER" .

ns8:id a owl:DatatypeProperty ;
    dcterms:description "NOT NULL. One of only TWO NOT NULL columns in the entire 309-column schema, so the strongest PK candidate present. Sample range 140001+. Per-table sequence - never join id across fact tables." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_aum> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "id" ;
    meta:sourceSqlType "INTEGER" .

ns8:lob_id a owl:DatatypeProperty ;
    dcterms:description "-> dim_lob_hierarchy.lob_id. HAZARD: lob_id is NOT unique in that table (its grain is sub-LOB), so joining directly FANS OUT and multiplies aum_value. Join to (SELECT DISTINCT lob_id, ...) instead." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_aum> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "lob_id" ;
    meta:sourceSqlType "INTEGER" .

ns8:lob_name a owl:DatatypeProperty ;
    dcterms:description "Denormalised copy of dim_lob_hierarchy.lob_name, stored to avoid a join. Can drift from the master if an LOB is renamed. Observed values (180 rows): Neo Wealth Advisory (126), Broking Services (36), Asset Management (18) - all three present in dim_lob_hierarchy.lob_name." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_aum> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "lob_name" ;
    meta:sourceSqlType "VARCHAR" .

ns8:source_table a owl:DatatypeProperty ;
    dcterms:description "Lineage: name of the ORIGIN object in the SOURCE system, not this table. Proven by dim_client_master rows carrying 'clients'. Present in all 21 tables. NEVER join or filter business logic on this." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_aum> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "source_table" ;
    meta:sourceSqlType "VARCHAR" .

ns4:accrued_interest a owl:DatatypeProperty ;
    dcterms:description "Zero across every sample row - all samples are equity and MF. Meaningful only for bonds and fixed deposits." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_holdings> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "accrued_interest" ;
    meta:sourceSqlType "DOUBLE" .

ns4:as_on_date a owl:DatatypeProperty ;
    dcterms:description "DAILY position snapshot date; all 10 samples are 2026-05-19. Contrast client_aum.as_on_date, which is month-start." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_holdings> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "as_on_date" ;
    meta:sourceSqlType "DATE" .

ns4:avg_cost_price a owl:DatatypeProperty ;
    dcterms:description "Weighted average per-unit purchase price. Typed real while current_price is double precision - the two are directly subtracted, so arithmetic is promoted to double precision while silently inheriting real's lower accuracy." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_holdings> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "avg_cost_price" ;
    meta:sourceSqlType "FLOAT" .

ns4:benchmark_name a owl:DatatypeProperty ;
    dcterms:description "NOT in the DDL - present in the CSV delivery. Name of the benchmark used for comparison, carried on the position row. Populated on all 505 rows and equal on every row to dim_product_unified_cat.benchmark for the same product_id (the coarse product-level benchmark, not the fund master's benchmark_name). Observed values: 'Nifty 50 TRI' (239 rows), 'Nifty 10 yr Benchmark G-Sec Index' (130), 'Nifty 500 TRI' (128), 'Nasdaq 100 TRI' (8). NO value equals any dim_cmot_index_prices.index_name exactly (0 of 505). Preserve the label as supplied and keep it unmatched in stored data and the KG - never strip ' TRI' or store an alias. The ' TRI' strip in 01_domain_and_business_rules.md §3.8 is a QUERY-TIME house rule only, which an equivalent KG query must reproduce exactly as the SQL does." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_holdings> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "benchmark_name" ;
    meta:sourceSqlType "VARCHAR" .

ns4:client_id a owl:DatatypeProperty ;
    dcterms:description "-> dim_client_master.id. CONFIRMED: holdings for client_id 7001 all carry client_pan 'ABCPK1001A', which is exactly dim_client_master.pan_number for id 7001." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_holdings> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "client_id" ;
    meta:sourceSqlType "INTEGER" .

ns4:client_pan a owl:DatatypeProperty ;
    dcterms:description "Denormalised copy of dim_client_master.pan_number. DO NOT JOIN ON THIS - PAN is user-entered, correctable, can be shared across joint holdings, is nullable, and is sensitive. Present for display and upstream reconciliation only. PII." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_holdings> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "client_pan" ;
    meta:sourceSqlType "VARCHAR" .

ns4:current_price a owl:DatatypeProperty ;
    dcterms:description "Per-unit mark price. For equity it should reconcile to dim_equity_price_latest.nav_close; for funds to dim_mf_nav_history.nav_value on the same date. Compare with a tolerance - the two sides differ in precision." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_holdings> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "current_price" ;
    meta:sourceSqlType "DOUBLE" .

ns4:current_value a owl:DatatypeProperty ;
    dcterms:description "VERIFIED: = quantity * current_price (row 80001: 985 * 295.80 = 291363.00, exact)." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_holdings> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "current_value" ;
    meta:sourceSqlType "DOUBLE" .

ns4:id a owl:DatatypeProperty ;
    dcterms:description "NOT NULL. The second and last NOT NULL column in the schema. Sample range 80001+. Per-table sequence - never join across tables." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_holdings> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "id" ;
    meta:sourceSqlType "INTEGER" .

ns4:instrument_name a owl:DatatypeProperty ;
    dcterms:description "Denormalised instrument label. Samples include 'Bharat Electronics Ltd', 'Kotak Flexi Cap Fund - Direct Growth' (note MF names carry plan and option)." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_holdings> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "instrument_name" ;
    meta:sourceSqlType "VARCHAR" .

ns4:invested_value a owl:DatatypeProperty ;
    dcterms:description "VERIFIED: = quantity * avg_cost_price (row 80001: 985 * 224.84 = 221467.40, exact). Nullable and can be zero - guard with NULLIF when dividing." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_holdings> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "invested_value" ;
    meta:sourceSqlType "DOUBLE" .

ns4:is_held_away a owl:DatatypeProperty ;
    dcterms:description "Flags externally-custodied assets the firm advises on but does not hold. One sample row TRUE (Infosys, id 80005). Held-away assets are typically EXCLUDED from fee-billable AUM and revenue attribution but INCLUDED in a total-wealth view. Nullable, so always COALESCE(is_held_away, FALSE)." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_holdings> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "is_held_away" ;
    meta:sourceSqlType "BOOLEAN" .

ns4:product_id a owl:DatatypeProperty ;
    dcterms:description "-> dim_product_unified_cat.product_id. THE PREFERRED product join key. Sample format is type-prefixed: PROD_EQ_025, PROD_MF_010." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_holdings> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "product_id" ;
    meta:sourceSqlType "VARCHAR" .

ns4:product_type a owl:DatatypeProperty ;
    dcterms:description "Denormalised from the catalogue. Observed values (505 rows): Mutual Funds (176), Direct Equity (154), Bonds (66), Fixed Deposits (51), AIF (19), REITs (17), PMS (15), InvITs (7). Acts as the routing discriminator for onward market-data joins." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_holdings> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "product_type" ;
    meta:sourceSqlType "VARCHAR" .

ns4:quantity a owl:DatatypeProperty ;
    dcterms:description "Units/shares held. Fractional for funds (49130.91) and whole for equity (985) - so it can NEVER be typed integer. Typed real here but client_transactions.units is double precision: same concept, two precisions, expect reconciliation residuals." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_holdings> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "quantity" ;
    meta:sourceSqlType "FLOAT" .

ns4:source_table a owl:DatatypeProperty ;
    dcterms:description "Lineage: name of the ORIGIN object in the SOURCE system, not this table. Proven by dim_client_master rows carrying 'clients'. Present in all 21 tables. NEVER join or filter business logic on this." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_holdings> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "source_table" ;
    meta:sourceSqlType "VARCHAR" .

ns4:unrealized_gain a owl:DatatypeProperty ;
    dcterms:description "TYPE DEFECT: declared character varying(256) but holds numbers (samples 69895.6, 240301, 702792.2). SUM() fails; ORDER BY sorts lexicographically so '9' ranks after '240301'. VERIFIED derivable: = current_value - invested_value. DO NOT parse it - COMPUTE it. Also mis-classified as a BI 'dimension' in the schema documentation's semantic layer, so tools will not offer it as a measure." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_holdings> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "unrealized_gain" ;
    meta:sourceSqlType "VARCHAR" .

ns4:unrealized_gain_pct a owl:DatatypeProperty ;
    dcterms:description "TYPE DEFECT: character varying(256) holding a number (samples 31.56, 17.54). VERIFIED derivable: = 100.0 * (current_value - invested_value) / NULLIF(invested_value, 0). Expressed as whole percent (31.56 means 31.56%)." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_holdings> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "unrealized_gain_pct" ;
    meta:sourceSqlType "VARCHAR" .

ns4:wsw_account_code a owl:DatatypeProperty ;
    dcterms:description "-> dim_client_account_map.wsw_account_code. THE ONLY account-level join in the schema: no other fact table records an account, so account-level reporting is possible for holdings and nothing else. Sample 70001. 'wsw' is a source-system prefix. Populated on all 505 rows (30 distinct codes). Of the 505 holdings, 174 match an account-map row on code AND client_id, 210 match on code but the account-map row names a DIFFERENT client_id (e.g. holding 80175: client 7009, account 70017 mapped to client 7010), and 121 carry a code absent from dim_client_account_map. A code match is a source-record match, NOT validated client ownership: never derive client identity through this join - use client_id directly for anything client-level. Reproduce a query's own join condition exactly - joining on code alone gives 384 matched rows; adding client_id changes the result. Keep both source client_ids and report the conflict; never invent a matching account. Whether the intended key is the code alone or code + client_id is not stated by the source and must be confirmed with the data team." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_holdings> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "wsw_account_code" ;
    meta:sourceSqlType "INTEGER" .

ns7:client_id a owl:DatatypeProperty ;
    dcterms:description "-> dim_client_master.id." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_net_new_money> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "client_id" ;
    meta:sourceSqlType "INTEGER" .

ns7:id a owl:DatatypeProperty ;
    dcterms:description "Nullable." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_net_new_money> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "id" ;
    meta:sourceSqlType "INTEGER" .

ns7:inflow a owl:DatatypeProperty ;
    dcterms:description "Gross money in, positive magnitude." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_net_new_money> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "inflow" ;
    meta:sourceSqlType "DOUBLE" .

ns7:net_flow a owl:DatatypeProperty ;
    dcterms:description "TYPE DEFECT: character varying(256) while both its operands are proper double precision. COMPUTE inflow - outflow instead of reading it, since a text column sorts and compares as text. The stored text equals inflow - outflow on all 612 rows, with a leading minus sign on the 87 net-outflow rows; outflow is never negative. NNM is a headline KPI - it isolates genuine asset gathering from market movement, which AUM growth cannot." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_net_new_money> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "net_flow" ;
    meta:sourceSqlType "VARCHAR" .

ns7:outflow a owl:DatatypeProperty ;
    dcterms:description "Gross money out, stored as its own POSITIVE magnitude - so net attrition shows as outflow > inflow." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_net_new_money> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "outflow" ;
    meta:sourceSqlType "DOUBLE" .

ns7:period_date a owl:DatatypeProperty ;
    dcterms:description "A period aggregate, not an event date. Month-start dated: six periods, 2025-12-01 to 2026-05-01, 102 rows each, matching client_aum's month-start dating." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_net_new_money> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "period_date" ;
    meta:sourceSqlType "DATE" .

ns7:product_id a owl:DatatypeProperty ;
    dcterms:description "Declared join -> dim_product_unified_cat.product_id - which matches no row in this data (see below). This is the ONLY product-bearing fact table with NO isin - flows are tracked at product_id granularity only. In this data product_id holds 4 AGGREGATE codes, not catalogue product keys: AGG_BONDS (102 rows, product_type 'Bonds'), AGG_DIRECT_EQUITY (150, 'Direct Equity'), AGG_FIXED_DEPOSITS (180, 'Fixed Deposits'), AGG_MUTUAL_FUNDS (180, 'Mutual Funds'). NONE of the 612 rows matches a dim_product_unified_cat.product_id (individual products such as PROD_EQ_001), so the declared join returns no rows - and an equivalent query must keep returning none. Read the bucket from product_type on the same row. Whether AGG_* codes denote investment categories is not stated by the source and must be confirmed with the data team. A confirmed category relationship may be added separately; it must not replace this join or spread a category total across individual products. Preserve the original product_id, product_type, client and period values." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_net_new_money> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "product_id" ;
    meta:sourceSqlType "VARCHAR" .

ns7:product_type a owl:DatatypeProperty ;
    dcterms:description "Denormalised." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_net_new_money> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "product_type" ;
    meta:sourceSqlType "VARCHAR" .

ns7:source_table a owl:DatatypeProperty ;
    dcterms:description "Lineage: name of the ORIGIN object in the SOURCE system, not this table. Proven by dim_client_master rows carrying 'clients'. Present in all 21 tables. NEVER join or filter business logic on this." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_net_new_money> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "source_table" ;
    meta:sourceSqlType "VARCHAR" .

ns15:buy_date a owl:DatatypeProperty ;
    dcterms:description "Buy leg of the matched lot. Samples span 2023-03-07 to 2025-07-06." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_realized_gain> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "buy_date" ;
    meta:sourceSqlType "DATE" .

ns15:buy_price a owl:DatatypeProperty ;
    dcterms:description "Per-unit purchase price of the lot." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_realized_gain> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "buy_price" ;
    meta:sourceSqlType "FLOAT" .

ns15:client_id a owl:DatatypeProperty ;
    dcterms:description "-> dim_client_master.id. Samples reference 7001-7004." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_realized_gain> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "client_id" ;
    meta:sourceSqlType "INTEGER" .

ns15:client_pan a owl:DatatypeProperty ;
    dcterms:description "Denormalised PAN. Do not join on it. PII." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_realized_gain> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "client_pan" ;
    meta:sourceSqlType "VARCHAR" .

ns15:holding_period_days a owl:DatatypeProperty ;
    dcterms:description "VERIFIED on id 110001: 2024-07-01 -> 2026-04-05 = 643 days, exact. Plain calendar-day difference sell_date - buy_date. Samples range 210-1091 days. Combine with product_type to classify short vs long term; the schema encodes no threshold." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_realized_gain> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "holding_period_days" ;
    meta:sourceSqlType "INTEGER" .

ns15:id a owl:DatatypeProperty ;
    dcterms:description "Nullable. Sample range 110001+." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_realized_gain> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "id" ;
    meta:sourceSqlType "INTEGER" .

ns15:instrument_name a owl:DatatypeProperty ;
    dcterms:description "Denormalised instrument label." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_realized_gain> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "instrument_name" ;
    meta:sourceSqlType "VARCHAR" .

ns15:isin a owl:DatatypeProperty ;
    dcterms:description "Instrument identity." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_realized_gain> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "isin" ;
    meta:sourceSqlType "VARCHAR" .

ns15:product_id a owl:DatatypeProperty ;
    dcterms:description "-> dim_product_unified_cat.product_id." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_realized_gain> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "product_id" ;
    meta:sourceSqlType "VARCHAR" .

ns15:product_type a owl:DatatypeProperty ;
    dcterms:description "Denormalised. REQUIRED for capital-gains classification: the Indian long/short-term boundary depends on asset class, so holding_period_days alone cannot classify a gain." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_realized_gain> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "product_type" ;
    meta:sourceSqlType "VARCHAR" .

ns15:quantity a owl:DatatypeProperty ;
    dcterms:description "Units in the matched lot." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_realized_gain> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "quantity" ;
    meta:sourceSqlType "FLOAT" .

ns15:realized_gain a owl:DatatypeProperty ;
    dcterms:description "VERIFIED on sample id 110001 (SBI, 130 units, 505.19 -> 799.52): (799.52 - 505.19) * 130 = 38262.90, EXACT. So realized_gain = (sell_price - buy_price) * quantity, GROSS of costs - no brokerage, STT or tax is netted off. There is NO realized_loss column and no sign flag, so a loss must be a NEGATIVE realized_gain. SUM() therefore yields a NET figure; split on sign to report gross gains and losses separately." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_realized_gain> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "realized_gain" ;
    meta:sourceSqlType "DOUBLE" .

ns15:sell_date a owl:DatatypeProperty ;
    dcterms:description "Sell leg. Samples span 2025-12-22 to 2026-05-08." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_realized_gain> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "sell_date" ;
    meta:sourceSqlType "DATE" .

ns15:sell_price a owl:DatatypeProperty ;
    dcterms:description "Per-unit sale price of the lot." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_realized_gain> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "sell_price" ;
    meta:sourceSqlType "FLOAT" .

ns15:source_table a owl:DatatypeProperty ;
    dcterms:description "Lineage: name of the ORIGIN object in the SOURCE system, not this table. Proven by dim_client_master rows carrying 'clients'. Present in all 21 tables. NEVER join or filter business logic on this." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_realized_gain> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "source_table" ;
    meta:sourceSqlType "VARCHAR" .

ns6:client_id a owl:DatatypeProperty ;
    dcterms:description "-> dim_client_master.id." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_revenue> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "client_id" ;
    meta:sourceSqlType "INTEGER" .

ns6:emp_code a owl:DatatypeProperty ;
    dcterms:description "-> dim_employee_profile.code. Text join; denormalised duplicate of the emp_id path. You must resolve emp_id -> code before traversing the employee hierarchy, which is keyed on code." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_revenue> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "emp_code" ;
    meta:sourceSqlType "VARCHAR" .

ns6:emp_id a owl:DatatypeProperty ;
    dcterms:description "-> dim_employee_profile.id. Integer join, PREFERRED. This is the ONLY fact table carrying an employee key, so it is the sole basis for RM productivity and incentive reporting. The schema documentation does NOT say which role this represents - servicing banker, acquiring banker, or neither - nor whether it is the banker at time of posting. Do not assume it equals either dim_client_master banker." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_revenue> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "emp_id" ;
    meta:sourceSqlType "INTEGER" .

ns6:id a owl:DatatypeProperty ;
    dcterms:description "Nullable." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_revenue> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "id" ;
    meta:sourceSqlType "INTEGER" .

ns6:lob_id a owl:DatatypeProperty ;
    dcterms:description "-> dim_lob_hierarchy.lob_id, enabling LOB P&L without a detour through the client master. Unlike client_aum, no denormalised lob_name is carried, so labelling always requires the join - and the join must be de-duplicated (see the fan-out hazard)." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_revenue> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "lob_id" ;
    meta:sourceSqlType "INTEGER" .

ns6:product_type a owl:DatatypeProperty ;
    dcterms:description "Revenue is attributed at product_type level ONLY - there is no product_id and no isin here, so revenue CANNOT be attributed to an individual instrument. Coarsest product grain of any fact table." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_revenue> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "product_type" ;
    meta:sourceSqlType "VARCHAR" .

ns6:revenue_amount a owl:DatatypeProperty ;
    dcterms:description "Fee or commission income amount." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_revenue> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "revenue_amount" ;
    meta:sourceSqlType "DOUBLE" .

ns6:revenue_date a owl:DatatypeProperty ;
    dcterms:description "Posting date." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_revenue> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "revenue_date" ;
    meta:sourceSqlType "DATE" .

ns6:revenue_type a owl:DatatypeProperty ;
    dcterms:description "Uncontrolled varchar(256) with no declared enumeration. Observed values (675 rows, no blanks): Advisory Fee (147), Upfront Commission (145), Trail Commission (135), Transaction Fee (127), Brokerage (121). The recurring-vs-one-off split is usually the most important cut of this table; Advisory Fee and Trail Commission read as recurring and the other three as one-off, but the source does not declare it. Filter on these labels exactly as supplied." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_revenue> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "revenue_type" ;
    meta:sourceSqlType "VARCHAR" .

ns6:source_table a owl:DatatypeProperty ;
    dcterms:description "Lineage: name of the ORIGIN object in the SOURCE system, not this table. Proven by dim_client_master rows carrying 'clients'. Present in all 21 tables. NEVER join or filter business logic on this." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_revenue> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "source_table" ;
    meta:sourceSqlType "VARCHAR" .

ns1:amount a owl:DatatypeProperty ;
    dcterms:description "The rupee consideration, always stored positive, Redemption rows included. amount ~= units * nav_price holds on all 3,004 rows to within rounding (max relative difference < 0.001%). Direction is carried only by transaction_type, never by the sign of this column: net flow = SUM(CASE WHEN transaction_type='Redemption' THEN -amount ELSE amount END); turnover = SUM(amount) over both directions. Summing amount without a transaction_type filter therefore adds redemptions to purchases." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_transactions> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "amount" ;
    meta:sourceSqlType "DOUBLE" .

ns1:client_id a owl:DatatypeProperty ;
    dcterms:description "-> dim_client_master.id." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_transactions> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "client_id" ;
    meta:sourceSqlType "INTEGER" .

ns1:client_pan a owl:DatatypeProperty ;
    dcterms:description "Denormalised PAN. Do not join on it. PII." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_transactions> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "client_pan" ;
    meta:sourceSqlType "VARCHAR" .

ns1:id a owl:DatatypeProperty ;
    dcterms:description "Nullable - not a valid PK as declared." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_transactions> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "id" ;
    meta:sourceSqlType "INTEGER" .

ns1:nav_price a owl:DatatypeProperty ;
    dcterms:description "Per-unit execution price. Named for mutual funds but serves as the generic execution price for equity too." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_transactions> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "nav_price" ;
    meta:sourceSqlType "FLOAT" .

ns1:product_id a owl:DatatypeProperty ;
    dcterms:description "-> dim_product_unified_cat.product_id." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_transactions> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "product_id" ;
    meta:sourceSqlType "VARCHAR" .

ns1:product_type a owl:DatatypeProperty ;
    dcterms:description "Denormalised routing discriminator." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_transactions> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "product_type" ;
    meta:sourceSqlType "VARCHAR" .

ns1:source_table a owl:DatatypeProperty ;
    dcterms:description "Lineage: name of the ORIGIN object in the SOURCE system, not this table. Proven by dim_client_master rows carrying 'clients'. Present in all 21 tables. NEVER join or filter business logic on this." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_transactions> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "source_table" ;
    meta:sourceSqlType "VARCHAR" .

ns1:transaction_date a owl:DatatypeProperty ;
    dcterms:description "Event date. This is the schema's only true event/ledger table - everything else is a snapshot or a period aggregate." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_transactions> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "transaction_date" ;
    meta:sourceSqlType "DATE" .

ns1:transaction_type a owl:DatatypeProperty ;
    dcterms:description "Purchase or Redemption - observed values: Purchase (2,972 rows) and Redemption (32), no blanks; no Buy/Sell/SIP/Switch/Dividend labels occur. This is the ONLY source of transaction direction: amount and units do not carry a sign. Filter on the labels exactly as supplied (transaction_type = 'Purchase'); do not assume other values exist." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_transactions> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "transaction_type" ;
    meta:sourceSqlType "VARCHAR" .

ns1:units a owl:DatatypeProperty ;
    dcterms:description "Typed double precision while client_holdings.quantity is real - same concept, two precisions." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_transactions> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "units" ;
    meta:sourceSqlType "DOUBLE" .

ns5:client_id a owl:DatatypeProperty ;
    dcterms:description "-> dim_client_master.id." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_valuations> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "client_id" ;
    meta:sourceSqlType "INTEGER" .

ns5:cost_value a owl:DatatypeProperty ;
    dcterms:description "Equivalent to client_holdings.invested_value." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_valuations> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "cost_value" ;
    meta:sourceSqlType "DOUBLE" .

ns5:id a owl:DatatypeProperty ;
    dcterms:description "NULLABLE here - so it is NOT a valid primary key as declared." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_valuations> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "id" ;
    meta:sourceSqlType "INTEGER" .

ns5:market_value a owl:DatatypeProperty ;
    dcterms:description "Equivalent to client_holdings.current_value." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_valuations> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "market_value" ;
    meta:sourceSqlType "DOUBLE" .

ns5:product_id a owl:DatatypeProperty ;
    dcterms:description "-> dim_product_unified_cat.product_id." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_valuations> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "product_id" ;
    meta:sourceSqlType "VARCHAR" .

ns5:source_table a owl:DatatypeProperty ;
    dcterms:description "Lineage: name of the ORIGIN object in the SOURCE system, not this table. Proven by dim_client_master rows carrying 'clients'. Present in all 21 tables. NEVER join or filter business logic on this." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_valuations> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "source_table" ;
    meta:sourceSqlType "VARCHAR" .

ns5:unrealized_pnl a owl:DatatypeProperty ;
    dcterms:description "TYPE DEFECT: character varying(256) holding a number. Same defect as client_holdings.unrealized_gain - the recurrence suggests one shared upstream transformation emits P&L as a string. COMPUTE market_value - cost_value instead." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_valuations> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "unrealized_pnl" ;
    meta:sourceSqlType "VARCHAR" .

ns5:valuation_date a owl:DatatypeProperty ;
    dcterms:description "Equivalent to client_holdings.as_on_date." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_valuations> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "valuation_date" ;
    meta:sourceSqlType "DATE" .

ns19:account_details_id a owl:DatatypeProperty ;
    dcterms:description "The account's surrogate key in the UPSTREAM source system. There is no dim_account table, so this points at nothing inside the warehouse - a dangling reference useful only for tracing back to the source." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_client_account_map> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "account_details_id" ;
    meta:sourceSqlType "INTEGER" .

ns19:account_number a owl:DatatypeProperty ;
    dcterms:description "Bank account number. Populated on all 47 rows. PAYMENT CREDENTIAL - this table warrants stricter access control than dim_client_master. Mask or tokenise in every non-production copy." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_client_account_map> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "account_number" ;
    meta:sourceSqlType "VARCHAR" .

ns19:account_type a owl:DatatypeProperty ;
    dcterms:description "Uncontrolled varchar(256) with no declared enumeration. Observed values: Individual (30 rows), HUF (12), Joint (3), NRI (2) - a holder/ownership category, NOT a bank / demat / folio discriminator. It does not tell you which identifier group to read: Individual, HUF and Joint rows carry bank, DP ID and (on some rows) folio identifiers together, and the 2 NRI rows carry bank identifiers only. What account_type classifies is not stated by the source and must be confirmed with the data team. Keep the original label; never derive an account kind from it." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_client_account_map> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "account_type" ;
    meta:sourceSqlType "VARCHAR" .

ns19:bank_name a owl:DatatypeProperty ;
    dcterms:description "Part of the banking triple used for settlement, payouts and mandates." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_client_account_map> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "bank_name" ;
    meta:sourceSqlType "VARCHAR" .

ns19:client_id a owl:DatatypeProperty ;
    dcterms:description "-> dim_client_master.id. Many-to-one: a client with several accounts has several rows here, so client_id is NOT unique in this table." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_client_account_map> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "client_id" ;
    meta:sourceSqlType "INTEGER" .

ns19:ifsc_code a owl:DatatypeProperty ;
    dcterms:description "Indian Financial System Code - pins the specific bank branch. Payment credential; mask outside production." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_client_account_map> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "ifsc_code" ;
    meta:sourceSqlType "VARCHAR" .

ns19:is_active a owl:DatatypeProperty ;
    dcterms:description "Distinguishes live from closed accounts. CAUTION: a closed account may still have historical holdings attached, so filtering on this when joining to client_holdings can drop legitimate historical positions. Be deliberate." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_client_account_map> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "is_active" ;
    meta:sourceSqlType "BOOLEAN" .

ns19:row_hash a owl:DatatypeProperty ;
    dcterms:description "64-bit change-detection fingerprint; samples are 16 lowercase hex chars. Used for change-detecting upsert. Present in all 14 dim_* tables, none of the client_* facts. NEVER join on this." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_client_account_map> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "row_hash" ;
    meta:sourceSqlType "VARCHAR" .

ns19:source_load_ts a owl:DatatypeProperty ;
    dcterms:description "ETL load timestamp, WITHOUT TIME ZONE - no timezone is recorded anywhere, so IST vs UTC is a convention held outside the DB. Present in 12 of 14 dim_* tables; absent from both MF history tables and from all 7 client_* facts." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_client_account_map> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "source_load_ts" ;
    meta:sourceSqlType "TIMESTAMP" .

ns19:source_table a owl:DatatypeProperty ;
    dcterms:description "Lineage: name of the ORIGIN object in the SOURCE system, not this table. Proven by dim_client_master rows carrying 'clients'. Present in all 21 tables. NEVER join or filter business logic on this." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_client_account_map> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "source_table" ;
    meta:sourceSqlType "VARCHAR" .

ns19:wsw_account_code a owl:DatatypeProperty ;
    dcterms:description "-> client_holdings.wsw_account_code. THE ONLY account key reachable from a fact table, so this is the one to join on. Unique in this data (47 distinct codes on 47 rows). Of the 505 holdings, 174 match a code here with the same client_id, 210 match a code whose row names a DIFFERENT client_id, and 121 carry a code absent from this table. A code match is a source-record match, not validated client ownership - reproduce each query's own join condition exactly (see client_holdings.wsw_account_code)." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_client_account_map> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "wsw_account_code" ;
    meta:sourceSqlType "INTEGER" .

ns16:acquiring_banker_id a owl:DatatypeProperty ;
    dcterms:description "-> dim_employee_profile.id. The banker who originally WON the client (new-business incentives). Samples show this is frequently a DIFFERENT person from the servicing banker. This table therefore has TWO independent paths to dim_employee_profile - any query needing both names must join that table TWICE with distinct aliases. Joining once and hoping is a common silent error." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_client_master> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "acquiring_banker_id" ;
    meta:sourceSqlType "INTEGER" .

ns16:acquiring_banker_name a owl:DatatypeProperty ;
    dcterms:description "Denormalised banker name." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_client_master> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "acquiring_banker_name" ;
    meta:sourceSqlType "VARCHAR" .

ns16:client_name a owl:DatatypeProperty ;
    dcterms:description "Full client name. PII." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_client_master> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "client_name" ;
    meta:sourceSqlType "VARCHAR" .

ns16:current_city a owl:DatatypeProperty ;
    dcterms:description "NOT in the DDL - present in the CSV delivery. The client's current city, as free text. Populated on all 30 rows; observed values: Ahmedabad (7), Bengaluru (6), Delhi (6), Goa (6), Mumbai (5). Not a foreign key - there is no city or geography dimension. Personal data (location): treat as PII." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_client_master> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "current_city" ;
    meta:sourceSqlType "VARCHAR" .

ns16:dob a owl:DatatypeProperty ;
    dcterms:description "Date of birth, populated for INDIVIDUALS. PII. See date_of_incorporation - there is no entity_type column, so client type must be inferred from which of the two dates is populated." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_client_master> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "dob" ;
    meta:sourceSqlType "DATE" .

ns16:family_id a owl:DatatypeProperty ;
    dcterms:description "Family rollup, nested BELOW group. Samples: 9001 = Krishnan Family (6 clients), 9002 = Mehra Family (4 clients). No dim_family table exists. For a wealth business where family-office consolidated reporting is a core product, this is a notable structural gap." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_client_master> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "family_id" ;
    meta:sourceSqlType "INTEGER" .

ns16:family_name a owl:DatatypeProperty ;
    dcterms:description "Denormalised family label. No backing dimension." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_client_master> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "family_name" ;
    meta:sourceSqlType "VARCHAR" .

ns16:gender a owl:DatatypeProperty ;
    dcterms:description "Values seen in samples: Male, Female. Not an exhaustive enumeration. PII." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_client_master> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "gender" ;
    meta:sourceSqlType "VARCHAR" .

ns16:group_id a owl:DatatypeProperty ;
    dcterms:description "Top rollup level. Sample: 900 = 'Group 900', covering all ten sample clients. No dim_group table exists anywhere in the 21 tables - group rollups are only possible by grouping on these denormalised columns, and the names cannot be validated." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_client_master> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "group_id" ;
    meta:sourceSqlType "INTEGER" .

ns16:group_name a owl:DatatypeProperty ;
    dcterms:description "Denormalised group label. No backing dimension." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_client_master> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "group_name" ;
    meta:sourceSqlType "VARCHAR" .

ns16:id a owl:DatatypeProperty ;
    dcterms:description "The client surrogate key and the hub of the entire model - every fact's client_id points here. NULLABLE, so the hub table of the model has NO valid primary key as declared. The most significant structural defect in the schema. Sample range 7001-7010." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_client_master> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "id" ;
    meta:sourceSqlType "INTEGER" .

ns16:is_active a owl:DatatypeProperty ;
    dcterms:description "Soft-delete pair, part 1. Plausibly means dormant/closed. Nullable and therefore THREE-VALUED - 'WHERE is_active' silently drops NULL rows. Use COALESCE(is_active, TRUE) = TRUE." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_client_master> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "is_active" ;
    meta:sourceSqlType "BOOLEAN" .

ns16:is_deleted a owl:DatatypeProperty ;
    dcterms:description "Soft-delete pair, part 2. Logically removed. The schema documentation does not forbid the contradictory combination is_active = TRUE AND is_deleted = TRUE. Use COALESCE(is_deleted, FALSE) = FALSE." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_client_master> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "is_deleted" ;
    meta:sourceSqlType "BOOLEAN" .

ns16:kyc_status a owl:DatatypeProperty ;
    dcterms:description "Only the compliant value 'KYC Compliant' occurs in this data (all 30 clients). A production feed would also carry pending and non-compliant states." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_client_master> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "kyc_status" ;
    meta:sourceSqlType "VARCHAR" .

ns16:lob_id a owl:DatatypeProperty ;
    dcterms:description "-> dim_lob_hierarchy.lob_id (LOB level). Sample: 1 = 'Neo Wealth Advisory'." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_client_master> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "lob_id" ;
    meta:sourceSqlType "INTEGER" .

ns16:lob_name a owl:DatatypeProperty ;
    dcterms:description "Denormalised LOB label." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_client_master> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "lob_name" ;
    meta:sourceSqlType "VARCHAR" .

ns16:marital_status a owl:DatatypeProperty ;
    dcterms:description "Values seen: Married, Single, Widowed. Not exhaustive. PII." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_client_master> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "marital_status" ;
    meta:sourceSqlType "VARCHAR" .

ns16:occupation a owl:DatatypeProperty ;
    dcterms:description "Values seen: Business, Homemaker, Professional, Salaried, Retired. Not exhaustive." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_client_master> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "occupation" ;
    meta:sourceSqlType "VARCHAR" .

ns16:pan_number a owl:DatatypeProperty ;
    dcterms:description "Indian Permanent Account Number, the real-world tax identifier. Samples are synthetic (ABCPK1001A, DEFPM2001G). Declared varchar(256) carries NO validation value - the real PAN format is 10 chars; enforcement lives nowhere in this schema. SENSITIVE PII under India's DPDP Act; mask outside production." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_client_master> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "pan_number" ;
    meta:sourceSqlType "VARCHAR" .

ns16:pep_status a owl:DatatypeProperty ;
    dcterms:description "Politically Exposed Person - a mandatory AML/KYC risk classification. Sample value 'Non-PEP'. Typed varchar not boolean, so it can express intermediate states such as 'Related to PEP'." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_client_master> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "pep_status" ;
    meta:sourceSqlType "VARCHAR" .

ns16:row_hash a owl:DatatypeProperty ;
    dcterms:description "64-bit change-detection fingerprint; samples are 16 lowercase hex chars. Used for change-detecting upsert. Present in all 14 dim_* tables, none of the client_* facts. NEVER join on this." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_client_master> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "row_hash" ;
    meta:sourceSqlType "VARCHAR" .

ns16:servicing_banker_1_id a owl:DatatypeProperty ;
    dcterms:description "-> dim_employee_profile.id. The banker who MANAGES the client now (ongoing service and trail incentives). The '_1' suffix implies a _2, _3 ... that DO NOT EXIST, so full coverage-team reporting is impossible from this table." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_client_master> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "servicing_banker_1_id" ;
    meta:sourceSqlType "INTEGER" .

ns16:servicing_banker_name a owl:DatatypeProperty ;
    dcterms:description "Denormalised banker name." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_client_master> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "servicing_banker_name" ;
    meta:sourceSqlType "VARCHAR" .

ns16:source_load_ts a owl:DatatypeProperty ;
    dcterms:description "ETL load timestamp, WITHOUT TIME ZONE - no timezone is recorded anywhere, so IST vs UTC is a convention held outside the DB. Present in 12 of 14 dim_* tables; absent from both MF history tables and from all 7 client_* facts." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_client_master> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "source_load_ts" ;
    meta:sourceSqlType "TIMESTAMP" .

ns16:source_table a owl:DatatypeProperty ;
    dcterms:description "Lineage: name of the ORIGIN object in the SOURCE system, not this table. Proven by dim_client_master rows carrying 'clients'. Present in all 21 tables. NEVER join or filter business logic on this." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_client_master> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "source_table" ;
    meta:sourceSqlType "VARCHAR" .

ns16:sub_lob_id a owl:DatatypeProperty ;
    dcterms:description "-> dim_lob_hierarchy.sub_lob_id (leaf level). Samples: 10 = Private Wealth, 11 = Family Office. NAMING TRAP: dim_employee_profile spells the same concept 'sublob_id' with no underscore - you CANNOT write USING (sub_lob_id) against that table." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_client_master> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "sub_lob_id" ;
    meta:sourceSqlType "INTEGER" .

ns16:sub_lob_name a owl:DatatypeProperty ;
    dcterms:description "Denormalised sub-LOB label." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_client_master> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "sub_lob_name" ;
    meta:sourceSqlType "VARCHAR" .

ns16:tier a owl:DatatypeProperty ;
    dcterms:description "Wealth segmentation. Values seen: 'Ultra HNI', 'HNI', 'Affluent', 'Retail'. These form an ordered ladder, but the ordering is a business convention - there is NO lookup table and NO numeric rank column, so any sort by tier needs an explicit CASE expression. Type-1 overwrite: a client's historical tier is NOT retained anywhere." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_client_master> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "tier" ;
    meta:sourceSqlType "VARCHAR" .

ns10:bse_code a owl:DatatypeProperty ;
    dcterms:description "BSE scrip code, e.g. 500325. NAMING TRAP: dim_product_unified_cat calls the identical concept 'bse_symbol' - same integer type, two names. A company may list on one or both exchanges, so either code may be NULL." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_cmot_company_mstr> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "bse_code" ;
    meta:sourceSqlType "INTEGER" .

ns10:bse_group a owl:DatatypeProperty ;
    dcterms:description "BSE liquidity/surveillance classification (A, B, T, Z ...). The Z and T groups flag restricted or surveillance-listed scrips, so this column has real risk-monitoring value. Every one of the 25 companies in this data is in group A; no B, T or Z scrip occurs." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_cmot_company_mstr> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "bse_group" ;
    meta:sourceSqlType "VARCHAR" .

ns10:co_code a owl:DatatypeProperty ;
    dcterms:description "The vendor's internal COMPANY key and the join hub for the equity tables. WARNING: dim_cmot_index_prices reuses this same column name for an INDEX. Never join the two tables on co_code - such a join compiles, returns rows, and is entirely meaningless." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_cmot_company_mstr> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "co_code" ;
    meta:sourceSqlType "INTEGER" .

ns10:company_name a owl:DatatypeProperty ;
    dcterms:description "Full legal name, e.g. 'Bharat Electronics Ltd', 'Larsen & Toubro Ltd'." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_cmot_company_mstr> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "company_name" ;
    meta:sourceSqlType "VARCHAR" .

ns10:company_short_name a owl:DatatypeProperty ;
    dcterms:description "Display abbreviation." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_cmot_company_mstr> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "company_short_name" ;
    meta:sourceSqlType "VARCHAR" .

ns10:is_active a owl:DatatypeProperty ;
    dcterms:description "No is_deleted here. A delisted company would be marked is_active = FALSE rather than removed, which is correct since historical holdings still reference it." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_cmot_company_mstr> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "is_active" ;
    meta:sourceSqlType "BOOLEAN" .

ns10:isin a owl:DatatypeProperty ;
    dcterms:description "Equity ISIN (INE prefix)." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_cmot_company_mstr> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "isin" ;
    meta:sourceSqlType "VARCHAR" .

ns10:mcap_type a owl:DatatypeProperty ;
    dcterms:description "Market-capitalisation band (Large/Mid/Small Cap) per SEBI's ranked definition. STORED AS A SINGLE CURRENT VALUE WITH NO EFFECTIVE DATE, yet SEBI reclassifies the universe every six months. Historical style analysis using this column applies TODAY's classification to PAST holdings - a subtle but real point-in-time error the schema has no mechanism to fix. Observed values (25 rows): Large Cap (20), Mid Cap (4), Small Cap (1)." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_cmot_company_mstr> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "mcap_type" ;
    meta:sourceSqlType "VARCHAR" .

ns10:nse_symbol a owl:DatatypeProperty ;
    dcterms:description "NSE ticker, e.g. RELIANCE." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_cmot_company_mstr> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "nse_symbol" ;
    meta:sourceSqlType "VARCHAR" .

ns10:row_hash a owl:DatatypeProperty ;
    dcterms:description "64-bit change-detection fingerprint; samples are 16 lowercase hex chars. Used for change-detecting upsert. Present in all 14 dim_* tables, none of the client_* facts. NEVER join on this." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_cmot_company_mstr> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "row_hash" ;
    meta:sourceSqlType "VARCHAR" .

ns10:sector_code a owl:DatatypeProperty ;
    dcterms:description "Sector classification code - the basis for concentration and diversification reporting. No dim_sector table exists." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_cmot_company_mstr> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "sector_code" ;
    meta:sourceSqlType "VARCHAR" .

ns10:sector_name a owl:DatatypeProperty ;
    dcterms:description "Sector name. NAMING TRAP: dim_product_unified_cat stores the same concept as a bare 'sector' column with no code." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_cmot_company_mstr> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "sector_name" ;
    meta:sourceSqlType "VARCHAR" .

ns10:source_load_ts a owl:DatatypeProperty ;
    dcterms:description "ETL load timestamp, WITHOUT TIME ZONE - no timezone is recorded anywhere, so IST vs UTC is a convention held outside the DB. Present in 12 of 14 dim_* tables; absent from both MF history tables and from all 7 client_* facts." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_cmot_company_mstr> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "source_load_ts" ;
