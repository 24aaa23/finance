<https://wealth.example.org/neowealth/declared-attribute/main/dim_mf_nav_history/nav_date> a meta:DeclaredAttribute ;
    meta:rawYaml """attribute_type: time_dimension
description: 'WATCH FOR GAPS: nothing guarantees a row for every fund on every trading
  day. Weekends and market holidays are absent by design; a genuine data gap looks
  IDENTICAL. With no dim_date you cannot distinguish ''market closed'' from ''data
  missing''. Compute returns with LAG(nav_value) OVER (PARTITION BY mstar_id ORDER
  BY nav_date) rather than assuming a fixed calendar offset.'
display_name: NAV Date
filterable: true
name: nav_date
nullable: true
sql_type: date
type: date
""" .

<https://wealth.example.org/neowealth/declared-attribute/main/dim_mf_nav_history/nav_value> a meta:DeclaredAttribute ;
    meta:rawYaml """attribute_type: fact
description: 'A SINGLE price point per day - no open/high/low. Correct for mutual
  funds, which strike ONE NAV per day after close. Consequence: intraday ranges and
  high/low volatility CANNOT be computed for funds, only close-to-close returns. Should
  reconcile to client_holdings.current_price for a fund holding on the same date.'
display_name: NAV Value
filterable: true
name: nav_value
nullable: true
sql_type: real
type: float
""" .

