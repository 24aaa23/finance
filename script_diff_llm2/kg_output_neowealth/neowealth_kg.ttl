    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "sub_category" ;
    meta:sourceSqlType "VARCHAR" .

ns3:category a owl:DatatypeProperty ;
    dcterms:description "Denormalised onto every daily row." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_mf_nav_history> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "category" ;
    meta:sourceSqlType "VARCHAR" .

ns3:fund_name a owl:DatatypeProperty ;
    dcterms:description "Denormalised onto every daily row. Deliberate: on a columnar warehouse these low-cardinality repeated strings compress extremely well, and it lets a NAV chart be drawn without joining the fund master." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_mf_nav_history> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "fund_name" ;
    meta:sourceSqlType "VARCHAR" .

ns3:isin a owl:DatatypeProperty ;
    dcterms:description "Alternative grain key: (isin, nav_date)." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_mf_nav_history> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "isin" ;
    meta:sourceSqlType "VARCHAR" .

ns3:mstar_id a owl:DatatypeProperty ;
    dcterms:description "Part of the grain: (mstar_id, nav_date). -> dim_mf_fund_complete.mstar_id." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_mf_nav_history> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "mstar_id" ;
    meta:sourceSqlType "VARCHAR" .

ns3:nav_currency a owl:DatatypeProperty ;
    dcterms:description "Implies multi-currency capability (offshore/feeder funds). Overwhelmingly INR for an India-domiciled book. Nullable with NO default, so a NULL currency is indistinguishable from INR - any cross-currency aggregation must handle that explicitly." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_mf_nav_history> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "nav_currency" ;
    meta:sourceSqlType "VARCHAR" .

ns3:nav_date a owl:DatatypeProperty ;
    dcterms:description "WATCH FOR GAPS: nothing guarantees a row for every fund on every trading day. Weekends and market holidays are absent by design; a genuine data gap looks IDENTICAL. With no dim_date you cannot distinguish 'market closed' from 'data missing'. Compute returns with LAG(nav_value) OVER (PARTITION BY mstar_id ORDER BY nav_date) rather than assuming a fixed calendar offset." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_mf_nav_history> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "nav_date" ;
    meta:sourceSqlType "DATE" .

ns3:nav_value a owl:DatatypeProperty ;
    dcterms:description "A SINGLE price point per day - no open/high/low. Correct for mutual funds, which strike ONE NAV per day after close. Consequence: intraday ranges and high/low volatility CANNOT be computed for funds, only close-to-close returns. Should reconcile to client_holdings.current_price for a fund holding on the same date." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_mf_nav_history> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "nav_value" ;
    meta:sourceSqlType "FLOAT" .

ns3:row_hash a owl:DatatypeProperty ;
    dcterms:description "64-bit change-detection fingerprint; samples are 16 lowercase hex chars. Used for change-detecting upsert. Present in all 14 dim_* tables, none of the client_* facts. NEVER join on this." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_mf_nav_history> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "row_hash" ;
    meta:sourceSqlType "VARCHAR" .

ns3:source_table a owl:DatatypeProperty ;
    dcterms:description "Lineage: name of the ORIGIN object in the SOURCE system, not this table. Proven by dim_client_master rows carrying 'clients'. Present in all 21 tables. NEVER join or filter business logic on this." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_mf_nav_history> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "source_table" ;
    meta:sourceSqlType "VARCHAR" .

ns11:category a owl:DatatypeProperty ;
    dcterms:description "Denormalised onto every row." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_mf_returns_history> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "category" ;
    meta:sourceSqlType "VARCHAR" .

ns11:fund_id a owl:DatatypeProperty ;
    dcterms:description "Carried here but NOT in dim_mf_nav_history - a small inconsistency between the two history tables." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_mf_returns_history> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "fund_id" ;
    meta:sourceSqlType "INTEGER" .

ns11:fund_name a owl:DatatypeProperty ;
    dcterms:description "Denormalised onto every row." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_mf_returns_history> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "fund_name" ;
    meta:sourceSqlType "VARCHAR" .

ns11:isin a owl:DatatypeProperty ;
    dcterms:description "Alternative grain key." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_mf_returns_history> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "isin" ;
    meta:sourceSqlType "VARCHAR" .

ns11:mstar_id a owl:DatatypeProperty ;
    dcterms:description "Part of the grain: (mstar_id, return_date)." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_mf_returns_history> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "mstar_id" ;
    meta:sourceSqlType "VARCHAR" .

ns11:return_1m a owl:DatatypeProperty ;
    dcterms:description "TYPE DEFECT: character varying(256) while return_3y/5y/10y in this same table are proper real. AVG() fails; ORDER BY sorts lexicographically so '9.5' ranks ABOVE '12.3' and any top-performing-funds ranking built naively on it is SILENTLY AND COMPLETELY WRONG. A bare cast will THROW on the first sentinel value. Use the regex-guarded CASE." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_mf_returns_history> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "return_1m" ;
    meta:sourceSqlType "VARCHAR" .

ns11:return_1y a owl:DatatypeProperty ;
    dcterms:description "TYPE DEFECT: character varying(256). See return_1m. Because it is text the UNIT is unverifiable - whether '31.56' means 31.56% or 0.3156 cannot be determined from the schema. The analogous client_holdings.unrealized_gain_pct samples use whole percent, so the same convention is inferred." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_mf_returns_history> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "return_1y" ;
    meta:sourceSqlType "VARCHAR" .

ns11:return_3m a owl:DatatypeProperty ;
    dcterms:description "TYPE DEFECT: character varying(256). See return_1m." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_mf_returns_history> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "return_3m" ;
    meta:sourceSqlType "VARCHAR" .

ns11:return_3y a owl:DatatypeProperty ;
    dcterms:description "Properly typed real. Multi-year horizons are CONVENTIONALLY annualised (CAGR) while sub-1-year figures are absolute - but the schema documentation does NOT state this, and getting it backwards changes a 3-year number by roughly a factor of three. Confirm with the data vendor before publishing." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_mf_returns_history> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "return_3y" ;
    meta:sourceSqlType "FLOAT" .

ns11:return_6m a owl:DatatypeProperty ;
    dcterms:description "TYPE DEFECT: character varying(256). See return_1m." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_mf_returns_history> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "return_6m" ;
    meta:sourceSqlType "VARCHAR" .

ns11:return_date a owl:DatatypeProperty ;
    dcterms:description "The as-of date. One row holds the FULL trailing-return vector as of this date." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_mf_returns_history> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "return_date" ;
    meta:sourceSqlType "DATE" .

ns11:row_hash a owl:DatatypeProperty ;
    dcterms:description "64-bit change-detection fingerprint; samples are 16 lowercase hex chars. Used for change-detecting upsert. Present in all 14 dim_* tables, none of the client_* facts. NEVER join on this." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_mf_returns_history> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "row_hash" ;
    meta:sourceSqlType "VARCHAR" .

ns11:source_table a owl:DatatypeProperty ;
    dcterms:description "Lineage: name of the ORIGIN object in the SOURCE system, not this table. Proven by dim_client_master rows carrying 'clients'. Present in all 21 tables. NEVER join or filter business logic on this." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_mf_returns_history> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "source_table" ;
    meta:sourceSqlType "VARCHAR" .

ns21:credit_rating a owl:DatatypeProperty ;
    dcterms:description "The CONSOLIDATED headline rating chosen from the agency columns. The schema documentation does NOT state the selection rule (lowest/most conservative, or the primary agency's). Do not assume - the choice directly affects risk reporting. This table is the source of record; the unified catalogue holds a cached copy." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_product_credit_rtng> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "credit_rating" ;
    meta:sourceSqlType "VARCHAR" .

ns21:credit_rating_agency a owl:DatatypeProperty ;
    dcterms:description "Which agency the consolidated credit_rating came from." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_product_credit_rtng> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "credit_rating_agency" ;
    meta:sourceSqlType "VARCHAR" .

ns21:crisil_rating a owl:DatatypeProperty ;
    dcterms:description "CRISIL grade (S&P affiliate; largest Indian CRA). Note CRISIL writes 'CRISIL AAA'." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_product_credit_rtng> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "crisil_rating" ;
    meta:sourceSqlType "VARCHAR" .

ns21:face_value a owl:DatatypeProperty ;
    dcterms:description "Typed integer - adequate for standard 100 / 1,000 / 100,000 denominations but cannot represent a fractional face value." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_product_credit_rtng> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "face_value" ;
    meta:sourceSqlType "INTEGER" .

ns21:instrument_name a owl:DatatypeProperty ;
    dcterms:description "Duplicated in dim_product_unified_cat." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_product_credit_rtng> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "instrument_name" ;
    meta:sourceSqlType "VARCHAR" .

ns21:interest_rate a owl:DatatypeProperty ;
    dcterms:description "Coupon rate." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_product_credit_rtng> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "interest_rate" ;
    meta:sourceSqlType "FLOAT" .

ns21:isin a owl:DatatypeProperty ;
    dcterms:description "Intended instrument identifier - one row per fixed-income instrument; equity and equity MF have no place here. It is NOT a key in this data - NOT UNIQUE: 15 rows, 12 distinct real ISINs, and the literal text 'N/A' on 3 rows (scheme_master_id 40011, 40012, 40014). scheme_master_id is unique on all 15 rows - prefer it to join to the catalogue (matches all rows), and use isin only as a fallback. Whether 'N/A' is literal source text or an export marker for a missing value is not stated by the source; it is kept as the text 'N/A' - never silently replaced with NULL, blank or another default (IS NULL and = 'N/A' select different rows). It matches no product ISIN, so those 3 rows drop out of any ISIN join." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_product_credit_rtng> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "isin" ;
    meta:sourceSqlType "VARCHAR" .

ns21:maturity_date a owl:DatatypeProperty ;
    dcterms:description "Enables duration and maturity-bucket analysis. This table has NO is_active flag, so a matured bond stays in it indefinitely with no status column - use maturity_date < CURRENT_DATE to identify matured instruments." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_product_credit_rtng> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "maturity_date" ;
    meta:sourceSqlType "DATE" .

ns21:row_hash a owl:DatatypeProperty ;
    dcterms:description "64-bit change-detection fingerprint; samples are 16 lowercase hex chars. Used for change-detecting upsert. Present in all 14 dim_* tables, none of the client_* facts. NEVER join on this." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_product_credit_rtng> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "row_hash" ;
    meta:sourceSqlType "VARCHAR" .

ns21:scheme_master_id a owl:DatatypeProperty ;
    dcterms:description "-> dim_product_unified_cat.scheme_master_id. The PREFERRED join to the catalogue: it matches every row, whereas 3 rows have isin = 'N/A' and so miss on an isin join." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_product_credit_rtng> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "scheme_master_id" ;
    meta:sourceSqlType "INTEGER" .

ns21:source_load_ts a owl:DatatypeProperty ;
    dcterms:description "ETL load timestamp, WITHOUT TIME ZONE - no timezone is recorded anywhere, so IST vs UTC is a convention held outside the DB. Present in 12 of 14 dim_* tables; absent from both MF history tables and from all 7 client_* facts." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_product_credit_rtng> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "source_load_ts" ;
    meta:sourceSqlType "TIMESTAMP" .

ns21:source_table a owl:DatatypeProperty ;
    dcterms:description "Lineage: name of the ORIGIN object in the SOURCE system, not this table. Proven by dim_client_master rows carrying 'clients'. Present in all 21 tables. NEVER join or filter business logic on this." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_product_credit_rtng> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "source_table" ;
    meta:sourceSqlType "VARCHAR" .

ns13:id a owl:DatatypeProperty ;
    dcterms:description "Nullable surrogate." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_product_segment_map> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "id" ;
    meta:sourceSqlType "INTEGER" .

ns13:is_active a owl:DatatypeProperty ;
    dcterms:description "Lets an assignment be retired without deleting the row. There is NO effective-date pair, so the HISTORY of segment assignment is not retained - only the current state plus this flag." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_product_segment_map> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "is_active" ;
    meta:sourceSqlType "BOOLEAN" .

ns13:product_id a owl:DatatypeProperty ;
    dcterms:description "-> dim_product_unified_cat.product_id. BRIDGE - a join to a fact table on product_id multiplies the fact rows if a product has multiple segment assignments: a holding worth 1,000,000 in three segments would become three rows totalling 3,000,000. In this data every product_id appears exactly once (25 rows, 25 products, all Direct Equity), so there is at most one segment match per product. Preserve all assignments when reproducing SQL results; do not deduplicate the bridge automatically, and do not infer that future exports carry only one segment per product." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_product_segment_map> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "product_id" ;
    meta:sourceSqlType "VARCHAR" .

ns13:row_hash a owl:DatatypeProperty ;
    dcterms:description "64-bit change-detection fingerprint; samples are 16 lowercase hex chars. Used for change-detecting upsert. Present in all 14 dim_* tables, none of the client_* facts. NEVER join on this." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_product_segment_map> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "row_hash" ;
    meta:sourceSqlType "VARCHAR" .

ns13:segment_id a owl:DatatypeProperty ;
    dcterms:description "No dim_segment table exists - another ID/name pair with no backing dimension. 13 distinct IDs (601-613) for only 10 distinct names: three names carry two IDs each - 'Information Technology' 601 and 612, 'Energy' 602 and 610, 'Banking & Financial Services' 603 and 608. Every ID maps to one name. So COUNT(DISTINCT segment_id) = 13 while COUNT(DISTINCT segment_name) = 10; use whichever field the question or query names, exactly as supplied. Do not merge IDs or invent a replacement ID." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_product_segment_map> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "segment_id" ;
    meta:sourceSqlType "INTEGER" .

ns13:segment_name a owl:DatatypeProperty ;
    dcterms:description "Supplied values (10 distinct): Automobiles & Ancillaries, Banking & Financial Services, Consumer & Retail, Defence & Aerospace, Diversified Conglomerates, Energy, Healthcare & Pharma, Information Technology, Infrastructure & Construction, Telecom & Media. NOT unique per segment: the 10 names are spread across 13 segment_ids, so grouping by segment groups on segment_id with segment_name; a plain list of names returns 10. The labels look like an industry grouping, but they are NOT the same values as dim_cmot_company_mstr.sector_name or dim_product_unified_cat.sector (e.g. segment 'Information Technology' vs sector 'IT - Software' / 'Electronics'), and the source gives no definition. Whether a segment is the same classification as sector or a separate grouping must be confirmed with the data team. Keep segment_name as supplied; never present segments as sectors or merge Segment and Sector into one category on label similarity." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_product_segment_map> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "segment_name" ;
    meta:sourceSqlType "VARCHAR" .

ns13:source_load_ts a owl:DatatypeProperty ;
    dcterms:description "ETL load timestamp, WITHOUT TIME ZONE - no timezone is recorded anywhere, so IST vs UTC is a convention held outside the DB. Present in 12 of 14 dim_* tables; absent from both MF history tables and from all 7 client_* facts." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_product_segment_map> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "source_load_ts" ;
    meta:sourceSqlType "TIMESTAMP" .

ns13:source_table a owl:DatatypeProperty ;
    dcterms:description "Lineage: name of the ORIGIN object in the SOURCE system, not this table. Proven by dim_client_master rows carrying 'clients'. Present in all 21 tables. NEVER join or filter business logic on this." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_product_segment_map> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "source_table" ;
    meta:sourceSqlType "VARCHAR" .

ns9:asset_class a owl:DatatypeProperty ;
    dcterms:description "Level 1 asset classification name." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_product_unified_cat> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "asset_class" ;
    meta:sourceSqlType "VARCHAR" .

ns9:asset_class_id a owl:DatatypeProperty ;
    dcterms:description "Level 1 asset classification. No dim_asset_class table exists - the hierarchy lives only as denormalised columns and cannot be validated or extended." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_product_unified_cat> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "asset_class_id" ;
    meta:sourceSqlType "INTEGER" .

ns9:benchmark a owl:DatatypeProperty ;
    dcterms:description "Intended link to dim_cmot_index_prices.index_name by FREE-TEXT MATCH - which, by exact match, finds nothing in this data (see below). NAMING TRAP: dim_mf_fund_complete calls the same concept 'benchmark_name'. There is NO index_id anywhere, so a spelling variation ('Nifty 50' vs 'NIFTY 50' vs 'Nifty 50 TRI') breaks the link SILENTLY, yielding no benchmark rather than an error. Populated on all 98 rows with 4 values: 'Nifty 50 TRI' (39), 'Nifty 500 TRI' (30), 'Nifty 10 yr Benchmark G-Sec Index' (28), 'Nasdaq 100 TRI' (1). NONE equals an index_name exactly (0 of 98): the TRI labels name total-return series while the price table holds price series ('Nifty 50'), the G-Sec label is spelled differently from 'Nifty 10yr G-sec', and Nasdaq 100 has no series at all. For the 30 funds it differs from dim_mf_fund_complete.benchmark_name on 19. Preserve each label and its unmatched status in stored data and the KG - never strip ' TRI' or store an alias. The ' TRI' strip in 01_domain_and_business_rules.md §3.8 is a QUERY-TIME house rule only, which an equivalent KG query must reproduce exactly as the SQL does. A verified mapping or matching series would be a separate enrichment." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_product_unified_cat> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "benchmark" ;
    meta:sourceSqlType "VARCHAR" .

ns9:company_name a owl:DatatypeProperty ;
    dcterms:description "The issuer; meaningful for equity." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_product_unified_cat> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "company_name" ;
    meta:sourceSqlType "VARCHAR" .

ns9:display_name a owl:DatatypeProperty ;
    dcterms:description "The UI-facing label. The schema documentation does not define how it differs from instrument_name." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_product_unified_cat> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "display_name" ;
    meta:sourceSqlType "VARCHAR" .

ns9:instrument_name a owl:DatatypeProperty ;
    dcterms:description "The formal instrument name - the one the fact tables denormalise. One of three overlapping name columns here." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_product_unified_cat> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "instrument_name" ;
    meta:sourceSqlType "VARCHAR" .

ns9:is_active a owl:DatatypeProperty ;
    dcterms:description "Nullable three-valued flag." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_product_unified_cat> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "is_active" ;
    meta:sourceSqlType "BOOLEAN" .

ns9:is_deleted a owl:DatatypeProperty ;
    dcterms:description "Nullable three-valued flag." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_product_unified_cat> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "is_deleted" ;
    meta:sourceSqlType "BOOLEAN" .

ns9:is_etf a owl:DatatypeProperty ;
    dcterms:description "Boolean, nullable and three-valued." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_product_unified_cat> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "is_etf" ;
    meta:sourceSqlType "BOOLEAN" .

ns9:is_listed a owl:DatatypeProperty ;
    dcterms:description "Declared character varying(256): a text field, unlike its neighbours is_etf, is_active and is_deleted, which are booleans. Observed values: 'Listed' (72 rows) and 'Unlisted' (26 rows); no blanks. Filter on the text (is_listed = 'Listed'); a bare 'WHERE is_listed' does not apply to a text column. The is_ prefix does not make it a Boolean - keep the string datatype and the original values." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_product_unified_cat> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "is_listed" ;
    meta:sourceSqlType "VARCHAR" .

ns9:product_id a owl:DatatypeProperty ;
    dcterms:description "THE UNIVERSAL PRODUCT KEY and the reason this table exists - it gives every investable instrument one key regardless of asset class. Referenced by 5 fact tables plus dim_product_segment_map. Format is type-prefixed and human-readable (PROD_EQ_001, PROD_MF_010), but filter on product_type rather than parsing the string." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_product_unified_cat> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "product_id" ;
    meta:sourceSqlType "VARCHAR" .

ns9:product_short_code a owl:DatatypeProperty ;
    dcterms:description "Internal short code." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_product_unified_cat> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "product_short_code" ;
    meta:sourceSqlType "VARCHAR" .

ns9:product_type a owl:DatatypeProperty ;
    dcterms:description "THE ROUTING DISCRIMINATOR that decides which specialist dimension is valid to join onward to. Observed values (98 rows): Mutual Funds (30), Direct Equity (25), Bonds (15), Fixed Deposits (10), AIF (8), PMS (5), REITs (3), InvITs (2) - the fixed-income types the schema documentation samples omitted are present." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_product_unified_cat> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "product_type" ;
    meta:sourceSqlType "VARCHAR" .

ns9:row_hash a owl:DatatypeProperty ;
    dcterms:description "64-bit change-detection fingerprint; samples are 16 lowercase hex chars. Used for change-detecting upsert. Present in all 14 dim_* tables, none of the client_* facts. NEVER join on this." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_product_unified_cat> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "row_hash" ;
    meta:sourceSqlType "VARCHAR" .

ns9:scheme_master_id a owl:DatatypeProperty ;
    dcterms:description "Internal scheme surrogate key; also present in dim_product_credit_rtng. Use this column (not isin) to join to the credit-rating table -- 3 rated instruments have isin = 'N/A' and so are missed by an isin join." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_product_unified_cat> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "scheme_master_id" ;
    meta:sourceSqlType "INTEGER" .

ns9:source_load_ts a owl:DatatypeProperty ;
    dcterms:description "ETL load timestamp, WITHOUT TIME ZONE - no timezone is recorded anywhere, so IST vs UTC is a convention held outside the DB. Present in 12 of 14 dim_* tables; absent from both MF history tables and from all 7 client_* facts." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_product_unified_cat> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "source_load_ts" ;
    meta:sourceSqlType "TIMESTAMP" .

ns9:source_table a owl:DatatypeProperty ;
    dcterms:description "Lineage: name of the ORIGIN object in the SOURCE system, not this table. Proven by dim_client_master rows carrying 'clients'. Present in all 21 tables. NEVER join or filter business logic on this." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_product_unified_cat> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "source_table" ;
    meta:sourceSqlType "VARCHAR" .

