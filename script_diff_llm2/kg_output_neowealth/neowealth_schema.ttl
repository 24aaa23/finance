<https://wealth.example.org/neowealth/column/main/dim_product_unified_cat/product_type> a owl:DatatypeProperty ;
    dcterms:description "THE ROUTING DISCRIMINATOR that decides which specialist dimension is valid to join onward to. Observed values (98 rows): Mutual Funds (30), Direct Equity (25), Bonds (15), Fixed Deposits (10), AIF (8), PMS (5), REITs (3), InvITs (2) - the fixed-income types the schema documentation samples omitted are present." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_product_unified_cat> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "product_type" ;
    meta:sourceSqlType "VARCHAR" .

<https://wealth.example.org/neowealth/column/main/dim_product_unified_cat/row_hash> a owl:DatatypeProperty ;
    dcterms:description "64-bit change-detection fingerprint; samples are 16 lowercase hex chars. Used for change-detecting upsert. Present in all 14 dim_* tables, none of the client_* facts. NEVER join on this." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_product_unified_cat> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "row_hash" ;
    meta:sourceSqlType "VARCHAR" .

<https://wealth.example.org/neowealth/column/main/dim_product_unified_cat/rta_code> a owl:DatatypeProperty ;
