<https://wealth.example.org/neowealth/column/main/dim_cmot_company_mstr/bse_group> a owl:DatatypeProperty ;
    dcterms:description "BSE liquidity/surveillance classification (A, B, T, Z ...). The Z and T groups flag restricted or surveillance-listed scrips, so this column has real risk-monitoring value. Every one of the 25 companies in this data is in group A; no B, T or Z scrip occurs." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_cmot_company_mstr> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "bse_group" ;
