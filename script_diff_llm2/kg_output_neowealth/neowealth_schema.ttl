<https://wealth.example.org/neowealth/column/main/dim_product_segment_map/product_id> a owl:DatatypeProperty ;
    dcterms:description "-> dim_product_unified_cat.product_id. BRIDGE - a join to a fact table on product_id multiplies the fact rows if a product has multiple segment assignments: a holding worth 1,000,000 in three segments would become three rows totalling 3,000,000. In this data every product_id appears exactly once (25 rows, 25 products, all Direct Equity), so there is at most one segment match per product. Preserve all assignments when reproducing SQL results; do not deduplicate the bridge automatically, and do not infer that future exports carry only one segment per product." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_product_segment_map> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "product_id" ;
    meta:sourceSqlType "VARCHAR" .

