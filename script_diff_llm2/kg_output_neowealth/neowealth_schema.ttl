<https://wealth.example.org/neowealth/column/main/dim_mf_fund_complete/asset_alloc_cash_net> a owl:DatatypeProperty ;
    dcterms:description "Look-through cash weight, net. These three cover equity, bond and cash ONLY - there is no other/alternatives bucket, so they need NOT sum to 100%." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_mf_fund_complete> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "asset_alloc_cash_net" ;
