<https://wealth.example.org/neowealth/column/main/client_revenue/revenue_type> a owl:DatatypeProperty ;
    dcterms:description "Uncontrolled varchar(256) with no declared enumeration. Observed values (675 rows, no blanks): Advisory Fee (147), Upfront Commission (145), Trail Commission (135), Transaction Fee (127), Brokerage (121). The recurring-vs-one-off split is usually the most important cut of this table; Advisory Fee and Trail Commission read as recurring and the other three as one-off, but the source does not declare it. Filter on these labels exactly as supplied." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_revenue> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "revenue_type" ;
    meta:sourceSqlType "VARCHAR" .

<https://wealth.example.org/neowealth/column/main/client_revenue/source_table> a owl:DatatypeProperty ;
    dcterms:description "Lineage: name of the ORIGIN object in the SOURCE system, not this table. Proven by dim_client_master rows carrying 'clients'. Present in all 21 tables. NEVER join or filter business logic on this." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_revenue> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "source_table" ;
    meta:sourceSqlType "VARCHAR" .

<https://wealth.example.org/neowealth/column/main/client_transactions/amount> a owl:DatatypeProperty ;
    dcterms:description "The rupee consideration, always stored positive, Redemption rows included. amount ~= units * nav_price holds on all 3,004 rows to within rounding (max relative difference < 0.001%). Direction is carried only by transaction_type, never by the sign of this column: net flow = SUM(CASE WHEN transaction_type='Redemption' THEN -amount ELSE amount END); turnover = SUM(amount) over both directions. Summing amount without a transaction_type filter therefore adds redemptions to purchases." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_transactions> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "amount" ;
    meta:sourceSqlType "DOUBLE" .

