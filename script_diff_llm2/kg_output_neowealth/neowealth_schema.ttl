    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_revenue> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "id" ;
    meta:sourceSqlType "INTEGER" .

<https://wealth.example.org/neowealth/column/main/client_revenue/lob_id> a owl:DatatypeProperty ;
    dcterms:description "-> dim_lob_hierarchy.lob_id, enabling LOB P&L without a detour through the client master. Unlike client_aum, no denormalised lob_name is carried, so labelling always requires the join - and the join must be de-duplicated (see the fan-out hazard)." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_revenue> ;
