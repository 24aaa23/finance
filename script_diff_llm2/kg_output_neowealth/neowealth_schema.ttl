<https://wealth.example.org/neowealth/column/main/dim_product_unified_cat/product_id> a owl:DatatypeProperty ;
    dcterms:description "THE UNIVERSAL PRODUCT KEY and the reason this table exists - it gives every investable instrument one key regardless of asset class. Referenced by 5 fact tables plus dim_product_segment_map. Format is type-prefixed and human-readable (PROD_EQ_001, PROD_MF_010), but filter on product_type rather than parsing the string." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_product_unified_cat> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "product_id" ;
    meta:sourceSqlType "VARCHAR" .

<https://wealth.example.org/neowealth/column/main/dim_product_unified_cat/product_short_code> a owl:DatatypeProperty ;
