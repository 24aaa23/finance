    meta:sourceSqlType "INTEGER" .

<https://wealth.example.org/neowealth/column/main/dim_cmot_index_prices/index_name> a owl:DatatypeProperty ;
    dcterms:description "The safe key for this table, and the target of the two free-text benchmark joins (dim_mf_fund_complete.benchmark_name and dim_product_unified_cat.benchmark). There is NO index_id anywhere in the schema. Also unrecorded: whether these are PRICE or TOTAL RETURN (TRI) indices - a fund's NAV return is net of expenses and includes reinvested dividends, so a fair comparison needs a TRI. Check the actual values for a TRI suffix before publishing any relative-performance figure. Five values, 12 daily rows each (2026-05-04 to 2026-05-19): 'Nifty 50', 'Nifty 500', 'Nifty Midcap 150', 'Nifty Smallcap 250', 'Nifty 10yr G-sec'. None carries a TRI suffix - they are price series - and no benchmark label in dim_mf_fund_complete, dim_product_unified_cat or client_holdings equals any of them exactly. Preserve the names as supplied; the ' TRI' strip (01_domain_and_business_rules.md §3.8) is applied at query time only." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_cmot_index_prices> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "index_name" ;
    meta:sourceSqlType "VARCHAR" .

<https://wealth.example.org/neowealth/column/main/dim_cmot_index_prices/nav_close> a owl:DatatypeProperty ;
    dcterms:description "NOTE THE ORDINAL POSITION: nav_close is column 4, BEFORE nav_open at column 5 - the only place in the schema where OHLC is not in O-H-L-C order. Cosmetic, but SELECT * returns them in a surprising order and a POSITIONAL column mapping downstream would silently swap open and close. ALWAYS SELECT THESE BY NAME." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_cmot_index_prices> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "nav_close" ;
    meta:sourceSqlType "FLOAT" .

<https://wealth.example.org/neowealth/column/main/dim_cmot_index_prices/nav_date> a owl:DatatypeProperty ;
    dcterms:description "Part of the grain: (index_name, nav_date)." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_cmot_index_prices> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "nav_date" ;
    meta:sourceSqlType "DATE" .

<https://wealth.example.org/neowealth/column/main/dim_cmot_index_prices/nav_high> a owl:DatatypeProperty ;
    dcterms:description "Intraday high." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_cmot_index_prices> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "nav_high" ;
    meta:sourceSqlType "FLOAT" .

<https://wealth.example.org/neowealth/column/main/dim_cmot_index_prices/nav_low> a owl:DatatypeProperty ;
    dcterms:description "Intraday low. There is NO nav_volume here - correct, since an index has no traded volume of its own." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_cmot_index_prices> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "nav_low" ;
    meta:sourceSqlType "FLOAT" .

<https://wealth.example.org/neowealth/column/main/dim_cmot_index_prices/nav_open> a owl:DatatypeProperty ;
    dcterms:description "Opening level. See the ordinal warning on nav_close." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_cmot_index_prices> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "nav_open" ;
    meta:sourceSqlType "FLOAT" .

<https://wealth.example.org/neowealth/column/main/dim_cmot_index_prices/row_hash> a owl:DatatypeProperty ;
    dcterms:description "64-bit change-detection fingerprint; samples are 16 lowercase hex chars. Used for change-detecting upsert. Present in all 14 dim_* tables, none of the client_* facts. NEVER join on this." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_cmot_index_prices> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "row_hash" ;
    meta:sourceSqlType "VARCHAR" .

<https://wealth.example.org/neowealth/column/main/dim_cmot_index_prices/source_load_ts> a owl:DatatypeProperty ;
    dcterms:description "ETL load timestamp, WITHOUT TIME ZONE - no timezone is recorded anywhere, so IST vs UTC is a convention held outside the DB. Present in 12 of 14 dim_* tables; absent from both MF history tables and from all 7 client_* facts." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_cmot_index_prices> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "source_load_ts" ;
    meta:sourceSqlType "TIMESTAMP" .

<https://wealth.example.org/neowealth/column/main/dim_cmot_index_prices/source_table> a owl:DatatypeProperty ;
    dcterms:description "Lineage: name of the ORIGIN object in the SOURCE system, not this table. Proven by dim_client_master rows carrying 'clients'. Present in all 21 tables. NEVER join or filter business logic on this." ;
