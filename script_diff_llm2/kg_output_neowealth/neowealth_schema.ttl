<https://wealth.example.org/neowealth/column/main/dim_client_account_map/account_details_id> a owl:DatatypeProperty ;
    dcterms:description "The account's surrogate key in the UPSTREAM source system. There is no dim_account table, so this points at nothing inside the warehouse - a dangling reference useful only for tracing back to the source." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_client_account_map> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "account_details_id" ;
    meta:sourceSqlType "INTEGER" .

<https://wealth.example.org/neowealth/column/main/dim_client_account_map/account_number> a owl:DatatypeProperty ;
    dcterms:description "Bank account number. Populated on all 47 rows. PAYMENT CREDENTIAL - this table warrants stricter access control than dim_client_master. Mask or tokenise in every non-production copy." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_client_account_map> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "account_number" ;
    meta:sourceSqlType "VARCHAR" .

<https://wealth.example.org/neowealth/column/main/dim_client_account_map/account_type> a owl:DatatypeProperty ;
    dcterms:description "Uncontrolled varchar(256) with no declared enumeration. Observed values: Individual (30 rows), HUF (12), Joint (3), NRI (2) - a holder/ownership category, NOT a bank / demat / folio discriminator. It does not tell you which identifier group to read: Individual, HUF and Joint rows carry bank, DP ID and (on some rows) folio identifiers together, and the 2 NRI rows carry bank identifiers only. What account_type classifies is not stated by the source and must be confirmed with the data team. Keep the original label; never derive an account kind from it." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_client_account_map> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "account_type" ;
    meta:sourceSqlType "VARCHAR" .

<https://wealth.example.org/neowealth/column/main/dim_client_account_map/bank_name> a owl:DatatypeProperty ;
    dcterms:description "Part of the banking triple used for settlement, payouts and mandates." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_client_account_map> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "bank_name" ;
    meta:sourceSqlType "VARCHAR" .

<https://wealth.example.org/neowealth/column/main/dim_client_account_map/client_id> a owl:DatatypeProperty ;
    dcterms:description "-> dim_client_master.id. Many-to-one: a client with several accounts has several rows here, so client_id is NOT unique in this table." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_client_account_map> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "client_id" ;
    meta:sourceSqlType "INTEGER" .

<https://wealth.example.org/neowealth/column/main/dim_client_account_map/dp_id> a owl:DatatypeProperty ;
    dcterms:description "Depository Participant ID - part of the NSDL/CDSL demat account identifier for dematerialised securities. Populated on 45 of 47 rows (blank only on the 2 NRI rows), alongside the bank details on the same row - so its presence does not identify a demat-only account. When dp_id is populated is not stated by the source and must be confirmed with the data team (Y1)." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_client_account_map> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "dp_id" ;
    meta:sourceSqlType "VARCHAR" .

<https://wealth.example.org/neowealth/column/main/dim_client_account_map/folio> a owl:DatatypeProperty ;
    dcterms:description "Mutual fund folio number, assigned by the AMC/RTA. Populated on 25 of 47 rows, always alongside dp_id and the bank details on the same row - so its presence does not identify an MF-only account. When folio is populated is not stated by the source and must be confirmed with the data team (Y1)." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_client_account_map> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "folio" ;
    meta:sourceSqlType "VARCHAR" .

<https://wealth.example.org/neowealth/column/main/dim_client_account_map/ifsc_code> a owl:DatatypeProperty ;
    dcterms:description "Indian Financial System Code - pins the specific bank branch. Payment credential; mask outside production." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_client_account_map> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "ifsc_code" ;
    meta:sourceSqlType "VARCHAR" .

<https://wealth.example.org/neowealth/column/main/dim_client_account_map/is_active> a owl:DatatypeProperty ;
    dcterms:description "Distinguishes live from closed accounts. CAUTION: a closed account may still have historical holdings attached, so filtering on this when joining to client_holdings can drop legitimate historical positions. Be deliberate." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_client_account_map> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "is_active" ;
