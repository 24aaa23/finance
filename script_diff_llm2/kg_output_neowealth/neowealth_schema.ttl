<https://wealth.example.org/neowealth/column/main/dim_product_credit_rtng/isin> a owl:DatatypeProperty ;
    dcterms:description "Intended instrument identifier - one row per fixed-income instrument; equity and equity MF have no place here. It is NOT a key in this data - NOT UNIQUE: 15 rows, 12 distinct real ISINs, and the literal text 'N/A' on 3 rows (scheme_master_id 40011, 40012, 40014). scheme_master_id is unique on all 15 rows - prefer it to join to the catalogue (matches all rows), and use isin only as a fallback. Whether 'N/A' is literal source text or an export marker for a missing value is not stated by the source; it is kept as the text 'N/A' - never silently replaced with NULL, blank or another default (IS NULL and = 'N/A' select different rows). It matches no product ISIN, so those 3 rows drop out of any ISIN join." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_product_credit_rtng> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "isin" ;
    meta:sourceSqlType "VARCHAR" .

