<https://wealth.example.org/neowealth/column/main/dim_product_unified_cat/is_listed> a owl:DatatypeProperty ;
    dcterms:description "Declared character varying(256): a text field, unlike its neighbours is_etf, is_active and is_deleted, which are booleans. Observed values: 'Listed' (72 rows) and 'Unlisted' (26 rows); no blanks. Filter on the text (is_listed = 'Listed'); a bare 'WHERE is_listed' does not apply to a text column. The is_ prefix does not make it a Boolean - keep the string datatype and the original values." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_product_unified_cat> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "is_listed" ;
