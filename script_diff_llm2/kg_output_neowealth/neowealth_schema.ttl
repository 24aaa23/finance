<https://wealth.example.org/neowealth/table/main/dim_product_segment_map> a owl:Class,
        meta:SourceTable ;
    rdfs:label "Product Segment Map" ;
    dcterms:description """DIMENSION / BRIDGE, 8 columns. The narrowest dimension. Product-to-segment assignment. Its existence as a separate table allows a product to carry several segments, and a join on product_id CAN multiply fact rows if a product has multiple segment assignments. In this data it does not: 25 rows for 25 distinct products (all Direct Equity, all is_active = true), so each product has at most one segment. Preserve every assignment when reproducing SQL - do not deduplicate the bridge, and do not assume future data keeps one segment per product. Segment names are supplied but no definition is: whether a segment is the same classification as sector or a separate grouping is not stated by the source and must be confirmed with the data team. segment_name is NOT unique -- 10 distinct names span 13 segment_ids -- so grouping by segment groups on segment_id with segment_name; a plain list of names returns 10. No dim_segment table, no effective dating.
""" ;
    rdfs:subClassOf meta:SourceRow ;
    meta:hasDeclaredAttribute <https://wealth.example.org/neowealth/declared-attribute/main/dim_product_segment_map/id>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_product_segment_map/is_active>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_product_segment_map/product_id>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_product_segment_map/row_hash>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_product_segment_map/segment_id>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_product_segment_map/segment_name>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_product_segment_map/source_load_ts>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_product_segment_map/source_table> ;
    meta:identityMethod "configured_key" ;
    meta:rawYaml """
identity:
  id: "TABLE_DIM_PRODUCT_SEGMENT_MAP_001"
  type: "Table"
  subtype: "Dimension"
  name: "dim_product_segment_map"
  display_name: "Product Segment Map"
  description: >
    DIMENSION / BRIDGE, 8 columns. The narrowest dimension. Product-to-segment
    assignment. Its existence as a separate table allows a product to carry
    several segments, and a join on product_id CAN multiply fact rows if a product
    has multiple segment assignments. In this data it does not: 25 rows for
    25 distinct products (all Direct Equity, all is_active = true), so each product
    has at most one segment. Preserve every assignment when reproducing SQL - do
    not deduplicate the bridge, and do not assume future data keeps one segment
    per product. Segment names are supplied but no definition is: whether a
    segment is the same classification as sector or a separate grouping is not
    stated by the source and must be confirmed with the data team. segment_name is
    NOT unique -- 10 distinct names span 13 segment_ids -- so grouping by segment
    groups on segment_id with segment_name; a plain list of names returns 10. No
    dim_segment table, no effective dating.

layer: "dimension"
subtype_role: "bridge"
grain: "product x segment"
not_null_columns: []
fan_out_hazard: true
missing_dimension: "dim_segment"

semantics:
  business_purpose: >
    Product-to-segment assignment bridge. Summing measures across it fans out
    whenever a product carries more than one segment (none does in this
    export). What a segment classifies is not stated by the source and must be confirmed with the data team; keep
    segment_id and segment_name as supplied and never merge Segment with Sector.

attributes:
  - name: "id"
    display_name: "ID"
    description: "Nullable surrogate."
    type: "integer"
    sql_type: "integer"
    nullable: true
    filterable: true
    attribute_type: "identifier"

  - name: "product_id"
    display_name: "Product ID"
    description: "-> dim_product_unified_cat.product_id. BRIDGE - a join to a fact table on product_id multiplies the fact rows if a product has multiple segment assignments: a holding worth 1,000,000 in three segments would become three rows totalling 3,000,000. In this data every product_id appears exactly once (25 rows, 25 products, all Direct Equity), so there is at most one segment match per product. Preserve all assignments when reproducing SQL results; do not deduplicate the bridge automatically, and do not infer that future exports carry only one segment per product."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "identifier"
    join_target: "dim_product_unified_cat.product_id"
    fan_out_hazard: true

  - name: "segment_id"
    display_name: "Segment ID"
    description: "No dim_segment table exists - another ID/name pair with no backing dimension. 13 distinct IDs (601-613) for only 10 distinct names: three names carry two IDs each - 'Information Technology' 601 and 612, 'Energy' 602 and 610, 'Banking & Financial Services' 603 and 608. Every ID maps to one name. So COUNT(DISTINCT segment_id) = 13 while COUNT(DISTINCT segment_name) = 10; use whichever field the question or query names, exactly as supplied. Do not merge IDs or invent a replacement ID."
    type: "integer"
    sql_type: "integer"
    nullable: true
    filterable: true
    attribute_type: "identifier"
    missing_dimension: "dim_segment"

  - name: "segment_name"
    display_name: "Segment Name"
    description: "Supplied values (10 distinct): Automobiles & Ancillaries, Banking & Financial Services, Consumer & Retail, Defence & Aerospace, Diversified Conglomerates, Energy, Healthcare & Pharma, Information Technology, Infrastructure & Construction, Telecom & Media. NOT unique per segment: the 10 names are spread across 13 segment_ids, so grouping by segment groups on segment_id with segment_name; a plain list of names returns 10. The labels look like an industry grouping, but they are NOT the same values as dim_cmot_company_mstr.sector_name or dim_product_unified_cat.sector (e.g. segment 'Information Technology' vs sector 'IT - Software' / 'Electronics'), and the source gives no definition. Whether a segment is the same classification as sector or a separate grouping must be confirmed with the data team. Keep segment_name as supplied; never present segments as sectors or merge Segment and Sector into one category on label similarity."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "dimension"
    observed_values: ["Automobiles & Ancillaries", "Banking & Financial Services", "Consumer & Retail", "Defence & Aerospace", "Diversified Conglomerates", "Energy", "Healthcare & Pharma", "Information Technology", "Infrastructure & Construction", "Telecom & Media"]
    meaning_pending_confirmation: true

  - name: "is_active"
    display_name: "Is Active"
    description: "Lets an assignment be retired without deleting the row. There is NO effective-date pair, so the HISTORY of segment assignment is not retained - only the current state plus this flag."
    type: "boolean"
    sql_type: "boolean"
    nullable: true
    filterable: true
    attribute_type: "dimension"
    three_valued: true

  - name: "source_table"
    display_name: "Source Table"
    description: "Lineage: name of the ORIGIN object in the SOURCE system, not this table. Proven by dim_client_master rows carrying 'clients'. Present in all 21 tables. NEVER join or filter business logic on this."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: false
    attribute_type: "dimension"
    hidden: true

  - name: "source_load_ts"
    display_name: "Source Load Timestamp"
    description: "ETL load timestamp, WITHOUT TIME ZONE - no timezone is recorded anywhere, so IST vs UTC is a convention held outside the DB. Present in 12 of 14 dim_* tables; absent from both MF history tables and from all 7 client_* facts."
    type: "timestamp"
    sql_type: "timestamp without time zone"
    nullable: true
    filterable: true
    attribute_type: "time_dimension"
    hidden: true

  - name: "row_hash"
    display_name: "Row Hash"
    description: "64-bit change-detection fingerprint; samples are 16 lowercase hex chars. Used for change-detecting upsert. Present in all 14 dim_* tables, none of the client_* facts. NEVER join on this."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: false
    attribute_type: "dimension"
    hidden: true""" ;
    meta:sourceFile "DIM_PRODUCT_SEGMENT_MAP_001.yaml" .

<https://wealth.example.org/neowealth/table/main/dim_master_enums> a owl:Class,
        meta:SourceTable ;
    rdfs:label "Master Enums" ;
    dcterms:description """DIMENSION, 10 columns. Generic key-value lookup - the 'one lookup table to rule them all' pattern, where every coded vocabulary lives partitioned by a category column. NOTHING IN THE SCHEMA LINKS IT TO THE COLUMNS IT GOVERNS. There is no enum_id on dim_client_master.tier, no revenue_type_id on client_revenue - every coded column stores a FREE-TEXT LABEL, not a foreign key. So this table is DOCUMENTARY, NOT ENFORCING: it records what the valid values are but cannot prevent an invalid one, joining to it requires fragile text matching, and renaming a value here will NOT update labels already written into the client, product and fact tables. Its most valuable use is as a DATA-QUALITY REFERENCE - compare SELECT DISTINCT tier against the registered values to detect misspellings. DELIVERY DEFECT: dim_master_enums.csv is a byte-identical copy of dim_cmot_company_mstr.csv (25 company records with co_code, isin, company_name, nse_symbol ...), not an enum export. This reference deliberately still describes the INTENDED enum table: none of id, type_key, master_category_name, name, master_type_key or is_deleted is in the CSV, so they load NULL, and is_active, source_table, source_load_ts and row_hash load the COMPANY values. The intended enum table is OUT OF SCOPE for SQL/KG equivalence until the correct export is supplied; do not claim it converted, and do not re-describe it as company data.
""" ;
    rdfs:subClassOf meta:SourceRow ;
    meta:hasDeclaredAttribute <https://wealth.example.org/neowealth/declared-attribute/main/dim_master_enums/id>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_master_enums/is_active>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_master_enums/is_deleted>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_master_enums/master_category_name>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_master_enums/master_type_key>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_master_enums/name>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_master_enums/row_hash>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_master_enums/source_load_ts>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_master_enums/source_table>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_master_enums/type_key> ;
    meta:identityMethod "row_content_hash_with_duplicate_occurrence" ;
    meta:rawYaml """
identity:
  id: "TABLE_DIM_MASTER_ENUMS_001"
  type: "Table"
  subtype: "Dimension"
  name: "dim_master_enums"
  display_name: "Master Enums"
  description: >
    DIMENSION, 10 columns. Generic key-value lookup - the 'one lookup table to
    rule them all' pattern, where every coded vocabulary lives partitioned by a
    category column. NOTHING IN THE SCHEMA LINKS IT TO THE COLUMNS IT GOVERNS.
    There is no enum_id on dim_client_master.tier, no revenue_type_id on
    client_revenue - every coded column stores a FREE-TEXT LABEL, not a foreign
    key. So this table is DOCUMENTARY, NOT ENFORCING: it records what the valid
    values are but cannot prevent an invalid one, joining to it requires fragile
    text matching, and renaming a value here will NOT update labels already
    written into the client, product and fact tables. Its most valuable use is as
    a DATA-QUALITY REFERENCE - compare SELECT DISTINCT tier against the registered
    values to detect misspellings. DELIVERY DEFECT: dim_master_enums.csv is a
    byte-identical copy of dim_cmot_company_mstr.csv (25 company records with
    co_code, isin, company_name, nse_symbol ...), not an enum export. This reference
    deliberately still describes the INTENDED enum table: none of id, type_key,
    master_category_name, name, master_type_key or is_deleted is in the CSV, so
    they load NULL, and is_active, source_table, source_load_ts and row_hash load
    the COMPANY values. The intended enum table is OUT OF SCOPE for SQL/KG
    equivalence until the correct export is supplied; do not claim it converted, and do not re-describe it as
    company data.

layer: "dimension"
grain: "one row per enum value"
not_null_columns: []
role: "documentary reference only - not linked to the columns it governs"
delivery_defect: "CSV is a byte-identical copy of dim_cmot_company_mstr.csv; intended enum table out of scope until a correct export is supplied"

semantics:
  business_purpose: >
    Generic key-value lookup for coded vocabularies. Not linked by foreign keys to
    the columns it governs, so it is documentary rather than enforcing; best used
    as a data-quality reference.

attributes:
  - name: "id"
    display_name: "ID"
    description: "Integer surrogate."
    type: "integer"
    sql_type: "integer"
    nullable: true
    filterable: true
    attribute_type: "identifier"

  - name: "type_key"
    display_name: "Type Key"
    description: "The CODE of the individual value within its enumeration."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "identifier"

  - name: "master_category_name"
    display_name: "Master Category Name"
    description: "Identifies WHICH enumeration a row belongs to."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "dimension"

  - name: "name"
    display_name: "Name"
    description: "The human-readable label to display."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "dimension"

  - name: "master_type_key"
    display_name: "Master Type Key"
    description: "The presence of TWO key-ish columns (type_key and master_type_key) suggests a two-level structure, but this is moot: in this data every enum payload column (id, type_key, master_category_name, name, master_type_key) is NULL - the 25 rows carry only company-master is_active / lineage values - so the table cannot be used to resolve labels regardless of key structure. Read coded values directly from the label already stored on the client/product tables."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "identifier"
    select_distinct_required: true

  - name: "is_active"
    display_name: "Is Active"
    description: "Soft-delete pair lets retired enum values be hidden from pickers while remaining resolvable for historical rows - a genuinely useful property."
    type: "boolean"
    sql_type: "boolean"
    nullable: true
    filterable: true
    attribute_type: "dimension"
    three_valued: true

  - name: "is_deleted"
    display_name: "Is Deleted"
    description: "Soft-delete pair, part 2."
    type: "boolean"
    sql_type: "boolean"
    nullable: true
    filterable: true
    attribute_type: "dimension"
    three_valued: true

  - name: "source_table"
    display_name: "Source Table"
    description: "Lineage: name of the ORIGIN object in the SOURCE system, not this table. Proven by dim_client_master rows carrying 'clients'. Present in all 21 tables. NEVER join or filter business logic on this."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: false
    attribute_type: "dimension"
    hidden: true

  - name: "source_load_ts"
    display_name: "Source Load Timestamp"
    description: "ETL load timestamp, WITHOUT TIME ZONE - no timezone is recorded anywhere, so IST vs UTC is a convention held outside the DB. Present in 12 of 14 dim_* tables; absent from both MF history tables and from all 7 client_* facts."
    type: "timestamp"
    sql_type: "timestamp without time zone"
    nullable: true
    filterable: true
    attribute_type: "time_dimension"
    hidden: true

  - name: "row_hash"
    display_name: "Row Hash"
    description: "64-bit change-detection fingerprint; samples are 16 lowercase hex chars. Used for change-detecting upsert. Present in all 14 dim_* tables, none of the client_* facts. NEVER join on this."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: false
    attribute_type: "dimension"
    hidden: true""" ;
    meta:sourceFile "DIM_MASTER_ENUMS_001.yaml" .

<https://wealth.example.org/neowealth/table/main/dim_mf_nav_history> a owl:Class,
        meta:SourceTable ;
    rdfs:label "MF NAV History" ;
    dcterms:description """TIME SERIES, 9 columns, despite the dim_ prefix - the prefix reflects a convention of grouping all externally-sourced market data under dim_, not a claim about grain. One of only TWO tables lacking source_load_ts (the other is dim_mf_returns_history); both are append-only, where the business date is the version. GRAIN: (mstar_id, nav_date) or (isin, nav_date). THE HIGHEST-ROW-COUNT TABLE IN THE SCHEMA by a wide margin - thousands of funds x thousands of trading days. ALWAYS DATE-BOUND ANY QUERY AGAINST IT. Single price point per day (correct for funds, which strike one NAV after close), so no intraday volatility is computable. Watch for gaps: holidays and genuine data loss look identical.
""" ;
    rdfs:subClassOf meta:SourceRow ;
    meta:hasDeclaredAttribute <https://wealth.example.org/neowealth/declared-attribute/main/dim_mf_nav_history/category>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_mf_nav_history/fund_name>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_mf_nav_history/isin>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_mf_nav_history/mstar_id>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_mf_nav_history/nav_currency>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_mf_nav_history/nav_date>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_mf_nav_history/nav_value>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_mf_nav_history/row_hash>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_mf_nav_history/source_table> ;
    meta:identityMethod "configured_key" ;
    meta:rawYaml """
identity:
  id: "TABLE_DIM_MF_NAV_HISTORY_001"
  type: "Table"
  subtype: "Dimension"
  name: "dim_mf_nav_history"
  display_name: "MF NAV History"
  description: >
    TIME SERIES, 9 columns, despite the dim_ prefix - the prefix reflects a
    convention of grouping all externally-sourced market data under dim_, not a
    claim about grain. One of only TWO tables lacking source_load_ts (the other is
    dim_mf_returns_history); both are append-only, where the business date is the
    version. GRAIN: (mstar_id, nav_date) or (isin, nav_date). THE HIGHEST-ROW-COUNT
    TABLE IN THE SCHEMA by a wide margin - thousands of funds x thousands of
    trading days. ALWAYS DATE-BOUND ANY QUERY AGAINST IT. Single price point per
    day (correct for funds, which strike one NAV after close), so no intraday
    volatility is computable. Watch for gaps: holidays and genuine data loss look
    identical.

layer: "dimension"
structural_type: "time_series"
grain: "mstar_id x nav_date (or isin x nav_date)"
not_null_columns: []
note: "highest-row-count table; always date-bound queries. Lacks source_load_ts (append-only)."

semantics:
  business_purpose: >
    Daily mutual-fund NAV time series, one price point per fund per day. The
    largest table in the schema; append-only. Compute returns with LAG over
    nav_date rather than assuming a fixed calendar offset.

attributes:
  - name: "mstar_id"
    display_name: "Morningstar ID"
    description: "Part of the grain: (mstar_id, nav_date). -> dim_mf_fund_complete.mstar_id."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "identifier"
    join_target: "dim_mf_fund_complete.mstar_id"

  - name: "isin"
    display_name: "ISIN"
    description: "Alternative grain key: (isin, nav_date)."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "identifier"

  - name: "fund_name"
    display_name: "Fund Name"
    description: "Denormalised onto every daily row. Deliberate: on a columnar warehouse these low-cardinality repeated strings compress extremely well, and it lets a NAV chart be drawn without joining the fund master."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "dimension"

  - name: "category"
    display_name: "Category"
    description: "Denormalised onto every daily row."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "dimension"

  - name: "nav_date"
    display_name: "NAV Date"
    description: "WATCH FOR GAPS: nothing guarantees a row for every fund on every trading day. Weekends and market holidays are absent by design; a genuine data gap looks IDENTICAL. With no dim_date you cannot distinguish 'market closed' from 'data missing'. Compute returns with LAG(nav_value) OVER (PARTITION BY mstar_id ORDER BY nav_date) rather than assuming a fixed calendar offset."
    type: "date"
    sql_type: "date"
    nullable: true
    filterable: true
    attribute_type: "time_dimension"

  - name: "nav_value"
    display_name: "NAV Value"
    description: "A SINGLE price point per day - no open/high/low. Correct for mutual funds, which strike ONE NAV per day after close. Consequence: intraday ranges and high/low volatility CANNOT be computed for funds, only close-to-close returns. Should reconcile to client_holdings.current_price for a fund holding on the same date."
    type: "float"
    sql_type: "real"
    nullable: true
    filterable: true
    attribute_type: "fact"

  - name: "nav_currency"
    display_name: "NAV Currency"
    description: "Implies multi-currency capability (offshore/feeder funds). Overwhelmingly INR for an India-domiciled book. Nullable with NO default, so a NULL currency is indistinguishable from INR - any cross-currency aggregation must handle that explicitly."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "dimension"

  - name: "source_table"
    display_name: "Source Table"
    description: "Lineage: name of the ORIGIN object in the SOURCE system, not this table. Proven by dim_client_master rows carrying 'clients'. Present in all 21 tables. NEVER join or filter business logic on this."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: false
    attribute_type: "dimension"
    hidden: true

  - name: "row_hash"
    display_name: "Row Hash"
    description: "64-bit change-detection fingerprint; samples are 16 lowercase hex chars. Used for change-detecting upsert. Present in all 14 dim_* tables, none of the client_* facts. NEVER join on this."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: false
    attribute_type: "dimension"
    hidden: true""" ;
    meta:sourceFile "DIM_MF_NAV_HISTORY_001.yaml" .

<https://wealth.example.org/neowealth/table/main/client_net_new_money> a owl:Class,
        meta:SourceTable ;
    rdfs:label "Client Net New Money" ;
    dcterms:description """FACT, 9 columns. Flow analysis. Grain: client x product x period. NNM is a primary wealth-management KPI because it isolates genuine asset gathering from market movement - AUM can grow purely because markets rose, NNM cannot. NOTE: no isin (flows tracked at product_id only) and no lob_id (unlike client_aum and client_revenue), so LOB attribution must go through dim_client_master.lob_id, which attributes by the client's CURRENT LOB rather than the LOB at the time of the flow.
""" ;
    rdfs:subClassOf meta:SourceRow ;
    meta:hasDeclaredAttribute <https://wealth.example.org/neowealth/declared-attribute/main/client_net_new_money/client_id>,
        <https://wealth.example.org/neowealth/declared-attribute/main/client_net_new_money/id>,
        <https://wealth.example.org/neowealth/declared-attribute/main/client_net_new_money/inflow>,
        <https://wealth.example.org/neowealth/declared-attribute/main/client_net_new_money/net_flow>,
        <https://wealth.example.org/neowealth/declared-attribute/main/client_net_new_money/outflow>,
        <https://wealth.example.org/neowealth/declared-attribute/main/client_net_new_money/period_date>,
        <https://wealth.example.org/neowealth/declared-attribute/main/client_net_new_money/product_id>,
        <https://wealth.example.org/neowealth/declared-attribute/main/client_net_new_money/product_type>,
        <https://wealth.example.org/neowealth/declared-attribute/main/client_net_new_money/source_table> ;
    meta:identityMethod "configured_key" ;
    meta:rawYaml """
identity:
  id: "TABLE_CLIENT_NET_NEW_MONEY_001"
  type: "Table"
  subtype: "Fact"
  name: "client_net_new_money"
  display_name: "Client Net New Money"
  description: >
    FACT, 9 columns. Flow analysis. Grain: client x product x period. NNM
    is a primary wealth-management KPI because it isolates genuine asset gathering
    from market movement - AUM can grow purely because markets rose, NNM cannot.
    NOTE: no isin (flows tracked at product_id only) and no lob_id (unlike
    client_aum and client_revenue), so LOB attribution must go through
    dim_client_master.lob_id, which attributes by the client's CURRENT LOB rather
    than the LOB at the time of the flow.

layer: "fact"
grain: "client_id x product_id x period_date"
not_null_columns: []

semantics:
  business_purpose: >
    Net new money (inflow minus outflow) per client per product per period - a
    headline KPI isolating genuine asset gathering from market movement. Tracked
    at product_id granularity; no isin and no lob_id.

attributes:
  - name: "id"
    display_name: "ID"
    description: "Nullable."
    type: "integer"
    sql_type: "integer"
    nullable: true
    filterable: true
    attribute_type: "identifier"

  - name: "client_id"
    display_name: "Client ID"
    description: "-> dim_client_master.id."
    type: "integer"
    sql_type: "integer"
    nullable: true
    filterable: true
    attribute_type: "identifier"
    join_target: "dim_client_master.id"

  - name: "product_id"
    display_name: "Product ID"
    description: "Declared join -> dim_product_unified_cat.product_id - which matches no row in this data (see below). This is the ONLY product-bearing fact table with NO isin - flows are tracked at product_id granularity only. In this data product_id holds 4 AGGREGATE codes, not catalogue product keys: AGG_BONDS (102 rows, product_type 'Bonds'), AGG_DIRECT_EQUITY (150, 'Direct Equity'), AGG_FIXED_DEPOSITS (180, 'Fixed Deposits'), AGG_MUTUAL_FUNDS (180, 'Mutual Funds'). NONE of the 612 rows matches a dim_product_unified_cat.product_id (individual products such as PROD_EQ_001), so the declared join returns no rows - and an equivalent query must keep returning none. Read the bucket from product_type on the same row. Whether AGG_* codes denote investment categories is not stated by the source and must be confirmed with the data team. A confirmed category relationship may be added separately; it must not replace this join or spread a category total across individual products. Preserve the original product_id, product_type, client and period values."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "identifier"
    join_target: "dim_product_unified_cat.product_id"

  - name: "product_type"
    display_name: "Product Type"
    description: "Denormalised."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "dimension"

  - name: "period_date"
    display_name: "Period Date"
    description: "A period aggregate, not an event date. Month-start dated: six periods, 2025-12-01 to 2026-05-01, 102 rows each, matching client_aum's month-start dating."
    type: "date"
    sql_type: "date"
    nullable: true
    filterable: true
    attribute_type: "time_dimension"

  - name: "inflow"
    display_name: "Inflow"
    description: "Gross money in, positive magnitude."
    type: "float"
    sql_type: "double precision"
    nullable: true
    filterable: true
    attribute_type: "fact"

  - name: "outflow"
    display_name: "Outflow"
    description: "Gross money out, stored as its own POSITIVE magnitude - so net attrition shows as outflow > inflow."
    type: "float"
    sql_type: "double precision"
    nullable: true
    filterable: true
    attribute_type: "fact"

  - name: "net_flow"
    display_name: "Net Flow"
    description: "TYPE DEFECT: character varying(256) while both its operands are proper double precision. COMPUTE inflow - outflow instead of reading it, since a text column sorts and compares as text. The stored text equals inflow - outflow on all 612 rows, with a leading minus sign on the 87 net-outflow rows; outflow is never negative. NNM is a headline KPI - it isolates genuine asset gathering from market movement, which AUM growth cannot."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "dimension"
    attribute_type_corrected: "fact"
    type_defect: "numeric stored as varchar; compute inflow - outflow"
    verified_identity: "inflow - outflow"

  - name: "source_table"
    display_name: "Source Table"
    description: "Lineage: name of the ORIGIN object in the SOURCE system, not this table. Proven by dim_client_master rows carrying 'clients'. Present in all 21 tables. NEVER join or filter business logic on this."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: false
    attribute_type: "dimension"
    hidden: true""" ;
    meta:sourceFile "CLIENT_NET_NEW_MONEY_001.yaml" .

<https://wealth.example.org/neowealth/table/main/client_valuations> a owl:Class,
        meta:SourceTable ;
    rdfs:label "Client Valuations" ;
    dcterms:description """FACT, 9 columns. Instrument-level mark-to-market. Grain: client x instrument x valuation_date. SUBSTANTIALLY OVERLAPS client_holdings: market_value = current_value, cost_value = invested_value, unrealized_pnl = unrealized_gain, valuation_date = as_on_date. The difference is richness - client_holdings is a full position record (quantity, prices, account, held-away flag), this is a narrow valuation-only series. This is likely the retained HISTORICAL series while client_holdings is the current snapshot, but the schema documentation does not state it - confirm each table's retention policy before choosing one for a trend chart.
""" ;
    rdfs:subClassOf meta:SourceRow ;
    meta:hasDeclaredAttribute <https://wealth.example.org/neowealth/declared-attribute/main/client_valuations/client_id>,
        <https://wealth.example.org/neowealth/declared-attribute/main/client_valuations/cost_value>,
        <https://wealth.example.org/neowealth/declared-attribute/main/client_valuations/id>,
        <https://wealth.example.org/neowealth/declared-attribute/main/client_valuations/isin>,
        <https://wealth.example.org/neowealth/declared-attribute/main/client_valuations/market_value>,
        <https://wealth.example.org/neowealth/declared-attribute/main/client_valuations/product_id>,
        <https://wealth.example.org/neowealth/declared-attribute/main/client_valuations/source_table>,
        <https://wealth.example.org/neowealth/declared-attribute/main/client_valuations/unrealized_pnl>,
        <https://wealth.example.org/neowealth/declared-attribute/main/client_valuations/valuation_date> ;
    meta:identityMethod "configured_key" ;
    meta:rawYaml """
identity:
  id: "TABLE_CLIENT_VALUATIONS_001"
  type: "Table"
  subtype: "Fact"
  name: "client_valuations"
  display_name: "Client Valuations"
  description: >
    FACT, 9 columns. Instrument-level mark-to-market. Grain: client x
    instrument x valuation_date. SUBSTANTIALLY OVERLAPS client_holdings:
    market_value = current_value, cost_value = invested_value, unrealized_pnl =
    unrealized_gain, valuation_date = as_on_date. The difference is richness -
    client_holdings is a full position record (quantity, prices, account,
    held-away flag), this is a narrow valuation-only series. This is likely
    the retained HISTORICAL series while client_holdings is the current snapshot,
    but the schema documentation does not state it - confirm each table's retention policy
    before choosing one for a trend chart.

layer: "fact"
grain: "client_id x isin x valuation_date"
not_null_columns: []

semantics:
  business_purpose: >
    Narrow instrument-level mark-to-market series (market value, cost value,
    unrealized P&L) per client per instrument per valuation date; overlaps
    client_holdings and is inferred to be the retained historical series.

attributes:
  - name: "id"
    display_name: "ID"
    description: "NULLABLE here - so it is NOT a valid primary key as declared."
    type: "integer"
    sql_type: "integer"
    nullable: true
    filterable: true
    attribute_type: "identifier"

  - name: "client_id"
    display_name: "Client ID"
    description: "-> dim_client_master.id."
    type: "integer"
    sql_type: "integer"
    nullable: true
    filterable: true
    attribute_type: "identifier"
    join_target: "dim_client_master.id"

  - name: "isin"
    display_name: "ISIN"
    description: "Instrument identity."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "identifier"

  - name: "product_id"
    display_name: "Product ID"
    description: "-> dim_product_unified_cat.product_id."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "identifier"
    join_target: "dim_product_unified_cat.product_id"

  - name: "valuation_date"
    display_name: "Valuation Date"
    description: "Equivalent to client_holdings.as_on_date."
    type: "date"
    sql_type: "date"
    nullable: true
    filterable: true
    attribute_type: "time_dimension"

  - name: "market_value"
    display_name: "Market Value"
    description: "Equivalent to client_holdings.current_value."
    type: "float"
    sql_type: "double precision"
    nullable: true
    filterable: true
    attribute_type: "fact"

  - name: "cost_value"
    display_name: "Cost Value"
    description: "Equivalent to client_holdings.invested_value."
    type: "float"
    sql_type: "double precision"
    nullable: true
    filterable: true
    attribute_type: "fact"

  - name: "unrealized_pnl"
    display_name: "Unrealized P&L"
    description: "TYPE DEFECT: character varying(256) holding a number. Same defect as client_holdings.unrealized_gain - the recurrence suggests one shared upstream transformation emits P&L as a string. COMPUTE market_value - cost_value instead."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "dimension"
    attribute_type_corrected: "fact"
    type_defect: "numeric stored as varchar; compute market_value - cost_value"
    verified_identity: "market_value - cost_value"

  - name: "source_table"
    display_name: "Source Table"
    description: "Lineage: name of the ORIGIN object in the SOURCE system, not this table. Proven by dim_client_master rows carrying 'clients'. Present in all 21 tables. NEVER join or filter business logic on this."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: false
    attribute_type: "dimension"
    hidden: true""" ;
    meta:sourceFile "CLIENT_VALUATIONS_001.yaml" .

<https://wealth.example.org/neowealth/table/main/client_aum> a owl:Class,
        meta:SourceTable ;
    rdfs:label "Client AUM" ;
    dcterms:description """FACT, 10 columns. Assets Under Management snapshots - the headline AUM reporting table. Grain: client x LOB x month-end, natural key (client_id, lob_id, as_on_date), proven by client 7001 appearing once for each of six consecutive month-start dates. KEY IDENTITY verified on all 10 samples: aum_value = aum_equity + aum_fixed_income + aum_alternatives, exactly. NOTE: has NO product_id and NO product_type - AUM is held at asset-class buckets, not instrument level; use client_holdings for instrument-level exposure. HAZARD: joining lob_id to dim_lob_hierarchy fans out.
""" ;
    rdfs:subClassOf meta:SourceRow ;
    meta:hasDeclaredAttribute <https://wealth.example.org/neowealth/declared-attribute/main/client_aum/as_on_date>,
        <https://wealth.example.org/neowealth/declared-attribute/main/client_aum/aum_alternatives>,
        <https://wealth.example.org/neowealth/declared-attribute/main/client_aum/aum_equity>,
        <https://wealth.example.org/neowealth/declared-attribute/main/client_aum/aum_fixed_income>,
        <https://wealth.example.org/neowealth/declared-attribute/main/client_aum/aum_value>,
        <https://wealth.example.org/neowealth/declared-attribute/main/client_aum/client_id>,
        <https://wealth.example.org/neowealth/declared-attribute/main/client_aum/id>,
        <https://wealth.example.org/neowealth/declared-attribute/main/client_aum/lob_id>,
        <https://wealth.example.org/neowealth/declared-attribute/main/client_aum/lob_name>,
        <https://wealth.example.org/neowealth/declared-attribute/main/client_aum/source_table> ;
    meta:identityMethod "configured_key" ;
    meta:rawYaml """
identity:
  id: "TABLE_CLIENT_AUM_001"
  type: "Table"
  subtype: "Fact"
  name: "client_aum"
  display_name: "Client AUM"
  description: >
    FACT, 10 columns. Assets Under Management snapshots - the headline AUM
    reporting table. Grain: client x LOB x month-end, natural key
    (client_id, lob_id, as_on_date), proven by client 7001 appearing once for
    each of six consecutive month-start dates. KEY IDENTITY verified on all
    10 samples: aum_value = aum_equity + aum_fixed_income + aum_alternatives,
    exactly. NOTE: has NO product_id and NO product_type - AUM is held at
    asset-class buckets, not instrument level; use client_holdings for
    instrument-level exposure. HAZARD: joining lob_id to dim_lob_hierarchy fans
    out.

layer: "fact"
grain: "client_id x lob_id x as_on_date (month)"
not_null_columns: ["id"]

semantics:
  business_purpose: >
    Month-start snapshots of total Assets Under Management per client per line of
    business, split into equity / fixed income / alternatives buckets that
    reconcile exactly to the total. The headline AUM reporting fact.

attributes:
  - name: "id"
    display_name: "ID"
    description: "NOT NULL. One of only TWO NOT NULL columns in the entire 309-column schema, so the strongest PK candidate present. Sample range 140001+. Per-table sequence - never join id across fact tables."
    type: "integer"
    sql_type: "integer"
    nullable: false
    filterable: true
    attribute_type: "identifier"

  - name: "client_id"
    display_name: "Client ID"
    description: "-> dim_client_master.id. Confirmed by sample data (7001, 7002 fall inside the master's 7001-7010 range). Nullable: an inner join can silently drop rows."
    type: "integer"
    sql_type: "integer"
    nullable: true
    filterable: true
    attribute_type: "identifier"
    join_target: "dim_client_master.id"

  - name: "lob_id"
    display_name: "LOB ID"
    description: "-> dim_lob_hierarchy.lob_id. HAZARD: lob_id is NOT unique in that table (its grain is sub-LOB), so joining directly FANS OUT and multiplies aum_value. Join to (SELECT DISTINCT lob_id, ...) instead."
    type: "integer"
    sql_type: "integer"
    nullable: true
    filterable: true
    attribute_type: "identifier"
    join_target: "dim_lob_hierarchy.lob_id"
    fan_out_hazard: true

  - name: "lob_name"
    display_name: "LOB Name"
    description: "Denormalised copy of dim_lob_hierarchy.lob_name, stored to avoid a join. Can drift from the master if an LOB is renamed. Observed values (180 rows): Neo Wealth Advisory (126), Broking Services (36), Asset Management (18) - all three present in dim_lob_hierarchy.lob_name."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "dimension"
    observed_values: ["Neo Wealth Advisory", "Broking Services", "Asset Management"]

  - name: "as_on_date"
    display_name: "As On Date"
    description: "MONTH-START dated monthly snapshot (2025-12-01, 2026-01-01, ... 2026-05-01). HAZARD: client_holdings.as_on_date is a DAILY date - equi-joining the two on date returns nothing or wrong rows. Align with DATE_TRUNC('month', ...)."
    type: "date"
    sql_type: "date"
    nullable: true
    filterable: true
    attribute_type: "time_dimension"

  - name: "aum_value"
    display_name: "AUM Value"
    description: "Total AUM. VERIFIED IDENTITY on all 10 sample rows: aum_value = aum_equity + aum_fixed_income + aum_alternatives, exactly. Usable as a production data-quality assertion with a tolerance."
    type: "float"
    sql_type: "double precision"
    nullable: true
    filterable: true
    attribute_type: "fact"
    verified_identity: "aum_equity + aum_fixed_income + aum_alternatives"

  - name: "aum_equity"
    display_name: "AUM Equity"
    description: "Equity component of aum_value. Part of the exhaustive 3-way split that reconciles to the total."
    type: "float"
    sql_type: "double precision"
    nullable: true
    filterable: true
    attribute_type: "fact"

  - name: "aum_fixed_income"
    display_name: "AUM Fixed Income"
    description: "Fixed-income component of aum_value."
    type: "float"
    sql_type: "double precision"
    nullable: true
    filterable: true
    attribute_type: "fact"

  - name: "aum_alternatives"
    display_name: "AUM Alternatives"
    description: "Alternatives component of aum_value."
    type: "float"
    sql_type: "double precision"
    nullable: true
    filterable: true
    attribute_type: "fact"

  - name: "source_table"
    display_name: "Source Table"
    description: "Lineage: name of the ORIGIN object in the SOURCE system, not this table. Proven by dim_client_master rows carrying 'clients'. Present in all 21 tables. NEVER join or filter business logic on this."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: false
    attribute_type: "dimension"
    hidden: true""" ;
    meta:sourceFile "CLIENT_AUM_001.yaml" .

<https://wealth.example.org/neowealth/table/main/dim_cmot_index_prices> a owl:Class,
        meta:SourceTable ;
    rdfs:label "Index Prices" ;
    dcterms:description """TIME SERIES, 10 columns. Benchmark index OHLC - Nifty 50, Sensex, sectoral indices and so on. This data holds five series only (Nifty 50, Nifty 500, Nifty Midcap 150, Nifty Smallcap 250, Nifty 10yr G-sec), 2026-05-04 to 2026-05-19. GRAIN: one row per index per date. co_code HERE MEANS AN INDEX, NOT A COMPANY - the vendor reuses one code space for both, so this table must NEVER be joined to dim_cmot_company_mstr on co_code. Join on index_name. This table answers the 'did we beat the market' question, but BOTH paths that reach it are FREE-TEXT JOINS on index names (from benchmark_name and from benchmark, two different column names for the same concept), and any spelling mismatch fails SILENTLY. The schema's weakest join. Also note nav_close sits at ordinal 4, BEFORE nav_open - always select these by name.
""" ;
    rdfs:subClassOf meta:SourceRow ;
    meta:hasDeclaredAttribute <https://wealth.example.org/neowealth/declared-attribute/main/dim_cmot_index_prices/co_code>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_cmot_index_prices/index_name>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_cmot_index_prices/nav_close>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_cmot_index_prices/nav_date>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_cmot_index_prices/nav_high>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_cmot_index_prices/nav_low>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_cmot_index_prices/nav_open>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_cmot_index_prices/row_hash>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_cmot_index_prices/source_load_ts>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_cmot_index_prices/source_table> ;
    meta:identityMethod "configured_key" ;
    meta:rawYaml """
identity:
  id: "TABLE_DIM_CMOT_INDEX_PRICES_001"
  type: "Table"
  subtype: "Dimension"
  name: "dim_cmot_index_prices"
  display_name: "Index Prices"
  description: >
    TIME SERIES, 10 columns. Benchmark index OHLC - Nifty 50, Sensex, sectoral
    indices and so on. This data holds five series only (Nifty 50, Nifty 500,
    Nifty Midcap 150, Nifty Smallcap 250, Nifty 10yr G-sec), 2026-05-04 to
    2026-05-19. GRAIN: one row per index per date. co_code HERE MEANS AN
    INDEX, NOT A COMPANY - the vendor reuses one code space for both, so this table
    must NEVER be joined to dim_cmot_company_mstr on co_code. Join on index_name.
    This table answers the 'did we beat the market' question, but BOTH paths that
    reach it are FREE-TEXT JOINS on index names (from benchmark_name and from
    benchmark, two different column names for the same concept), and any spelling
    mismatch fails SILENTLY. The schema's weakest join. Also note nav_close sits at
    ordinal 4, BEFORE nav_open - always select these by name.

layer: "dimension"
structural_type: "time_series"
grain: "index_name x nav_date"
not_null_columns: []
open_question: "are index_name values PRICE or TOTAL-RETURN (TRI) indices?"

semantics:
  business_purpose: >
    Benchmark index OHLC time series for relative-performance ('beat the market')
    analysis. Reached only by fragile free-text joins on index_name. co_code here
    is an index, not a company.

attributes:
  - name: "co_code"
    display_name: "Index Code"
    description: "HERE co_code IDENTIFIES AN INDEX, NOT A COMPANY. The vendor reuses one code space for both entity types. NEVER join this table to dim_cmot_company_mstr on co_code - it would produce meaningless matches. Join on index_name instead."
    type: "integer"
    sql_type: "integer"
    nullable: true
    filterable: true
    attribute_type: "identifier"
    warning: "identifies an INDEX, not a company; never join to dim_cmot_company_mstr on co_code"

  - name: "index_name"
    display_name: "Index Name"
    description: "The safe key for this table, and the target of the two free-text benchmark joins (dim_mf_fund_complete.benchmark_name and dim_product_unified_cat.benchmark). There is NO index_id anywhere in the schema. Also unrecorded: whether these are PRICE or TOTAL RETURN (TRI) indices - a fund's NAV return is net of expenses and includes reinvested dividends, so a fair comparison needs a TRI. Check the actual values for a TRI suffix before publishing any relative-performance figure. Five values, 12 daily rows each (2026-05-04 to 2026-05-19): 'Nifty 50', 'Nifty 500', 'Nifty Midcap 150', 'Nifty Smallcap 250', 'Nifty 10yr G-sec'. None carries a TRI suffix - they are price series - and no benchmark label in dim_mf_fund_complete, dim_product_unified_cat or client_holdings equals any of them exactly. Preserve the names as supplied; the ' TRI' strip (01_domain_and_business_rules.md §3.8) is applied at query time only."
    observed_values: ["Nifty 50", "Nifty 500", "Nifty Midcap 150", "Nifty Smallcap 250", "Nifty 10yr G-sec"]
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "identifier"

  - name: "nav_date"
    display_name: "Index Date"
    description: "Part of the grain: (index_name, nav_date)."
    type: "date"
    sql_type: "date"
    nullable: true
    filterable: true
    attribute_type: "time_dimension"

  - name: "nav_close"
    display_name: "Close"
    description: "NOTE THE ORDINAL POSITION: nav_close is column 4, BEFORE nav_open at column 5 - the only place in the schema where OHLC is not in O-H-L-C order. Cosmetic, but SELECT * returns them in a surprising order and a POSITIONAL column mapping downstream would silently swap open and close. ALWAYS SELECT THESE BY NAME."
    type: "float"
    sql_type: "real"
    nullable: true
    filterable: true
    attribute_type: "fact"

  - name: "nav_open"
    display_name: "Open"
    description: "Opening level. See the ordinal warning on nav_close."
    type: "float"
    sql_type: "real"
    nullable: true
    filterable: true
    attribute_type: "fact"

  - name: "nav_high"
    display_name: "High"
    description: "Intraday high."
    type: "float"
    sql_type: "real"
    nullable: true
    filterable: true
    attribute_type: "fact"

  - name: "nav_low"
    display_name: "Low"
    description: "Intraday low. There is NO nav_volume here - correct, since an index has no traded volume of its own."
    type: "float"
    sql_type: "real"
    nullable: true
    filterable: true
    attribute_type: "fact"

  - name: "source_table"
    display_name: "Source Table"
    description: "Lineage: name of the ORIGIN object in the SOURCE system, not this table. Proven by dim_client_master rows carrying 'clients'. Present in all 21 tables. NEVER join or filter business logic on this."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: false
    attribute_type: "dimension"
    hidden: true

  - name: "source_load_ts"
    display_name: "Source Load Timestamp"
    description: "ETL load timestamp, WITHOUT TIME ZONE - no timezone is recorded anywhere, so IST vs UTC is a convention held outside the DB. Present in 12 of 14 dim_* tables; absent from both MF history tables and from all 7 client_* facts."
    type: "timestamp"
    sql_type: "timestamp without time zone"
    nullable: true
    filterable: true
    attribute_type: "time_dimension"
    hidden: true

  - name: "row_hash"
    display_name: "Row Hash"
    description: "64-bit change-detection fingerprint; samples are 16 lowercase hex chars. Used for change-detecting upsert. Present in all 14 dim_* tables, none of the client_* facts. NEVER join on this."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: false
    attribute_type: "dimension"
    hidden: true""" ;
    meta:sourceFile "DIM_CMOT_INDEX_PRICES_001.yaml" .

<https://wealth.example.org/neowealth/table/main/client_revenue> a owl:Class,
        meta:SourceTable ;
    rdfs:label "Client Revenue" ;
    dcterms:description """FACT, 10 columns. Fee and commission income. Grain: one revenue posting per client, employee, date, type and product type. THE ONLY FACT TABLE CARRYING AN EMPLOYEE KEY, so it is the sole basis for RM productivity and incentive reporting. Attribution is ambiguous: dim_client_master records TWO bankers per client and the schema documentation does not say which role emp_id represents. Coarsest product grain of any fact table - product_type only, no product_id, no isin.
""" ;
    rdfs:subClassOf meta:SourceRow ;
    meta:hasDeclaredAttribute <https://wealth.example.org/neowealth/declared-attribute/main/client_revenue/client_id>,
        <https://wealth.example.org/neowealth/declared-attribute/main/client_revenue/emp_code>,
        <https://wealth.example.org/neowealth/declared-attribute/main/client_revenue/emp_id>,
        <https://wealth.example.org/neowealth/declared-attribute/main/client_revenue/id>,
        <https://wealth.example.org/neowealth/declared-attribute/main/client_revenue/lob_id>,
        <https://wealth.example.org/neowealth/declared-attribute/main/client_revenue/product_type>,
        <https://wealth.example.org/neowealth/declared-attribute/main/client_revenue/revenue_amount>,
        <https://wealth.example.org/neowealth/declared-attribute/main/client_revenue/revenue_date>,
        <https://wealth.example.org/neowealth/declared-attribute/main/client_revenue/revenue_type>,
        <https://wealth.example.org/neowealth/declared-attribute/main/client_revenue/source_table> ;
    meta:identityMethod "configured_key" ;
    meta:rawYaml """
identity:
  id: "TABLE_CLIENT_REVENUE_001"
  type: "Table"
  subtype: "Fact"
  name: "client_revenue"
  display_name: "Client Revenue"
  description: >
    FACT, 10 columns. Fee and commission income. Grain: one revenue
    posting per client, employee, date, type and product type. THE ONLY FACT
    TABLE CARRYING AN EMPLOYEE KEY, so it is the sole basis for RM productivity
    and incentive reporting. Attribution is ambiguous: dim_client_master records
    TWO bankers per client and the schema documentation does not say which role emp_id
    represents. Coarsest product grain of any fact table - product_type only, no
    product_id, no isin.

layer: "fact"
grain: "client_id x emp_id x revenue_date x revenue_type x product_type"
not_null_columns: []

semantics:
  business_purpose: >
    Fee and commission income - the only fact table with an employee key, hence
    the sole basis for RM productivity and incentive reporting. Attributed at
    product_type level only. Employee-role attribution is ambiguous.

attributes:
  - name: "id"
    display_name: "ID"
    description: "Nullable."
    type: "integer"
    sql_type: "integer"
    nullable: true
    filterable: true
    attribute_type: "identifier"

  - name: "client_id"
    display_name: "Client ID"
    description: "-> dim_client_master.id."
    type: "integer"
    sql_type: "integer"
    nullable: true
    filterable: true
    attribute_type: "identifier"
    join_target: "dim_client_master.id"

  - name: "emp_id"
    display_name: "Employee ID"
    description: "-> dim_employee_profile.id. Integer join, PREFERRED. This is the ONLY fact table carrying an employee key, so it is the sole basis for RM productivity and incentive reporting. The schema documentation does NOT say which role this represents - servicing banker, acquiring banker, or neither - nor whether it is the banker at time of posting. Do not assume it equals either dim_client_master banker."
    type: "integer"
    sql_type: "integer"
    nullable: true
    filterable: true
    attribute_type: "identifier"
    join_target: "dim_employee_profile.id"

  - name: "emp_code"
    display_name: "Employee Code"
    description: "-> dim_employee_profile.code. Text join; denormalised duplicate of the emp_id path. You must resolve emp_id -> code before traversing the employee hierarchy, which is keyed on code."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "identifier"
    join_target: "dim_employee_profile.code"

  - name: "revenue_date"
    display_name: "Revenue Date"
    description: "Posting date."
    type: "date"
    sql_type: "date"
    nullable: true
    filterable: true
    attribute_type: "time_dimension"

  - name: "revenue_type"
    display_name: "Revenue Type"
    description: "Uncontrolled varchar(256) with no declared enumeration. Observed values (675 rows, no blanks): Advisory Fee (147), Upfront Commission (145), Trail Commission (135), Transaction Fee (127), Brokerage (121). The recurring-vs-one-off split is usually the most important cut of this table; Advisory Fee and Trail Commission read as recurring and the other three as one-off, but the source does not declare it. Filter on these labels exactly as supplied."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "dimension"
    observed_values: ["Advisory Fee", "Upfront Commission", "Trail Commission", "Transaction Fee", "Brokerage"]

  - name: "revenue_amount"
    display_name: "Revenue Amount"
    description: "Fee or commission income amount."
    type: "float"
    sql_type: "double precision"
    nullable: true
    filterable: true
    attribute_type: "fact"

  - name: "product_type"
    display_name: "Product Type"
    description: "Revenue is attributed at product_type level ONLY - there is no product_id and no isin here, so revenue CANNOT be attributed to an individual instrument. Coarsest product grain of any fact table."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "dimension"

  - name: "lob_id"
    display_name: "LOB ID"
    description: "-> dim_lob_hierarchy.lob_id, enabling LOB P&L without a detour through the client master. Unlike client_aum, no denormalised lob_name is carried, so labelling always requires the join - and the join must be de-duplicated (see the fan-out hazard)."
    type: "integer"
    sql_type: "integer"
    nullable: true
    filterable: true
    attribute_type: "identifier"
    join_target: "dim_lob_hierarchy.lob_id"
    fan_out_hazard: true

  - name: "source_table"
    display_name: "Source Table"
    description: "Lineage: name of the ORIGIN object in the SOURCE system, not this table. Proven by dim_client_master rows carrying 'clients'. Present in all 21 tables. NEVER join or filter business logic on this."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: false
    attribute_type: "dimension\"""" ;
    meta:sourceFile "CLIENT_REVENUE_001.yaml" .

<https://wealth.example.org/neowealth/table/main/client_transactions> a owl:Class,
        meta:SourceTable ;
    rdfs:label "Client Transactions" ;
    dcterms:description """FACT, 12 columns. Buy/sell activity ledger. Grain: one row per executed transaction - THE ONLY TRUE EVENT/LEDGER TABLE in the schema; everything else is a snapshot or a period aggregate. 3,004 rows, 2014-10-22 to 2026-04-21. amount ~= units * nav_price on every row, and amount and units are always stored positive: direction is carried ONLY by transaction_type, which holds Purchase (2,972) and Redemption (32). Net traded flow = SUM(CASE WHEN transaction_type='Redemption' THEN -amount ELSE amount END). Turnover = SUM(amount) over both directions, not netted.
""" ;
    rdfs:subClassOf meta:SourceRow ;
    meta:hasDeclaredAttribute <https://wealth.example.org/neowealth/declared-attribute/main/client_transactions/amount>,
        <https://wealth.example.org/neowealth/declared-attribute/main/client_transactions/client_id>,
        <https://wealth.example.org/neowealth/declared-attribute/main/client_transactions/client_pan>,
        <https://wealth.example.org/neowealth/declared-attribute/main/client_transactions/id>,
        <https://wealth.example.org/neowealth/declared-attribute/main/client_transactions/isin>,
        <https://wealth.example.org/neowealth/declared-attribute/main/client_transactions/nav_price>,
        <https://wealth.example.org/neowealth/declared-attribute/main/client_transactions/product_id>,
        <https://wealth.example.org/neowealth/declared-attribute/main/client_transactions/product_type>,
        <https://wealth.example.org/neowealth/declared-attribute/main/client_transactions/source_table>,
        <https://wealth.example.org/neowealth/declared-attribute/main/client_transactions/transaction_date>,
        <https://wealth.example.org/neowealth/declared-attribute/main/client_transactions/transaction_type>,
        <https://wealth.example.org/neowealth/declared-attribute/main/client_transactions/units> ;
    meta:identityMethod "configured_key" ;
    meta:rawYaml """
identity:
  id: "TABLE_CLIENT_TRANSACTIONS_001"
  type: "Table"
  subtype: "Fact"
  name: "client_transactions"
  display_name: "Client Transactions"
  description: >
    FACT, 12 columns. Buy/sell activity ledger. Grain: one row per
    executed transaction - THE ONLY TRUE EVENT/LEDGER TABLE in the schema;
    everything else is a snapshot or a period aggregate. 3,004 rows, 2014-10-22
    to 2026-04-21. amount ~= units * nav_price on every row, and amount and units
    are always stored positive: direction is carried ONLY by transaction_type,
    which holds Purchase (2,972) and Redemption (32). Net traded flow = SUM(CASE
    WHEN transaction_type='Redemption' THEN -amount ELSE amount END). Turnover =
    SUM(amount) over both directions, not netted.

layer: "fact"
grain: "one row per executed transaction"
not_null_columns: []
warning: "amount and units are positive on every row; only transaction_type (Purchase / Redemption) separates redemptions from purchases - a net figure must subtract Redemption rows explicitly."

semantics:
  business_purpose: >
    Buy/sell activity ledger - the schema's only true event/ledger table. One row
    per executed transaction. amount and units are always positive; use
    transaction_type to determine direction when computing a net flow.

attributes:
  - name: "id"
    display_name: "ID"
    description: "Nullable - not a valid PK as declared."
    type: "integer"
    sql_type: "integer"
    nullable: true
    filterable: true
    attribute_type: "identifier"

  - name: "client_id"
    display_name: "Client ID"
    description: "-> dim_client_master.id."
    type: "integer"
    sql_type: "integer"
    nullable: true
    filterable: true
    attribute_type: "identifier"
    join_target: "dim_client_master.id"

  - name: "client_pan"
    display_name: "Client PAN"
    description: "Denormalised PAN. Do not join on it. PII."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "identifier"
    pii: true
    do_not_join: true

  - name: "isin"
    display_name: "ISIN"
    description: "Instrument identity."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "identifier"

  - name: "product_id"
    display_name: "Product ID"
    description: "-> dim_product_unified_cat.product_id."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "identifier"
    join_target: "dim_product_unified_cat.product_id"

  - name: "product_type"
    display_name: "Product Type"
    description: "Denormalised routing discriminator."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "dimension"

  - name: "transaction_type"
    display_name: "Transaction Type"
    description: "Purchase or Redemption - observed values: Purchase (2,972 rows) and Redemption (32), no blanks; no Buy/Sell/SIP/Switch/Dividend labels occur. This is the ONLY source of transaction direction: amount and units do not carry a sign. Filter on the labels exactly as supplied (transaction_type = 'Purchase'); do not assume other values exist."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "dimension"
    observed_values: ["Purchase", "Redemption"]

  - name: "transaction_date"
    display_name: "Transaction Date"
    description: "Event date. This is the schema's only true event/ledger table - everything else is a snapshot or a period aggregate."
    type: "date"
    sql_type: "date"
    nullable: true
    filterable: true
    attribute_type: "time_dimension"

  - name: "amount"
    display_name: "Amount"
    description: "The rupee consideration, always stored positive, Redemption rows included. amount ~= units * nav_price holds on all 3,004 rows to within rounding (max relative difference < 0.001%). Direction is carried only by transaction_type, never by the sign of this column: net flow = SUM(CASE WHEN transaction_type='Redemption' THEN -amount ELSE amount END); turnover = SUM(amount) over both directions. Summing amount without a transaction_type filter therefore adds redemptions to purchases."
    type: "float"
    sql_type: "double precision"
    nullable: true
    filterable: true
    attribute_type: "fact"

  - name: "units"
    display_name: "Units"
    description: "Typed double precision while client_holdings.quantity is real - same concept, two precisions."
    type: "float"
    sql_type: "double precision"
    nullable: true
    filterable: true
    attribute_type: "fact"

  - name: "nav_price"
    display_name: "NAV Price"
    description: "Per-unit execution price. Named for mutual funds but serves as the generic execution price for equity too."
    type: "float"
    sql_type: "real"
    nullable: true
    filterable: true
    attribute_type: "fact"

  - name: "source_table"
    display_name: "Source Table"
    description: "Lineage: name of the ORIGIN object in the SOURCE system, not this table. Proven by dim_client_master rows carrying 'clients'. Present in all 21 tables. NEVER join or filter business logic on this."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: false
    attribute_type: "dimension"
    hidden: true""" ;
    meta:sourceFile "CLIENT_TRANSACTIONS_001.yaml" .

<https://wealth.example.org/neowealth/table/main/dim_equity_price_latest> a owl:Class,
        meta:SourceTable ;
    rdfs:label "Equity Price (Latest)" ;
    dcterms:description """13 columns. Equity OHLCV prices. Despite the OHLC-shaped columns, this table is a SINGLE-DATE SNAPSHOT (2026-05-19 only, one row per instrument), not a price history -- there is no equity time series in this warehouse. GRAIN INCLUDES exchange: the key is (co_code, exchange, nav_date) because the same company trades on both NSE and BSE at different prices - joining on isin + date alone DOUBLES the position. The nav_* prefix is a misnomer carried over from the MF tables; these are OHLCV market prices, not NAVs. nav_volume is integer and can overflow.
""" ;
    rdfs:subClassOf meta:SourceRow ;
    meta:hasDeclaredAttribute <https://wealth.example.org/neowealth/declared-attribute/main/dim_equity_price_latest/co_code>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_equity_price_latest/company_name>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_equity_price_latest/exchange>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_equity_price_latest/isin>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_equity_price_latest/nav_close>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_equity_price_latest/nav_date>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_equity_price_latest/nav_high>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_equity_price_latest/nav_low>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_equity_price_latest/nav_open>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_equity_price_latest/nav_volume>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_equity_price_latest/row_hash>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_equity_price_latest/source_load_ts>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_equity_price_latest/source_table> ;
    meta:identityMethod "configured_key" ;
    meta:rawYaml """
identity:
  id: "TABLE_DIM_EQUITY_PRICE_LATEST_001"
  type: "Table"
  subtype: "Dimension"
  name: "dim_equity_price_latest"
  display_name: "Equity Price (Latest)"
  description: >
    13 columns. Equity OHLCV prices. Despite the OHLC-shaped columns, this table
    is a SINGLE-DATE SNAPSHOT (2026-05-19 only, one row per instrument), not a
    price history -- there is no equity time series in this warehouse.
    GRAIN INCLUDES exchange: the key is (co_code, exchange, nav_date) because the
    same company trades on both NSE and BSE at different prices - joining on isin +
    date alone DOUBLES the position. The nav_* prefix is a misnomer carried over
    from the MF tables; these are OHLCV market prices, not NAVs. nav_volume is
    integer and can overflow.

layer: "dimension"
structural_type: "time_series"
grain: "co_code x exchange x nav_date"
not_null_columns: []
open_question: "one current row per instrument, or full history? Settled for this data: one row per instrument on 2026-05-19 (single-date snapshot)."

semantics:
  business_purpose: >
    Equity OHLCV market prices. Grain includes exchange (same ISIN trades on NSE
    and BSE), so exchange must be pinned on every join to avoid doubling. In
    this data it holds one row per instrument on a single date (2026-05-19), NSE only.

attributes:
  - name: "co_code"
    display_name: "Company Code"
    description: "-> dim_cmot_company_mstr.co_code. Part of the grain."
    type: "integer"
    sql_type: "integer"
    nullable: true
    filterable: true
    attribute_type: "identifier"
    join_target: "dim_cmot_company_mstr.co_code"

  - name: "isin"
    display_name: "ISIN"
    description: "Equity ISIN. NOT UNIQUE in this table - the same ISIN trades on BOTH NSE and BSE, so joining on isin + date alone DOUBLES the position. Always pin exchange."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "identifier"
    not_unique: true

  - name: "company_name"
    display_name: "Company Name"
    description: "Denormalised."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "dimension"

  - name: "exchange"
    display_name: "Exchange"
    description: "PART OF THE GRAIN. The same company trades on both NSE and BSE at slightly different prices, so the key is (co_code, exchange, nav_date), NOT (co_code, nav_date). This is a fan-out hazard on every join."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "dimension"
    fan_out_hazard: true

  - name: "nav_date"
    display_name: "Price Date"
    description: "THE TABLE NAME SAYS _latest BUT THE STRUCTURE SAYS HISTORY. A date column plus full OHLCV is the signature of a time series. The schema documentation CANNOT settle whether this holds one current row per instrument or full history. Run: SELECT co_code, COUNT(*) FROM dim_equity_price_latest GROUP BY 1 ORDER BY 2 DESC LIMIT 5 - the answer changes every query you write against it. Settled in this data: 25 rows, one per co_code, all dated 2026-05-19."
    type: "date"
    sql_type: "date"
    nullable: true
    filterable: true
    attribute_type: "time_dimension"

  - name: "nav_open"
    display_name: "Open"
    description: "Opening price. The nav_ prefix is a MISNOMER for equities - NAV is mutual-fund terminology; equities have a market price. The prefix was copied from the MF tables. Harmless once known, but a search for 'price' columns will miss this table entirely."
    type: "float"
    sql_type: "real"
    nullable: true
    filterable: true
    attribute_type: "fact"

  - name: "nav_high"
    display_name: "High"
    description: "Intraday high. Unlike dim_mf_nav_history this table has full OHLC, because exchange-traded instruments do have intraday ranges - so intraday volatility, true-range and gap analysis ARE possible for equity but not for funds."
    type: "float"
    sql_type: "real"
    nullable: true
    filterable: true
    attribute_type: "fact"

  - name: "nav_low"
    display_name: "Low"
    description: "Intraday low."
    type: "float"
    sql_type: "real"
    nullable: true
    filterable: true
    attribute_type: "fact"

  - name: "nav_close"
    display_name: "Close"
    description: "Closing price. Should reconcile to client_holdings.current_price for a direct equity holding on the same date - a good ongoing data-quality check. Compare with a TOLERANCE: current_price is double precision while this is real."
    type: "float"
    sql_type: "real"
    nullable: true
    filterable: true
    attribute_type: "fact"

  - name: "nav_volume"
    display_name: "Volume"
    description: "TYPE DEFECT (latent): declared integer, capped at ~2.15 billion. A heavily traded penny stock can exceed 2.15bn shares in a day and would OVERFLOW. bigint would have been the safe choice."
    type: "integer"
    sql_type: "integer"
    nullable: true
    filterable: true
    attribute_type: "fact"
    type_defect: "latent overflow - integer capped at ~2.15bn; should be bigint"

  - name: "source_table"
    display_name: "Source Table"
    description: "Lineage: name of the ORIGIN object in the SOURCE system, not this table. Proven by dim_client_master rows carrying 'clients'. Present in all 21 tables. NEVER join or filter business logic on this."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: false
    attribute_type: "dimension"
    hidden: true

  - name: "source_load_ts"
    display_name: "Source Load Timestamp"
    description: "ETL load timestamp, WITHOUT TIME ZONE - no timezone is recorded anywhere, so IST vs UTC is a convention held outside the DB. Present in 12 of 14 dim_* tables; absent from both MF history tables and from all 7 client_* facts."
    type: "timestamp"
    sql_type: "timestamp without time zone"
    nullable: true
    filterable: true
    attribute_type: "time_dimension"
    hidden: true

  - name: "row_hash"
    display_name: "Row Hash"
    description: "64-bit change-detection fingerprint; samples are 16 lowercase hex chars. Used for change-detecting upsert. Present in all 14 dim_* tables, none of the client_* facts. NEVER join on this."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: false
    attribute_type: "dimension"
    hidden: true""" ;
    meta:sourceFile "DIM_EQUITY_PRICE_LATEST_001.yaml" .

<https://wealth.example.org/neowealth/table/main/dim_client_account_map> a owl:Class,
        meta:SourceTable ;
    rdfs:label "Client Account Map" ;
    dcterms:description """DIMENSION / BRIDGE, 13 columns. Client-to-account bridge. Note it has NO id column. Grain: one row per client account - so client_id is NOT unique here. 47 rows for 30 clients; wsw_account_code is unique (47 distinct). THREE identifier groups coexist ON THE SAME ROW (folio, dp_id, and account_number + bank_name + ifsc_code): account_number, bank_name and ifsc_code are populated on all 47 rows, dp_id on 45 and folio on 25, and 25 rows carry all three groups at once. A row is therefore NOT a bank-only, demat-only or folio-only account, and neither account_type nor the identifiers present say which kind of account a row is - account_type holds Individual (30), HUF (12), Joint (3) and NRI (2). What account_type classifies, and what one row represents (e.g. one wealth-management account with linked bank, demat and folio details), is not stated by the source and must be confirmed with the data team. Keep each row's label and identifiers together; never turn a row into a Bank Account or Demat Account from its label or from which identifiers are present - a question about clients with a DP ID, IFSC code or folio on file filters on that identifier being non-null, nothing more. The join from client_holdings.wsw_account_code into this table is UNRELIABLE: of 505 holdings, 174 match on code and client_id, 210 match on code but point to an account of a DIFFERENT client, and 121 have no matching account row. Never derive client identity, or any account attribute used to identify a client, through this join. This is the only bridge from client_holdings.wsw_account_code to account details. MOST SENSITIVE TABLE IN THE SCHEMA - holds bank account numbers and IFSC codes, which are payment credentials. Stricter access control than dim_client_master; mask or tokenise everywhere outside production.
""" ;
    rdfs:subClassOf meta:SourceRow ;
    meta:hasDeclaredAttribute <https://wealth.example.org/neowealth/declared-attribute/main/dim_client_account_map/account_details_id>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_client_account_map/account_number>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_client_account_map/account_type>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_client_account_map/bank_name>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_client_account_map/client_id>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_client_account_map/dp_id>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_client_account_map/folio>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_client_account_map/ifsc_code>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_client_account_map/is_active>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_client_account_map/row_hash>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_client_account_map/source_load_ts>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_client_account_map/source_table>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_client_account_map/wsw_account_code> ;
    meta:identityMethod "configured_key" ;
    meta:rawYaml """
identity:
  id: "TABLE_DIM_CLIENT_ACCOUNT_MAP_001"
  type: "Table"
  subtype: "Dimension"
  name: "dim_client_account_map"
  display_name: "Client Account Map"
  description: >
    DIMENSION / BRIDGE, 13 columns. Client-to-account bridge. Note it has NO
    id column. Grain: one row per client account - so client_id is NOT unique
    here. 47 rows for 30 clients; wsw_account_code is unique (47 distinct).
    THREE identifier groups coexist ON THE SAME ROW (folio, dp_id, and
    account_number + bank_name + ifsc_code): account_number, bank_name and
    ifsc_code are populated on all 47 rows, dp_id on 45 and folio on 25, and 25
    rows carry all three groups at once. A row is therefore NOT a bank-only,
    demat-only or folio-only account, and neither account_type nor the identifiers
    present say which kind of account a row is - account_type holds Individual
    (30), HUF (12), Joint (3) and NRI (2). What account_type classifies, and what
    one row represents (e.g. one wealth-management account with linked bank, demat
    and folio details), is not stated by the source and must be confirmed with the
    data team. Keep each row's label and identifiers together; never turn a row
    into a Bank Account or Demat Account from its label or from which identifiers
    are present - a question about clients with a DP ID, IFSC code or folio on
    file filters on that identifier being non-null, nothing more. The join from
    client_holdings.wsw_account_code into this table is UNRELIABLE: of 505
    holdings, 174 match on code and client_id, 210 match on code but point to an
    account of a DIFFERENT client, and 121 have no matching account row. Never
    derive client identity, or any account attribute used to identify a client,
    through this join. This is the only bridge from client_holdings.wsw_account_code to account details. MOST SENSITIVE TABLE
    IN THE SCHEMA - holds bank account numbers and IFSC codes, which are payment
    credentials. Stricter access control than dim_client_master; mask or tokenise
    everywhere outside production.

layer: "dimension"
subtype_role: "bridge"
grain: "one row per client account (client_id NOT unique)"
not_null_columns: []
sensitivity: "highest in schema - payment credentials"

semantics:
  business_purpose: >
    Client-to-account bridge: one client to many account rows, each row carrying
    its bank details and, where present, a demat DP ID and an MF folio. The only
    path from a fact (client_holdings.wsw_account_code) to account details. What a
    row represents is not stated by the source and must be confirmed with the data team. Most sensitive table in the
    schema.

attributes:
  - name: "client_id"
    display_name: "Client ID"
    description: "-> dim_client_master.id. Many-to-one: a client with several accounts has several rows here, so client_id is NOT unique in this table."
    type: "integer"
    sql_type: "integer"
    nullable: true
    filterable: true
    attribute_type: "identifier"
    join_target: "dim_client_master.id"

  - name: "account_details_id"
    display_name: "Account Details ID"
    description: "The account's surrogate key in the UPSTREAM source system. There is no dim_account table, so this points at nothing inside the warehouse - a dangling reference useful only for tracing back to the source."
    type: "integer"
    sql_type: "integer"
    nullable: true
    filterable: true
    attribute_type: "identifier"
    missing_dimension: "dim_account"

  - name: "account_number"
    display_name: "Account Number"
    description: "Bank account number. Populated on all 47 rows. PAYMENT CREDENTIAL - this table warrants stricter access control than dim_client_master. Mask or tokenise in every non-production copy."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "identifier"
    pii: true
    payment_credential: true

  - name: "account_type"
    display_name: "Account Type"
    description: "Uncontrolled varchar(256) with no declared enumeration. Observed values: Individual (30 rows), HUF (12), Joint (3), NRI (2) - a holder/ownership category, NOT a bank / demat / folio discriminator. It does not tell you which identifier group to read: Individual, HUF and Joint rows carry bank, DP ID and (on some rows) folio identifiers together, and the 2 NRI rows carry bank identifiers only. What account_type classifies is not stated by the source and must be confirmed with the data team. Keep the original label; never derive an account kind from it."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "dimension"
    observed_values: ["Individual", "HUF", "Joint", "NRI"]
    meaning_pending_confirmation: true

  - name: "wsw_account_code"
    display_name: "Account Code"
    description: "-> client_holdings.wsw_account_code. THE ONLY account key reachable from a fact table, so this is the one to join on. Unique in this data (47 distinct codes on 47 rows). Of the 505 holdings, 174 match a code here with the same client_id, 210 match a code whose row names a DIFFERENT client_id, and 121 carry a code absent from this table. A code match is a source-record match, not validated client ownership - reproduce each query's own join condition exactly (see client_holdings.wsw_account_code)."
    type: "integer"
    sql_type: "integer"
    nullable: true
    filterable: true
    attribute_type: "identifier"
    join_target: "client_holdings.wsw_account_code"

  - name: "folio"
    display_name: "Folio"
    description: "Mutual fund folio number, assigned by the AMC/RTA. Populated on 25 of 47 rows, always alongside dp_id and the bank details on the same row - so its presence does not identify an MF-only account. When folio is populated is not stated by the source and must be confirmed with the data team (Y1)."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "identifier"

  - name: "dp_id"
    display_name: "DP ID"
    description: "Depository Participant ID - part of the NSDL/CDSL demat account identifier for dematerialised securities. Populated on 45 of 47 rows (blank only on the 2 NRI rows), alongside the bank details on the same row - so its presence does not identify a demat-only account. When dp_id is populated is not stated by the source and must be confirmed with the data team (Y1)."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "identifier"

  - name: "bank_name"
    display_name: "Bank Name"
    description: "Part of the banking triple used for settlement, payouts and mandates."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "dimension"

  - name: "ifsc_code"
    display_name: "IFSC Code"
    description: "Indian Financial System Code - pins the specific bank branch. Payment credential; mask outside production."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "identifier"
    pii: true
    payment_credential: true

  - name: "is_active"
    display_name: "Is Active"
    description: "Distinguishes live from closed accounts. CAUTION: a closed account may still have historical holdings attached, so filtering on this when joining to client_holdings can drop legitimate historical positions. Be deliberate."
    type: "boolean"
    sql_type: "boolean"
    nullable: true
    filterable: true
    attribute_type: "dimension"
    three_valued: true

  - name: "source_table"
    display_name: "Source Table"
    description: "Lineage: name of the ORIGIN object in the SOURCE system, not this table. Proven by dim_client_master rows carrying 'clients'. Present in all 21 tables. NEVER join or filter business logic on this."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: false
    attribute_type: "dimension"
    hidden: true

  - name: "source_load_ts"
    display_name: "Source Load Timestamp"
    description: "ETL load timestamp, WITHOUT TIME ZONE - no timezone is recorded anywhere, so IST vs UTC is a convention held outside the DB. Present in 12 of 14 dim_* tables; absent from both MF history tables and from all 7 client_* facts."
    type: "timestamp"
    sql_type: "timestamp without time zone"
    nullable: true
    filterable: true
    attribute_type: "time_dimension"
    hidden: true

  - name: "row_hash"
    display_name: "Row Hash"
    description: "64-bit change-detection fingerprint; samples are 16 lowercase hex chars. Used for change-detecting upsert. Present in all 14 dim_* tables, none of the client_* facts. NEVER join on this."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: false
    attribute_type: "dimension"
    hidden: true""" ;
    meta:sourceFile "DIM_CLIENT_ACCOUNT_MAP_001.yaml" .

<https://wealth.example.org/neowealth/table/main/dim_cmot_company_mstr> a owl:Class,
        meta:SourceTable ;
    rdfs:label "Company Master" ;
    dcterms:description """DIMENSION, 14 columns. Listed-company master; the equity counterpart to dim_mf_fund_complete. GRAIN: one row per listed company, keyed on co_code - the vendor's company key and the join hub for the equity tables. 'cmot' is a vendor/source-system code for the Indian equity reference-data provider (co_code + nse_symbol + bse_code + bse_group is the classic Capitaline/CMOTS identifier set); the schema documentation does not define the acronym. mcap_type has NO effective date despite SEBI reclassifying every six months. No dim_sector backs sector_code/sector_name.
""" ;
    rdfs:subClassOf meta:SourceRow ;
    meta:hasDeclaredAttribute <https://wealth.example.org/neowealth/declared-attribute/main/dim_cmot_company_mstr/bse_code>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_cmot_company_mstr/bse_group>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_cmot_company_mstr/co_code>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_cmot_company_mstr/company_name>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_cmot_company_mstr/company_short_name>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_cmot_company_mstr/is_active>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_cmot_company_mstr/isin>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_cmot_company_mstr/mcap_type>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_cmot_company_mstr/nse_symbol>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_cmot_company_mstr/row_hash>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_cmot_company_mstr/sector_code>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_cmot_company_mstr/sector_name>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_cmot_company_mstr/source_load_ts>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_cmot_company_mstr/source_table> ;
    meta:identityMethod "configured_key" ;
    meta:rawYaml """
identity:
  id: "TABLE_DIM_CMOT_COMPANY_MSTR_001"
  type: "Table"
  subtype: "Dimension"
  name: "dim_cmot_company_mstr"
  display_name: "Company Master"
  description: >
    DIMENSION, 14 columns. Listed-company master; the equity counterpart to
    dim_mf_fund_complete. GRAIN: one row per listed company, keyed on co_code - the
    vendor's company key and the join hub for the equity tables. 'cmot' is a
    vendor/source-system code for the Indian equity reference-data provider
    (co_code + nse_symbol + bse_code + bse_group is the classic Capitaline/CMOTS
    identifier set); the schema documentation does not define the acronym. mcap_type has NO
    effective date despite SEBI reclassifying every six months. No dim_sector backs
    sector_code/sector_name.

layer: "dimension"
grain: "one row per listed company (keyed on co_code)"
not_null_columns: []

semantics:
  business_purpose: >
    Listed-company master and equity join hub, keyed on co_code. Carries the
    classic vendor identifier set and market-cap band. No backing dim_sector.

attributes:
  - name: "co_code"
    display_name: "Company Code"
    description: "The vendor's internal COMPANY key and the join hub for the equity tables. WARNING: dim_cmot_index_prices reuses this same column name for an INDEX. Never join the two tables on co_code - such a join compiles, returns rows, and is entirely meaningless."
    type: "integer"
    sql_type: "integer"
    nullable: true
    filterable: true
    attribute_type: "identifier"
    warning: "co_code identifies an INDEX in dim_cmot_index_prices; never join the two on co_code"

  - name: "isin"
    display_name: "ISIN"
    description: "Equity ISIN (INE prefix)."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "identifier"

  - name: "company_name"
    display_name: "Company Name"
    description: "Full legal name, e.g. 'Bharat Electronics Ltd', 'Larsen & Toubro Ltd'."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "dimension"

  - name: "company_short_name"
    display_name: "Company Short Name"
    description: "Display abbreviation."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "dimension"

  - name: "nse_symbol"
    display_name: "NSE Symbol"
    description: "NSE ticker, e.g. RELIANCE."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "identifier"

  - name: "bse_code"
    display_name: "BSE Code"
    description: "BSE scrip code, e.g. 500325. NAMING TRAP: dim_product_unified_cat calls the identical concept 'bse_symbol' - same integer type, two names. A company may list on one or both exchanges, so either code may be NULL."
    type: "integer"
    sql_type: "integer"
    nullable: true
    filterable: true
    attribute_type: "identifier"
    naming_trap: "called bse_symbol in dim_product_unified_cat"

  - name: "bse_group"
    display_name: "BSE Group"
    description: "BSE liquidity/surveillance classification (A, B, T, Z ...). The Z and T groups flag restricted or surveillance-listed scrips, so this column has real risk-monitoring value. Every one of the 25 companies in this data is in group A; no B, T or Z scrip occurs."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "dimension"
    observed_values: ["A"]

  - name: "mcap_type"
    display_name: "Market Cap Type"
    description: "Market-capitalisation band (Large/Mid/Small Cap) per SEBI's ranked definition. STORED AS A SINGLE CURRENT VALUE WITH NO EFFECTIVE DATE, yet SEBI reclassifies the universe every six months. Historical style analysis using this column applies TODAY's classification to PAST holdings - a subtle but real point-in-time error the schema has no mechanism to fix. Observed values (25 rows): Large Cap (20), Mid Cap (4), Small Cap (1)."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "dimension"
    observed_values: ["Large Cap", "Mid Cap", "Small Cap"]

  - name: "sector_code"
    display_name: "Sector Code"
    description: "Sector classification code - the basis for concentration and diversification reporting. No dim_sector table exists."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "identifier"
    missing_dimension: "dim_sector"

  - name: "sector_name"
    display_name: "Sector Name"
    description: "Sector name. NAMING TRAP: dim_product_unified_cat stores the same concept as a bare 'sector' column with no code."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "dimension"
    naming_trap: "stored as bare 'sector' in dim_product_unified_cat"

  - name: "is_active"
    display_name: "Is Active"
    description: "No is_deleted here. A delisted company would be marked is_active = FALSE rather than removed, which is correct since historical holdings still reference it."
    type: "boolean"
    sql_type: "boolean"
    nullable: true
    filterable: true
    attribute_type: "dimension"
    three_valued: true

  - name: "source_table"
    display_name: "Source Table"
    description: "Lineage: name of the ORIGIN object in the SOURCE system, not this table. Proven by dim_client_master rows carrying 'clients'. Present in all 21 tables. NEVER join or filter business logic on this."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: false
    attribute_type: "dimension"
    hidden: true

  - name: "source_load_ts"
    display_name: "Source Load Timestamp"
    description: "ETL load timestamp, WITHOUT TIME ZONE - no timezone is recorded anywhere, so IST vs UTC is a convention held outside the DB. Present in 12 of 14 dim_* tables; absent from both MF history tables and from all 7 client_* facts."
    type: "timestamp"
    sql_type: "timestamp without time zone"
    nullable: true
    filterable: true
    attribute_type: "time_dimension"
    hidden: true

  - name: "row_hash"
    display_name: "Row Hash"
    description: "64-bit change-detection fingerprint; samples are 16 lowercase hex chars. Used for change-detecting upsert. Present in all 14 dim_* tables, none of the client_* facts. NEVER join on this."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: false
    attribute_type: "dimension"
    hidden: true""" ;
    meta:sourceFile "DIM_CMOT_COMPANY_MSTR_001.yaml" .

<https://wealth.example.org/neowealth/table/main/dim_mf_returns_history> a owl:Class,
        meta:SourceTable ;
    rdfs:label "MF Returns History" ;
    dcterms:description """TIME SERIES, 15 columns. Pre-computed trailing returns - one row per fund per return_date holding the FULL trailing-return vector as of that date. THE MOST STRIKING DEFECT IN THE SCHEMA: the seven return columns are split across two types with no conceivable business reason - return_1m/3m/6m/1y are character varying(256) while return_3y/5y/10y are properly real. Naive fund rankings on the text columns are SILENTLY AND COMPLETELY WRONG (lexicographic sort), and cross-horizon comparison needs a cast on one side of every query. Everything here is derivable from dim_mf_nav_history, and given the type problems, COMPUTING RETURNS FROM THE NAV SERIES YOURSELF IS THE MORE RELIABLE ROUTE - correct types, a known annualisation convention, and arbitrary custom horizons.
""" ;
    rdfs:subClassOf meta:SourceRow ;
    meta:hasDeclaredAttribute <https://wealth.example.org/neowealth/declared-attribute/main/dim_mf_returns_history/category>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_mf_returns_history/fund_id>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_mf_returns_history/fund_name>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_mf_returns_history/isin>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_mf_returns_history/mstar_id>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_mf_returns_history/return_10y>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_mf_returns_history/return_1m>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_mf_returns_history/return_1y>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_mf_returns_history/return_3m>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_mf_returns_history/return_3y>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_mf_returns_history/return_5y>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_mf_returns_history/return_6m>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_mf_returns_history/return_date>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_mf_returns_history/row_hash>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_mf_returns_history/source_table> ;
    meta:identityMethod "configured_key" ;
    meta:rawYaml """
identity:
  id: "TABLE_DIM_MF_RETURNS_HISTORY_001"
  type: "Table"
  subtype: "Dimension"
  name: "dim_mf_returns_history"
  display_name: "MF Returns History"
  description: >
    TIME SERIES, 15 columns. Pre-computed trailing returns - one row per fund
    per return_date holding the FULL trailing-return vector as of that date. THE
    MOST STRIKING DEFECT IN THE SCHEMA: the seven return columns are split across
    two types with no conceivable business reason - return_1m/3m/6m/1y are
    character varying(256) while return_3y/5y/10y are properly real. Naive fund
    rankings on the text columns are SILENTLY AND COMPLETELY WRONG (lexicographic
    sort), and cross-horizon comparison needs a cast on one side of every query.
    Everything here is derivable from dim_mf_nav_history, and given the type
    problems, COMPUTING RETURNS FROM THE NAV SERIES YOURSELF IS THE MORE RELIABLE
    ROUTE - correct types, a known annualisation convention, and arbitrary custom
    horizons.

layer: "dimension"
structural_type: "time_series"
grain: "mstar_id x return_date (or isin x return_date)"
not_null_columns: []
note: "Lacks source_load_ts (append-only). Prefer computing returns from dim_mf_nav_history."

semantics:
  business_purpose: >
    Pre-computed trailing returns per fund per as-of date. Four short-horizon
    columns are mis-typed as text (wrong when ranked naively); three long-horizon
    columns are properly numeric. Computing from the NAV series is more reliable.

attributes:
  - name: "fund_id"
    display_name: "Fund ID"
    description: "Carried here but NOT in dim_mf_nav_history - a small inconsistency between the two history tables."
    type: "integer"
    sql_type: "integer"
    nullable: true
    filterable: true
    attribute_type: "identifier"

  - name: "mstar_id"
    display_name: "Morningstar ID"
    description: "Part of the grain: (mstar_id, return_date)."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "identifier"
    join_target: "dim_mf_fund_complete.mstar_id"

  - name: "isin"
    display_name: "ISIN"
    description: "Alternative grain key."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "identifier"

  - name: "fund_name"
    display_name: "Fund Name"
    description: "Denormalised onto every row."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "dimension"

  - name: "category"
    display_name: "Category"
    description: "Denormalised onto every row."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "dimension"

  - name: "return_date"
    display_name: "Return Date"
    description: "The as-of date. One row holds the FULL trailing-return vector as of this date."
    type: "date"
    sql_type: "date"
    nullable: true
    filterable: true
    attribute_type: "time_dimension"

  - name: "return_1m"
    display_name: "Return 1M"
    description: "TYPE DEFECT: character varying(256) while return_3y/5y/10y in this same table are proper real. AVG() fails; ORDER BY sorts lexicographically so '9.5' ranks ABOVE '12.3' and any top-performing-funds ranking built naively on it is SILENTLY AND COMPLETELY WRONG. A bare cast will THROW on the first sentinel value. Use the regex-guarded CASE."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "dimension"
    attribute_type_corrected: "fact"
    type_defect: "numeric return stored as varchar; use regex-guarded cast or compute from NAV series"

  - name: "return_3m"
    display_name: "Return 3M"
    description: "TYPE DEFECT: character varying(256). See return_1m."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "dimension"
    attribute_type_corrected: "fact"
    type_defect: "numeric return stored as varchar; use regex-guarded cast or compute from NAV series"

  - name: "return_6m"
    display_name: "Return 6M"
    description: "TYPE DEFECT: character varying(256). See return_1m."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "dimension"
    attribute_type_corrected: "fact"
    type_defect: "numeric return stored as varchar; use regex-guarded cast or compute from NAV series"

  - name: "return_1y"
    display_name: "Return 1Y"
    description: "TYPE DEFECT: character varying(256). See return_1m. Because it is text the UNIT is unverifiable - whether '31.56' means 31.56% or 0.3156 cannot be determined from the schema. The analogous client_holdings.unrealized_gain_pct samples use whole percent, so the same convention is inferred."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "dimension"
    attribute_type_corrected: "fact"
    type_defect: "numeric return stored as varchar; unit (percent vs decimal) unverifiable; use regex-guarded cast or compute from NAV series"

  - name: "return_3y"
    display_name: "Return 3Y"
    description: "Properly typed real. Multi-year horizons are CONVENTIONALLY annualised (CAGR) while sub-1-year figures are absolute - but the schema documentation does NOT state this, and getting it backwards changes a 3-year number by roughly a factor of three. Confirm with the data vendor before publishing."
    type: "float"
    sql_type: "real"
    nullable: true
    filterable: true
    attribute_type: "fact"

  - name: "return_5y"
    display_name: "Return 5Y"
    description: "Properly typed real. Same annualisation caveat."
    type: "float"
    sql_type: "real"
    nullable: true
    filterable: true
    attribute_type: "fact"

  - name: "return_10y"
    display_name: "Return 10Y"
    description: "Properly typed real. Same annualisation caveat."
    type: "float"
    sql_type: "real"
    nullable: true
    filterable: true
    attribute_type: "fact"

  - name: "source_table"
    display_name: "Source Table"
    description: "Lineage: name of the ORIGIN object in the SOURCE system, not this table. Proven by dim_client_master rows carrying 'clients'. Present in all 21 tables. NEVER join or filter business logic on this."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: false
    attribute_type: "dimension"
    hidden: true

  - name: "row_hash"
    display_name: "Row Hash"
    description: "64-bit change-detection fingerprint; samples are 16 lowercase hex chars. Used for change-detecting upsert. Present in all 14 dim_* tables, none of the client_* facts. NEVER join on this."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: false
    attribute_type: "dimension"
    hidden: true""" ;
    meta:sourceFile "DIM_MF_RETURNS_HISTORY_001.yaml" .

<https://wealth.example.org/neowealth/table/main/client_realized_gain> a owl:Class,
        meta:SourceTable ;
    rdfs:label "Client Realized Gain" ;
    dcterms:description """FACT, 15 columns. Closed positions and booked P&L. Grain: one row per MATCHED BUY-SELL LOT - each row carries both legs, so this is pre-computed lot-matching output, not raw events. The matching method (FIFO/LIFO/specific-identification) is NOT recorded and it matters for Indian tax reporting. VERIFIED: realized_gain = (sell_price - buy_price) * quantity, gross of costs; holding_period_days = sell_date - buy_date in calendar days. There is NO realized_loss column - losses are negative realized_gain.
""" ;
    rdfs:subClassOf meta:SourceRow ;
    meta:hasDeclaredAttribute <https://wealth.example.org/neowealth/declared-attribute/main/client_realized_gain/buy_date>,
        <https://wealth.example.org/neowealth/declared-attribute/main/client_realized_gain/buy_price>,
        <https://wealth.example.org/neowealth/declared-attribute/main/client_realized_gain/client_id>,
        <https://wealth.example.org/neowealth/declared-attribute/main/client_realized_gain/client_pan>,
        <https://wealth.example.org/neowealth/declared-attribute/main/client_realized_gain/holding_period_days>,
        <https://wealth.example.org/neowealth/declared-attribute/main/client_realized_gain/id>,
        <https://wealth.example.org/neowealth/declared-attribute/main/client_realized_gain/instrument_name>,
        <https://wealth.example.org/neowealth/declared-attribute/main/client_realized_gain/isin>,
        <https://wealth.example.org/neowealth/declared-attribute/main/client_realized_gain/product_id>,
        <https://wealth.example.org/neowealth/declared-attribute/main/client_realized_gain/product_type>,
        <https://wealth.example.org/neowealth/declared-attribute/main/client_realized_gain/quantity>,
        <https://wealth.example.org/neowealth/declared-attribute/main/client_realized_gain/realized_gain>,
        <https://wealth.example.org/neowealth/declared-attribute/main/client_realized_gain/sell_date>,
        <https://wealth.example.org/neowealth/declared-attribute/main/client_realized_gain/sell_price>,
        <https://wealth.example.org/neowealth/declared-attribute/main/client_realized_gain/source_table> ;
    meta:identityMethod "configured_key" ;
    meta:rawYaml """
identity:
  id: "TABLE_CLIENT_REALIZED_GAIN_001"
  type: "Table"
  subtype: "Fact"
  name: "client_realized_gain"
  display_name: "Client Realized Gain"
  description: >
    FACT, 15 columns. Closed positions and booked P&L. Grain: one row per
    MATCHED BUY-SELL LOT - each row carries both legs, so this is pre-computed
    lot-matching output, not raw events. The matching method
    (FIFO/LIFO/specific-identification) is NOT recorded and it matters for Indian
    tax reporting. VERIFIED: realized_gain = (sell_price - buy_price) *
    quantity, gross of costs; holding_period_days = sell_date - buy_date in
    calendar days. There is NO realized_loss column - losses are negative
    realized_gain.

layer: "fact"
grain: "one row per matched buy-sell lot"
not_null_columns: []

semantics:
  business_purpose: >
    Closed-position booked P&L, one row per matched buy-sell lot with both legs.
    Realized gain and holding period are verified arithmetic identities; losses
    are negative realized_gain. Lot-matching method is not recorded.

attributes:
  - name: "id"
    display_name: "ID"
    description: "Nullable. Sample range 110001+."
    type: "integer"
    sql_type: "integer"
    nullable: true
    filterable: true
    attribute_type: "identifier"

  - name: "client_id"
    display_name: "Client ID"
    description: "-> dim_client_master.id. Samples reference 7001-7004."
    type: "integer"
    sql_type: "integer"
    nullable: true
    filterable: true
    attribute_type: "identifier"
    join_target: "dim_client_master.id"

  - name: "client_pan"
    display_name: "Client PAN"
    description: "Denormalised PAN. Do not join on it. PII."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "identifier"
    pii: true
    do_not_join: true

  - name: "isin"
    display_name: "ISIN"
    description: "Instrument identity."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "identifier"

  - name: "product_id"
    display_name: "Product ID"
    description: "-> dim_product_unified_cat.product_id."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "identifier"
    join_target: "dim_product_unified_cat.product_id"

  - name: "product_type"
    display_name: "Product Type"
    description: "Denormalised. REQUIRED for capital-gains classification: the Indian long/short-term boundary depends on asset class, so holding_period_days alone cannot classify a gain."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "dimension"

  - name: "instrument_name"
    display_name: "Instrument Name"
    description: "Denormalised instrument label."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "dimension"

  - name: "buy_date"
    display_name: "Buy Date"
    description: "Buy leg of the matched lot. Samples span 2023-03-07 to 2025-07-06."
    type: "date"
    sql_type: "date"
    nullable: true
    filterable: true
    attribute_type: "time_dimension"

  - name: "sell_date"
    display_name: "Sell Date"
    description: "Sell leg. Samples span 2025-12-22 to 2026-05-08."
    type: "date"
    sql_type: "date"
    nullable: true
    filterable: true
    attribute_type: "time_dimension"

  - name: "buy_price"
    display_name: "Buy Price"
    description: "Per-unit purchase price of the lot."
    type: "float"
    sql_type: "real"
    nullable: true
    filterable: true
    attribute_type: "fact"

  - name: "sell_price"
    display_name: "Sell Price"
    description: "Per-unit sale price of the lot."
    type: "float"
    sql_type: "real"
    nullable: true
    filterable: true
    attribute_type: "fact"

  - name: "quantity"
    display_name: "Quantity"
    description: "Units in the matched lot."
    type: "float"
    sql_type: "real"
    nullable: true
    filterable: true
    attribute_type: "fact"

  - name: "realized_gain"
    display_name: "Realized Gain"
    description: "VERIFIED on sample id 110001 (SBI, 130 units, 505.19 -> 799.52): (799.52 - 505.19) * 130 = 38262.90, EXACT. So realized_gain = (sell_price - buy_price) * quantity, GROSS of costs - no brokerage, STT or tax is netted off. There is NO realized_loss column and no sign flag, so a loss must be a NEGATIVE realized_gain. SUM() therefore yields a NET figure; split on sign to report gross gains and losses separately."
    type: "float"
    sql_type: "double precision"
    nullable: true
    filterable: true
    attribute_type: "fact"
    verified_identity: "(sell_price - buy_price) * quantity"

  - name: "holding_period_days"
    display_name: "Holding Period Days"
    description: "VERIFIED on id 110001: 2024-07-01 -> 2026-04-05 = 643 days, exact. Plain calendar-day difference sell_date - buy_date. Samples range 210-1091 days. Combine with product_type to classify short vs long term; the schema encodes no threshold."
    type: "integer"
    sql_type: "integer"
    nullable: true
    filterable: true
    attribute_type: "fact"
    verified_identity: "sell_date - buy_date (calendar days)"

  - name: "source_table"
    display_name: "Source Table"
    description: "Lineage: name of the ORIGIN object in the SOURCE system, not this table. Proven by dim_client_master rows carrying 'clients'. Present in all 21 tables. NEVER join or filter business logic on this."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: false
    attribute_type: "dimension"
    hidden: true""" ;
    meta:sourceFile "CLIENT_REALIZED_GAIN_001.yaml" .

<https://wealth.example.org/neowealth/table/main/dim_lob_hierarchy> a owl:Class,
        meta:SourceTable ;
    rdfs:label "LOB Hierarchy" ;
    dcterms:description """DIMENSION, 11 columns. Organisational structure: SBU -> LOB -> Sub-LOB, flattened one row per leaf. No id column. GRAIN IS SUB-LOB, NOT LOB. lob_id is therefore NOT UNIQUE, SELECT lob_name returns duplicates, and joining any fact on lob_id alone FANS OUT and multiplies measures by the number of sub-LOBs. This is the single most likely cause of inflated totals when working with this schema. sbu_name has no id or code - the top level is identified by NAME ONLY.
""" ;
    rdfs:subClassOf meta:SourceRow ;
    meta:hasDeclaredAttribute <https://wealth.example.org/neowealth/declared-attribute/main/dim_lob_hierarchy/is_active>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_lob_hierarchy/lob_code>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_lob_hierarchy/lob_id>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_lob_hierarchy/lob_name>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_lob_hierarchy/row_hash>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_lob_hierarchy/sbu_name>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_lob_hierarchy/source_load_ts>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_lob_hierarchy/source_table>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_lob_hierarchy/sub_lob_code>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_lob_hierarchy/sub_lob_id>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_lob_hierarchy/sub_lob_name> ;
    meta:identityMethod "configured_key" ;
    meta:rawYaml """
identity:
  id: "TABLE_DIM_LOB_HIERARCHY_001"
  type: "Table"
  subtype: "Dimension"
  name: "dim_lob_hierarchy"
  display_name: "LOB Hierarchy"
  description: >
    DIMENSION, 11 columns. Organisational structure: SBU -> LOB -> Sub-LOB,
    flattened one row per leaf. No id column. GRAIN IS SUB-LOB, NOT LOB. lob_id is
    therefore NOT UNIQUE, SELECT lob_name returns duplicates, and joining any fact
    on lob_id alone FANS OUT and multiplies measures by the number of sub-LOBs.
    This is the single most likely cause of inflated totals when working with this
    schema. sbu_name has no id or code - the top level is identified by NAME ONLY.

layer: "dimension"
grain: "one row per sub-LOB (leaf); lob_id NOT unique"
not_null_columns: []
fan_out_hazard: true

semantics:
  business_purpose: >
    Organisational hierarchy SBU -> LOB -> Sub-LOB, flattened one row per leaf.
    Grain is sub-LOB, so lob_id is not unique - the primary fan-out hazard in the
    schema.

attributes:
  - name: "lob_id"
    display_name: "LOB ID"
    description: "Line of Business, the MIDDLE level. NOT UNIQUE in this table - the grain is sub-LOB, so LOB columns repeat across every sub-LOB. This is the single most likely cause of inflated totals in the whole schema."
    type: "integer"
    sql_type: "integer"
    nullable: true
    filterable: true
    attribute_type: "identifier"
    not_unique: true

  - name: "lob_code"
    display_name: "LOB Code"
    description: "Short business code for the LOB."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "identifier"

  - name: "lob_name"
    display_name: "LOB Name"
    description: "LOB display name. SELECT lob_name FROM dim_lob_hierarchy RETURNS DUPLICATES."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "dimension"

  - name: "sub_lob_id"
    display_name: "Sub-LOB ID"
    description: "Sub-LOB, the LEAF level and the true grain of this table. Samples: 10 = Private Wealth, 11 = Family Office."
    type: "integer"
    sql_type: "integer"
    nullable: true
    filterable: true
    attribute_type: "identifier"

  - name: "sub_lob_code"
    display_name: "Sub-LOB Code"
    description: "Short business code for the sub-LOB."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "identifier"

  - name: "sub_lob_name"
    display_name: "Sub-LOB Name"
    description: "Sub-LOB display name."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "dimension"

  - name: "sbu_name"
    display_name: "SBU Name"
    description: "Strategic Business Unit, the TOP level. Has NO accompanying sbu_id or sbu_code - the top of the hierarchy is identified by NAME ONLY, so SBU rollups group on a text label vulnerable to whitespace and casing, and the SBU cannot be renamed safely."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "dimension"

  - name: "is_active"
    display_name: "Is Active"
    description: "Note this table has is_active but NO is_deleted, unlike the client and employee dimensions - the soft-delete convention is applied inconsistently across the schema."
    type: "boolean"
    sql_type: "boolean"
    nullable: true
    filterable: true
    attribute_type: "dimension"
    three_valued: true

  - name: "source_table"
    display_name: "Source Table"
    description: "Lineage: name of the ORIGIN object in the SOURCE system, not this table. Proven by dim_client_master rows carrying 'clients'. Present in all 21 tables. NEVER join or filter business logic on this."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: false
    attribute_type: "dimension"
    hidden: true

  - name: "source_load_ts"
    display_name: "Source Load Timestamp"
    description: "ETL load timestamp, WITHOUT TIME ZONE - no timezone is recorded anywhere, so IST vs UTC is a convention held outside the DB. Present in 12 of 14 dim_* tables; absent from both MF history tables and from all 7 client_* facts."
    type: "timestamp"
    sql_type: "timestamp without time zone"
    nullable: true
    filterable: true
    attribute_type: "time_dimension"
    hidden: true

  - name: "row_hash"
    display_name: "Row Hash"
    description: "64-bit change-detection fingerprint; samples are 16 lowercase hex chars. Used for change-detecting upsert. Present in all 14 dim_* tables, none of the client_* facts. NEVER join on this."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: false
    attribute_type: "dimension"
    hidden: true""" ;
    meta:sourceFile "DIM_LOB_HIERARCHY_001.yaml" .

<https://wealth.example.org/neowealth/table/main/dim_product_credit_rtng> a owl:Class,
        meta:SourceTable ;
    rdfs:label "Product Credit Rating" ;
    dcterms:description """DIMENSION, 16 columns. Fixed-income ratings and terms (rtng = rating). Grain: one row per fixed-income instrument keyed by isin and/or scheme_master_id (in this data only scheme_master_id is unique - isin holds the literal 'N/A' on 3 rows); equity has no place here. Holds FIVE agency-specific ratings plus a consolidated pair, because the same bond is often rated differently by different agencies and Indian regulation requires disclosure of each. The rule that selects the consolidated credit_rating is NOT recorded. Ratings are free text with NO numeric rank and no dim_credit_rating scale table, so you CANNOT sort or compare them without building your own ordinal mapping - and notation varies by agency (CRISIL AAA vs [ICRA]AAA). This is the SOURCE OF RECORD for the fixed-income attributes that dim_product_unified_cat caches. No is_active flag.
""" ;
    rdfs:subClassOf meta:SourceRow ;
    meta:hasDeclaredAttribute <https://wealth.example.org/neowealth/declared-attribute/main/dim_product_credit_rtng/brick_rating>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_product_credit_rtng/care_rating>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_product_credit_rtng/credit_rating>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_product_credit_rtng/credit_rating_agency>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_product_credit_rtng/crisil_rating>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_product_credit_rtng/face_value>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_product_credit_rtng/fitch_rating>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_product_credit_rtng/icra_rating>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_product_credit_rtng/instrument_name>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_product_credit_rtng/interest_rate>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_product_credit_rtng/isin>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_product_credit_rtng/maturity_date>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_product_credit_rtng/row_hash>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_product_credit_rtng/scheme_master_id>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_product_credit_rtng/source_load_ts>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_product_credit_rtng/source_table> ;
    meta:identityMethod "configured_key" ;
    meta:rawYaml """
identity:
  id: "TABLE_DIM_PRODUCT_CREDIT_RTNG_001"
  type: "Table"
  subtype: "Dimension"
  name: "dim_product_credit_rtng"
  display_name: "Product Credit Rating"
  description: >
    DIMENSION, 16 columns. Fixed-income ratings and terms (rtng = rating).
    Grain: one row per fixed-income instrument keyed by isin and/or
    scheme_master_id (in this data only scheme_master_id is unique - isin
    holds the literal 'N/A' on 3 rows); equity has no place here. Holds FIVE agency-specific ratings
    plus a consolidated pair, because the same bond is often rated differently by
    different agencies and Indian regulation requires disclosure of each. The rule
    that selects the consolidated credit_rating is NOT recorded. Ratings are free
    text with NO numeric rank and no dim_credit_rating scale table, so you CANNOT
    sort or compare them without building your own ordinal mapping - and notation
    varies by agency (CRISIL AAA vs [ICRA]AAA). This is the SOURCE OF RECORD
    for the fixed-income attributes that dim_product_unified_cat caches. No
    is_active flag.

layer: "dimension"
grain: "one row per fixed-income instrument (isin and/or scheme_master_id)"
not_null_columns: []
missing_dimension: "dim_credit_rating (no ordinal rank scale)"

semantics:
  business_purpose: >
    Fixed-income ratings and terms - source of record for the credit attributes
    cached in dim_product_unified_cat. Five agency ratings plus a consolidated
    pair; ratings are free text with no ordinal scale.

attributes:
  - name: "isin"
    display_name: "ISIN"
    description: "Intended instrument identifier - one row per fixed-income instrument; equity and equity MF have no place here. It is NOT a key in this data - NOT UNIQUE: 15 rows, 12 distinct real ISINs, and the literal text 'N/A' on 3 rows (scheme_master_id 40011, 40012, 40014). scheme_master_id is unique on all 15 rows - prefer it to join to the catalogue (matches all rows), and use isin only as a fallback. Whether 'N/A' is literal source text or an export marker for a missing value is not stated by the source; it is kept as the text 'N/A' - never silently replaced with NULL, blank or another default (IS NULL and = 'N/A' select different rows). It matches no product ISIN, so those 3 rows drop out of any ISIN join."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "identifier"

  - name: "scheme_master_id"
    display_name: "Scheme Master ID"
    description: "-> dim_product_unified_cat.scheme_master_id. The PREFERRED join to the catalogue: it matches every row, whereas 3 rows have isin = 'N/A' and so miss on an isin join."
    type: "integer"
    sql_type: "integer"
    nullable: true
    filterable: true
    attribute_type: "identifier"
    join_target: "dim_product_unified_cat.scheme_master_id"

  - name: "instrument_name"
    display_name: "Instrument Name"
    description: "Duplicated in dim_product_unified_cat."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "dimension"

  - name: "credit_rating"
    display_name: "Credit Rating"
    description: "The CONSOLIDATED headline rating chosen from the agency columns. The schema documentation does NOT state the selection rule (lowest/most conservative, or the primary agency's). Do not assume - the choice directly affects risk reporting. This table is the source of record; the unified catalogue holds a cached copy."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "dimension"

  - name: "credit_rating_agency"
    display_name: "Credit Rating Agency"
    description: "Which agency the consolidated credit_rating came from."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "dimension"

  - name: "care_rating"
    display_name: "CARE Rating"
    description: "CARE Ratings grade."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "dimension"

  - name: "icra_rating"
    display_name: "ICRA Rating"
    description: "ICRA grade (Moody's affiliate). Note ICRA writes its grades as '[ICRA]AAA', so notation differs by agency and a naive string comparison across the five columns will NOT align."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "dimension"

  - name: "crisil_rating"
    display_name: "CRISIL Rating"
    description: "CRISIL grade (S&P affiliate; largest Indian CRA). Note CRISIL writes 'CRISIL AAA'."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "dimension"

  - name: "fitch_rating"
    display_name: "Fitch Rating"
    description: "Fitch / India Ratings grade."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "dimension"

  - name: "brick_rating"
    display_name: "Brickwork Rating"
    description: "TYPE DEFECT: declared hllsketch. Should be varchar(256) - it sits in a run of eight sibling rating columns that are ALL varchar, and Brickwork Ratings is an Indian credit-rating agency whose grades are plainly text. Near-certain cause: the column arrived 100% NULL and the loader could not infer a type. UNQUERYABLE - Redshift restricts hllsketch to HLL functions, so casting or comparing it to a string will ERROR. Treat as unavailable; any 'how many agencies rated this bond' count is wrong by one wherever Brickwork was the rater. EXPORT MISMATCH: the CSV has no brick_rating column; it carries brick_rating_count instead, blank on all 15 rows. The loader keeps this DDL name, so brick_rating loads 100% NULL. A count and a rating are different information - never map brick_rating_count onto this field. Both hllsketch columns in the DDL arrive with a _count suffix, consistent with the export having transformed the sketch type; whether the rating field was transformed or renamed, or a count is intended, is not stated by the source and must be confirmed with the data team."
    type: "hllsketch"
    sql_type: "hllsketch"
    nullable: true
    filterable: false
    attribute_type: "dimension"
    type_defect: "should be varchar(256); landed on hllsketch (likely 100% NULL at load)"
    export_mismatch: "CSV header is brick_rating_count (all 15 values blank); intended field unconfirmed"
    unqueryable: true

  - name: "interest_rate"
    display_name: "Interest Rate"
    description: "Coupon rate."
    type: "float"
    sql_type: "real"
    nullable: true
    filterable: true
    attribute_type: "fact"

  - name: "maturity_date"
    display_name: "Maturity Date"
    description: "Enables duration and maturity-bucket analysis. This table has NO is_active flag, so a matured bond stays in it indefinitely with no status column - use maturity_date < CURRENT_DATE to identify matured instruments."
    type: "date"
    sql_type: "date"
    nullable: true
    filterable: true
    attribute_type: "time_dimension"

  - name: "face_value"
    display_name: "Face Value"
    description: "Typed integer - adequate for standard 100 / 1,000 / 100,000 denominations but cannot represent a fractional face value."
    type: "integer"
    sql_type: "integer"
    nullable: true
    filterable: true
    attribute_type: "fact"

  - name: "source_table"
    display_name: "Source Table"
    description: "Lineage: name of the ORIGIN object in the SOURCE system, not this table. Proven by dim_client_master rows carrying 'clients'. Present in all 21 tables. NEVER join or filter business logic on this."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: false
    attribute_type: "dimension"
    hidden: true

  - name: "source_load_ts"
    display_name: "Source Load Timestamp"
    description: "ETL load timestamp, WITHOUT TIME ZONE - no timezone is recorded anywhere, so IST vs UTC is a convention held outside the DB. Present in 12 of 14 dim_* tables; absent from both MF history tables and from all 7 client_* facts."
    type: "timestamp"
    sql_type: "timestamp without time zone"
    nullable: true
    filterable: true
    attribute_type: "time_dimension"
    hidden: true

  - name: "row_hash"
    display_name: "Row Hash"
    description: "64-bit change-detection fingerprint; samples are 16 lowercase hex chars. Used for change-detecting upsert. Present in all 14 dim_* tables, none of the client_* facts. NEVER join on this."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: false
    attribute_type: "dimension"
    hidden: true""" ;
    meta:sourceFile "DIM_PRODUCT_CREDIT_RTNG_001.yaml" .

meta:SourceRow a owl:Class .

meta:SourceTable a owl:Class .

<https://wealth.example.org/neowealth/table/main/client_holdings> a owl:Class,
        meta:SourceTable ;
    rdfs:label "Client Holdings" ;
    dcterms:description """FACT, 19 columns declared; the CSV delivery adds benchmark_name, benchmark_return_1y and benchmark_return_3y, 22 in all. Current portfolio positions - the widest fact table and the operational core of the portfolio view. Grain: client x instrument x as_on_date; all 10 samples share as_on_date 2026-05-19, a DAILY snapshot (contrast client_aum's month-start dating). The ONLY fact table carrying an account reference (wsw_account_code), so account-level reporting is possible here and nowhere else. TWO STRING-TYPED NUMERIC COLUMNS - compute them instead of parsing. This is also the ONLY table in the schema documentation with a semantic/BI annotation block (6 identifier / 6 dimension / 6 fact / 1 time_dimension).
""" ;
    rdfs:subClassOf meta:SourceRow ;
    meta:hasDeclaredAttribute <https://wealth.example.org/neowealth/declared-attribute/main/client_holdings/accrued_interest>,
        <https://wealth.example.org/neowealth/declared-attribute/main/client_holdings/as_on_date>,
        <https://wealth.example.org/neowealth/declared-attribute/main/client_holdings/avg_cost_price>,
        <https://wealth.example.org/neowealth/declared-attribute/main/client_holdings/benchmark_name>,
        <https://wealth.example.org/neowealth/declared-attribute/main/client_holdings/benchmark_return_1y>,
        <https://wealth.example.org/neowealth/declared-attribute/main/client_holdings/benchmark_return_3y>,
        <https://wealth.example.org/neowealth/declared-attribute/main/client_holdings/client_id>,
        <https://wealth.example.org/neowealth/declared-attribute/main/client_holdings/client_pan>,
        <https://wealth.example.org/neowealth/declared-attribute/main/client_holdings/current_price>,
        <https://wealth.example.org/neowealth/declared-attribute/main/client_holdings/current_value>,
        <https://wealth.example.org/neowealth/declared-attribute/main/client_holdings/id>,
        <https://wealth.example.org/neowealth/declared-attribute/main/client_holdings/instrument_name>,
        <https://wealth.example.org/neowealth/declared-attribute/main/client_holdings/invested_value>,
        <https://wealth.example.org/neowealth/declared-attribute/main/client_holdings/is_held_away>,
        <https://wealth.example.org/neowealth/declared-attribute/main/client_holdings/isin>,
        <https://wealth.example.org/neowealth/declared-attribute/main/client_holdings/product_id>,
        <https://wealth.example.org/neowealth/declared-attribute/main/client_holdings/product_type>,
        <https://wealth.example.org/neowealth/declared-attribute/main/client_holdings/quantity>,
        <https://wealth.example.org/neowealth/declared-attribute/main/client_holdings/source_table>,
        <https://wealth.example.org/neowealth/declared-attribute/main/client_holdings/unrealized_gain>,
        <https://wealth.example.org/neowealth/declared-attribute/main/client_holdings/unrealized_gain_pct>,
        <https://wealth.example.org/neowealth/declared-attribute/main/client_holdings/wsw_account_code> ;
    meta:identityMethod "configured_key" ;
    meta:rawYaml """# benchmark_name, benchmark_return_1y and benchmark_return_3y are present in the data but NOT in the
# DDL or the schema documentation, so they sit outside the declared semantic block below.
# NOTE: this is the ONLY table with a DECLARED semantic/BI annotation block in the
# schema documentation (6 identifier / 6 dimension / 6 fact / 1 time_dimension). attribute_type
# values below are therefore DECLARED, not inferred.

identity:
  id: "TABLE_CLIENT_HOLDINGS_001"
  type: "Table"
  subtype: "Fact"
  name: "client_holdings"
  display_name: "Client Holdings"
  description: >
    FACT, 19 columns declared; the CSV delivery adds benchmark_name,
    benchmark_return_1y and benchmark_return_3y, 22 in all. Current portfolio positions - the widest fact table and
    the operational core of the portfolio view. Grain: client x instrument x
    as_on_date; all 10 samples share as_on_date 2026-05-19, a DAILY snapshot
    (contrast client_aum's month-start dating). The ONLY fact table carrying an
    account reference (wsw_account_code), so account-level reporting is possible
    here and nowhere else. TWO STRING-TYPED NUMERIC COLUMNS - compute them instead
    of parsing. This is also the ONLY table in the schema documentation with a semantic/BI
    annotation block (6 identifier / 6 dimension / 6 fact / 1 time_dimension).

layer: "fact"
grain: "client_id x isin x as_on_date (daily)"
not_null_columns: ["id"]

semantics:
  business_purpose: >
    Instrument-level current positions for portfolio reporting: quantity, cost,
    market value and unrealized P&L per client per instrument per snapshot date.
    The operational core of the portfolio view.

attributes:
  - name: "id"
    display_name: "ID"
    description: "NOT NULL. The second and last NOT NULL column in the schema. Sample range 80001+. Per-table sequence - never join across tables."
    type: "integer"
    sql_type: "integer"
    nullable: false
    filterable: true
    attribute_type: "identifier"

  - name: "client_id"
    display_name: "Client ID"
    description: "-> dim_client_master.id. CONFIRMED: holdings for client_id 7001 all carry client_pan 'ABCPK1001A', which is exactly dim_client_master.pan_number for id 7001."
    type: "integer"
    sql_type: "integer"
    nullable: true
    filterable: true
    attribute_type: "identifier"
    join_target: "dim_client_master.id"

  - name: "client_pan"
    display_name: "Client PAN"
    description: "Denormalised copy of dim_client_master.pan_number. DO NOT JOIN ON THIS - PAN is user-entered, correctable, can be shared across joint holdings, is nullable, and is sensitive. Present for display and upstream reconciliation only. PII."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "identifier"
    pii: true
    do_not_join: true

  - name: "isin"
    display_name: "ISIN"
    description: "Instrument identity. Samples: INE-prefixed = equity, INF-prefixed = mutual fund. Prefer joining to the catalogue on product_id, then taking ISIN from the catalogue row."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "identifier"

  - name: "product_id"
    display_name: "Product ID"
    description: "-> dim_product_unified_cat.product_id. THE PREFERRED product join key. Sample format is type-prefixed: PROD_EQ_025, PROD_MF_010."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "identifier"
    join_target: "dim_product_unified_cat.product_id"

  - name: "product_type"
    display_name: "Product Type"
    description: "Denormalised from the catalogue. Observed values (505 rows): Mutual Funds (176), Direct Equity (154), Bonds (66), Fixed Deposits (51), AIF (19), REITs (17), PMS (15), InvITs (7). Acts as the routing discriminator for onward market-data joins."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "dimension"
    observed_values: ["Mutual Funds", "Direct Equity", "Bonds", "Fixed Deposits", "AIF", "REITs", "PMS", "InvITs"]

  - name: "instrument_name"
    display_name: "Instrument Name"
    description: "Denormalised instrument label. Samples include 'Bharat Electronics Ltd', 'Kotak Flexi Cap Fund - Direct Growth' (note MF names carry plan and option)."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "dimension"

  - name: "quantity"
    display_name: "Quantity"
    description: "Units/shares held. Fractional for funds (49130.91) and whole for equity (985) - so it can NEVER be typed integer. Typed real here but client_transactions.units is double precision: same concept, two precisions, expect reconciliation residuals."
    type: "float"
    sql_type: "real"
    nullable: true
    filterable: true
    attribute_type: "fact"

  - name: "avg_cost_price"
    display_name: "Avg Cost Price"
    description: "Weighted average per-unit purchase price. Typed real while current_price is double precision - the two are directly subtracted, so arithmetic is promoted to double precision while silently inheriting real's lower accuracy."
    type: "float"
    sql_type: "real"
    nullable: true
    filterable: true
    attribute_type: "fact"

  - name: "current_price"
    display_name: "Current Price"
    description: "Per-unit mark price. For equity it should reconcile to dim_equity_price_latest.nav_close; for funds to dim_mf_nav_history.nav_value on the same date. Compare with a tolerance - the two sides differ in precision."
    type: "float"
    sql_type: "double precision"
    nullable: true
    filterable: true
    attribute_type: "fact"

  - name: "invested_value"
    display_name: "Invested Value"
    description: "VERIFIED: = quantity * avg_cost_price (row 80001: 985 * 224.84 = 221467.40, exact). Nullable and can be zero - guard with NULLIF when dividing."
    type: "float"
    sql_type: "double precision"
    nullable: true
    filterable: true
    attribute_type: "fact"
    verified_identity: "quantity * avg_cost_price"

  - name: "current_value"
    display_name: "Current Value"
    description: "VERIFIED: = quantity * current_price (row 80001: 985 * 295.80 = 291363.00, exact)."
    type: "float"
    sql_type: "double precision"
    nullable: true
    filterable: true
    attribute_type: "fact"
    verified_identity: "quantity * current_price"

  - name: "unrealized_gain"
    display_name: "Unrealized Gain"
    description: "TYPE DEFECT: declared character varying(256) but holds numbers (samples 69895.6, 240301, 702792.2). SUM() fails; ORDER BY sorts lexicographically so '9' ranks after '240301'. VERIFIED derivable: = current_value - invested_value. DO NOT parse it - COMPUTE it. Also mis-classified as a BI 'dimension' in the schema documentation's semantic layer, so tools will not offer it as a measure."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "dimension"
    attribute_type_corrected: "fact"           # it is a measure; the schema itself flags this misclassification
    type_defect: "numeric stored as varchar; compute current_value - invested_value"
    verified_identity: "current_value - invested_value"

  - name: "unrealized_gain_pct"
    display_name: "Unrealized Gain %"
    description: "TYPE DEFECT: character varying(256) holding a number (samples 31.56, 17.54). VERIFIED derivable: = 100.0 * (current_value - invested_value) / NULLIF(invested_value, 0). Expressed as whole percent (31.56 means 31.56%)."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "dimension"
    attribute_type_corrected: "fact"
    type_defect: "numeric stored as varchar; compute from invested/current value"
    verified_identity: "100.0 * (current_value - invested_value) / NULLIF(invested_value, 0)"

  - name: "accrued_interest"
    display_name: "Accrued Interest"
    description: "Zero across every sample row - all samples are equity and MF. Meaningful only for bonds and fixed deposits."
    type: "float"
    sql_type: "double precision"
    nullable: true
    filterable: true
    attribute_type: "fact"

  - name: "is_held_away"
    display_name: "Is Held Away"
    description: "Flags externally-custodied assets the firm advises on but does not hold. One sample row TRUE (Infosys, id 80005). Held-away assets are typically EXCLUDED from fee-billable AUM and revenue attribution but INCLUDED in a total-wealth view. Nullable, so always COALESCE(is_held_away, FALSE)."
    type: "boolean"
    sql_type: "boolean"
    nullable: true
    filterable: true
    attribute_type: "dimension"
    three_valued: true

  - name: "wsw_account_code"
    display_name: "Account Code"
    description: "-> dim_client_account_map.wsw_account_code. THE ONLY account-level join in the schema: no other fact table records an account, so account-level reporting is possible for holdings and nothing else. Sample 70001. 'wsw' is a source-system prefix. Populated on all 505 rows (30 distinct codes). Of the 505 holdings, 174 match an account-map row on code AND client_id, 210 match on code but the account-map row names a DIFFERENT client_id (e.g. holding 80175: client 7009, account 70017 mapped to client 7010), and 121 carry a code absent from dim_client_account_map. A code match is a source-record match, NOT validated client ownership: never derive client identity through this join - use client_id directly for anything client-level. Reproduce a query's own join condition exactly - joining on code alone gives 384 matched rows; adding client_id changes the result. Keep both source client_ids and report the conflict; never invent a matching account. Whether the intended key is the code alone or code + client_id is not stated by the source and must be confirmed with the data team."
    type: "integer"
    sql_type: "integer"
    nullable: true
    filterable: true
    attribute_type: "identifier"
    join_target: "dim_client_account_map.wsw_account_code"

  - name: "as_on_date"
    display_name: "As On Date"
    description: "DAILY position snapshot date; all 10 samples are 2026-05-19. Contrast client_aum.as_on_date, which is month-start."
    type: "date"
    sql_type: "date"
    nullable: true
    filterable: true
    attribute_type: "time_dimension"

  - name: "source_table"
    display_name: "Source Table"
    description: "Lineage: name of the ORIGIN object in the SOURCE system, not this table. Proven by dim_client_master rows carrying 'clients'. Present in all 21 tables. NEVER join or filter business logic on this."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: false
    attribute_type: "dimension"
    hidden: true

  - name: "benchmark_name"
    display_name: "Benchmark Name"
    description: "NOT in the DDL - present in the CSV delivery. Name of the benchmark used for comparison, carried on the position row. Populated on all 505 rows and equal on every row to dim_product_unified_cat.benchmark for the same product_id (the coarse product-level benchmark, not the fund master's benchmark_name). Observed values: 'Nifty 50 TRI' (239 rows), 'Nifty 10 yr Benchmark G-Sec Index' (130), 'Nifty 500 TRI' (128), 'Nasdaq 100 TRI' (8). NO value equals any dim_cmot_index_prices.index_name exactly (0 of 505). Preserve the label as supplied and keep it unmatched in stored data and the KG - never strip ' TRI' or store an alias. The ' TRI' strip in 01_domain_and_business_rules.md §3.8 is a QUERY-TIME house rule only, which an equivalent KG query must reproduce exactly as the SQL does."
    type: "string"
    sql_type: "character varying(256)"
    nullable: true
    filterable: true
    attribute_type: "dimension"
    provenance: "present in the 2026-08-28 CSV delivery; NOT in NEOWEALTH_DDL.sql"
    observed_values: ["Nifty 50 TRI", "Nifty 10 yr Benchmark G-Sec Index", "Nifty 500 TRI", "Nasdaq 100 TRI"]

  - name: "benchmark_return_1y"
    display_name: "Benchmark Return 1Y"
    description: "NOT in the DDL - present in the CSV delivery. Stored one-year return of the row's benchmark_name, supplied pre-computed: one value per benchmark (Nifty 50 TRI 13.2, Nifty 500 TRI 15.05, Nasdaq 100 TRI 18.4). Blank on the 130 rows benchmarked to 'Nifty 10 yr Benchmark G-Sec Index' (all 66 Bonds, all 51 Fixed Deposits and 13 Mutual Funds rows), populated on the other 375. Preserve as supplied - do not recalculate it or change its unit. The values read as whole percent (13.2 = 13.2%), like unrealized_gain_pct; the source does not declare the unit."
    type: "float"
    sql_type: "double precision"
    nullable: true
    filterable: true
    attribute_type: "fact"
    provenance: "present in the 2026-08-28 CSV delivery; NOT in NEOWEALTH_DDL.sql"

  - name: "benchmark_return_3y"
    display_name: "Benchmark Return 3Y"
    description: "NOT in the DDL - present in the CSV delivery. Stored three-year return of the row's benchmark_name, supplied pre-computed: one value per benchmark (Nifty 50 TRI 12.9, Nifty 500 TRI 16.1, Nasdaq 100 TRI 20.1). Blank on exactly the same 130 G-Sec-benchmarked rows as benchmark_return_1y, populated on the other 375. Preserve as supplied - do not recalculate it or change its unit. Whole percent, as for benchmark_return_1y; the source does not declare the unit or whether it is annualised."
    type: "float"
    sql_type: "double precision"
    nullable: true
    filterable: true
    attribute_type: "fact"
    provenance: "present in the 2026-08-28 CSV delivery; NOT in NEOWEALTH_DDL.sql"
""" ;
    meta:sourceFile "CLIENT_HOLDINGS_001.yaml" .

<https://wealth.example.org/neowealth/table/main/dim_mf_fund_complete> a owl:Class,
        meta:SourceTable ;
    rdfs:label "Mutual Fund Master" ;
    dcterms:description """DIMENSION, 23 columns. Mutual fund master. Grain: one row per scheme-PLAN-OPTION combination, keyed by isin - in India a single fund has separate ISINs for Regular vs Direct plan and Growth vs IDCW option, so one 'fund' in common speech is SEVERAL ROWS here. Four identifiers on one row (fund_id, mstar_id, isin, rta_code); mstar_id is what ties this to the NAV and returns history. THE FUND-MERGER LINEAGE IS BROKEN - obsolete_into_mstar_id is typed hllsketch and cannot be traversed, so a fund that merged mid-period simply disappears from the time series. The CSV carries it as obsolete_into_mstar_id_count, blank on all 30 rows; the intended field is not stated by the source and must be confirmed with the data team. The three asset_alloc_*_net columns enable true look-through allocation analysis.
""" ;
    rdfs:subClassOf meta:SourceRow ;
    meta:hasDeclaredAttribute <https://wealth.example.org/neowealth/declared-attribute/main/dim_mf_fund_complete/amc_code>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_mf_fund_complete/amc_id>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_mf_fund_complete/amc_name>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_mf_fund_complete/asset_alloc_bond_net>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_mf_fund_complete/asset_alloc_cash_net>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_mf_fund_complete/asset_alloc_equity_net>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_mf_fund_complete/benchmark_name>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_mf_fund_complete/category>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_mf_fund_complete/expense_ratio>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_mf_fund_complete/fund_id>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_mf_fund_complete/fund_manager_name>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_mf_fund_complete/fund_name>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_mf_fund_complete/inception_date>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_mf_fund_complete/is_active>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_mf_fund_complete/is_obsolete>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_mf_fund_complete/isin>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_mf_fund_complete/mstar_id>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_mf_fund_complete/obsolete_into_mstar_id>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_mf_fund_complete/row_hash>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_mf_fund_complete/rta_code>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_mf_fund_complete/source_load_ts>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_mf_fund_complete/source_table>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_mf_fund_complete/sub_category> ;
    meta:identityMethod "configured_key" ;
    meta:rawYaml """
identity:
  id: "TABLE_DIM_MF_FUND_COMPLETE_001"
  type: "Table"
  subtype: "Dimension"
  name: "dim_mf_fund_complete"
  display_name: "Mutual Fund Master"
  description: >
    DIMENSION, 23 columns. Mutual fund master. Grain: one row per
    scheme-PLAN-OPTION combination, keyed by isin - in India a single fund has
    separate ISINs for Regular vs Direct plan and Growth vs IDCW option, so one
    'fund' in common speech is SEVERAL ROWS here. Four identifiers on one row
    (fund_id, mstar_id, isin, rta_code); mstar_id is what ties this to the NAV and
    returns history. THE FUND-MERGER LINEAGE IS BROKEN - obsolete_into_mstar_id is
    typed hllsketch and cannot be traversed, so a fund that merged mid-period
    simply disappears from the time series. The CSV carries it as
    obsolete_into_mstar_id_count, blank on all 30 rows; the intended field is
    not stated by the source and must be confirmed with the data team. The three asset_alloc_*_net columns
    enable true look-through allocation analysis.

layer: "dimension"
grain: "one row per scheme-plan-option (keyed by isin)"
not_null_columns: []

semantics:
  business_purpose: >
    Mutual fund master, one row per scheme-plan-option keyed by ISIN. mstar_id ties
    to NAV and returns history. Look-through allocation columns support true asset
    allocation analysis. Fund-merger lineage is broken (hllsketch defect).

attributes:
  - name: "fund_id"
    display_name: "Fund ID"
    description: "Internal integer fund key; also carried by dim_mf_returns_history but NOT by dim_mf_nav_history."
    type: "integer"
    sql_type: "integer"
    nullable: true
    filterable: true
    attribute_type: "identifier"

  - name: "mstar_id"
    display_name: "Morningstar ID"
    description: "Morningstar identifier - THE key that ties this table to dim_mf_nav_history and dim_mf_returns_history."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "identifier"

  - name: "isin"
    display_name: "ISIN"
    description: "The grain key. MF ISINs begin INF while equity ISINs begin INE - the standard Indian convention (IN country code, then F for funds, E for equities), and a cheap way to route an ISIN when product_type is missing."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "identifier"

  - name: "rta_code"
    display_name: "RTA Code"
    description: "Registrar's scheme code."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "identifier"

  - name: "fund_name"
    display_name: "Fund Name"
    description: "Sample names carry plan and option explicitly, e.g. 'Kotak Flexi Cap Fund - Direct Growth'."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "dimension"

  - name: "category"
    display_name: "Category"
    description: "SEBI's mandated scheme classification (Equity -> Flexi Cap / Large Cap / Mid Cap; Debt -> Liquid / Short Duration; Hybrid; Solution-Oriented). A primary axis for peer comparison."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "dimension"

  - name: "sub_category"
    display_name: "Sub-Category"
    description: "Second level of the SEBI classification."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "dimension"

  - name: "amc_id"
    display_name: "AMC ID"
    description: "Asset Management Company key. No dim_amc table exists."
    type: "integer"
    sql_type: "integer"
    nullable: true
    filterable: true
    attribute_type: "identifier"
    missing_dimension: "dim_amc"

  - name: "amc_name"
    display_name: "AMC Name"
    description: "Fund house name. NAMING TRAP: dim_product_unified_cat calls this 'amc_display_name'."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "dimension"
    naming_trap: "called amc_display_name in dim_product_unified_cat"

  - name: "amc_code"
    display_name: "AMC Code"
    description: "Fund house short code."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "identifier"

  - name: "inception_date"
    display_name: "Inception Date"
    description: "Fund launch date."
    type: "date"
    sql_type: "date"
    nullable: true
    filterable: true
    attribute_type: "time_dimension"

  - name: "expense_ratio"
    display_name: "Expense Ratio"
    description: "Annual cost. Essential for net-of-fee analysis and for the Regular-vs-Direct plan comparison that drives much advisory conversation."
    type: "float"
    sql_type: "real"
    nullable: true
    filterable: true
    attribute_type: "fact"

  - name: "fund_manager_name"
    display_name: "Fund Manager Name"
    description: "A single free-text column - it CANNOT represent co-managed funds cleanly, and there is no dim_fund_manager, so manager-level analysis relies on exact string matching."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "dimension"

  - name: "benchmark_name"
    display_name: "Benchmark Name"
    description: "Intended link to dim_cmot_index_prices.index_name by FREE-TEXT MATCH - which, by exact match, finds nothing in this data (see below). NAMING TRAP: dim_product_unified_cat calls this 'benchmark'. The differing names suggest the two were populated by different processes with different conventions, which makes the text join even more fragile. Populated on all 30 rows with 16 distinct values (e.g. 'Nifty 500 TRI' 7, 'Nifty 50 TRI' 3, 'Nifty 100 TRI' 3, 'Nifty Midcap 150 TRI' 3). NONE equals an index_name exactly (0 of 30). It differs from dim_product_unified_cat.benchmark for 19 of the 30 funds (matched on isin). Preserve each label and its unmatched status in stored data and the KG - never strip ' TRI' or store an alias. The ' TRI' strip in 01_domain_and_business_rules.md §3.8 is a QUERY-TIME house rule only, which an equivalent KG query must reproduce exactly as the SQL does."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "dimension"
    join_target: "dim_cmot_index_prices.index_name (free-text match)"
    naming_trap: "called benchmark in dim_product_unified_cat"

  - name: "asset_alloc_equity_net"
    display_name: "Asset Allocation Equity (Net)"
    description: "Look-through equity weight. The _net suffix implies NET of derivative and short positions, so a value can in principle exceed 100% or go negative. Main analytical use: TRUE asset-allocation look-through - a client's equity exposure is their direct equity PLUS fund_value * asset_alloc_equity_net for every fund held. This is how you reconcile bottom-up allocation against client_aum's splits."
    type: "float"
    sql_type: "real"
    nullable: true
    filterable: true
    attribute_type: "fact"

  - name: "asset_alloc_bond_net"
    display_name: "Asset Allocation Bond (Net)"
    description: "Look-through bond weight, net."
    type: "float"
    sql_type: "real"
    nullable: true
    filterable: true
    attribute_type: "fact"

  - name: "asset_alloc_cash_net"
    display_name: "Asset Allocation Cash (Net)"
    description: "Look-through cash weight, net. These three cover equity, bond and cash ONLY - there is no other/alternatives bucket, so they need NOT sum to 100%."
    type: "float"
    sql_type: "real"
    nullable: true
    filterable: true
    attribute_type: "fact"

  - name: "is_obsolete"
    display_name: "Is Obsolete"
    description: "MARKET status - the scheme was wound up or merged away. Independent of is_active, which is the RECORD status; the schema documentation does not define their interaction."
    type: "boolean"
    sql_type: "boolean"
    nullable: true
    filterable: true
    attribute_type: "dimension"
    three_valued: true

  - name: "obsolete_into_mstar_id"
    display_name: "Obsolete Into Morningstar ID"
    description: "TYPE DEFECT: declared hllsketch. Intended as a self-reference to mstar_id pointing at the surviving fund a merged scheme went into - every other mstar_id in the schema is varchar(256). Near-certain cause: arrived 100% NULL, loader could not infer a type. THE FUND-MERGER CHAIN CANNOT BE TRAVERSED AT ALL. A fund that merged mid-period simply disappears from the time series, breaking long-run performance history and making it impossible to follow a client's holding through a scheme merger. This is the one genuinely missing edge in the join graph. EXPORT MISMATCH: the CSV has no obsolete_into_mstar_id column; it carries obsolete_into_mstar_id_count instead, blank on all 30 rows, so the intended meaning cannot be read from the values. The loader keeps this DDL name, so the column loads 100% NULL. A count is not a replacement-fund identifier - never treat obsolete_into_mstar_id_count as one. Whether the identifier was transformed during export or the count is intentional is not stated by the source and must be confirmed with the data team."
    type: "hllsketch"
    sql_type: "hllsketch"
    nullable: true
    filterable: false
    attribute_type: "identifier"
    type_defect: "should be varchar(256) self-reference to mstar_id; landed on hllsketch (likely 100% NULL at load)"
    export_mismatch: "CSV header is obsolete_into_mstar_id_count (all 30 values blank); intended field unconfirmed"
    unqueryable: true

  - name: "is_active"
    display_name: "Is Active"
    description: "RECORD status - the row is current in the warehouse. Note there is NO is_deleted here, unlike the client, employee, enum and unified-product tables."
    type: "boolean"
    sql_type: "boolean"
    nullable: true
    filterable: true
    attribute_type: "dimension"
    three_valued: true

  - name: "source_table"
    display_name: "Source Table"
    description: "Lineage: name of the ORIGIN object in the SOURCE system, not this table. Proven by dim_client_master rows carrying 'clients'. Present in all 21 tables. NEVER join or filter business logic on this."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: false
    attribute_type: "dimension"
    hidden: true

  - name: "source_load_ts"
    display_name: "Source Load Timestamp"
    description: "ETL load timestamp, WITHOUT TIME ZONE - no timezone is recorded anywhere, so IST vs UTC is a convention held outside the DB. Present in 12 of 14 dim_* tables; absent from both MF history tables and from all 7 client_* facts."
    type: "timestamp"
    sql_type: "timestamp without time zone"
    nullable: true
    filterable: true
    attribute_type: "time_dimension"
    hidden: true

  - name: "row_hash"
    display_name: "Row Hash"
    description: "64-bit change-detection fingerprint; samples are 16 lowercase hex chars. Used for change-detecting upsert. Present in all 14 dim_* tables, none of the client_* facts. NEVER join on this."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: false
    attribute_type: "dimension"
    hidden: true""" ;
    meta:sourceFile "DIM_MF_FUND_COMPLETE_001.yaml" .

<https://wealth.example.org/neowealth/table/main/dim_employee_profile> a owl:Class,
        meta:SourceTable ;
    rdfs:label "Employee Profile" ;
    dcterms:description """DIMENSION, 22 columns. Relationship managers and staff. GRAIN: one row per employee. Referenced from client_revenue (emp_id -> id, emp_code -> code) and TWICE from dim_client_master (servicing_banker_1_id and acquiring_banker_id, both -> id). THE SELF-HIERARCHY IS KEYED ON code, NOT id (reporting_manager_code -> code) - so org rollups need a recursive CTE with a depth guard, and you must resolve emp_id -> code first. Uses the sublob_* spelling where every other table uses sub_lob_*. Contains employee PII.
""" ;
    rdfs:subClassOf meta:SourceRow ;
    meta:hasDeclaredAttribute <https://wealth.example.org/neowealth/declared-attribute/main/dim_employee_profile/code>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_employee_profile/department>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_employee_profile/designation>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_employee_profile/doj>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_employee_profile/email>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_employee_profile/euin>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_employee_profile/gender>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_employee_profile/id>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_employee_profile/is_active>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_employee_profile/is_deleted>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_employee_profile/lob_id>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_employee_profile/lob_name>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_employee_profile/mobile>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_employee_profile/name>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_employee_profile/reporting_manager_code>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_employee_profile/resignation_date>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_employee_profile/role_name>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_employee_profile/row_hash>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_employee_profile/source_load_ts>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_employee_profile/source_table>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_employee_profile/sublob_id>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_employee_profile/sublob_name> ;
    meta:identityMethod "configured_key" ;
    meta:rawYaml """
identity:
  id: "TABLE_DIM_EMPLOYEE_PROFILE_001"
  type: "Table"
  subtype: "Dimension"
  name: "dim_employee_profile"
  display_name: "Employee Profile"
  description: >
    DIMENSION, 22 columns. Relationship managers and staff. GRAIN: one row per
    employee. Referenced from client_revenue (emp_id -> id, emp_code -> code) and
    TWICE from dim_client_master (servicing_banker_1_id and acquiring_banker_id,
    both -> id). THE SELF-HIERARCHY IS KEYED ON code, NOT id
    (reporting_manager_code -> code) - so org rollups need a recursive CTE with a
    depth guard, and you must resolve emp_id -> code first. Uses the sublob_*
    spelling where every other table uses sub_lob_*. Contains employee PII.

layer: "dimension"
grain: "one row per employee"
not_null_columns: []

semantics:
  business_purpose: >
    Relationship managers and staff master. One row per employee. Self-referencing
    org hierarchy keyed on code (not id), requiring a recursive CTE with a depth
    guard. Contains employee PII.

attributes:
  - name: "id"
    display_name: "ID"
    description: "Employee surrogate key. Target of client_revenue.emp_id and of BOTH dim_client_master banker columns. IDs seen in the client-master samples: 5001 Rajesh Kumar, 5002 Priya Sharma, 5003 Amit Patel, 5004 Sneha Reddy, 5009 Suresh Iyer, 5010 Deepa Gupta."
    type: "integer"
    sql_type: "integer"
    nullable: true
    filterable: true
    attribute_type: "identifier"

  - name: "code"
    display_name: "Code"
    description: "Employee business code. Target of client_revenue.emp_code AND of reporting_manager_code. The hierarchy is keyed on code, NOT on id - so you cannot traverse the org tree with the same key you join from client_revenue."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "identifier"

  - name: "name"
    display_name: "Name"
    description: "Employee name. PII."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "dimension"
    pii: true

  - name: "euin"
    display_name: "EUIN"
    description: "Employee Unique Identification Number - the SEBI/AMFI-mandated identifier for individuals authorised to advise on or sell mutual funds in India. Its presence shows this table covers regulated distribution staff; a NULL euin on someone attributed MF revenue is a compliance red flag worth monitoring."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "identifier"

  - name: "designation"
    display_name: "Designation"
    description: "HR job title. One of three overlapping role descriptors (with role_name and department); the source gives no definitions. Observed values (10 rows): AVP (4), VP (4), Senior VP (2)."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "dimension"
    observed_values: ["AVP", "VP", "Senior VP"]

  - name: "role_name"
    display_name: "Role Name"
    description: "System/functional role. See designation. Observed values (10 rows): Relationship Manager (4), Senior RM (2), Portfolio Advisor, Branch Manager, Wealth Advisor, Team Lead (1 each)."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "dimension"
    observed_values: ["Relationship Manager", "Senior RM", "Portfolio Advisor", "Branch Manager", "Wealth Advisor", "Team Lead"]

  - name: "department"
    display_name: "Department"
    description: "Org unit. See designation. Observed values (10 rows): Wealth Advisory (5), Broking (2), Family Office, NRI Advisory, Asset Mgmt (1 each)."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "dimension"
    observed_values: ["Wealth Advisory", "Broking", "Family Office", "NRI Advisory", "Asset Mgmt"]

  - name: "lob_id"
    display_name: "LOB ID"
    description: "-> dim_lob_hierarchy.lob_id."
    type: "integer"
    sql_type: "integer"
    nullable: true
    filterable: true
    attribute_type: "identifier"
    join_target: "dim_lob_hierarchy.lob_id"
    fan_out_hazard: true

  - name: "lob_name"
    display_name: "LOB Name"
    description: "Denormalised LOB label."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "dimension"

  - name: "sublob_id"
    display_name: "Sub-LOB ID"
    description: "-> dim_lob_hierarchy.sub_lob_id. NAMING TRAP: spelled 'sublob_id' HERE but 'sub_lob_id' in dim_client_master and dim_lob_hierarchy. Same concept, three characters different. Any generated join on matching column names will SILENTLY OMIT this edge."
    type: "integer"
    sql_type: "integer"
    nullable: true
    filterable: true
    attribute_type: "identifier"
    join_target: "dim_lob_hierarchy.sub_lob_id"
    naming_trap: "spelled sub_lob_id elsewhere in the schema"

  - name: "sublob_name"
    display_name: "Sub-LOB Name"
    description: "Denormalised sub-LOB label. Same naming trap as sublob_id."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "dimension"

  - name: "email"
    display_name: "Email"
    description: "Employee email. PII."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "dimension"
    pii: true

  - name: "mobile"
    display_name: "Mobile"
    description: "Employee mobile number. PII."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "dimension"
    pii: true

  - name: "reporting_manager_code"
    display_name: "Reporting Manager Code"
    description: "SELF-REFERENCE -> dim_employee_profile.code (NOT .id). There is no reporting_manager_id, no depth column, no path column and no closure table, so org rollups require a RECURSIVE CTE. Nothing in the schema prevents a cycle - always include a depth guard."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "identifier"
    join_target: "dim_employee_profile.code"
    self_reference: true

  - name: "gender"
    display_name: "Gender"
    description: "PII."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "dimension"
    pii: true

  - name: "is_active"
    display_name: "Is Active"
    description: "Nullable three-valued flag. See the COALESCE guidance."
    type: "boolean"
    sql_type: "boolean"
    nullable: true
    filterable: true
    attribute_type: "dimension"
    three_valued: true

  - name: "is_deleted"
    display_name: "Is Deleted"
    description: "Nullable three-valued flag."
    type: "boolean"
    sql_type: "boolean"
    nullable: true
    filterable: true
    attribute_type: "dimension"
    three_valued: true

  - name: "doj"
    display_name: "Date of Joining"
    description: "Date of joining."
    type: "date"
    sql_type: "date"
    nullable: true
    filterable: true
    attribute_type: "time_dimension"

  - name: "resignation_date"
    display_name: "Resignation Date"
    description: "Populated marks a departed employee. IMPORTANT for historical attribution: revenue booked in 2024 should still credit the banker covering the client then, even if they have since left. DO NOT filter out inactive employees when reporting historical periods - use the date range instead of the flag."
    type: "date"
    sql_type: "date"
    nullable: true
    filterable: true
    attribute_type: "time_dimension"

  - name: "source_table"
    display_name: "Source Table"
    description: "Lineage: name of the ORIGIN object in the SOURCE system, not this table. Proven by dim_client_master rows carrying 'clients'. Present in all 21 tables. NEVER join or filter business logic on this."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: false
    attribute_type: "dimension"
    hidden: true

  - name: "source_load_ts"
    display_name: "Source Load Timestamp"
    description: "ETL load timestamp, WITHOUT TIME ZONE - no timezone is recorded anywhere, so IST vs UTC is a convention held outside the DB. Present in 12 of 14 dim_* tables; absent from both MF history tables and from all 7 client_* facts."
    type: "timestamp"
    sql_type: "timestamp without time zone"
    nullable: true
    filterable: true
    attribute_type: "time_dimension"
    hidden: true

  - name: "row_hash"
    display_name: "Row Hash"
    description: "64-bit change-detection fingerprint; samples are 16 lowercase hex chars. Used for change-detecting upsert. Present in all 14 dim_* tables, none of the client_* facts. NEVER join on this."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: false
    attribute_type: "dimension"
    hidden: true""" ;
    meta:sourceFile "DIM_EMPLOYEE_PROFILE_001.yaml" .

<https://wealth.example.org/neowealth/table/main/dim_client_master> a owl:Class,
        meta:SourceTable ;
    rdfs:label "Client Master" ;
    dcterms:description """DIMENSION, 28 columns declared; the CSV delivery adds current_city, 29 in all. The client 360 record - THE HUB OF THE ENTIRE MODEL, reached by all 7 fact tables plus dim_client_account_map. GRAIN: one row per client. id is NULLABLE, so the hub has no valid primary key as declared - the most significant structural defect in the schema. Holds BOTH individuals (dob) and corporate entities (date_of_incorporation) with no entity_type column. Encodes a group -> family -> client hierarchy via denormalised columns only (no dim_group, no dim_family). TWO independent paths to dim_employee_profile. Type-1 overwrite with no effective dating: historical tier and coverage are LOST. CONTAINS SENSITIVE PII (PAN, name, DOB, gender, marital status, current city) subject to India's DPDP Act.
""" ;
    rdfs:subClassOf meta:SourceRow ;
    meta:hasDeclaredAttribute <https://wealth.example.org/neowealth/declared-attribute/main/dim_client_master/acquiring_banker_id>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_client_master/acquiring_banker_name>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_client_master/client_name>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_client_master/current_city>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_client_master/date_of_incorporation>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_client_master/dob>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_client_master/family_id>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_client_master/family_name>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_client_master/gender>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_client_master/group_id>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_client_master/group_name>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_client_master/id>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_client_master/is_active>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_client_master/is_deleted>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_client_master/kyc_status>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_client_master/lob_id>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_client_master/lob_name>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_client_master/marital_status>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_client_master/occupation>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_client_master/pan_number>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_client_master/pep_status>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_client_master/row_hash>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_client_master/servicing_banker_1_id>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_client_master/servicing_banker_name>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_client_master/source_load_ts>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_client_master/source_table>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_client_master/sub_lob_id>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_client_master/sub_lob_name>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_client_master/tier> ;
    meta:identityMethod "configured_key" ;
    meta:rawYaml """# current_city is present in the data but NOT in the DDL or the schema documentation.

identity:
  id: "TABLE_DIM_CLIENT_MASTER_001"
  type: "Table"
  subtype: "Dimension"
  name: "dim_client_master"
  display_name: "Client Master"
  description: >
    DIMENSION, 28 columns declared; the CSV delivery adds current_city,
    29 in all. The client 360 record - THE HUB OF THE ENTIRE
    MODEL, reached by all 7 fact tables plus dim_client_account_map. GRAIN: one
    row per client. id is NULLABLE, so the hub has no valid primary key as
    declared - the most significant structural defect in the schema. Holds BOTH
    individuals (dob) and corporate entities (date_of_incorporation) with no
    entity_type column. Encodes a group -> family -> client hierarchy via
    denormalised columns only (no dim_group, no dim_family). TWO independent paths
    to dim_employee_profile. Type-1 overwrite with no effective dating: historical
    tier and coverage are LOST. CONTAINS SENSITIVE PII (PAN, name, DOB, gender,
    marital status, current city) subject to India's DPDP Act.

layer: "dimension"
grain: "one row per client"
not_null_columns: []

semantics:
  business_purpose: >
    The client 360 record and central hub of the model. One row per client,
    covering identity, KYC/AML classification, wealth tier, organisational
    placement, group/family rollup, and two banker relationships. Type-1
    overwrite; contains sensitive PII.

attributes:
  - name: "id"
    display_name: "ID"
    description: "The client surrogate key and the hub of the entire model - every fact's client_id points here. NULLABLE, so the hub table of the model has NO valid primary key as declared. The most significant structural defect in the schema. Sample range 7001-7010."
    type: "integer"
    sql_type: "integer"
    nullable: true
    filterable: true
    attribute_type: "identifier"

  - name: "pan_number"
    display_name: "PAN Number"
    description: "Indian Permanent Account Number, the real-world tax identifier. Samples are synthetic (ABCPK1001A, DEFPM2001G). Declared varchar(256) carries NO validation value - the real PAN format is 10 chars; enforcement lives nowhere in this schema. SENSITIVE PII under India's DPDP Act; mask outside production."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "identifier"
    pii: true

  - name: "client_name"
    display_name: "Client Name"
    description: "Full client name. PII."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "dimension"
    pii: true

  - name: "gender"
    display_name: "Gender"
    description: "Values seen in samples: Male, Female. Not an exhaustive enumeration. PII."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "dimension"
    pii: true
    observed_values: ["Male", "Female"]

  - name: "dob"
    display_name: "Date of Birth"
    description: "Date of birth, populated for INDIVIDUALS. PII. See date_of_incorporation - there is no entity_type column, so client type must be inferred from which of the two dates is populated."
    type: "date"
    sql_type: "date"
    nullable: true
    filterable: true
    attribute_type: "time_dimension"
    pii: true

  - name: "tier"
    display_name: "Tier"
    description: "Wealth segmentation. Values seen: 'Ultra HNI', 'HNI', 'Affluent', 'Retail'. These form an ordered ladder, but the ordering is a business convention - there is NO lookup table and NO numeric rank column, so any sort by tier needs an explicit CASE expression. Type-1 overwrite: a client's historical tier is NOT retained anywhere."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "dimension"
    observed_values: ["Ultra HNI", "HNI", "Affluent", "Retail"]
    ordered_ladder: true

  - name: "pep_status"
    display_name: "PEP Status"
    description: "Politically Exposed Person - a mandatory AML/KYC risk classification. Sample value 'Non-PEP'. Typed varchar not boolean, so it can express intermediate states such as 'Related to PEP'."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "dimension"
    observed_values: ["Non-PEP"]

  - name: "occupation"
    display_name: "Occupation"
    description: "Values seen: Business, Homemaker, Professional, Salaried, Retired. Not exhaustive."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "dimension"
    observed_values: ["Business", "Homemaker", "Professional", "Salaried", "Retired"]

  - name: "marital_status"
    display_name: "Marital Status"
    description: "Values seen: Married, Single, Widowed. Not exhaustive. PII."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "dimension"
    pii: true
    observed_values: ["Married", "Single", "Widowed"]

  - name: "kyc_status"
    display_name: "KYC Status"
    description: "Only the compliant value 'KYC Compliant' occurs in this data (all 30 clients). A production feed would also carry pending and non-compliant states."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "dimension"
    observed_values: ["KYC Compliant"]

  - name: "lob_id"
    display_name: "LOB ID"
    description: "-> dim_lob_hierarchy.lob_id (LOB level). Sample: 1 = 'Neo Wealth Advisory'."
    type: "integer"
    sql_type: "integer"
    nullable: true
    filterable: true
    attribute_type: "identifier"
    join_target: "dim_lob_hierarchy.lob_id"
    fan_out_hazard: true

  - name: "lob_name"
    display_name: "LOB Name"
    description: "Denormalised LOB label."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "dimension"

  - name: "sub_lob_id"
    display_name: "Sub-LOB ID"
    description: "-> dim_lob_hierarchy.sub_lob_id (leaf level). Samples: 10 = Private Wealth, 11 = Family Office. NAMING TRAP: dim_employee_profile spells the same concept 'sublob_id' with no underscore - you CANNOT write USING (sub_lob_id) against that table."
    type: "integer"
    sql_type: "integer"
    nullable: true
    filterable: true
    attribute_type: "identifier"
    join_target: "dim_lob_hierarchy.sub_lob_id"
    naming_trap: "spelled sublob_id in dim_employee_profile"

  - name: "sub_lob_name"
    display_name: "Sub-LOB Name"
    description: "Denormalised sub-LOB label."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "dimension"

  - name: "group_id"
    display_name: "Group ID"
    description: "Top rollup level. Sample: 900 = 'Group 900', covering all ten sample clients. No dim_group table exists anywhere in the 21 tables - group rollups are only possible by grouping on these denormalised columns, and the names cannot be validated."
    type: "integer"
    sql_type: "integer"
    nullable: true
    filterable: true
    attribute_type: "identifier"
    missing_dimension: "dim_group"

  - name: "group_name"
    display_name: "Group Name"
    description: "Denormalised group label. No backing dimension."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "dimension"

  - name: "family_id"
    display_name: "Family ID"
    description: "Family rollup, nested BELOW group. Samples: 9001 = Krishnan Family (6 clients), 9002 = Mehra Family (4 clients). No dim_family table exists. For a wealth business where family-office consolidated reporting is a core product, this is a notable structural gap."
    type: "integer"
    sql_type: "integer"
    nullable: true
    filterable: true
    attribute_type: "identifier"
    missing_dimension: "dim_family"

  - name: "family_name"
    display_name: "Family Name"
    description: "Denormalised family label. No backing dimension."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "dimension"

  - name: "servicing_banker_1_id"
    display_name: "Servicing Banker ID"
    description: "-> dim_employee_profile.id. The banker who MANAGES the client now (ongoing service and trail incentives). The '_1' suffix implies a _2, _3 ... that DO NOT EXIST, so full coverage-team reporting is impossible from this table."
    type: "integer"
    sql_type: "integer"
    nullable: true
    filterable: true
    attribute_type: "identifier"
    join_target: "dim_employee_profile.id"

  - name: "servicing_banker_name"
    display_name: "Servicing Banker Name"
    description: "Denormalised banker name."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "dimension"

  - name: "acquiring_banker_id"
    display_name: "Acquiring Banker ID"
    description: "-> dim_employee_profile.id. The banker who originally WON the client (new-business incentives). Samples show this is frequently a DIFFERENT person from the servicing banker. This table therefore has TWO independent paths to dim_employee_profile - any query needing both names must join that table TWICE with distinct aliases. Joining once and hoping is a common silent error."
    type: "integer"
    sql_type: "integer"
    nullable: true
    filterable: true
    attribute_type: "identifier"
    join_target: "dim_employee_profile.id"

  - name: "acquiring_banker_name"
    display_name: "Acquiring Banker Name"
    description: "Denormalised banker name."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "dimension"

  - name: "date_of_incorporation"
    display_name: "Date of Incorporation"
    description: "Populated for CORPORATE entities (companies, trusts); NULL across all 10 individual samples. Together with dob this is the only way to tell an individual from an entity - fragile, since both are nullable and a row with neither is unclassifiable."
    type: "date"
    sql_type: "date"
    nullable: true
    filterable: true
    attribute_type: "time_dimension"

  - name: "is_active"
    display_name: "Is Active"
    description: "Soft-delete pair, part 1. Plausibly means dormant/closed. Nullable and therefore THREE-VALUED - 'WHERE is_active' silently drops NULL rows. Use COALESCE(is_active, TRUE) = TRUE."
    type: "boolean"
    sql_type: "boolean"
    nullable: true
    filterable: true
    attribute_type: "dimension"
    three_valued: true

  - name: "is_deleted"
    display_name: "Is Deleted"
    description: "Soft-delete pair, part 2. Logically removed. The schema documentation does not forbid the contradictory combination is_active = TRUE AND is_deleted = TRUE. Use COALESCE(is_deleted, FALSE) = FALSE."
    type: "boolean"
    sql_type: "boolean"
    nullable: true
    filterable: true
    attribute_type: "dimension"
    three_valued: true

  - name: "source_table"
    display_name: "Source Table"
    description: "Lineage: name of the ORIGIN object in the SOURCE system, not this table. Proven by dim_client_master rows carrying 'clients'. Present in all 21 tables. NEVER join or filter business logic on this."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: false
    attribute_type: "dimension"
    hidden: true

  - name: "source_load_ts"
    display_name: "Source Load Timestamp"
    description: "ETL load timestamp, WITHOUT TIME ZONE - no timezone is recorded anywhere, so IST vs UTC is a convention held outside the DB. Present in 12 of 14 dim_* tables; absent from both MF history tables and from all 7 client_* facts."
    type: "timestamp"
    sql_type: "timestamp without time zone"
    nullable: true
    filterable: true
    attribute_type: "time_dimension"
    hidden: true

  - name: "row_hash"
    display_name: "Row Hash"
    description: "64-bit change-detection fingerprint; samples are 16 lowercase hex chars. Used for change-detecting upsert. Present in all 14 dim_* tables, none of the client_* facts. NEVER join on this."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: false
    attribute_type: "dimension"
    hidden: true

  - name: "current_city"
    display_name: "Current City"
    description: "NOT in the DDL - present in the CSV delivery. The client's current city, as free text. Populated on all 30 rows; observed values: Ahmedabad (7), Bengaluru (6), Delhi (6), Goa (6), Mumbai (5). Not a foreign key - there is no city or geography dimension. Personal data (location): treat as PII."
    type: "string"
    sql_type: "character varying(256)"
    nullable: true
    filterable: true
    attribute_type: "dimension"
    pii: true
    provenance: "present in the 2026-08-28 CSV delivery; NOT in NEOWEALTH_DDL.sql"
    observed_values: ["Ahmedabad", "Bengaluru", "Delhi", "Goa", "Mumbai"]
""" ;
    meta:sourceFile "DIM_CLIENT_MASTER_001.yaml" .

<https://wealth.example.org/neowealth/table/main/dim_product_unified_cat> a owl:Class,
        meta:SourceTable ;
    rdfs:label "Product Unified Catalogue" ;
    dcterms:description """DIMENSION, 33 columns - THE WIDEST TABLE IN THE SCHEMA and the product-side hub, counterpart to dim_client_master. GRAIN: one row per product. Its purpose is to give every investable instrument - equity, MF, bonds, ETFs - a SINGLE product_id so facts reference one key regardless of asset class. It is an EIGHT-WAY IDENTIFIER CROSSWALK (isin, scheme_master_id, product_id, product_short_code, rta_code, amfi_code, mstar_id, co_code, bse_symbol, nse_symbol) and is the ONLY place these systems meet on one row. Because the identifiers apply to different asset classes, MOST ARE NULL ON ANY GIVEN ROW - a wide, sparse dimension. Never assume an identifier is present without checking product_type first. product_type is the SWITCHBOARD that decides which specialist dimension is valid to join onward to.
""" ;
    rdfs:subClassOf meta:SourceRow ;
    meta:hasDeclaredAttribute <https://wealth.example.org/neowealth/declared-attribute/main/dim_product_unified_cat/amc_display_name>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_product_unified_cat/amfi_code>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_product_unified_cat/asset_class>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_product_unified_cat/asset_class_id>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_product_unified_cat/benchmark>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_product_unified_cat/bse_symbol>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_product_unified_cat/category>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_product_unified_cat/co_code>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_product_unified_cat/company_name>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_product_unified_cat/credit_rating>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_product_unified_cat/display_name>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_product_unified_cat/face_value>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_product_unified_cat/instrument_name>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_product_unified_cat/interest_rate>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_product_unified_cat/is_active>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_product_unified_cat/is_deleted>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_product_unified_cat/is_etf>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_product_unified_cat/is_listed>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_product_unified_cat/isin>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_product_unified_cat/maturity_date>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_product_unified_cat/mstar_id>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_product_unified_cat/nse_symbol>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_product_unified_cat/product_id>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_product_unified_cat/product_short_code>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_product_unified_cat/product_type>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_product_unified_cat/row_hash>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_product_unified_cat/rta_code>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_product_unified_cat/scheme_master_id>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_product_unified_cat/sector>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_product_unified_cat/source_load_ts>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_product_unified_cat/source_table>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_product_unified_cat/sub_asset_class>,
        <https://wealth.example.org/neowealth/declared-attribute/main/dim_product_unified_cat/sub_asset_class_id> ;
    meta:identityMethod "configured_key" ;
    meta:rawYaml """
identity:
  id: "TABLE_DIM_PRODUCT_UNIFIED_CAT_001"
  type: "Table"
  subtype: "Dimension"
  name: "dim_product_unified_cat"
  display_name: "Product Unified Catalogue"
  description: >
    DIMENSION, 33 columns - THE WIDEST TABLE IN THE SCHEMA and the
    product-side hub, counterpart to dim_client_master. GRAIN: one row per
    product. Its purpose is to give every investable instrument - equity, MF,
    bonds, ETFs - a SINGLE product_id so facts reference one key regardless of
    asset class. It is an EIGHT-WAY IDENTIFIER CROSSWALK (isin, scheme_master_id,
    product_id, product_short_code, rta_code, amfi_code, mstar_id, co_code,
    bse_symbol, nse_symbol) and is the ONLY place these systems meet on one row.
    Because the identifiers apply to different asset classes, MOST ARE NULL ON ANY
    GIVEN ROW - a wide, sparse dimension. Never assume an identifier is present
    without checking product_type first. product_type is the SWITCHBOARD that
    decides which specialist dimension is valid to join onward to.

layer: "dimension"
grain: "one row per product"
not_null_columns: []
routing_switchboard: "product_type"

semantics:
  business_purpose: >
    The unified product catalogue and product-side hub. One row per product,
    giving every investable instrument a single product_id across asset classes.
    A wide, sparse identifier crosswalk; product_type routes to the correct
    specialist dimension.

attributes:
  - name: "scheme_master_id"
    display_name: "Scheme Master ID"
    description: "Internal scheme surrogate key; also present in dim_product_credit_rtng. Use this column (not isin) to join to the credit-rating table -- 3 rated instruments have isin = 'N/A' and so are missed by an isin join."
    type: "integer"
    sql_type: "integer"
    nullable: true
    filterable: true
    attribute_type: "identifier"
    join_target: "dim_product_credit_rtng.scheme_master_id"

  - name: "product_id"
    display_name: "Product ID"
    description: "THE UNIVERSAL PRODUCT KEY and the reason this table exists - it gives every investable instrument one key regardless of asset class. Referenced by 5 fact tables plus dim_product_segment_map. Format is type-prefixed and human-readable (PROD_EQ_001, PROD_MF_010), but filter on product_type rather than parsing the string."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "identifier"

  - name: "product_type"
    display_name: "Product Type"
    description: "THE ROUTING DISCRIMINATOR that decides which specialist dimension is valid to join onward to. Observed values (98 rows): Mutual Funds (30), Direct Equity (25), Bonds (15), Fixed Deposits (10), AIF (8), PMS (5), REITs (3), InvITs (2) - the fixed-income types the schema documentation samples omitted are present."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "dimension"
    observed_values: ["Mutual Funds", "Direct Equity", "Bonds", "Fixed Deposits", "AIF", "REITs", "PMS", "InvITs"]

  - name: "product_short_code"
    display_name: "Product Short Code"
    description: "Internal short code."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "identifier"

  - name: "isin"
    display_name: "ISIN"
    description: "International Securities Identification Number - the one identifier that spans every asset class and every vendor table (present in 11 tables). Take ISIN from HERE rather than from a fact row. NOT unique in dim_equity_price_latest, whose grain includes exchange."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "identifier"

  - name: "instrument_name"
    display_name: "Instrument Name"
    description: "The formal instrument name - the one the fact tables denormalise. One of three overlapping name columns here."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "dimension"

  - name: "display_name"
    display_name: "Display Name"
    description: "The UI-facing label. The schema documentation does not define how it differs from instrument_name."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "dimension"

  - name: "company_name"
    display_name: "Company Name"
    description: "The issuer; meaningful for equity."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "dimension"

  - name: "sector"
    display_name: "Sector"
    description: "Sector as a bare NAME with no code. NAMING TRAP: dim_cmot_company_mstr splits the same concept into sector_code + sector_name, giving two representations to reconcile. No dim_sector table exists."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "dimension"
    naming_trap: "dim_cmot_company_mstr splits this into sector_code + sector_name"
    missing_dimension: "dim_sector"

  - name: "category"
    display_name: "Category"
    description: "Product category. Note 'category' also appears in dim_mf_fund_complete, dim_mf_nav_history and dim_mf_returns_history - four tables carry it."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "dimension"

  - name: "amc_display_name"
    display_name: "AMC Display Name"
    description: "Asset Management Company name. NAMING TRAP: dim_mf_fund_complete calls this 'amc_name'. No dim_amc table exists."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "dimension"
    naming_trap: "called amc_name in dim_mf_fund_complete"
    missing_dimension: "dim_amc"

  - name: "asset_class_id"
    display_name: "Asset Class ID"
    description: "Level 1 asset classification. No dim_asset_class table exists - the hierarchy lives only as denormalised columns and cannot be validated or extended."
    type: "integer"
    sql_type: "integer"
    nullable: true
    filterable: true
    attribute_type: "identifier"
    missing_dimension: "dim_asset_class"

  - name: "asset_class"
    display_name: "Asset Class"
    description: "Level 1 asset classification name."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "dimension"

  - name: "sub_asset_class_id"
    display_name: "Sub-Asset Class ID"
    description: "Level 2 asset classification. No backing dimension. NOT A RELIABLE IDENTITY: ID 1004 carries several labels - Contra, Dividend Yield, Flexi Cap, FoF Overseas, Focused and Value under asset_class_id 901 (8 products), and Dynamic Bond, Gilt and Liquid under 902 (3 products) - 11 products in all. Adding asset_class_id does not resolve it, because several labels remain within each parent. Also, asset_class_id 903 ('Hybrid') holds two products: PROD_MF_019 carries sub_asset_class_id 903 ('Hybrid') - the same value as its asset_class_id - and PROD_MF_020 carries 1011 ('Balanced Advantage'). Blank on 28 rows. Keep sub_asset_class_id and sub_asset_class together on each product row exactly as supplied; SQL filters and groups use them directly. Do not overwrite labels, invent replacement IDs, infer one authoritative name per ID, or build a shared category entity on this ID until the data team confirms what 1004 means."
    type: "integer"
    sql_type: "integer"
    nullable: true
    filterable: true
    attribute_type: "identifier"

  - name: "sub_asset_class"
    display_name: "Sub-Asset Class"
    description: "Level 2 asset classification name. Not determined by sub_asset_class_id - one ID carries several names (see sub_asset_class_id). Blank on 28 rows. Preserve as supplied."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "dimension"

  - name: "rta_code"
    display_name: "RTA Code"
    description: "Registrar & Transfer Agent scheme code (CAMS/KFin). MUTUAL FUNDS ONLY - NULL on equity rows."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "identifier"

  - name: "amfi_code"
    display_name: "AMFI Code"
    description: "AMFI scheme code. MUTUAL FUNDS ONLY."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "identifier"

  - name: "mstar_id"
    display_name: "Morningstar ID"
    description: "Morningstar identifier -> dim_mf_fund_complete.mstar_id. MUTUAL FUNDS ONLY. This is the crosswalk that reaches the NAV and returns history."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "identifier"
    join_target: "dim_mf_fund_complete.mstar_id"

  - name: "co_code"
    display_name: "Company Code"
    description: "Equity data vendor company code -> dim_cmot_company_mstr.co_code. WARNING: the same column name in dim_cmot_index_prices identifies an INDEX, not a company. Populated on 30 of 98 rows: all 25 Direct Equity products (every one matches dim_cmot_company_mstr.co_code), plus 3 REITs (1050, 1051, 1052) and 2 InvITs (1053, 1054), whose codes do NOT appear in the supplied company master. Blank for every other product type. Whether those five codes should reference dim_cmot_company_mstr (company export incomplete) or another table is not stated by the source and must be confirmed with the data team. Preserve each original co_code; leave the five unmatched - do not invent company records or guess another target."
    type: "integer"
    sql_type: "integer"
    nullable: true
    filterable: true
    attribute_type: "identifier"
    join_target: "dim_cmot_company_mstr.co_code"
    warning: "co_code identifies an INDEX in dim_cmot_index_prices"

  - name: "bse_symbol"
    display_name: "BSE Symbol"
    description: "BSE scrip code. Typed INTEGER, which is substantively CORRECT (BSE codes are numeric, e.g. 500325) - but the shared '_symbol' suffix with the text nse_symbol invites treating them alike. NAMING TRAP: dim_cmot_company_mstr calls this 'bse_code'."
    type: "integer"
    sql_type: "integer"
    nullable: true
    filterable: true
    attribute_type: "identifier"
    naming_trap: "called bse_code in dim_cmot_company_mstr"

  - name: "nse_symbol"
    display_name: "NSE Symbol"
    description: "NSE trading symbol - alphabetic ticker, e.g. RELIANCE. Text, unlike bse_symbol."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "identifier"

  - name: "benchmark"
    display_name: "Benchmark"
    description: "Intended link to dim_cmot_index_prices.index_name by FREE-TEXT MATCH - which, by exact match, finds nothing in this data (see below). NAMING TRAP: dim_mf_fund_complete calls the same concept 'benchmark_name'. There is NO index_id anywhere, so a spelling variation ('Nifty 50' vs 'NIFTY 50' vs 'Nifty 50 TRI') breaks the link SILENTLY, yielding no benchmark rather than an error. Populated on all 98 rows with 4 values: 'Nifty 50 TRI' (39), 'Nifty 500 TRI' (30), 'Nifty 10 yr Benchmark G-Sec Index' (28), 'Nasdaq 100 TRI' (1). NONE equals an index_name exactly (0 of 98): the TRI labels name total-return series while the price table holds price series ('Nifty 50'), the G-Sec label is spelled differently from 'Nifty 10yr G-sec', and Nasdaq 100 has no series at all. For the 30 funds it differs from dim_mf_fund_complete.benchmark_name on 19. Preserve each label and its unmatched status in stored data and the KG - never strip ' TRI' or store an alias. The ' TRI' strip in 01_domain_and_business_rules.md §3.8 is a QUERY-TIME house rule only, which an equivalent KG query must reproduce exactly as the SQL does. A verified mapping or matching series would be a separate enrichment."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "dimension"
    join_target: "dim_cmot_index_prices.index_name (free-text match)"
    naming_trap: "called benchmark_name in dim_mf_fund_complete"

  - name: "credit_rating"
    display_name: "Credit Rating"
    description: "Cached copy. DUPLICATED from dim_product_credit_rtng, which is INFERRED to be the source of record. Read the specialist table for risk and compliance reporting; reconcile the two and alert on mismatches."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "dimension"
    duplicated_from: "dim_product_credit_rtng.credit_rating"

  - name: "interest_rate"
    display_name: "Interest Rate"
    description: "Coupon rate. Duplicated from dim_product_credit_rtng."
    type: "float"
    sql_type: "real"
    nullable: true
    filterable: true
    attribute_type: "fact"
    duplicated_from: "dim_product_credit_rtng.interest_rate"

  - name: "maturity_date"
    display_name: "Maturity Date"
    description: "Duplicated from dim_product_credit_rtng."
    type: "date"
    sql_type: "date"
    nullable: true
    filterable: true
    attribute_type: "time_dimension"
    duplicated_from: "dim_product_credit_rtng.maturity_date"

  - name: "face_value"
    display_name: "Face Value"
    description: "Duplicated from dim_product_credit_rtng. Typed integer, so it CANNOT represent a fractional face value."
    type: "integer"
    sql_type: "integer"
    nullable: true
    filterable: true
    attribute_type: "fact"
    duplicated_from: "dim_product_credit_rtng.face_value"

  - name: "is_etf"
    display_name: "Is ETF"
    description: "Boolean, nullable and three-valued."
    type: "boolean"
    sql_type: "boolean"
    nullable: true
    filterable: true
    attribute_type: "dimension"
    three_valued: true

  - name: "is_listed"
    display_name: "Is Listed"
    description: "Declared character varying(256): a text field, unlike its neighbours is_etf, is_active and is_deleted, which are booleans. Observed values: 'Listed' (72 rows) and 'Unlisted' (26 rows); no blanks. Filter on the text (is_listed = 'Listed'); a bare 'WHERE is_listed' does not apply to a text column. The is_ prefix does not make it a Boolean - keep the string datatype and the original values."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: true
    attribute_type: "dimension"
    observed_values: ["Listed", "Unlisted"]

  - name: "is_active"
    display_name: "Is Active"
    description: "Nullable three-valued flag."
    type: "boolean"
    sql_type: "boolean"
    nullable: true
    filterable: true
    attribute_type: "dimension"
    three_valued: true

  - name: "is_deleted"
    display_name: "Is Deleted"
    description: "Nullable three-valued flag."
    type: "boolean"
    sql_type: "boolean"
    nullable: true
    filterable: true
    attribute_type: "dimension"
    three_valued: true

  - name: "source_table"
    display_name: "Source Table"
    description: "Lineage: name of the ORIGIN object in the SOURCE system, not this table. Proven by dim_client_master rows carrying 'clients'. Present in all 21 tables. NEVER join or filter business logic on this."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: false
    attribute_type: "dimension"
    hidden: true

  - name: "source_load_ts"
    display_name: "Source Load Timestamp"
    description: "ETL load timestamp, WITHOUT TIME ZONE - no timezone is recorded anywhere, so IST vs UTC is a convention held outside the DB. Present in 12 of 14 dim_* tables; absent from both MF history tables and from all 7 client_* facts."
    type: "timestamp"
    sql_type: "timestamp without time zone"
    nullable: true
    filterable: true
    attribute_type: "time_dimension"
    hidden: true

  - name: "row_hash"
    display_name: "Row Hash"
    description: "64-bit change-detection fingerprint; samples are 16 lowercase hex chars. Used for change-detecting upsert. Present in all 14 dim_* tables, none of the client_* facts. NEVER join on this."
    type: "string"
    sql_type: "varchar(256)"
    nullable: true
    filterable: false
    attribute_type: "dimension"
    hidden: true""" ;
    meta:sourceFile "DIM_PRODUCT_UNIFIED_CAT_001.yaml" .

