attribute_type_corrected: fact
description: 'TYPE DEFECT: character varying(256) holding a number (samples 31.56,
  17.54). VERIFIED derivable: = 100.0 * (current_value - invested_value) / NULLIF(invested_value,
  0). Expressed as whole percent (31.56 means 31.56%).'
display_name: Unrealized Gain %
filterable: true
name: unrealized_gain_pct
nullable: true
sql_type: varchar(256)
type: string
type_defect: numeric stored as varchar; compute from invested/current value
