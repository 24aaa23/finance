    meta:sourceSqlType "VARCHAR" .

<https://wealth.example.org/neowealth/column/main/dim_client_master/id> a owl:DatatypeProperty ;
    dcterms:description "The client surrogate key and the hub of the entire model - every fact's client_id points here. NULLABLE, so the hub table of the model has NO valid primary key as declared. The most significant structural defect in the schema. Sample range 7001-7010." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_client_master> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "id" ;
    meta:sourceSqlType "INTEGER" .

<https://wealth.example.org/neowealth/column/main/dim_client_master/is_active> a owl:DatatypeProperty ;
    dcterms:description "Soft-delete pair, part 1. Plausibly means dormant/closed. Nullable and therefore THREE-VALUED - 'WHERE is_active' silently drops NULL rows. Use COALESCE(is_active, TRUE) = TRUE." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_client_master> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "is_active" ;
    meta:sourceSqlType "BOOLEAN" .

<https://wealth.example.org/neowealth/column/main/dim_client_master/is_deleted> a owl:DatatypeProperty ;
    dcterms:description "Soft-delete pair, part 2. Logically removed. The schema documentation does not forbid the contradictory combination is_active = TRUE AND is_deleted = TRUE. Use COALESCE(is_deleted, FALSE) = FALSE." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_client_master> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "is_deleted" ;
    meta:sourceSqlType "BOOLEAN" .

