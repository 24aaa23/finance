<https://wealth.example.org/neowealth/column/main/client_revenue/emp_code> a owl:DatatypeProperty ;
    dcterms:description "-> dim_employee_profile.code. Text join; denormalised duplicate of the emp_id path. You must resolve emp_id -> code before traversing the employee hierarchy, which is keyed on code." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_revenue> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "emp_code" ;
    meta:sourceSqlType "VARCHAR" .

<https://wealth.example.org/neowealth/column/main/client_revenue/emp_id> a owl:DatatypeProperty ;
    dcterms:description "-> dim_employee_profile.id. Integer join, PREFERRED. This is the ONLY fact table carrying an employee key, so it is the sole basis for RM productivity and incentive reporting. The schema documentation does NOT say which role this represents - servicing banker, acquiring banker, or neither - nor whether it is the banker at time of posting. Do not assume it equals either dim_client_master banker." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_revenue> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "emp_id" ;
    meta:sourceSqlType "INTEGER" .

<https://wealth.example.org/neowealth/column/main/client_revenue/id> a owl:DatatypeProperty ;
