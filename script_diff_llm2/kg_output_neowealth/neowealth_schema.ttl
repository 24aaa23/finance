<https://wealth.example.org/neowealth/column/main/client_realized_gain/realized_gain> a owl:DatatypeProperty ;
    dcterms:description "VERIFIED on sample id 110001 (SBI, 130 units, 505.19 -> 799.52): (799.52 - 505.19) * 130 = 38262.90, EXACT. So realized_gain = (sell_price - buy_price) * quantity, GROSS of costs - no brokerage, STT or tax is netted off. There is NO realized_loss column and no sign flag, so a loss must be a NEGATIVE realized_gain. SUM() therefore yields a NET figure; split on sign to report gross gains and losses separately." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_realized_gain> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "realized_gain" ;
    meta:sourceSqlType "DOUBLE" .

<https://wealth.example.org/neowealth/column/main/client_realized_gain/sell_date> a owl:DatatypeProperty ;
