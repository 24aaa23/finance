<https://wealth.example.org/neowealth/column/main/dim_mf_fund_complete/obsolete_into_mstar_id> a owl:DatatypeProperty ;
    dcterms:description "TYPE DEFECT: declared hllsketch. Intended as a self-reference to mstar_id pointing at the surviving fund a merged scheme went into - every other mstar_id in the schema is varchar(256). Near-certain cause: arrived 100% NULL, loader could not infer a type. THE FUND-MERGER CHAIN CANNOT BE TRAVERSED AT ALL. A fund that merged mid-period simply disappears from the time series, breaking long-run performance history and making it impossible to follow a client's holding through a scheme merger. This is the one genuinely missing edge in the join graph. EXPORT MISMATCH: the CSV has no obsolete_into_mstar_id column; it carries obsolete_into_mstar_id_count instead, blank on all 30 rows, so the intended meaning cannot be read from the values. The loader keeps this DDL name, so the column loads 100% NULL. A count is not a replacement-fund identifier - never treat obsolete_into_mstar_id_count as one. Whether the identifier was transformed during export or the count is intentional is not stated by the source and must be confirmed with the data team." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_mf_fund_complete> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "obsolete_into_mstar_id" ;
    meta:sourceSqlType "VARCHAR" .

<https://wealth.example.org/neowealth/column/main/dim_mf_fund_complete/row_hash> a owl:DatatypeProperty ;
    dcterms:description "64-bit change-detection fingerprint; samples are 16 lowercase hex chars. Used for change-detecting upsert. Present in all 14 dim_* tables, none of the client_* facts. NEVER join on this." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_mf_fund_complete> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "row_hash" ;
    meta:sourceSqlType "VARCHAR" .

<https://wealth.example.org/neowealth/column/main/dim_mf_fund_complete/rta_code> a owl:DatatypeProperty ;
