<https://wealth.example.org/neowealth/column/main/dim_mf_returns_history/return_1m> a owl:DatatypeProperty ;
    dcterms:description "TYPE DEFECT: character varying(256) while return_3y/5y/10y in this same table are proper real. AVG() fails; ORDER BY sorts lexicographically so '9.5' ranks ABOVE '12.3' and any top-performing-funds ranking built naively on it is SILENTLY AND COMPLETELY WRONG. A bare cast will THROW on the first sentinel value. Use the regex-guarded CASE." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_mf_returns_history> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "return_1m" ;
    meta:sourceSqlType "VARCHAR" .

<https://wealth.example.org/neowealth/column/main/dim_mf_returns_history/return_1y> a owl:DatatypeProperty ;
    dcterms:description "TYPE DEFECT: character varying(256). See return_1m. Because it is text the UNIT is unverifiable - whether '31.56' means 31.56% or 0.3156 cannot be determined from the schema. The analogous client_holdings.unrealized_gain_pct samples use whole percent, so the same convention is inferred." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_mf_returns_history> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "return_1y" ;
    meta:sourceSqlType "VARCHAR" .

<https://wealth.example.org/neowealth/column/main/dim_mf_returns_history/return_3m> a owl:DatatypeProperty ;
