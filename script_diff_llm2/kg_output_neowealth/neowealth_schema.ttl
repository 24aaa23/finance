<https://wealth.example.org/neowealth/column/main/dim_equity_price_latest/exchange> a owl:DatatypeProperty ;
    dcterms:description "PART OF THE GRAIN. The same company trades on both NSE and BSE at slightly different prices, so the key is (co_code, exchange, nav_date), NOT (co_code, nav_date). This is a fan-out hazard on every join." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_equity_price_latest> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "exchange" ;
    meta:sourceSqlType "VARCHAR" .

<https://wealth.example.org/neowealth/column/main/dim_equity_price_latest/isin> a owl:DatatypeProperty ;
    dcterms:description "Equity ISIN. NOT UNIQUE in this table - the same ISIN trades on BOTH NSE and BSE, so joining on isin + date alone DOUBLES the position. Always pin exchange." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_equity_price_latest> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "isin" ;
    meta:sourceSqlType "VARCHAR" .

<https://wealth.example.org/neowealth/column/main/dim_equity_price_latest/nav_close> a owl:DatatypeProperty ;
    dcterms:description "Closing price. Should reconcile to client_holdings.current_price for a direct equity holding on the same date - a good ongoing data-quality check. Compare with a TOLERANCE: current_price is double precision while this is real." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_equity_price_latest> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "nav_close" ;
    meta:sourceSqlType "FLOAT" .

<https://wealth.example.org/neowealth/column/main/dim_equity_price_latest/nav_date> a owl:DatatypeProperty ;
    dcterms:description "THE TABLE NAME SAYS _latest BUT THE STRUCTURE SAYS HISTORY. A date column plus full OHLCV is the signature of a time series. The schema documentation CANNOT settle whether this holds one current row per instrument or full history. Run: SELECT co_code, COUNT(*) FROM dim_equity_price_latest GROUP BY 1 ORDER BY 2 DESC LIMIT 5 - the answer changes every query you write against it. Settled in this data: 25 rows, one per co_code, all dated 2026-05-19." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_equity_price_latest> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "nav_date" ;
    meta:sourceSqlType "DATE" .

<https://wealth.example.org/neowealth/column/main/dim_equity_price_latest/nav_high> a owl:DatatypeProperty ;
    dcterms:description "Intraday high. Unlike dim_mf_nav_history this table has full OHLC, because exchange-traded instruments do have intraday ranges - so intraday volatility, true-range and gap analysis ARE possible for equity but not for funds." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_equity_price_latest> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "nav_high" ;
    meta:sourceSqlType "FLOAT" .

<https://wealth.example.org/neowealth/column/main/dim_equity_price_latest/nav_low> a owl:DatatypeProperty ;
    dcterms:description "Intraday low." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_equity_price_latest> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "nav_low" ;
    meta:sourceSqlType "FLOAT" .

<https://wealth.example.org/neowealth/column/main/dim_equity_price_latest/nav_open> a owl:DatatypeProperty ;
    dcterms:description "Opening price. The nav_ prefix is a MISNOMER for equities - NAV is mutual-fund terminology; equities have a market price. The prefix was copied from the MF tables. Harmless once known, but a search for 'price' columns will miss this table entirely." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_equity_price_latest> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "nav_open" ;
    meta:sourceSqlType "FLOAT" .

<https://wealth.example.org/neowealth/column/main/dim_equity_price_latest/nav_volume> a owl:DatatypeProperty ;
    dcterms:description "TYPE DEFECT (latent): declared integer, capped at ~2.15 billion. A heavily traded penny stock can exceed 2.15bn shares in a day and would OVERFLOW. bigint would have been the safe choice." ;
