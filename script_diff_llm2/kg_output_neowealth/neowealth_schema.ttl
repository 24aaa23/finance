<https://wealth.example.org/neowealth/column/main/dim_mf_nav_history/fund_name> a owl:DatatypeProperty ;
    dcterms:description "Denormalised onto every daily row. Deliberate: on a columnar warehouse these low-cardinality repeated strings compress extremely well, and it lets a NAV chart be drawn without joining the fund master." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_mf_nav_history> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "fund_name" ;
    meta:sourceSqlType "VARCHAR" .

