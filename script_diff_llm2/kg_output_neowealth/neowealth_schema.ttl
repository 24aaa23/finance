    meta:sourceColumn "isin" ;
    meta:sourceSqlType "VARCHAR" .

<https://wealth.example.org/neowealth/column/main/dim_mf_nav_history/mstar_id> a owl:DatatypeProperty ;
    dcterms:description "Part of the grain: (mstar_id, nav_date). -> dim_mf_fund_complete.mstar_id." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_mf_nav_history> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "mstar_id" ;
    meta:sourceSqlType "VARCHAR" .

<https://wealth.example.org/neowealth/column/main/dim_mf_nav_history/nav_currency> a owl:DatatypeProperty ;
    dcterms:description "Implies multi-currency capability (offshore/feeder funds). Overwhelmingly INR for an India-domiciled book. Nullable with NO default, so a NULL currency is indistinguishable from INR - any cross-currency aggregation must handle that explicitly." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_mf_nav_history> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "nav_currency" ;
    meta:sourceSqlType "VARCHAR" .

<https://wealth.example.org/neowealth/column/main/dim_mf_nav_history/nav_date> a owl:DatatypeProperty ;
    dcterms:description "WATCH FOR GAPS: nothing guarantees a row for every fund on every trading day. Weekends and market holidays are absent by design; a genuine data gap looks IDENTICAL. With no dim_date you cannot distinguish 'market closed' from 'data missing'. Compute returns with LAG(nav_value) OVER (PARTITION BY mstar_id ORDER BY nav_date) rather than assuming a fixed calendar offset." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_mf_nav_history> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "nav_date" ;
    meta:sourceSqlType "DATE" .

<https://wealth.example.org/neowealth/column/main/dim_mf_nav_history/nav_value> a owl:DatatypeProperty ;
    dcterms:description "A SINGLE price point per day - no open/high/low. Correct for mutual funds, which strike ONE NAV per day after close. Consequence: intraday ranges and high/low volatility CANNOT be computed for funds, only close-to-close returns. Should reconcile to client_holdings.current_price for a fund holding on the same date." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_mf_nav_history> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "nav_value" ;
    meta:sourceSqlType "FLOAT" .

<https://wealth.example.org/neowealth/column/main/dim_mf_nav_history/row_hash> a owl:DatatypeProperty ;
    dcterms:description "64-bit change-detection fingerprint; samples are 16 lowercase hex chars. Used for change-detecting upsert. Present in all 14 dim_* tables, none of the client_* facts. NEVER join on this." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_mf_nav_history> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "row_hash" ;
    meta:sourceSqlType "VARCHAR" .

<https://wealth.example.org/neowealth/column/main/dim_mf_nav_history/source_table> a owl:DatatypeProperty ;
    dcterms:description "Lineage: name of the ORIGIN object in the SOURCE system, not this table. Proven by dim_client_master rows carrying 'clients'. Present in all 21 tables. NEVER join or filter business logic on this." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_mf_nav_history> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "source_table" ;
    meta:sourceSqlType "VARCHAR" .

