<https://wealth.example.org/neowealth/declared-attribute/main/dim_product_segment_map/segment_id> a meta:DeclaredAttribute ;
    meta:rawYaml """attribute_type: identifier
description: 'No dim_segment table exists - another ID/name pair with no backing dimension.
  13 distinct IDs (601-613) for only 10 distinct names: three names carry two IDs
  each - ''Information Technology'' 601 and 612, ''Energy'' 602 and 610, ''Banking
  & Financial Services'' 603 and 608. Every ID maps to one name. So COUNT(DISTINCT
  segment_id) = 13 while COUNT(DISTINCT segment_name) = 10; use whichever field the
  question or query names, exactly as supplied. Do not merge IDs or invent a replacement
  ID.'
display_name: Segment ID
filterable: true
missing_dimension: dim_segment
name: segment_id
nullable: true
