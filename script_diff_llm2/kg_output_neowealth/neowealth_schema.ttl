<https://wealth.example.org/neowealth/column/main/dim_product_unified_cat/source_load_ts> a owl:DatatypeProperty ;
    dcterms:description "ETL load timestamp, WITHOUT TIME ZONE - no timezone is recorded anywhere, so IST vs UTC is a convention held outside the DB. Present in 12 of 14 dim_* tables; absent from both MF history tables and from all 7 client_* facts." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_product_unified_cat> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "source_load_ts" ;
    meta:sourceSqlType "TIMESTAMP" .

<https://wealth.example.org/neowealth/column/main/dim_product_unified_cat/source_table> a owl:DatatypeProperty ;
    dcterms:description "Lineage: name of the ORIGIN object in the SOURCE system, not this table. Proven by dim_client_master rows carrying 'clients'. Present in all 21 tables. NEVER join or filter business logic on this." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_product_unified_cat> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "source_table" ;
    meta:sourceSqlType "VARCHAR" .

<https://wealth.example.org/neowealth/column/main/dim_product_unified_cat/sub_asset_class> a owl:DatatypeProperty ;
    dcterms:description "Level 2 asset classification name. Not determined by sub_asset_class_id - one ID carries several names (see sub_asset_class_id). Blank on 28 rows. Preserve as supplied." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_product_unified_cat> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "sub_asset_class" ;
    meta:sourceSqlType "VARCHAR" .

<https://wealth.example.org/neowealth/column/main/dim_product_unified_cat/sub_asset_class_id> a owl:DatatypeProperty ;
    dcterms:description "Level 2 asset classification. No backing dimension. NOT A RELIABLE IDENTITY: ID 1004 carries several labels - Contra, Dividend Yield, Flexi Cap, FoF Overseas, Focused and Value under asset_class_id 901 (8 products), and Dynamic Bond, Gilt and Liquid under 902 (3 products) - 11 products in all. Adding asset_class_id does not resolve it, because several labels remain within each parent. Also, asset_class_id 903 ('Hybrid') holds two products: PROD_MF_019 carries sub_asset_class_id 903 ('Hybrid') - the same value as its asset_class_id - and PROD_MF_020 carries 1011 ('Balanced Advantage'). Blank on 28 rows. Keep sub_asset_class_id and sub_asset_class together on each product row exactly as supplied; SQL filters and groups use them directly. Do not overwrite labels, invent replacement IDs, infer one authoritative name per ID, or build a shared category entity on this ID until the data team confirms what 1004 means." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_product_unified_cat> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "sub_asset_class_id" ;
    meta:sourceSqlType "INTEGER" .

