<https://wealth.example.org/neowealth/column/main/dim_client_account_map/wsw_account_code> a owl:DatatypeProperty ;
    dcterms:description "-> client_holdings.wsw_account_code. THE ONLY account key reachable from a fact table, so this is the one to join on. Unique in this data (47 distinct codes on 47 rows). Of the 505 holdings, 174 match a code here with the same client_id, 210 match a code whose row names a DIFFERENT client_id, and 121 carry a code absent from this table. A code match is a source-record match, not validated client ownership - reproduce each query's own join condition exactly (see client_holdings.wsw_account_code)." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_client_account_map> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "wsw_account_code" ;
    meta:sourceSqlType "INTEGER" .

<https://wealth.example.org/neowealth/column/main/dim_client_master/acquiring_banker_id> a owl:DatatypeProperty ;
    dcterms:description "-> dim_employee_profile.id. The banker who originally WON the client (new-business incentives). Samples show this is frequently a DIFFERENT person from the servicing banker. This table therefore has TWO independent paths to dim_employee_profile - any query needing both names must join that table TWICE with distinct aliases. Joining once and hoping is a common silent error." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_client_master> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "acquiring_banker_id" ;
    meta:sourceSqlType "INTEGER" .

<https://wealth.example.org/neowealth/column/main/dim_client_master/acquiring_banker_name> a owl:DatatypeProperty ;
    dcterms:description "Denormalised banker name." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_client_master> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "acquiring_banker_name" ;
    meta:sourceSqlType "VARCHAR" .

<https://wealth.example.org/neowealth/column/main/dim_client_master/client_name> a owl:DatatypeProperty ;
    dcterms:description "Full client name. PII." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_client_master> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "client_name" ;
    meta:sourceSqlType "VARCHAR" .

<https://wealth.example.org/neowealth/column/main/dim_client_master/current_city> a owl:DatatypeProperty ;
    dcterms:description "NOT in the DDL - present in the CSV delivery. The client's current city, as free text. Populated on all 30 rows; observed values: Ahmedabad (7), Bengaluru (6), Delhi (6), Goa (6), Mumbai (5). Not a foreign key - there is no city or geography dimension. Personal data (location): treat as PII." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_client_master> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "current_city" ;
    meta:sourceSqlType "VARCHAR" .

<https://wealth.example.org/neowealth/column/main/dim_client_master/date_of_incorporation> a owl:DatatypeProperty ;
    dcterms:description "Populated for CORPORATE entities (companies, trusts); NULL across all 10 individual samples. Together with dob this is the only way to tell an individual from an entity - fragile, since both are nullable and a row with neither is unclassifiable." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_client_master> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "date_of_incorporation" ;
    meta:sourceSqlType "DATE" .

<https://wealth.example.org/neowealth/column/main/dim_client_master/dob> a owl:DatatypeProperty ;
    dcterms:description "Date of birth, populated for INDIVIDUALS. PII. See date_of_incorporation - there is no entity_type column, so client type must be inferred from which of the two dates is populated." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_client_master> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "dob" ;
    meta:sourceSqlType "DATE" .

<https://wealth.example.org/neowealth/column/main/dim_client_master/family_id> a owl:DatatypeProperty ;
    dcterms:description "Family rollup, nested BELOW group. Samples: 9001 = Krishnan Family (6 clients), 9002 = Mehra Family (4 clients). No dim_family table exists. For a wealth business where family-office consolidated reporting is a core product, this is a notable structural gap." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_client_master> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "family_id" ;
