@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix meta: <https://wealth.example.org/conversion-metadata/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

meta:SourceMatch a owl:Class .

meta:hasDeclaredAttribute a owl:ObjectProperty .

meta:identityMethod a owl:DatatypeProperty .

meta:joinDefinition a owl:DatatypeProperty .

meta:nullColumn a owl:ObjectProperty .

meta:nullable a owl:DatatypeProperty .

meta:rawYaml a owl:DatatypeProperty .

meta:relationshipKind a owl:DatatypeProperty .

meta:sha256 a owl:DatatypeProperty .

meta:sourceColumn a owl:DatatypeProperty .

meta:sourceFile a owl:DatatypeProperty .

meta:sourceRowNumber a owl:DatatypeProperty .

meta:sourceSqlType a owl:DatatypeProperty .

meta:sourceTable a owl:ObjectProperty .

<https://wealth.example.org/neowealth/column/main/client_aum/as_on_date> a owl:DatatypeProperty ;
    dcterms:description "MONTH-START dated monthly snapshot (2025-12-01, 2026-01-01, ... 2026-05-01). HAZARD: client_holdings.as_on_date is a DAILY date - equi-joining the two on date returns nothing or wrong rows. Align with DATE_TRUNC('month', ...)." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_aum> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "as_on_date" ;
    meta:sourceSqlType "DATE" .

<https://wealth.example.org/neowealth/column/main/client_aum/aum_alternatives> a owl:DatatypeProperty ;
    dcterms:description "Alternatives component of aum_value." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_aum> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "aum_alternatives" ;
    meta:sourceSqlType "DOUBLE" .

<https://wealth.example.org/neowealth/column/main/client_aum/aum_equity> a owl:DatatypeProperty ;
    dcterms:description "Equity component of aum_value. Part of the exhaustive 3-way split that reconciles to the total." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_aum> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "aum_equity" ;
    meta:sourceSqlType "DOUBLE" .

<https://wealth.example.org/neowealth/column/main/client_aum/aum_fixed_income> a owl:DatatypeProperty ;
    dcterms:description "Fixed-income component of aum_value." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_aum> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "aum_fixed_income" ;
    meta:sourceSqlType "DOUBLE" .

<https://wealth.example.org/neowealth/column/main/client_aum/aum_value> a owl:DatatypeProperty ;
    dcterms:description "Total AUM. VERIFIED IDENTITY on all 10 sample rows: aum_value = aum_equity + aum_fixed_income + aum_alternatives, exactly. Usable as a production data-quality assertion with a tolerance." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_aum> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "aum_value" ;
    meta:sourceSqlType "DOUBLE" .

<https://wealth.example.org/neowealth/column/main/client_aum/client_id> a owl:DatatypeProperty ;
    dcterms:description "-> dim_client_master.id. Confirmed by sample data (7001, 7002 fall inside the master's 7001-7010 range). Nullable: an inner join can silently drop rows." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_aum> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "client_id" ;
    meta:sourceSqlType "INTEGER" .

<https://wealth.example.org/neowealth/column/main/client_aum/id> a owl:DatatypeProperty ;
    dcterms:description "NOT NULL. One of only TWO NOT NULL columns in the entire 309-column schema, so the strongest PK candidate present. Sample range 140001+. Per-table sequence - never join id across fact tables." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_aum> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "id" ;
    meta:sourceSqlType "INTEGER" .

<https://wealth.example.org/neowealth/column/main/client_aum/lob_id> a owl:DatatypeProperty ;
    dcterms:description "-> dim_lob_hierarchy.lob_id. HAZARD: lob_id is NOT unique in that table (its grain is sub-LOB), so joining directly FANS OUT and multiplies aum_value. Join to (SELECT DISTINCT lob_id, ...) instead." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_aum> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "lob_id" ;
    meta:sourceSqlType "INTEGER" .

<https://wealth.example.org/neowealth/column/main/client_aum/lob_name> a owl:DatatypeProperty ;
    dcterms:description "Denormalised copy of dim_lob_hierarchy.lob_name, stored to avoid a join. Can drift from the master if an LOB is renamed. Observed values (180 rows): Neo Wealth Advisory (126), Broking Services (36), Asset Management (18) - all three present in dim_lob_hierarchy.lob_name." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_aum> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "lob_name" ;
    meta:sourceSqlType "VARCHAR" .

<https://wealth.example.org/neowealth/column/main/client_aum/source_table> a owl:DatatypeProperty ;
    dcterms:description "Lineage: name of the ORIGIN object in the SOURCE system, not this table. Proven by dim_client_master rows carrying 'clients'. Present in all 21 tables. NEVER join or filter business logic on this." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_aum> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "source_table" ;
    meta:sourceSqlType "VARCHAR" .

<https://wealth.example.org/neowealth/column/main/client_holdings/accrued_interest> a owl:DatatypeProperty ;
    dcterms:description "Zero across every sample row - all samples are equity and MF. Meaningful only for bonds and fixed deposits." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_holdings> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "accrued_interest" ;
    meta:sourceSqlType "DOUBLE" .

<https://wealth.example.org/neowealth/column/main/client_holdings/as_on_date> a owl:DatatypeProperty ;
    dcterms:description "DAILY position snapshot date; all 10 samples are 2026-05-19. Contrast client_aum.as_on_date, which is month-start." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_holdings> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "as_on_date" ;
    meta:sourceSqlType "DATE" .

<https://wealth.example.org/neowealth/column/main/client_holdings/avg_cost_price> a owl:DatatypeProperty ;
    dcterms:description "Weighted average per-unit purchase price. Typed real while current_price is double precision - the two are directly subtracted, so arithmetic is promoted to double precision while silently inheriting real's lower accuracy." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_holdings> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "avg_cost_price" ;
    meta:sourceSqlType "FLOAT" .

<https://wealth.example.org/neowealth/column/main/client_holdings/benchmark_name> a owl:DatatypeProperty ;
    dcterms:description "NOT in the DDL - present in the CSV delivery. Name of the benchmark used for comparison, carried on the position row. Populated on all 505 rows and equal on every row to dim_product_unified_cat.benchmark for the same product_id (the coarse product-level benchmark, not the fund master's benchmark_name). Observed values: 'Nifty 50 TRI' (239 rows), 'Nifty 10 yr Benchmark G-Sec Index' (130), 'Nifty 500 TRI' (128), 'Nasdaq 100 TRI' (8). NO value equals any dim_cmot_index_prices.index_name exactly (0 of 505). Preserve the label as supplied and keep it unmatched in stored data and the KG - never strip ' TRI' or store an alias. The ' TRI' strip in 01_domain_and_business_rules.md §3.8 is a QUERY-TIME house rule only, which an equivalent KG query must reproduce exactly as the SQL does." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_holdings> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "benchmark_name" ;
    meta:sourceSqlType "VARCHAR" .

<https://wealth.example.org/neowealth/column/main/client_holdings/benchmark_return_1y> a owl:DatatypeProperty ;
    dcterms:description "NOT in the DDL - present in the CSV delivery. Stored one-year return of the row's benchmark_name, supplied pre-computed: one value per benchmark (Nifty 50 TRI 13.2, Nifty 500 TRI 15.05, Nasdaq 100 TRI 18.4). Blank on the 130 rows benchmarked to 'Nifty 10 yr Benchmark G-Sec Index' (all 66 Bonds, all 51 Fixed Deposits and 13 Mutual Funds rows), populated on the other 375. Preserve as supplied - do not recalculate it or change its unit. The values read as whole percent (13.2 = 13.2%), like unrealized_gain_pct; the source does not declare the unit." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_holdings> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "benchmark_return_1y" ;
    meta:sourceSqlType "DOUBLE" .

<https://wealth.example.org/neowealth/column/main/client_holdings/benchmark_return_3y> a owl:DatatypeProperty ;
    dcterms:description "NOT in the DDL - present in the CSV delivery. Stored three-year return of the row's benchmark_name, supplied pre-computed: one value per benchmark (Nifty 50 TRI 12.9, Nifty 500 TRI 16.1, Nasdaq 100 TRI 20.1). Blank on exactly the same 130 G-Sec-benchmarked rows as benchmark_return_1y, populated on the other 375. Preserve as supplied - do not recalculate it or change its unit. Whole percent, as for benchmark_return_1y; the source does not declare the unit or whether it is annualised." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_holdings> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "benchmark_return_3y" ;
    meta:sourceSqlType "DOUBLE" .

<https://wealth.example.org/neowealth/column/main/client_holdings/client_id> a owl:DatatypeProperty ;
    dcterms:description "-> dim_client_master.id. CONFIRMED: holdings for client_id 7001 all carry client_pan 'ABCPK1001A', which is exactly dim_client_master.pan_number for id 7001." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_holdings> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "client_id" ;
    meta:sourceSqlType "INTEGER" .

<https://wealth.example.org/neowealth/column/main/client_holdings/client_pan> a owl:DatatypeProperty ;
    dcterms:description "Denormalised copy of dim_client_master.pan_number. DO NOT JOIN ON THIS - PAN is user-entered, correctable, can be shared across joint holdings, is nullable, and is sensitive. Present for display and upstream reconciliation only. PII." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_holdings> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "client_pan" ;
    meta:sourceSqlType "VARCHAR" .

<https://wealth.example.org/neowealth/column/main/client_holdings/current_price> a owl:DatatypeProperty ;
    dcterms:description "Per-unit mark price. For equity it should reconcile to dim_equity_price_latest.nav_close; for funds to dim_mf_nav_history.nav_value on the same date. Compare with a tolerance - the two sides differ in precision." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_holdings> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "current_price" ;
    meta:sourceSqlType "DOUBLE" .

<https://wealth.example.org/neowealth/column/main/client_holdings/current_value> a owl:DatatypeProperty ;
    dcterms:description "VERIFIED: = quantity * current_price (row 80001: 985 * 295.80 = 291363.00, exact)." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_holdings> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "current_value" ;
    meta:sourceSqlType "DOUBLE" .

<https://wealth.example.org/neowealth/column/main/client_holdings/id> a owl:DatatypeProperty ;
    dcterms:description "NOT NULL. The second and last NOT NULL column in the schema. Sample range 80001+. Per-table sequence - never join across tables." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_holdings> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "id" ;
    meta:sourceSqlType "INTEGER" .

<https://wealth.example.org/neowealth/column/main/client_holdings/instrument_name> a owl:DatatypeProperty ;
    dcterms:description "Denormalised instrument label. Samples include 'Bharat Electronics Ltd', 'Kotak Flexi Cap Fund - Direct Growth' (note MF names carry plan and option)." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_holdings> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "instrument_name" ;
    meta:sourceSqlType "VARCHAR" .

<https://wealth.example.org/neowealth/column/main/client_holdings/invested_value> a owl:DatatypeProperty ;
    dcterms:description "VERIFIED: = quantity * avg_cost_price (row 80001: 985 * 224.84 = 221467.40, exact). Nullable and can be zero - guard with NULLIF when dividing." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_holdings> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "invested_value" ;
    meta:sourceSqlType "DOUBLE" .

<https://wealth.example.org/neowealth/column/main/client_holdings/is_held_away> a owl:DatatypeProperty ;
    dcterms:description "Flags externally-custodied assets the firm advises on but does not hold. One sample row TRUE (Infosys, id 80005). Held-away assets are typically EXCLUDED from fee-billable AUM and revenue attribution but INCLUDED in a total-wealth view. Nullable, so always COALESCE(is_held_away, FALSE)." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_holdings> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "is_held_away" ;
    meta:sourceSqlType "BOOLEAN" .

<https://wealth.example.org/neowealth/column/main/client_holdings/isin> a owl:DatatypeProperty ;
    dcterms:description "Instrument identity. Samples: INE-prefixed = equity, INF-prefixed = mutual fund. Prefer joining to the catalogue on product_id, then taking ISIN from the catalogue row." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_holdings> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "isin" ;
    meta:sourceSqlType "VARCHAR" .

<https://wealth.example.org/neowealth/column/main/client_holdings/product_id> a owl:DatatypeProperty ;
    dcterms:description "-> dim_product_unified_cat.product_id. THE PREFERRED product join key. Sample format is type-prefixed: PROD_EQ_025, PROD_MF_010." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_holdings> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "product_id" ;
    meta:sourceSqlType "VARCHAR" .

<https://wealth.example.org/neowealth/column/main/client_holdings/product_type> a owl:DatatypeProperty ;
    dcterms:description "Denormalised from the catalogue. Observed values (505 rows): Mutual Funds (176), Direct Equity (154), Bonds (66), Fixed Deposits (51), AIF (19), REITs (17), PMS (15), InvITs (7). Acts as the routing discriminator for onward market-data joins." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_holdings> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "product_type" ;
    meta:sourceSqlType "VARCHAR" .

<https://wealth.example.org/neowealth/column/main/client_holdings/quantity> a owl:DatatypeProperty ;
    dcterms:description "Units/shares held. Fractional for funds (49130.91) and whole for equity (985) - so it can NEVER be typed integer. Typed real here but client_transactions.units is double precision: same concept, two precisions, expect reconciliation residuals." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_holdings> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "quantity" ;
    meta:sourceSqlType "FLOAT" .

<https://wealth.example.org/neowealth/column/main/client_holdings/source_table> a owl:DatatypeProperty ;
    dcterms:description "Lineage: name of the ORIGIN object in the SOURCE system, not this table. Proven by dim_client_master rows carrying 'clients'. Present in all 21 tables. NEVER join or filter business logic on this." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_holdings> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "source_table" ;
    meta:sourceSqlType "VARCHAR" .

<https://wealth.example.org/neowealth/column/main/client_holdings/unrealized_gain> a owl:DatatypeProperty ;
    dcterms:description "TYPE DEFECT: declared character varying(256) but holds numbers (samples 69895.6, 240301, 702792.2). SUM() fails; ORDER BY sorts lexicographically so '9' ranks after '240301'. VERIFIED derivable: = current_value - invested_value. DO NOT parse it - COMPUTE it. Also mis-classified as a BI 'dimension' in the schema documentation's semantic layer, so tools will not offer it as a measure." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_holdings> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "unrealized_gain" ;
    meta:sourceSqlType "VARCHAR" .

<https://wealth.example.org/neowealth/column/main/client_holdings/unrealized_gain_pct> a owl:DatatypeProperty ;
    dcterms:description "TYPE DEFECT: character varying(256) holding a number (samples 31.56, 17.54). VERIFIED derivable: = 100.0 * (current_value - invested_value) / NULLIF(invested_value, 0). Expressed as whole percent (31.56 means 31.56%)." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_holdings> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "unrealized_gain_pct" ;
    meta:sourceSqlType "VARCHAR" .

<https://wealth.example.org/neowealth/column/main/client_holdings/wsw_account_code> a owl:DatatypeProperty ;
    dcterms:description "-> dim_client_account_map.wsw_account_code. THE ONLY account-level join in the schema: no other fact table records an account, so account-level reporting is possible for holdings and nothing else. Sample 70001. 'wsw' is a source-system prefix. Populated on all 505 rows (30 distinct codes). Of the 505 holdings, 174 match an account-map row on code AND client_id, 210 match on code but the account-map row names a DIFFERENT client_id (e.g. holding 80175: client 7009, account 70017 mapped to client 7010), and 121 carry a code absent from dim_client_account_map. A code match is a source-record match, NOT validated client ownership: never derive client identity through this join - use client_id directly for anything client-level. Reproduce a query's own join condition exactly - joining on code alone gives 384 matched rows; adding client_id changes the result. Keep both source client_ids and report the conflict; never invent a matching account. Whether the intended key is the code alone or code + client_id is not stated by the source and must be confirmed with the data team." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_holdings> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "wsw_account_code" ;
    meta:sourceSqlType "INTEGER" .

<https://wealth.example.org/neowealth/column/main/client_net_new_money/client_id> a owl:DatatypeProperty ;
    dcterms:description "-> dim_client_master.id." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_net_new_money> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "client_id" ;
    meta:sourceSqlType "INTEGER" .

<https://wealth.example.org/neowealth/column/main/client_net_new_money/id> a owl:DatatypeProperty ;
    dcterms:description "Nullable." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_net_new_money> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "id" ;
    meta:sourceSqlType "INTEGER" .

<https://wealth.example.org/neowealth/column/main/client_net_new_money/inflow> a owl:DatatypeProperty ;
    dcterms:description "Gross money in, positive magnitude." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_net_new_money> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "inflow" ;
    meta:sourceSqlType "DOUBLE" .

<https://wealth.example.org/neowealth/column/main/client_net_new_money/net_flow> a owl:DatatypeProperty ;
    dcterms:description "TYPE DEFECT: character varying(256) while both its operands are proper double precision. COMPUTE inflow - outflow instead of reading it, since a text column sorts and compares as text. The stored text equals inflow - outflow on all 612 rows, with a leading minus sign on the 87 net-outflow rows; outflow is never negative. NNM is a headline KPI - it isolates genuine asset gathering from market movement, which AUM growth cannot." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_net_new_money> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "net_flow" ;
    meta:sourceSqlType "VARCHAR" .

<https://wealth.example.org/neowealth/column/main/client_net_new_money/outflow> a owl:DatatypeProperty ;
    dcterms:description "Gross money out, stored as its own POSITIVE magnitude - so net attrition shows as outflow > inflow." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_net_new_money> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "outflow" ;
    meta:sourceSqlType "DOUBLE" .

<https://wealth.example.org/neowealth/column/main/client_net_new_money/period_date> a owl:DatatypeProperty ;
    dcterms:description "A period aggregate, not an event date. Month-start dated: six periods, 2025-12-01 to 2026-05-01, 102 rows each, matching client_aum's month-start dating." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_net_new_money> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "period_date" ;
    meta:sourceSqlType "DATE" .

<https://wealth.example.org/neowealth/column/main/client_net_new_money/product_id> a owl:DatatypeProperty ;
    dcterms:description "Declared join -> dim_product_unified_cat.product_id - which matches no row in this data (see below). This is the ONLY product-bearing fact table with NO isin - flows are tracked at product_id granularity only. In this data product_id holds 4 AGGREGATE codes, not catalogue product keys: AGG_BONDS (102 rows, product_type 'Bonds'), AGG_DIRECT_EQUITY (150, 'Direct Equity'), AGG_FIXED_DEPOSITS (180, 'Fixed Deposits'), AGG_MUTUAL_FUNDS (180, 'Mutual Funds'). NONE of the 612 rows matches a dim_product_unified_cat.product_id (individual products such as PROD_EQ_001), so the declared join returns no rows - and an equivalent query must keep returning none. Read the bucket from product_type on the same row. Whether AGG_* codes denote investment categories is not stated by the source and must be confirmed with the data team. A confirmed category relationship may be added separately; it must not replace this join or spread a category total across individual products. Preserve the original product_id, product_type, client and period values." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_net_new_money> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "product_id" ;
    meta:sourceSqlType "VARCHAR" .

<https://wealth.example.org/neowealth/column/main/client_net_new_money/product_type> a owl:DatatypeProperty ;
    dcterms:description "Denormalised." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_net_new_money> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "product_type" ;
    meta:sourceSqlType "VARCHAR" .

<https://wealth.example.org/neowealth/column/main/client_net_new_money/source_table> a owl:DatatypeProperty ;
    dcterms:description "Lineage: name of the ORIGIN object in the SOURCE system, not this table. Proven by dim_client_master rows carrying 'clients'. Present in all 21 tables. NEVER join or filter business logic on this." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_net_new_money> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "source_table" ;
    meta:sourceSqlType "VARCHAR" .

<https://wealth.example.org/neowealth/column/main/client_realized_gain/buy_date> a owl:DatatypeProperty ;
    dcterms:description "Buy leg of the matched lot. Samples span 2023-03-07 to 2025-07-06." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_realized_gain> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "buy_date" ;
    meta:sourceSqlType "DATE" .

<https://wealth.example.org/neowealth/column/main/client_realized_gain/buy_price> a owl:DatatypeProperty ;
    dcterms:description "Per-unit purchase price of the lot." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_realized_gain> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "buy_price" ;
    meta:sourceSqlType "FLOAT" .

