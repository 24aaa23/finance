    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_product_unified_cat> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "scheme_master_id" ;
    meta:sourceSqlType "INTEGER" .

<https://wealth.example.org/neowealth/column/main/dim_product_unified_cat/sector> a owl:DatatypeProperty ;
    dcterms:description "Sector as a bare NAME with no code. NAMING TRAP: dim_cmot_company_mstr splits the same concept into sector_code + sector_name, giving two representations to reconcile. No dim_sector table exists." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_product_unified_cat> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "sector" ;
