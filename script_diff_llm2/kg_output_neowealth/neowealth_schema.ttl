    dcterms:description "BSE scrip code, e.g. 500325. NAMING TRAP: dim_product_unified_cat calls the identical concept 'bse_symbol' - same integer type, two names. A company may list on one or both exchanges, so either code may be NULL." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_cmot_company_mstr> ;
    meta:nullable "true"^^xsd:boolean ;
    meta:sourceColumn "bse_code" ;
