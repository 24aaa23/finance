<https://wealth.example.org/neowealth/column/main/client_transactions/transaction_type> a owl:DatatypeProperty ;
    dcterms:description "Purchase or Redemption - observed values: Purchase (2,972 rows) and Redemption (32), no blanks; no Buy/Sell/SIP/Switch/Dividend labels occur. This is the ONLY source of transaction direction: amount and units do not carry a sign. Filter on the labels exactly as supplied (transaction_type = 'Purchase'); do not assume other values exist." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/client_transactions> ;
    meta:nullable "true"^^xsd:boolean ;
