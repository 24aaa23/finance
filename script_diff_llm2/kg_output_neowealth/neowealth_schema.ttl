<https://wealth.example.org/neowealth/column/main/dim_client_master/gender> a owl:DatatypeProperty ;
    dcterms:description "Values seen in samples: Male, Female. Not an exhaustive enumeration. PII." ;
    rdfs:domain <https://wealth.example.org/neowealth/table/main/dim_client_master> ;
