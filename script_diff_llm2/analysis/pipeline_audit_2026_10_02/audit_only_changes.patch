+        dag.add_edge("Q2", "M1", source_field="account_id")
+        rows = [("Q1", {"data": [{"customer_id": "C-003", "region": "east"}]}),
+                ("Q2", {"data": [{"account_id": "A-9", "region": "east"}]})]
+        result = unmapped._run_set_operation("M1", "Set_Intersect", rows, dag)
