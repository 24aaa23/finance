+                                   "CREATE TABLE charges(customer_id INTEGER, amount REAL, charge_id INTEGER);")
+                conn.executemany("INSERT INTO customers VALUES (?, ?, ?)", [
+                    (1, None, 1), (2, None, 1), (3, "east", 1), (4, "east", 0)])
+                conn.executemany("INSERT INTO charges VALUES (?, ?, ?)", [
