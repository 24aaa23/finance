+            self.assertEqual(len(loaded["identity_bindings"]), 1)
+            selected = relevant_catalog_metrics(loaded, QUESTION, "sql", SCHEMA)
+            self.assertEqual([entry["id"] for entry in selected], ["average-charge"])
