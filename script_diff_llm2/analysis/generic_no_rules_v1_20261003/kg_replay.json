{
  "date_string_comparison": {
    "query": "PREFIX wm: <https://wealth.example.org/ontology/> PREFIX xsd: <http://www.w3.org/2001/XMLSchema#> SELECT (SUM(xsd:decimal(?a)) AS ?total) WHERE {?s a wm:CashFlow;wm:amount ?a;wm:date ?d. FILTER(?d >= \"2022-01-01\" && ?d <= \"2022-12-31\")}",
    "bindings": [
      {
        "total": {
          "type": "literal",
          "datatype": "http://www.w3.org/2001/XMLSchema#integer",
          "value": "0"
        }
      }
    ]
  },
  "date_typed_comparison": {
    "query": "PREFIX wm: <https://wealth.example.org/ontology/> PREFIX xsd: <http://www.w3.org/2001/XMLSchema#> SELECT (SUM(xsd:decimal(?a)) AS ?total) WHERE {?s a wm:CashFlow;wm:amount ?a;wm:date ?d. FILTER(?d >= \"2022-01-01\"^^xsd:date && ?d < \"2023-01-01\"^^xsd:date)}",
    "bindings": [
      {
        "total": {
          "type": "literal",
          "datatype": "http://www.w3.org/2001/XMLSchema#decimal",
          "value": "502078427.0"
        }
      }
    ]
  },
