        <https://wealth.example.org/metadata/ATOM_CONTEXT_SECTOR_001/attribute/sector_id> ;
    wm:primitiveId "ATOM_CONTEXT_SECTOR_001" ;
    wm:primitiveName "sector_context" ;
    wm:primitiveSubtype "Context" ;
    wm:sourceFile "TABLE_CONTEXT_SECTOR_001.yaml" ;
    wm:useCase "allocation_compliance",
        "portfolio_enrichment",
        "rebalancing_rules",
        "risk_assessment",
        "suitability_analysis" .

wmmeta:ATOM_CONTEXT_SEGMENT_001 a wm:Primitive ;
