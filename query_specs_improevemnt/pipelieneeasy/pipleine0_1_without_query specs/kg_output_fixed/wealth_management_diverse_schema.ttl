wmmeta:ATOM_CONTEXT_ASSET_CLASS_001 a wm:Primitive ;
    rdfs:label "Asset Class Context",
        "asset_class_context" ;
    dcterms:description "Unified business intelligence for asset categories and investment types, merging Category (Equity/Debt/Hybrid) and InvestmentType (Mutual Fund/Stock/ ELSS/PPF). Contains risk profiles, tax treatment, lock-in rules, and suitability guidelines." ;
    wm:businessPurpose "Provides comprehensive business intelligence for asset classes combining category characteristics (equity/debt/hybrid) with investment type specifics (mutual fund/stock/ELSS/PPF). Enables tax-aware recommendations, lock-in compliance, and suitability analysis." ;
    wm:hasContextValue <https://wealth.example.org/metadata/ATOM_CONTEXT_ASSET_CLASS_001/context/Alternative>,
        <https://wealth.example.org/metadata/ATOM_CONTEXT_ASSET_CLASS_001/context/Bonds>,
        <https://wealth.example.org/metadata/ATOM_CONTEXT_ASSET_CLASS_001/context/Cash-Equivalent>,
        <https://wealth.example.org/metadata/ATOM_CONTEXT_ASSET_CLASS_001/context/Commodities>,
        <https://wealth.example.org/metadata/ATOM_CONTEXT_ASSET_CLASS_001/context/Corporate-Bond>,
        <https://wealth.example.org/metadata/ATOM_CONTEXT_ASSET_CLASS_001/context/Crypto>,
        <https://wealth.example.org/metadata/ATOM_CONTEXT_ASSET_CLASS_001/context/Debt>,
        <https://wealth.example.org/metadata/ATOM_CONTEXT_ASSET_CLASS_001/context/ETF>,
        <https://wealth.example.org/metadata/ATOM_CONTEXT_ASSET_CLASS_001/context/Equity>,
        <https://wealth.example.org/metadata/ATOM_CONTEXT_ASSET_CLASS_001/context/Fixed-Income>,
        <https://wealth.example.org/metadata/ATOM_CONTEXT_ASSET_CLASS_001/context/Global-Equity>,
        <https://wealth.example.org/metadata/ATOM_CONTEXT_ASSET_CLASS_001/context/Gold>,
        <https://wealth.example.org/metadata/ATOM_CONTEXT_ASSET_CLASS_001/context/Government-Bond>,
        <https://wealth.example.org/metadata/ATOM_CONTEXT_ASSET_CLASS_001/context/Hedge-Fund>,
        <https://wealth.example.org/metadata/ATOM_CONTEXT_ASSET_CLASS_001/context/Hybrid>,
        <https://wealth.example.org/metadata/ATOM_CONTEXT_ASSET_CLASS_001/context/InVIT>,
        <https://wealth.example.org/metadata/ATOM_CONTEXT_ASSET_CLASS_001/context/Index-Fund>,
        <https://wealth.example.org/metadata/ATOM_CONTEXT_ASSET_CLASS_001/context/International>,
        <https://wealth.example.org/metadata/ATOM_CONTEXT_ASSET_CLASS_001/context/MF>,
        <https://wealth.example.org/metadata/ATOM_CONTEXT_ASSET_CLASS_001/context/Mutual-Fund>,
        <https://wealth.example.org/metadata/ATOM_CONTEXT_ASSET_CLASS_001/context/PPF>,
        <https://wealth.example.org/metadata/ATOM_CONTEXT_ASSET_CLASS_001/context/Private-Equity>,
        <https://wealth.example.org/metadata/ATOM_CONTEXT_ASSET_CLASS_001/context/REIT>,
        <https://wealth.example.org/metadata/ATOM_CONTEXT_ASSET_CLASS_001/context/Real-Estate>,
        <https://wealth.example.org/metadata/ATOM_CONTEXT_ASSET_CLASS_001/context/SGB>,
        <https://wealth.example.org/metadata/ATOM_CONTEXT_ASSET_CLASS_001/context/Venture-Capital> ;
    wm:hasDerivedContext <https://wealth.example.org/metadata/ATOM_CONTEXT_ASSET_CLASS_001/derived-context/has_lock_in>,
        <https://wealth.example.org/metadata/ATOM_CONTEXT_ASSET_CLASS_001/derived-context/is_suitable_for_risk>,
        <https://wealth.example.org/metadata/ATOM_CONTEXT_ASSET_CLASS_001/derived-context/is_tax_saving> ;
    wm:hasPrimitiveAttribute <https://wealth.example.org/metadata/ATOM_CONTEXT_ASSET_CLASS_001/attribute/asset_class_id>,
        <https://wealth.example.org/metadata/ATOM_CONTEXT_ASSET_CLASS_001/attribute/category>,
        <https://wealth.example.org/metadata/ATOM_CONTEXT_ASSET_CLASS_001/attribute/investment_type> ;
    wm:primitiveId "ATOM_CONTEXT_ASSET_CLASS_001" ;
    wm:primitiveName "asset_class_context" ;
    wm:primitiveSubtype "Context" ;
    wm:sourceFile "TABLE_CONTEXT_ASSET_CLASS_001.yaml" ;
    wm:useCase "lock_in_compliance",
        "product_recommendation",
        "regulatory_compliance",
        "suitability_analysis",
        "tax_planning" .

wmmeta:ATOM_CONTEXT_INVESTMENT_GOAL_001 a wm:Primitive ;
    rdfs:label "Investment Goal Rules",
        "investment_goal_context" ;
    dcterms:description "Investment goal classification with embedded business intelligence including recommended asset allocations, target return expectations, time horizon requirements, milestone tracking rules, and priority-based contribution strategies. Enables goal-based portfolio construction and progress monitoring." ;
    wm:businessPurpose "Provides prescriptive business intelligence for goal-based investing. Enables automated goal tracking, asset allocation recommendations based on goal type, and progress milestone monitoring." ;
    wm:hasContextValue <https://wealth.example.org/metadata/ATOM_CONTEXT_INVESTMENT_GOAL_001/context/Child-Education>,
        <https://wealth.example.org/metadata/ATOM_CONTEXT_INVESTMENT_GOAL_001/context/Emergency-Fund>,
        <https://wealth.example.org/metadata/ATOM_CONTEXT_INVESTMENT_GOAL_001/context/Growth>,
        <https://wealth.example.org/metadata/ATOM_CONTEXT_INVESTMENT_GOAL_001/context/Income-Generation>,
        <https://wealth.example.org/metadata/ATOM_CONTEXT_INVESTMENT_GOAL_001/context/Retirement-Planning>,
        <https://wealth.example.org/metadata/ATOM_CONTEXT_INVESTMENT_GOAL_001/context/Wealth-Preservation> ;
    wm:hasDerivedContext <https://wealth.example.org/metadata/ATOM_CONTEXT_INVESTMENT_GOAL_001/derived-context/is_long_term_goal>,
        <https://wealth.example.org/metadata/ATOM_CONTEXT_INVESTMENT_GOAL_001/derived-context/is_tax_advantaged>,
        <https://wealth.example.org/metadata/ATOM_CONTEXT_INVESTMENT_GOAL_001/derived-context/recommended_equity_allocation>,
        <https://wealth.example.org/metadata/ATOM_CONTEXT_INVESTMENT_GOAL_001/derived-context/requires_liquidity> ;
    wm:hasPrimitiveAttribute <https://wealth.example.org/metadata/ATOM_CONTEXT_INVESTMENT_GOAL_001/attribute/goal_type_id>,
        <https://wealth.example.org/metadata/ATOM_CONTEXT_INVESTMENT_GOAL_001/attribute/investment_goal> ;
    wm:primitiveId "ATOM_CONTEXT_INVESTMENT_GOAL_001" ;
    wm:primitiveName "investment_goal_context" ;
    wm:primitiveSubtype "Context" ;
    wm:sourceFile "TABLE_CONTEXT_INVESTMENT_GOAL_001.yaml" ;
    wm:useCase "contribution_planning",
        "goal_based_portfolio_construction",
        "goal_priority_management",
        "milestone_alerts",
        "progress_tracking" .

wmmeta:ATOM_CONTEXT_INVESTMENT_TYPE_001 a wm:Primitive ;
