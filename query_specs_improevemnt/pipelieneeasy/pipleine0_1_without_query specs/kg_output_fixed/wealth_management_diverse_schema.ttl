wmmeta:ATOM_ENTITY_SECTOR_ALLOCATION_001 a wm:Primitive ;
    rdfs:label "Sector Allocation",
        "sector_allocation" ;
    dcterms:description "Pre-computed sector allocation percentages and total investments per sector for each investor. This is stored data (not computed at runtime) providing fast access to allocation analysis without recalculating from holdings." ;
    wm:businessPurpose "Provides pre-computed sector allocation breakdown for portfolio analysis and compliance checking. Enables fast queries for allocation percentages, concentration analysis, and diversification assessment." ;
    wm:hasPrimitiveAttribute <https://wealth.example.org/metadata/ATOM_ENTITY_SECTOR_ALLOCATION_001/attribute/allocation_pct>,
        <https://wealth.example.org/metadata/ATOM_ENTITY_SECTOR_ALLOCATION_001/attribute/investor_id>,
        <https://wealth.example.org/metadata/ATOM_ENTITY_SECTOR_ALLOCATION_001/attribute/sector>,
        <https://wealth.example.org/metadata/ATOM_ENTITY_SECTOR_ALLOCATION_001/attribute/sector_id>,
        <https://wealth.example.org/metadata/ATOM_ENTITY_SECTOR_ALLOCATION_001/attribute/total_investment> ;
    wm:primitiveId "ATOM_ENTITY_SECTOR_ALLOCATION_001" ;
    wm:primitiveName "sector_allocation" ;
    wm:primitiveSubtype "Entity" ;
    wm:sourceFile "TABLE_ENTITY_SECTOR_ALLOCATION_001.yaml" ;
    wm:useCase "allocation_analysis",
        "compliance_validation",
        "concentration_risk",
        "diversification_check",
        "rebalancing_input" .

wmmeta:ATOM_EVENT_CASH_FLOW_001 a wm:Primitive ;
    rdfs:label "Cash Flow",
        "cash_flow" ;
    dcterms:description "Time-stamped cash flow events including deposits, withdrawals, SIP contributions, lump sum investments, and redemptions. Primary event source for transaction history, cash flow analysis, and contribution tracking." ;
    wm:businessPurpose "Tracks all monetary transactions for investor portfolios including contributions and withdrawals. Enables cash flow analysis, contribution tracking, and transaction history reporting." ;
    wm:hasDerivedAttribute <https://wealth.example.org/metadata/ATOM_EVENT_CASH_FLOW_001/derived-attribute/absolute_amount>,
        <https://wealth.example.org/metadata/ATOM_EVENT_CASH_FLOW_001/derived-attribute/is_inflow>,
        <https://wealth.example.org/metadata/ATOM_EVENT_CASH_FLOW_001/derived-attribute/transaction_month> ;
    wm:hasPrimitiveAttribute <https://wealth.example.org/metadata/ATOM_EVENT_CASH_FLOW_001/attribute/amount>,
        <https://wealth.example.org/metadata/ATOM_EVENT_CASH_FLOW_001/attribute/cash_flow_id>,
        <https://wealth.example.org/metadata/ATOM_EVENT_CASH_FLOW_001/attribute/date>,
        <https://wealth.example.org/metadata/ATOM_EVENT_CASH_FLOW_001/attribute/investor_id>,
        <https://wealth.example.org/metadata/ATOM_EVENT_CASH_FLOW_001/attribute/notes>,
        <https://wealth.example.org/metadata/ATOM_EVENT_CASH_FLOW_001/attribute/source>,
        <https://wealth.example.org/metadata/ATOM_EVENT_CASH_FLOW_001/attribute/type> ;
    wm:primitiveId "ATOM_EVENT_CASH_FLOW_001" ;
    wm:primitiveName "cash_flow" ;
    wm:primitiveSubtype "Event" ;
    wm:sourceFile "TABLE_EVENT_CASH_FLOW_001.yaml" ;
    wm:useCase "cash_flow_analysis",
        "contribution_tracking",
        "sip_monitoring",
        "transaction_history",
        "withdrawal_analysis" .

wmmeta:ATOM_EVENT_REBALANCING_ACTION_001 a wm:Primitive ;
    rdfs:label "Rebalancing Action",
        "rebalancing_action" ;
    dcterms:description "Time-stamped portfolio rebalancing action events. Captures buy/sell/hold recommendations generated by rebalancing logic. Each event represents an actionable step to align portfolio with target allocation." ;
    wm:businessPurpose "Captures portfolio rebalancing recommendations and actions. Enables tracking of buy/sell/hold decisions, allocation drift analysis, and rebalancing strategy execution." ;
    wm:hasDerivedAttribute <https://wealth.example.org/metadata/ATOM_EVENT_REBALANCING_ACTION_001/derived-attribute/allocation_drift>,
        <https://wealth.example.org/metadata/ATOM_EVENT_REBALANCING_ACTION_001/derived-attribute/drift_direction> ;
    wm:hasPrimitiveAttribute <https://wealth.example.org/metadata/ATOM_EVENT_REBALANCING_ACTION_001/attribute/action>,
        <https://wealth.example.org/metadata/ATOM_EVENT_REBALANCING_ACTION_001/attribute/amount>,
        <https://wealth.example.org/metadata/ATOM_EVENT_REBALANCING_ACTION_001/attribute/current_allocation_pct>,
        <https://wealth.example.org/metadata/ATOM_EVENT_REBALANCING_ACTION_001/attribute/investor_id>,
        <https://wealth.example.org/metadata/ATOM_EVENT_REBALANCING_ACTION_001/attribute/logic>,
        <https://wealth.example.org/metadata/ATOM_EVENT_REBALANCING_ACTION_001/attribute/notes>,
        <https://wealth.example.org/metadata/ATOM_EVENT_REBALANCING_ACTION_001/attribute/rebalance_id>,
        <https://wealth.example.org/metadata/ATOM_EVENT_REBALANCING_ACTION_001/attribute/target_allocation_pct> ;
    wm:primitiveId "ATOM_EVENT_REBALANCING_ACTION_001" ;
    wm:primitiveName "rebalancing_action" ;
    wm:primitiveSubtype "Event" ;
    wm:sourceFile "TABLE_EVENT_REBALANCING_ACTION_001.yaml" ;
    wm:useCase "action_recommendations",
        "allocation_drift_analysis",
        "compliance_audit",
        "portfolio_adjustment",
        "rebalancing_tracking" .

wmmeta:ATOM_EVENT_SCENARIO_REBALANCING_001 a wm:Primitive ;
    rdfs:label "Scenario-Based Rebalancing",
        "scenario_rebalancing" ;
    dcterms:description "Time-stamped scenario-based rebalancing events. Captures rebalancing actions triggered by specific market scenarios (e.g., interest rate changes, market volatility spikes). Each event represents a conditional rebalancing response with rationale and affected assets." ;
    wm:businessPurpose "Captures scenario-driven portfolio rebalancing triggers. Enables tracking of how market events or conditions trigger rebalancing actions, affected assets/sectors, and the rationale behind allocation changes." ;
    wm:hasDerivedAttribute <https://wealth.example.org/metadata/ATOM_EVENT_SCENARIO_REBALANCING_001/derived-attribute/allocation_change>,
        <https://wealth.example.org/metadata/ATOM_EVENT_SCENARIO_REBALANCING_001/derived-attribute/change_direction> ;
    wm:hasPrimitiveAttribute <https://wealth.example.org/metadata/ATOM_EVENT_SCENARIO_REBALANCING_001/attribute/affected_assets_sectors>,
        <https://wealth.example.org/metadata/ATOM_EVENT_SCENARIO_REBALANCING_001/attribute/current_allocation_pct>,
        <https://wealth.example.org/metadata/ATOM_EVENT_SCENARIO_REBALANCING_001/attribute/investor_id>,
        <https://wealth.example.org/metadata/ATOM_EVENT_SCENARIO_REBALANCING_001/attribute/new_allocation_pct>,
        <https://wealth.example.org/metadata/ATOM_EVENT_SCENARIO_REBALANCING_001/attribute/rationale>,
        <https://wealth.example.org/metadata/ATOM_EVENT_SCENARIO_REBALANCING_001/attribute/scenario>,
        <https://wealth.example.org/metadata/ATOM_EVENT_SCENARIO_REBALANCING_001/attribute/scenario_rebalance_id>,
        <https://wealth.example.org/metadata/ATOM_EVENT_SCENARIO_REBALANCING_001/attribute/triggered_action> ;
    wm:primitiveId "ATOM_EVENT_SCENARIO_REBALANCING_001" ;
    wm:primitiveName "scenario_rebalancing" ;
    wm:primitiveSubtype "Event" ;
    wm:sourceFile "TABLE_EVENT_SCENARIO_REBALANCING_001.yaml" ;
    wm:useCase "compliance_documentation",
        "conditional_rebalancing",
        "market_response_analysis",
        "risk_event_tracking",
        "scenario_analysis" .

