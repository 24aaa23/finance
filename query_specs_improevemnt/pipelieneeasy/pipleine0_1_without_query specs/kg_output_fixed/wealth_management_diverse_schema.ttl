        "portfolio_monitoring",
        "risk_identification" .

wmmeta:ATOM_ENTITY_PORTFOLIO_HOLDING_001 a wm:Primitive ;
    rdfs:label "Portfolio Holding",
        "portfolio_holding" ;
    dcterms:description "Individual investment positions held by investors. Contains cost basis, current valuations, returns, and classification by sector/segment/category. Primary fact table for portfolio analytics and performance tracking." ;
    wm:businessPurpose "Core transactional data for portfolio composition analysis, performance  tracking, and asset allocation. Enables queries about what investors own, portfolio value, returns, and diversification." ;
    wm:hasDerivedAttribute <https://wealth.example.org/metadata/ATOM_ENTITY_PORTFOLIO_HOLDING_001/derived-attribute/absolute_return>,
        <https://wealth.example.org/metadata/ATOM_ENTITY_PORTFOLIO_HOLDING_001/derived-attribute/holding_period_days>,
