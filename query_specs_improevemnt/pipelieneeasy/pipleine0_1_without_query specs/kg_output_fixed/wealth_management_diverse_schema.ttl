wmmeta:ATOM_ENTITY_INVESTOR_PROFILE_001 a wm:Primitive ;
    rdfs:label "Investor Profile",
        "investor_profile" ;
    dcterms:description "Core investor identity and investment preferences. This is the primary entity for all investor-centric queries including risk profiling, goal setting, and suitability analysis. Contains demographic information, risk tolerance,  investment horizon, and sector preferences." ;
