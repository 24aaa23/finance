wmmeta:ATOM_CONTEXT_TIME_HORIZON_001 a wm:Primitive ;
    rdfs:label "Time Horizon Rules",
        "time_horizon_context" ;
    dcterms:description "Investment time horizon classification with embedded business intelligence including asset allocation strategies, product eligibility rules, liquidity requirements, and risk-return optimization guidelines. Enables duration-based portfolio construction and maturity planning." ;
    wm:businessPurpose "Provides prescriptive business intelligence for duration-based investing. Enables time-appropriate asset allocation, product selection, and exit strategy planning based on investment horizon." ;
