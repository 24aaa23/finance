        <https://wealth.example.org/metadata/ATOM_ENTITY_PORTFOLIO_HOLDING_001/attribute/purchase_date>,
        <https://wealth.example.org/metadata/ATOM_ENTITY_PORTFOLIO_HOLDING_001/attribute/returns_pct>,
        <https://wealth.example.org/metadata/ATOM_ENTITY_PORTFOLIO_HOLDING_001/attribute/sector>,
        <https://wealth.example.org/metadata/ATOM_ENTITY_PORTFOLIO_HOLDING_001/attribute/segment>,
        <https://wealth.example.org/metadata/ATOM_ENTITY_PORTFOLIO_HOLDING_001/attribute/taxes_paid> ;
    wm:primitiveId "ATOM_ENTITY_PORTFOLIO_HOLDING_001" ;
    wm:primitiveName "portfolio_holding" ;
