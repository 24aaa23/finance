        <https://wealth.example.org/metadata/ATOM_ENTITY_PORTFOLIO_HEALTH_001/attribute/goal_match_pct>,
        <https://wealth.example.org/metadata/ATOM_ENTITY_PORTFOLIO_HEALTH_001/attribute/investor_id>,
        <https://wealth.example.org/metadata/ATOM_ENTITY_PORTFOLIO_HEALTH_001/attribute/liquidity_score>,
        <https://wealth.example.org/metadata/ATOM_ENTITY_PORTFOLIO_HEALTH_001/attribute/portfolio_health_id>,
        <https://wealth.example.org/metadata/ATOM_ENTITY_PORTFOLIO_HEALTH_001/attribute/risk_score> ;
    wm:primitiveId "ATOM_ENTITY_PORTFOLIO_HEALTH_001" ;
    wm:primitiveName "portfolio_health" ;
    wm:primitiveSubtype "Entity" ;
