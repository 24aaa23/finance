wmmeta:ATOM_ENTITY_INVESTMENT_GOAL_001 a wm:Primitive ;
    rdfs:label "Investment Goal",
        "investment_goal" ;
    dcterms:description "Unified investment goal entity consolidating goal definition, progress tracking, performance metrics, and risk metrics. Provides a complete view of investor goals including target amounts, current progress, returns, and volatility. Replaces separate GoalTracking, GoalPerformance, and GoalRiskMetrics entities." ;
    wm:businessPurpose "Provides unified view of investor financial goals including definition, progress tracking, performance metrics, and risk metrics. Enables goal-based advisory, progress monitoring, and goal achievement forecasting." ;
    wm:hasDerivedAttribute <https://wealth.example.org/metadata/ATOM_ENTITY_INVESTMENT_GOAL_001/derived-attribute/is_on_track>,
