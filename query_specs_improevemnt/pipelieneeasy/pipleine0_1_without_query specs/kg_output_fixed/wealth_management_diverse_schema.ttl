wmmeta:ATOM_CONTEXT_RISK_TOLERANCE_001 a wm:Primitive ;
    rdfs:label "Risk Tolerance Rules",
        "risk_tolerance_context" ;
    dcterms:description "Risk tolerance classification with embedded business intelligence including asset allocation limits, product suitability rules, volatility thresholds, and compliance requirements. This is NOT just a lookup table - it contains the rules that govern how each risk profile should be treated in portfolio construction and compliance validation." ;
    wm:businessPurpose "Provides prescriptive business intelligence for risk-based portfolio management. Enables automated compliance checking, suitability validation, and risk-appropriate product recommendations." ;
    wm:hasContextValue <https://wealth.example.org/metadata/ATOM_CONTEXT_RISK_TOLERANCE_001/context/Aggressive>,
        <https://wealth.example.org/metadata/ATOM_CONTEXT_RISK_TOLERANCE_001/context/Conservative>,
        <https://wealth.example.org/metadata/ATOM_CONTEXT_RISK_TOLERANCE_001/context/Moderate> ;
    wm:hasDerivedContext <https://wealth.example.org/metadata/ATOM_CONTEXT_RISK_TOLERANCE_001/derived-context/get_suitable_products>,
        <https://wealth.example.org/metadata/ATOM_CONTEXT_RISK_TOLERANCE_001/derived-context/is_equity_heavy_allowed>,
        <https://wealth.example.org/metadata/ATOM_CONTEXT_RISK_TOLERANCE_001/derived-context/is_high_risk_products_allowed>,
        <https://wealth.example.org/metadata/ATOM_CONTEXT_RISK_TOLERANCE_001/derived-context/max_equity_allocation> ;
    wm:hasPrimitiveAttribute <https://wealth.example.org/metadata/ATOM_CONTEXT_RISK_TOLERANCE_001/attribute/risk_tolerance>,
        <https://wealth.example.org/metadata/ATOM_CONTEXT_RISK_TOLERANCE_001/attribute/risk_tolerance_id> ;
    wm:primitiveId "ATOM_CONTEXT_RISK_TOLERANCE_001" ;
    wm:primitiveName "risk_tolerance_context" ;
    wm:primitiveSubtype "Context" ;
    wm:sourceFile "TABLE_CONTEXT_RISK_TOLERANCE_001.yaml" ;
    wm:useCase "asset_allocation_validation",
        "portfolio_compliance",
        "product_recommendation",
        "risk_based_rebalancing",
        "suitability_assessment" .

wmmeta:ATOM_CONTEXT_SECTOR_001 a wm:Primitive ;
    rdfs:label "Sector Context",
        "sector_context" ;
    dcterms:description "Business intelligence for industry sectors including risk characteristics, allocation limits by risk tolerance, volatility profiles, and regulatory considerations. This is NOT just a lookup table - it contains embedded business rules that travel with data." ;
    wm:businessPurpose "Provides business intelligence for sector-based portfolio analysis including risk characteristics, allocation limits, and suitability rules. Enables automated compliance checking and intelligent recommendations." ;
    wm:hasContextValue <https://wealth.example.org/metadata/ATOM_CONTEXT_SECTOR_001/context/Automobile>,
