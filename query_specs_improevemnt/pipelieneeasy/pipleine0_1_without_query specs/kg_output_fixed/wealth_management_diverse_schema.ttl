wmmeta:ATOM_ENTITY_PORTFOLIO_HEALTH_001 a wm:Primitive ;
    rdfs:label "Portfolio Health",
        "portfolio_health" ;
    dcterms:description "Pre-computed portfolio health scores across multiple dimensions: goal alignment, risk, liquidity, and diversification. This is stored data (not computed at  runtime) providing instant access to health assessments." ;
    wm:businessPurpose "Provides pre-computed health assessment scores for portfolio monitoring, risk management, and advisory prioritization. Enables quick identification of portfolios needing attention." ;
    wm:hasDerivedAttribute <https://wealth.example.org/metadata/ATOM_ENTITY_PORTFOLIO_HEALTH_001/derived-attribute/health_status>,
